---
import HardwareIndex from '../../../components/HardwareIndex.astro';
import records from '../../../data/hardware/enclosures.json';

const chips = (r: any) => [
  r['Type'] ? String(r['Type']) : null,
  r['Material'] ? String(r['Material']) : null,
  r['Price (USD)'] != null ? `~$${r['Price (USD)']}` : null,
].filter(Boolean) as string[];
---
<HardwareIndex
  records={records}
  route="enclosures"
  categoryLabel="ENCLOSURE"
  crumb="Enclosures"
  heading="Enclosures"
  sub="Enclosure kits and DIY designs. Material, thickness, chamber temperature, and fit."
  nounSingular="enclosure"
  nounPlural="enclosures"
  title="Best Enclosures for Voron & CoreXY 3D Printers"
  description="Enclosure specs, material, chamber temperature, and where to buy — kit and DIY enclosures for Voron, RatRig, and CoreXY builds."
  schemaName="Best Enclosures for Voron & CoreXY 3D Printers"
  chips={chips}
/>
