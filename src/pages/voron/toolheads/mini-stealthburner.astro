---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
const currentPath = '/voron/toolheads';
---
<Base hasPageH1={true} title="Mini-Stealthburner — Official Voron Toolhead Guide" description="Complete guide to the Mini-Stealthburner: printed parts, hardware list, hotend and extruder compatibility, and build notes for Voron 2.4 and Trident.">
  <Nav slot="nav" currentPath={currentPath} />

  <!-- HERO -->
  <div style="background:var(--black);padding:40px 0">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px">
        <a href="/" style="font-size:11px;color:rgba(255,255,255,.3);font-family:'JetBrains Mono',monospace">Home</a>
        <span style="color:rgba(255,255,255,.2)">/</span>
        <a href="/voron" style="font-size:11px;color:rgba(255,255,255,.3);font-family:'JetBrains Mono',monospace">Voron</a>
        <span style="color:rgba(255,255,255,.2)">/</span>
        <a href="/voron/toolheads" style="font-size:11px;color:rgba(255,255,255,.3);font-family:'JetBrains Mono',monospace">Toolheads</a>
        <span style="color:rgba(255,255,255,.2)">/</span>
        <span style="font-size:11px;color:rgba(255,255,255,.55);font-family:'JetBrains Mono',monospace">Mini-Stealthburner</span>
      </div>
      <div class="eyebrow" style="margin-bottom:10px">Voron · Toolhead</div>
      <h1 style="font-family:'Barlow Condensed',sans-serif;font-size:56px;font-weight:800;color:#fff;line-height:1;letter-spacing:-.5px;margin-bottom:8px">Mini-Stealthburner</h1>
      <div style="font-family:'JetBrains Mono',monospace;font-size:12px;color:rgba(255,255,255,.4);margin-bottom:16px">Official Voron Design</div>
      <p style="font-family:'Lora',serif;font-size:15px;color:rgba(255,255,255,.45);line-height:1.7;max-width:560px;margin-bottom:20px">Scaled-down Stealthburner for smaller builds and lighter hotends. Primarily used on Voron 0.</p>
      <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
        <span class="verdict verdict-upd" style="font-size:10px;letter-spacing:.06em">SITUATIONAL</span>
        <a href="https://github.com/VoronDesign/Voron-0" target="_blank" rel="noopener" style="font-family:'Barlow',sans-serif;font-size:13px;font-weight:700;color:var(--accent)">View on GitHub →</a>
        <a href="/voron/toolheads" style="font-family:'JetBrains Mono',monospace;font-size:12px;color:rgba(255,255,255,.4)">← All Toolheads</a>
      </div>
    </div>
  </div>

  <!-- MODEL CONTEXT BAR -->
  <div style="background:var(--surface);border-bottom:1px solid var(--border);padding:12px 0">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div class="model-context-bar">
        <span class="model-context-label">Showing parts for:</span>
        <span id="active-model-label" class="model-context-value">Voron 2.4</span>
        <a href="/voron" class="model-context-switch">Switch model →</a>
      </div>
    </div>
  </div>

  <!-- CALLOUT -->
  <div style="background:#f0efe9;border-bottom:1px solid var(--border);padding:20px 0">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div class="callout callout-orange" style="margin:0">
        <strong>Primarily a Voron 0 toolhead</strong>
        Mini-Stealthburner is designed for Voron 0. It works on 2.4 and Trident but offers limited advantages over standard Stealthburner — narrower hotend compatibility and documentation almost entirely focused on V0. Most builders on 2.4 or Trident should use Stealthburner or Xol instead.
      </div>
    </div>
  </div>

  <!-- MAIN CONTENT -->
  <div class="section" style="background:var(--bg)">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px;display:grid;grid-template-columns:1fr 280px;gap:48px;align-items:start">

      <!-- LEFT COLUMN -->
      <div>

        <section style="margin-bottom:40px">
          <h2 style="font-family:'Barlow Condensed',sans-serif;font-size:26px;font-weight:800;color:var(--black);margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid var(--border)">Overview</h2>
          <p style="font-family:'Lora',serif;font-size:16px;line-height:1.8;color:var(--g1);margin-bottom:16px">Mini-Stealthburner is the official scaled-down toolhead from Voron Design, originally designed for the Voron 0 (a compact CoreXY printer with a 120mm build volume). It is occasionally used on 2.4 and Trident builds where weight reduction is the primary goal, but this is uncommon.</p>
          <p style="font-family:'Lora',serif;font-size:16px;line-height:1.8;color:var(--g1);margin-bottom:16px">On a full-size Voron 2.4 or Trident, Mini-Stealthburner offers limited advantages over standard Stealthburner — the weight savings are real but the hotend compatibility is narrower and the community documentation is almost entirely focused on Voron 0. Most builders on 2.4 or Trident should use standard Stealthburner or Xol instead.</p>
          <p style="font-family:'Lora',serif;font-size:16px;line-height:1.8;color:var(--g1)">Mini-Stealthburner is included here because it works on 2.4 and Trident and some builders choose it for specific lightweight configurations.</p>
        </section>

        <section style="margin-bottom:40px">
          <h2 style="font-family:'Barlow Condensed',sans-serif;font-size:26px;font-weight:800;color:var(--black);margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid var(--border)">Printed Parts</h2>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px">
            {['Mini-Stealthburner body','Hotend mount','Fan shroud','Extruder mount'].map(part => (
              <li style="font-family:'Barlow',sans-serif;font-size:14px;color:var(--g1);display:flex;align-items:flex-start;gap:10px;padding:10px 14px;background:var(--surface);border:1px solid var(--border);border-radius:6px">
                <span style="color:var(--accent);flex-shrink:0;margin-top:1px">▸</span>{part}
              </li>
            ))}
          </ul>
          <p style="margin-top:12px"><a href="https://github.com/VoronDesign/Voron-0" target="_blank" rel="noopener" style="font-family:'Barlow',sans-serif;font-size:12px;font-weight:700;color:var(--accent)">All STLs on Voron Design GitHub (Voron-0 repo) →</a></p>
        </section>

        <section style="margin-bottom:40px">
          <h2 style="font-family:'Barlow Condensed',sans-serif;font-size:26px;font-weight:800;color:var(--black);margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid var(--border)">Required Hardware</h2>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px">
            {['M3 and M2 heat inserts (smaller hardware than full SB)','Smaller fasteners','25mm fans'].map(hw => (
              <li style="font-family:'Barlow',sans-serif;font-size:14px;color:var(--g1);padding:10px 14px;background:var(--surface);border:1px solid var(--border);border-radius:6px;display:flex;align-items:flex-start;gap:10px">
                <span style="color:var(--g2);flex-shrink:0">·</span>{hw}
              </li>
            ))}
          </ul>
        </section>

        <section style="margin-bottom:40px">
          <h2 style="font-family:'Barlow Condensed',sans-serif;font-size:26px;font-weight:800;color:var(--black);margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid var(--border)">Hotend Compatibility</h2>
          <div style="background:var(--surface);border-radius:10px;overflow:hidden;border:1px solid var(--border)">
            <table style="width:100%;border-collapse:collapse;font-size:13px;font-family:'Barlow',sans-serif">
              <thead>
                <tr style="background:var(--black)">
                  <th style="text-align:left;padding:10px 16px;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.4)">Hotend</th>
                  <th style="text-align:center;padding:10px 12px;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.4)">Max Temp</th>
                  <th style="text-align:center;padding:10px 12px;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.4)">Flow</th>
                  <th style="text-align:center;padding:10px 12px;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.4)">Status</th>
                </tr>
              </thead>
              <tbody>
                {[
                  { name:'Dragon HF',    temp:'300°C', flow:'25mm³/s', status:'SUPPORTED',        ok:true  },
                  { name:'Revo Micro',   temp:'300°C', flow:'15mm³/s', status:'SUPPORTED',        ok:true  },
                  { name:'Rapido HF',    temp:'300°C', flow:'28mm³/s', status:'LIMITED',          ok:null  },
                  { name:'Rapido 2 UHF', temp:'320°C', flow:'32mm³/s', status:'NOT COMPATIBLE',   ok:false },
                ].map((row, i) => (
                  <tr style={`border-bottom:1px solid var(--border);background:${i%2===0?'#fff':'var(--bg)'}`}>
                    <td style="padding:10px 16px;font-weight:600;color:var(--black)">{row.name}</td>
                    <td style="text-align:center;padding:10px 12px;color:var(--g1);font-family:'JetBrains Mono',monospace;font-size:12px">{row.temp}</td>
                    <td style="text-align:center;padding:10px 12px;color:var(--g1);font-family:'JetBrains Mono',monospace;font-size:12px">{row.flow}</td>
                    <td style="text-align:center;padding:10px 12px">
                      <span style={`font-size:10px;font-weight:700;font-family:'JetBrains Mono',monospace;padding:2px 8px;border-radius:3px;${row.ok===true?'background:rgba(46,125,50,.1);color:#2E7D32':row.ok===false?'background:rgba(198,40,40,.1);color:#C62828':'background:rgba(230,81,0,.1);color:#E65100'}`}>{row.status}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section style="margin-bottom:40px">
          <h2 style="font-family:'Barlow Condensed',sans-serif;font-size:26px;font-weight:800;color:var(--black);margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid var(--border)">Extruder Compatibility</h2>
          <div style="background:var(--surface);border-radius:10px;overflow:hidden;border:1px solid var(--border)">
            <table style="width:100%;border-collapse:collapse;font-size:13px;font-family:'Barlow',sans-serif">
              <thead>
                <tr style="background:var(--black)">
                  <th style="text-align:left;padding:10px 16px;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.4)">Extruder</th>
                  <th style="text-align:center;padding:10px 12px;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.4)">Gear Ratio</th>
                  <th style="text-align:center;padding:10px 12px;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.4)">Weight</th>
                  <th style="text-align:center;padding:10px 12px;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.4)">Status</th>
                </tr>
              </thead>
              <tbody>
                {[
                  { name:'Orbiter v2',  ratio:'7.5:1', weight:'175g', status:'SUPPORTED',          ok:true  },
                  { name:'Sherpa Mini', ratio:'5:1',   weight:'85g',  status:'SUPPORTED · recommended', ok:true },
                  { name:'Clockwork 2', ratio:'50:17', weight:'210g', status:'NOT COMPATIBLE',      ok:false },
                ].map((row, i) => (
                  <tr style={`border-bottom:1px solid var(--border);background:${i%2===0?'#fff':'var(--bg)'}`}>
                    <td style="padding:10px 16px;font-weight:600;color:var(--black)">{row.name}</td>
                    <td style="text-align:center;padding:10px 12px;color:var(--g1);font-family:'JetBrains Mono',monospace;font-size:12px">{row.ratio}</td>
                    <td style="text-align:center;padding:10px 12px;color:var(--g1);font-family:'JetBrains Mono',monospace;font-size:12px">{row.weight}</td>
                    <td style="text-align:center;padding:10px 12px">
                      <span style={`font-size:10px;font-weight:700;font-family:'JetBrains Mono',monospace;padding:2px 8px;border-radius:3px;${row.ok===true?'background:rgba(46,125,50,.1);color:#2E7D32':'background:rgba(198,40,40,.1);color:#C62828'}`}>{row.status}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

      </div>

      <!-- RIGHT SIDEBAR -->
      <aside style="position:sticky;top:80px;align-self:start;display:flex;flex-direction:column;gap:20px">
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;overflow:hidden">
          <div style="font-family:'Barlow',sans-serif;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--g2);padding:13px 18px 12px;border-bottom:1px solid var(--border);background:var(--bg)">Quick Specs</div>
          <div style="padding:12px 18px;display:flex;flex-direction:column;gap:10px">
            {[{ k:'Difficulty', v:'Intermediate' },{ k:'Creator', v:'Voron Design' },{ k:'Type', v:'Official' },{ k:'Primary Use', v:'Voron 0' },{ k:'Printed Parts', v:'Yes' }].map(row => (
              <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
                <span style="font-family:'Barlow',sans-serif;font-size:11px;color:var(--g2)">{row.k}</span>
                <span style="font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:700;color:var(--black)">{row.v}</span>
              </div>
            ))}
          </div>
        </div>
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;overflow:hidden">
          <div style="font-family:'Barlow',sans-serif;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--g2);padding:13px 18px 12px;border-bottom:1px solid var(--border);background:var(--bg)">Compatible Hotends</div>
          <div style="padding:8px 0">
            {['Dragon HF', 'Revo Micro'].map(h => (
              <div style="padding:8px 18px;border-bottom:1px solid var(--border);font-family:'Barlow',sans-serif;font-size:13px;color:var(--g1);display:flex;align-items:center;justify-content:space-between">
                <span>{h}</span><span style="font-size:10px;color:#2E7D32">✓</span>
              </div>
            ))}
          </div>
          <div style="padding:10px 18px"><a href="/voron/hotends" style="font-family:'Barlow',sans-serif;font-size:11px;font-weight:700;color:var(--accent)">Browse all hotends →</a></div>
        </div>
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;overflow:hidden">
          <div style="font-family:'Barlow',sans-serif;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--g2);padding:13px 18px 12px;border-bottom:1px solid var(--border);background:var(--bg)">Better Alternatives</div>
          <div style="padding:14px 18px;display:flex;flex-direction:column;gap:10px">
            <a href="/voron/toolheads/stealthburner" style="font-family:'Barlow',sans-serif;font-size:13px;color:var(--accent);font-weight:700">Stealthburner →</a>
            <a href="/voron/toolheads/xol" style="font-family:'Barlow',sans-serif;font-size:13px;color:var(--accent);font-weight:700">Xol Toolhead →</a>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <Footer slot="footer" />
</Base>

<script>
  (function() {
    const STORAGE_KEY = 'voron-model';
    const params = new URLSearchParams(window.location.search);
    const model = params.get('model') || localStorage.getItem(STORAGE_KEY) || '2.4';
    localStorage.setItem(STORAGE_KEY, model);
    const label = document.getElementById('active-model-label');
    if (label) label.textContent = model === '2.4' ? 'Voron 2.4' : 'Voron Trident';
  })();
</script>
