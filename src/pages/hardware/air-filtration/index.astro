---
import HardwareIndex from '../../../components/HardwareIndex.astro';
import records from '../../../data/hardware/air-filtration.json';

const chips = (r: any) => [
  r['Type'] ? String(r['Type']) : null,
  (r['Filter Media'] ?? r['Media']) ? String(r['Filter Media'] ?? r['Media']) : null,
  r['Price (USD)'] != null ? `~$${r['Price (USD)']}` : null,
].filter(Boolean) as string[];
---
<HardwareIndex
  records={records}
  route="air-filtration"
  categoryLabel="AIR FILTRATION"
  crumb="Air Filtration"
  heading="Air Filtration"
  sub="VOC and particulate filtration for enclosed printers. Media type, fan size, and fit."
  nounSingular="air filter"
  nounPlural="air filters"
  title="Best Air Filtration for Enclosed 3D Printers"
  description="Air filtration specs, filter media, fan size, and where to buy — VOC and particulate filters for enclosed Voron and CoreXY builds."
  schemaName="Best Air Filtration for Enclosed 3D Printers"
  chips={chips}
/>
