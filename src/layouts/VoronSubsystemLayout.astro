---
// Shared shell for the Voron subsystem pages (/voron/hotends, /voron/extruders, …):
// dark hero with breadcrumb, model context bar, and the ?model= / localStorage sync.
// Page-specific sections go in the default slot; JSON-LD goes in slot="head".
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  crumb: string;    // last breadcrumb item
  heading: string;  // visible H1
  intro: string;    // hero paragraph
}
const { title, description, crumb, heading, intro } = Astro.props;
---
<Base hasPageH1={true} title={title} description={description}>
  <Nav slot="nav" currentPath={Astro.url.pathname} />

  <div class="vs-hero">
    <div class="vs-wrap">
      <div class="vs-crumbs">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/voron">Voron</a>
        <span>/</span>
        <span class="vs-crumb-current">{crumb}</span>
      </div>
      <h1 class="vs-title">{heading}</h1>
      <p class="vs-intro">{intro}</p>
    </div>
  </div>

  <div class="vs-modelbar">
    <div class="vs-wrap">
      <div class="model-context-bar" id="model-context">
        <span class="model-context-label">Showing parts for:</span>
        <span id="active-model-label" class="model-context-value">Voron 2.4</span>
        <a href="/voron" class="model-context-switch">Switch model →</a>
      </div>
    </div>
  </div>

  <slot />

  <Footer slot="footer" />
  <slot name="head" slot="head" />
</Base>

<script>
  // Model-aware: reads ?model=, syncs localStorage, hides cards for the other model.
  (function() {
    const STORAGE_KEY = 'voron-model';
    const params = new URLSearchParams(window.location.search);
    const model = params.get('model') || localStorage.getItem(STORAGE_KEY) || '2.4';
    localStorage.setItem(STORAGE_KEY, model);

    const label = document.getElementById('active-model-label');
    if (label) label.textContent = model === '2.4' ? 'Voron 2.4' : 'Voron Trident';

    document.querySelectorAll<HTMLElement>('[data-compatible]').forEach(el => {
      const compatible = (el.dataset.compatible ?? '').split(',');
      el.style.display = compatible.includes(model) ? '' : 'none';
    });
  })();
</script>

<style>
  .vs-wrap { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
  .vs-hero { background: var(--black); padding: 40px 0; }
  .vs-crumbs { display: flex; align-items: center; gap: 8px; margin-bottom: 16px; color: var(--on-dark-muted); }
  .vs-crumbs a, .vs-crumb-current { font-size: 12px; color: var(--on-dark-muted); font-family: var(--fu); }
  .vs-title { font-family: var(--fd); font-size: 48px; font-weight: 800; color: var(--surface); line-height: 1; letter-spacing: -.5px; margin-bottom: 12px; }
  .vs-intro { font-family: var(--fb); font-size: 15px; color: var(--on-dark-muted); line-height: 1.7; max-width: 560px; margin-bottom: 20px; }
  .vs-modelbar { background: var(--surface); border-bottom: 1px solid var(--border); padding: 12px 0; }
</style>
