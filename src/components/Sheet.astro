---
// Sheet (System 4): native <dialog> that is a bottom sheet under 768px, and from 768px up either a
// centred modal (default) or a popover anchored to its trigger. All behaviour lives in
// src/scripts/sheet.ts; anything with data-sheet="<id>" opens it. See that file for the drag rules.
interface Props {
  id: string;
  title: string;
  /** Detent a phone sheet opens at. It can always be dragged to the other one. */
  detent?: 'medium' | 'large';
  /** What it becomes from 768px up. */
  desktop?: 'modal' | 'popover';
  /** Dark plane (menu); light surface otherwise. */
  dark?: boolean;
}
const { id, title, detent = 'medium', desktop = 'modal', dark = false } = Astro.props;
---
<dialog class:list={['sheet', { 'sheet--dark': dark }]} id={id} data-detent={detent} data-desktop={desktop} aria-labelledby={`${id}-title`}>
  <div class="sheet-scrim" data-sheet-close></div>
  <div class="sheet-panel" tabindex="-1">
    <div class="sheet-grab" data-sheet-drag aria-hidden="true"><span></span></div>
    <div class="sheet-head" data-sheet-drag>
      <h2 class="sheet-title" id={`${id}-title`}>{title}</h2>
      <button type="button" class="sheet-x" data-sheet-close aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <div class="sheet-body" data-sheet-scroll><slot /></div>
  </div>
</dialog>

<style is:global>
  /* Hallmark · component: sheet · genre: editorial · theme: DESIGN.md (Workshop Press)
   * states: default · hover · focus-visible · active · open · closing (no loading/error/success: it is a container)
   * motion: PRD tokens only. Open --dur-sheet on --spring-sheet; close --dur-base on --ease-out (exits are faster);
   *         desktop scale-in from --scale-enter. Reduced motion: no slide, spring or scale. */
  dialog.sheet {
    --scrim: rgba(0, 0, 0, 0.4);
    --sh-bg: var(--surface);
    --sh-fg: var(--black);
    --sh-muted: var(--g1);
    --sh-line: var(--border);
    --sh-wash: var(--bg);
    --sh-grab: var(--g2);
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    color: var(--sh-fg);
    max-width: none;
    max-height: none;
    overflow: clip; /* the scrim and panel never make the dialog itself scroll */
    overscroll-behavior: none;
  }
  dialog.sheet.sheet--dark {
    --sh-bg: var(--dark-surface);
    --sh-fg: #fff;
    --sh-muted: var(--on-dark-muted);
    --sh-line: var(--dark-border);
    --sh-wash: rgba(255, 255, 255, 0.06);
    --sh-grab: var(--on-dark-muted);
  }
  dialog.sheet::backdrop { background: transparent; }
  .sheet-panel:focus { outline: none; } /* focused by script on a pointer open; the items keep their own ring */

  /* Page lock while any modal sheet is open. */
  html.sheet-open { overflow: hidden; scrollbar-gutter: stable; }

  /* The page behind a phone sheet: scaled, rounded, over a dark canvas. */
  html.sheet-fx body { background: var(--dark-bg); }
  html.sheet-fx #page { transition: transform var(--dur-sheet) var(--spring-sheet), clip-path var(--dur-sheet) var(--ease-out); will-change: transform; }
  html.sheet-closing #page { transition-duration: var(--dur-base); transition-timing-function: var(--ease-out); }

  /* ── PHONE: bottom sheet ── */
  dialog.sheet[data-mode="sheet"] { position: fixed; inset: 0 0 auto 0; width: 100vw; height: 100dvh; } /* JS fits it to visualViewport */
  [data-mode="sheet"] .sheet-scrim { position: absolute; inset: 0; background: var(--scrim); opacity: 0; transition: opacity var(--dur-sheet) var(--ease-out); }
  [data-mode="sheet"] .sheet-panel {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 92%; /* the large detent */
    display: flex;
    flex-direction: column;
    background: var(--sh-bg);
    border-top: 1px solid var(--sh-line);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    transform: translateY(100%);
    transition: transform var(--dur-sheet) var(--spring-sheet);
    will-change: transform;
  }
  /* The spring overshoots a little past its rest position: keep the panel's colour under it. */
  [data-mode="sheet"] .sheet-panel::after { content: ""; position: absolute; top: 100%; left: 0; right: 0; height: 48px; background: var(--sh-bg); }
  html.sheet-closing .sheet-panel { transition-duration: var(--dur-base); transition-timing-function: var(--ease-out); }
  html.sheet-closing .sheet-scrim { transition-duration: var(--dur-base); }

  /* Grab handle: a 36 x 5 bar with a 44px-tall hit area. */
  .sheet-grab, .sheet-head { -webkit-user-select: none; user-select: none; }
  .sheet-grab { display: none; }
  [data-mode="sheet"] .sheet-grab { display: block; position: relative; flex: none; height: 24px; touch-action: none; cursor: grab; }
  .sheet-grab::before { content: ""; position: absolute; inset: -10px 0; }
  .sheet-grab span { position: absolute; top: 10px; left: 50%; width: 36px; height: 5px; margin-left: -18px; border-radius: 3px; background: var(--sh-grab); }

  .sheet-head { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0 8px 4px 20px; touch-action: none; }
  .sheet-title { margin: 0; font: 800 22px/1.1 var(--fd); letter-spacing: -0.2px; color: var(--sh-fg); }
  .sheet-x {
    position: relative;
    display: grid; place-items: center;
    width: 44px; height: 44px;
    background: transparent; border: 0; border-radius: var(--radius-md);
    color: var(--sh-muted); cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out), var(--press-release);
  }
  .sheet-x:active { background: var(--sh-wash); scale: var(--scale-press-icon); transition-duration: var(--dur-press); }
  @media (hover: hover) and (pointer: fine) { .sheet-x:hover { background: var(--sh-wash); color: var(--sh-fg); } }

  .sheet-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain; /* scrolling inside a sheet never scrolls the page */
    padding: 0 20px calc(20px + var(--hide, 0px));
    -webkit-overflow-scrolling: touch;
  }

  /* Rows shared by every sheet's content. */
  .sheet-label { display: block; font: 700 10px var(--fm); letter-spacing: 0.12em; text-transform: uppercase; color: var(--sh-muted); padding: 14px 4px 4px; }
  .sheet-row {
    display: flex; align-items: center; gap: 12px;
    width: 100%; min-height: 48px; padding: 8px 4px;
    border: 0; border-bottom: 1px solid var(--sh-line); border-radius: 0;
    background: transparent; color: var(--sh-fg);
    font: 600 15px var(--fu); text-align: left; text-decoration: none; cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .sheet-row:last-child { border-bottom: 0; }
  .sheet-row:active { background: var(--sh-wash); }
  @media (hover: hover) and (pointer: fine) { .sheet-row:hover { background: var(--sh-wash); } }
  .sheet-row[aria-current="page"] { color: var(--sh-fg); font-weight: 700; }
  .sheet-row .grow { flex: 1; min-width: 0; }
  .sheet-row .sub { display: block; font: 400 11px var(--fm); color: var(--sh-muted); }
  span.sheet-row { cursor: default; color: var(--sh-muted); } /* a "coming soon" entry: text, not a link */
  .sheet-tag { font: 500 10px var(--fm); text-transform: uppercase; letter-spacing: 0.06em; color: var(--sh-muted); }

  /* ── PHONE: full-screen view (data-phone="full", the palette) ──
     Fills the layout viewport and never changes size (iOS doesn't shrink it for the keyboard; JS only
     sets --kb, which the scroller adds to its bottom padding). The panel never moves: no transform, no
     will-change, no handle. The whole dialog fades. The backdrop is the panel's colour, so nothing
     different can ever show through. */
  dialog.sheet[data-mode="full"] {
    position: fixed; inset: 0; width: 100%; height: 100%;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  dialog.sheet[data-mode="full"].is-open { opacity: 1; }
  dialog.sheet[data-mode="full"]::backdrop { background: var(--sh-bg, var(--dark-surface)); }
  [data-mode="full"] .sheet-scrim { display: none; }
  [data-mode="full"] .sheet-panel {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    background: var(--sh-bg);
    padding-top: env(safe-area-inset-top, 0px);
  }

  /* ── DESKTOP: centred modal and "plain" (the palette's own panel) ── */
  dialog.sheet[data-mode="modal"], dialog.sheet[data-mode="plain"] { position: fixed; inset: 0; width: 100%; height: 100%; }
  [data-mode="modal"] .sheet-scrim, [data-mode="plain"] .sheet-scrim { position: absolute; inset: 0; background: var(--scrim); opacity: 0; transition: opacity var(--dur-base) var(--ease-out); }
  [data-mode="modal"].is-open .sheet-scrim { opacity: 1; }
  [data-mode="plain"] .sheet-scrim { opacity: 1; transition: none; }
  [data-mode="modal"] .sheet-panel {
    position: relative;
    display: flex; flex-direction: column;
    width: min(440px, calc(100% - 32px)); max-height: 72vh;
    margin: 14vh auto 0;
    background: var(--sh-bg);
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4); /* Floating Panel: a true overlay */
    transform: scale(var(--scale-enter));
    opacity: 0;
    transition: transform 180ms var(--ease-out), opacity 180ms var(--ease-out);
  }
  [data-mode="modal"].is-open .sheet-panel { transform: none; opacity: 1; }

  /* ── DESKTOP: popover anchored to its trigger (positioned and given its origin by JS) ── */
  dialog.sheet[data-mode="popover"] { position: fixed; z-index: 1150; left: 0; top: 0; width: min(360px, calc(100vw - 24px)); height: auto; overflow: visible; }
  [data-mode="popover"] .sheet-scrim { display: none; }
  [data-mode="popover"] .sheet-panel {
    position: relative;
    display: flex; flex-direction: column;
    max-height: min(70vh, 520px);
    background: var(--sh-bg);
    border: 1px solid var(--sh-line);
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    opacity: 0;
    transform: scale(var(--scale-enter));
    transition: transform 180ms var(--ease-out), opacity 180ms var(--ease-out);
  }
  [data-mode="popover"].is-open .sheet-panel { opacity: 1; transform: none; }
  [data-mode="popover"] .sheet-head { padding-top: 6px; }
  /* Closing is quicker and softer than opening (150ms). */
  html.sheet-closing [data-mode="modal"] .sheet-panel,
  html.sheet-closing [data-mode="popover"] .sheet-panel { transition-duration: var(--dur-fast); }
  html.sheet-closing [data-mode="modal"] .sheet-scrim { transition-duration: var(--dur-fast); }

  /* Reduced motion: no slide, spring or scale. The sheet appears where it rests; popovers and modals fade. */
  @media (prefers-reduced-motion: reduce) {
    [data-mode="sheet"] .sheet-panel, [data-mode="sheet"] .sheet-scrim, dialog.sheet[data-mode="full"] { transition: none !important; }
    [data-mode="modal"] .sheet-panel, [data-mode="popover"] .sheet-panel { transform: none; transition: opacity var(--dur-fast) var(--ease-out); }
    .sheet-x:active { scale: none; }
  }
</style>

<script>
  import '../scripts/sheet';
</script>
