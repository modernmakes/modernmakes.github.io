---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BeehiivEmbed from '../components/BeehiivEmbed.astro';
import '../styles/article.css';

interface Props {
  title: string;
  category: string;
  date: string;
  readTime: string;
  heroImage?: string;
  excerpt?: string;
  summary?: string[];
  currentPath?: string;
}

const {
  title,
  category,
  date,
  readTime,
  heroImage,
  excerpt = '',
  summary = [],
  currentPath = '/news',
} = Astro.props;

const moreNews = [
  { category: 'News',   title: 'Bambu Announces AMS Pro: 16 Spools, Active Drying', href: '/news/bambu-ams-pro-announced', date: 'May 19, 2026' },
  { category: 'Update', title: 'OrcaSlicer 2.3 Drops Arachne Wall Generation',       href: '/software/orcaslicer-2-3',      date: 'May 20, 2026' },
  { category: 'Guide',  title: 'Revo Voron vs Rapido 2: The 2026 Hotend Verdict',    href: '/voron/hotends',                date: 'May 17, 2026' },
];

const relatedArticles = [
  { category: 'News',     title: 'Bambu Announces AMS Pro: 16 Spools, Active Drying, Ships Q3', href: '/news/bambu-ams-pro-announced', date: 'May 19, 2026', gradient: 'linear-gradient(135deg,#1a1520,#0d0d18)' },
  { category: 'Printers', title: 'Prusa CORE One+: The Fully Enclosed CoreXY Finally Worth It', href: '/printers/prusa-core-one-plus',  date: 'May 24, 2026', gradient: 'linear-gradient(135deg,#1f2010,#131708)' },
  { category: 'Software', title: "OrcaSlicer 2.3 Drops Arachne Wall Generation. Here's What Actually Changed.", href: '/software/orcaslicer-2-3', date: 'May 20, 2026', gradient: 'linear-gradient(135deg,#1a1520,#0d0d18)' },
];

const siteBase = Astro.site
  ? new URL(Astro.site).href.replace(/\/$/, '')
  : 'https://modernmakes.github.io';
const pathSegments = Astro.url.pathname.replace(/^\/|\/$/g, '').split('/').filter(Boolean);
const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteBase}/` },
  ...pathSegments.map((seg: string, i: number) => ({
    '@type': 'ListItem',
    position: i + 2,
    name: i === pathSegments.length - 1 ? title : seg.charAt(0).toUpperCase() + seg.slice(1),
    item: `${siteBase}/${pathSegments.slice(0, i + 1).join('/')}`,
  })),
];
---
<Base title={title} description={excerpt} heroPage={true} hasHero={true} hasPageH1={true}>
  <Nav slot="nav" currentPath={currentPath} />

  <!-- ── HERO ── -->
  <div class="art-hero">
    {heroImage
      ? <img src={heroImage} alt="" class="art-hero-img" loading="lazy" aria-hidden="true" />
      : <div class="art-hero-bg" style="background: linear-gradient(160deg, #1a0e0a, #0d1520 55%, #1a1520)"></div>
    }
    <div class="art-hero-overlay"></div>
    <div class="art-hero-foot">
      <div class="art-hero-container">
        <span class="art-hero-cat">{category}</span>
      </div>
    </div>
  </div>

  <!-- ── ARTICLE HEADER ── -->
  <div class="art-header" id="art-header">
    <div class="art-header-container">
      <nav class="art-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/news">News</a>
        <span aria-hidden="true">/</span>
        <span>{category}</span>
      </nav>
      <div class="art-cat-badge">{category}</div>
      <h1 class="art-headline">{title}</h1>
      <div class="art-byline">
        <time class="art-date">{date}</time>
        <span class="art-sep" aria-hidden="true">·</span>
        <span class="art-readtime">{readTime}</span>
      </div>
    </div>
  </div>

  <!-- ── BODY ── -->
  <div class="art-body">
    <div class="art-body-container">

      <article class="art-content">
        <slot />
      </article>

      <aside class="art-sidebar" aria-label="Article sidebar">

        {summary.length > 0 && (
          <div class="art-sb-box art-sb-summary">
            <div class="art-sb-box-label">What to know</div>
            <ul class="art-sb-summary-list">
              {summary.map(item => <li>{item}</li>)}
            </ul>
          </div>
        )}

        <div class="art-sb-box art-sb-more">
          <div class="art-sb-box-label">More News</div>
          <div class="art-sb-more-list">
            {moreNews.map(item => (
              <a href={item.href} class="art-sb-more-item">
                <span class="art-sb-more-cat">{item.category}</span>
                <span class="art-sb-more-title">{item.title}</span>
                <time class="art-sb-more-date">{item.date}</time>
              </a>
            ))}
          </div>
        </div>

      </aside>
    </div>
  </div>

  <!-- ── RELATED ARTICLES ── -->
  <section class="art-related" aria-label="Related articles">
    <div class="art-related-container">
      <div class="art-related-head">
        <span class="art-related-label">Related</span>
        <a href="/news" class="art-related-all">All news →</a>
      </div>
      <div class="art-related-grid">
        {relatedArticles.map(card => (
          <a href={card.href} class="art-related-card">
            <div class="art-related-card-img" style={`background: ${card.gradient}`}>
              <div class="art-related-card-overlay"></div>
              <span class="art-related-card-cat-overlay">{card.category}</span>
            </div>
            <div class="art-related-card-body">
              <div class="art-related-card-cat">{card.category}</div>
              <div class="art-related-card-title">{card.title}</div>
              <time class="art-related-card-date">{card.date}</time>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── NEWSLETTER CAPTURE ── -->
  <div class="nl-capture-outer">
    <div class="newsletter-capture">
      <p class="newsletter-capture__label">Stay current</p>
      <h3 class="newsletter-capture__heading">The Modern Makes Brief</h3>
      <p class="newsletter-capture__sub">Printers, hardware, and builds worth knowing about. Weekly.</p>
      <div class="newsletter-capture__form">
        <BeehiivEmbed />
      </div>
    </div>
  </div>

  <Footer slot="footer" />

  <slot name="head" slot="head" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    "headline": title,
    "description": excerpt,
    "datePublished": date,
    "articleSection": category,
    "publisher": {
      "@type": "Organization",
      "name": "Modern Makes",
      "url": "https://modernmakes.com",
      "logo": { "@type": "ImageObject", "url": "https://modernmakes.com/images/wordmark.svg" }
    },
    "isPartOf": { "@type": "WebSite", "url": "https://modernmakes.com" }
  })}></script>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbItems,
  })}></script>
</Base>

<style is:global>
/* ── NEWSLETTER CAPTURE ── */
.nl-capture-outer {
  background: var(--black);
  border-top: 1px solid #1f1f1f;
  margin-top: 64px;
}
.newsletter-capture {
  max-width: 600px;
  margin: 0 auto;
  padding: 48px 24px;
  text-align: center;
}
.newsletter-capture__label {
  font-family: var(--fm);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .1em;
  color: var(--accent);
  margin: 0 0 10px;
}
.newsletter-capture__heading {
  font-family: var(--fd);
  font-size: 28px;
  font-weight: 800;
  color: #fff;
  line-height: 1.05;
  letter-spacing: -.3px;
  margin: 0 0 10px;
}
.newsletter-capture__sub {
  font-family: var(--fb);
  font-size: 14px;
  color: rgba(255,255,255,.45);
  line-height: 1.65;
  margin: 0 0 24px;
}
.newsletter-capture__form {
  min-height: 48px;
}
@media (max-width: 640px) {
  .newsletter-capture { padding: 40px 20px; }
  .newsletter-capture__heading { font-size: 22px; }
}
</style>

<script>
  /* ── Lazy-load article images ── */
  document.querySelectorAll('.art-content img').forEach(img => {
    if (!img.getAttribute('loading')) img.setAttribute('loading', 'lazy');
  });
</script>
