---
import TypeCover from '../components/TypeCover.astro';
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import NewsletterCapture from '../components/NewsletterCapture.astro';
import { getRelatedContent, type RelatedCollection } from '../lib/related-content';
import '../styles/article.css';

interface Props {
  title: string;
  category: string;
  date: string;
  dateISO?: string;
  readTime: string;
  heroImage?: string;
  excerpt?: string;
  summary?: string[];
  currentPath?: string;
  currentCollection?: RelatedCollection;
  currentSlug?: string;
}

const {
  title,
  category,
  date,
  dateISO,
  readTime,
  heroImage,
  excerpt = '',
  summary = [],
  currentPath = '/news',
  currentCollection,
  currentSlug,
} = Astro.props;

const relatedArticles = await getRelatedContent(currentCollection, currentSlug, 3);
const moreNews = relatedArticles;

const siteBase = Astro.site
  ? new URL(Astro.site).href.replace(/\/$/, '')
  : 'https://modernmakes.github.io';
const pathSegments = Astro.url.pathname.replace(/^\/|\/$/g, '').split('/').filter(Boolean);
const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteBase}/` },
  ...pathSegments.map((seg: string, i: number) => ({
    '@type': 'ListItem',
    position: i + 2,
    name: i === pathSegments.length - 1 ? title : seg.charAt(0).toUpperCase() + seg.slice(1),
    item: `${siteBase}/${pathSegments.slice(0, i + 1).join('/')}`,
  })),
];
---
<Base title={title} description={excerpt} heroPage={true} hasHero={true} hasPageH1={true}>
  <Nav slot="nav" currentPath={currentPath} />

  <!-- ── HERO ── -->
  <div class:list={['art-hero', { 'art-hero--band': !heroImage }]}>
    {heroImage
      ? <img src={heroImage} alt="" class="art-hero-img" loading="lazy" aria-hidden="true" />
      : <TypeCover size="hero" eyebrow={category} title={title} date={date} />
    }
    {heroImage && (
      <>
        <div class="art-hero-overlay"></div>
        <div class="art-hero-foot">
          <div class="art-hero-container">
            <span class="art-hero-cat">{category}</span>
          </div>
        </div>
      </>
    )}
  </div>

  <!-- ── ARTICLE HEADER ── -->
  <div class="art-header" id="art-header">
    <div class="art-header-container">
      <nav class="breadcrumb art-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/news">News</a>
        <span aria-hidden="true">/</span>
        <span>{category.charAt(0) + category.slice(1).toLowerCase()}</span>
      </nav>
      <div class="art-cat-badge">{category}</div>
      <h1 class="art-headline">{title}</h1>
      <div class="art-byline">
        <time class="art-date">{date}</time>
        <span class="art-sep" aria-hidden="true">·</span>
        <span class="art-readtime">{readTime}</span>
      </div>
    </div>
  </div>

  <!-- ── BODY ── -->
  <div class="art-body">
    <div class="art-body-container">

      <article class="art-content">
        <slot />
      </article>

      <aside class="art-sidebar" aria-label="Article sidebar">

        {summary.length > 0 && (
          <div class="art-sb-box art-sb-summary">
            <div class="art-sb-box-label">What to know</div>
            <ul class="art-sb-summary-list">
              {summary.map(item => <li>{item}</li>)}
            </ul>
          </div>
        )}

        <div class="art-sb-box art-sb-more">
          <div class="art-sb-box-label">More News</div>
          <div class="art-sb-more-list">
            {moreNews.map(item => (
              <a href={item.href} class="art-sb-more-item">
                <span class="art-sb-more-cat">{item.category}</span>
                <span class="art-sb-more-title">{item.title}</span>
                <time class="art-sb-more-date">{item.date}</time>
              </a>
            ))}
          </div>
        </div>

      </aside>
    </div>
  </div>

  <!-- ── RELATED ARTICLES ── -->
  <section class="art-related" aria-label="Related articles">
    <div class="art-related-container">
      <div class="art-related-head">
        <span class="art-related-label">Related</span>
        <a href="/news" class="art-related-all">All news →</a>
      </div>
      <div class="art-related-grid">
        {relatedArticles.map(card => (
          <a href={card.href} class="art-related-card">
            <div class="art-related-card-img">
              <TypeCover eyebrow={card.category} title={card.title} date={card.date} />
            </div>
            <div class="art-related-card-body">
              <div class="art-related-card-cat">{card.category}</div>
              <div class="art-related-card-title">{card.title}</div>
              <time class="art-related-card-date">{card.date}</time>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── NEWSLETTER CAPTURE ── -->
  <NewsletterCapture />

  <Footer slot="footer" />

  <slot name="head" slot="head" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    "headline": title,
    "description": excerpt,
    "datePublished": dateISO || date,
    "dateModified": dateISO || date,
    "articleSection": category,
    "publisher": {
      "@type": "Organization",
      "name": "Modern Makes",
      "url": siteBase,
      "logo": { "@type": "ImageObject", "url": `${siteBase}/images/wordmark.svg` }
    },
    "isPartOf": { "@type": "WebSite", "url": siteBase }
  })}></script>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbItems,
  })}></script>
</Base>

<script>
  /* ── Lazy-load article images ── */
  document.querySelectorAll('.art-content img').forEach(img => {
    if (!img.getAttribute('loading')) img.setAttribute('loading', 'lazy');
  });
</script>
