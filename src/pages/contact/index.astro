---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---
<Base
  title="Contact Modern Makes"
  description="Get in touch with Modern Makes — general questions, press inquiries, partnership proposals, and product submissions."
  heroPage={true}
>
  <Nav slot="nav" currentPath="/contact" />

  <!-- HERO -->
  <section class="pg-hero">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div class="eyebrow" style="margin-bottom:12px">Modern Makes</div>
      <h1 style="font-family:'Barlow Condensed',sans-serif;font-size:56px;font-weight:800;color:#fff;line-height:1;letter-spacing:-.5px;margin-bottom:16px">
        Get in Touch
      </h1>
      <p style="font-family:'Lora',serif;font-size:16px;color:rgba(255,255,255,.45);line-height:1.7;max-width:480px">
        We read every message. We aim to respond within 2 business days.
      </p>
    </div>
  </section>

  <!-- CONTACT CARDS -->
  <section class="section">
    <div class="container" style="max-width:960px">

      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:48px">

        <!-- General Questions -->
        <div style="border:1px solid var(--border);border-radius:10px;padding:32px 28px;background:var(--surface)">
          <div style="font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--g2);font-family:'Barlow',sans-serif;margin-bottom:14px">General Questions</div>
          <p style="font-family:'Lora',serif;font-size:14px;color:var(--g1);line-height:1.7;margin-bottom:20px">
            Reader feedback, corrections, editorial questions, and anything else — drop us a line.
          </p>
          <a
            href="mailto:modernmakesco@gmail.com"
            style="font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:600;color:var(--accent);text-decoration:none;border-bottom:1px solid rgba(255,90,31,.3);padding-bottom:2px;word-break:break-all"
          >
            modernmakesco@gmail.com
          </a>
        </div>

        <!-- Press & Partnerships -->
        <div style="border:1px solid var(--border);border-radius:10px;padding:32px 28px;background:var(--surface)">
          <div style="font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--g2);font-family:'Barlow',sans-serif;margin-bottom:14px">Press &amp; Partnerships</div>
          <p style="font-family:'Lora',serif;font-size:14px;color:var(--g1);line-height:1.7;margin-bottom:20px">
            Sponsored content, newsletter placements, and advertising inquiries. See <a href="/press" style="color:var(--accent)">Press & Advertising</a> for details.
          </p>
          <a
            href="mailto:modernmakesco@gmail.com"
            style="font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:600;color:var(--accent);text-decoration:none;border-bottom:1px solid rgba(255,90,31,.3);padding-bottom:2px;word-break:break-all"
          >
            modernmakesco@gmail.com
          </a>
        </div>

        <!-- Product Submissions -->
        <div style="border:1px solid var(--border);border-radius:10px;padding:32px 28px;background:var(--surface)">
          <div style="font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--g2);font-family:'Barlow',sans-serif;margin-bottom:14px">Product Submissions</div>
          <p style="font-family:'Lora',serif;font-size:14px;color:var(--g1);line-height:1.7;margin-bottom:20px">
            Review unit requests and product pitches. Note: receipt of hardware does not guarantee coverage. Our <a href="/about#editorial" style="color:var(--accent)">editorial policy</a> always applies.
          </p>
          <a
            href="mailto:modernmakesco@gmail.com"
            style="font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:600;color:var(--accent);text-decoration:none;border-bottom:1px solid rgba(255,90,31,.3);padding-bottom:2px;word-break:break-all"
          >
            modernmakesco@gmail.com
          </a>
        </div>

      </div>

      <!-- Response time note -->
      <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:20px 28px;display:flex;align-items:center;gap:14px">
        <div style="font-family:'JetBrains Mono',monospace;font-size:20px;color:var(--accent);flex-shrink:0">⏱</div>
        <p style="font-family:'Lora',serif;font-size:14px;color:var(--g1);line-height:1.6;margin:0">
          <strong style="font-family:'Barlow',sans-serif;color:var(--black)">Response time:</strong> We aim to respond within 2 business days.
          Press and partnership inquiries are prioritised.
        </p>
      </div>

    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr !important; }
  }
</style>
