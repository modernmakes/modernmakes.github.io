---
import VoronSubsystemLayout from '../../layouts/VoronSubsystemLayout.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import TypeCover from '../../components/TypeCover.astro';
import { resolveVerdict, toSlug } from '../../lib/hardware';
import hotends from '../../data/hardware/hotends.json';
const siteBase = Astro.site
  ? new URL(Astro.site).href.replace(/\/$/, '')
  : 'https://modernmakes.github.io';

// Airtable "Compatible Printers" name -> the model token VoronSubsystemLayout filters on.
// Universal and Voron 0 (no model button of its own) show for every model.
const MODEL_TOKENS: Record<string, string[]> = {
  'Voron 2.4': ['2.4'],
  'Voron Trident': ['trident'],
  'Voron 0': ['2.4', 'trident'],
  Universal: ['2.4', 'trident'],
};
const num = (v: unknown) => (typeof v === 'number' && v > 0 ? v : null);

const voronHotends = (hotends as any[])
  .filter((r) => typeof r.Name === 'string' && r.Name.trim())
  .map((r) => {
    const models = [...new Set(((r['Compatible Printers'] ?? []) as string[]).flatMap((p) => MODEL_TOKENS[p] ?? []))];
    const vendors = [1, 2, 3, 4, 5]
      .map((i) => ({ name: r[`Vendor ${i} Name`], url: r[`Vendor ${i} URL`], affiliate: r[`Vendor ${i} Affiliate`] === true }))
      .filter((v) => v.name && v.url);
    return {
      slug: toSlug(r.Name),
      name: r.Name as string,
      brand: r.Brand as string | undefined,
      maxTemp: num(r['Max Temp (°C)']),
      maxFlow: num(r['Max Flow (mm³/s)']),
      thermistor: r.Thermistor as string | undefined,
      description: r.Description as string | undefined,
      toolheads: (r['Compatible Toolheads'] ?? []) as string[],
      price: num(r['Price (USD)']),
      verdict: resolveVerdict(r.Verdict), // blank verdict -> null -> no badge
      models,
      vendors,
    };
  })
  .filter((p) => p.models.length > 0);

// Matrix columns: every toolhead named by a shown hotend. Fixed order first, the rest A-Z.
const TOOLHEAD_ORDER = ['stealthburner', 'xol', 'dragon burner', 'mini stealthburner'];
const toolheadCols = [...new Set(voronHotends.flatMap((p) => p.toolheads))].sort((a, b) => {
  const ia = TOOLHEAD_ORDER.indexOf(a.toLowerCase()), ib = TOOLHEAD_ORDER.indexOf(b.toLowerCase());
  if (ia !== -1 || ib !== -1) return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
  return a.localeCompare(b);
});

const relOf = (v: { affiliate: boolean }) => (v.affiliate ? 'sponsored noopener' : 'noopener');
const fmtPrice = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(2));
---
<VoronSubsystemLayout
  title="Best Hotends for Voron 2.4 & Trident"
  description="Every hotend worth considering for Voron 2.4 and Trident builds — Rapido 2, Dragon HF, Revo Voron, and more. Compatibility matrix, community consensus, and affiliate links."
  crumb="Hotends"
  heading="Hotends for Voron 2.4 & Trident"
  intro="The hotend is the most consequential upgrade on a Voron build. Max temp, flow rate, and toolhead compatibility all matter. The community has largely settled on the Rapido 2 as the default — but the right choice depends on your use case."
>

  <!-- CONTEXT CALLOUT -->
  <div style="background:#f0efe9;border-bottom:1px solid var(--border);padding:20px 0">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div class="callout callout-orange" style="margin:0">
        <strong>What to know before you choose</strong>
        Flow rate (mm³/s) is the number that matters for speed. Max temp matters for engineering materials — PA12, PC, and PEEK need 280°C+. Thermistor type affects accuracy at high temps: PT1000 is more accurate than NTC 100K above 250°C. Toolhead compatibility: check that your chosen hotend works with your toolhead before ordering.
      </div>
    </div>
  </div>

  <!-- PRODUCTS -->
  <section class="section" aria-label="Voron hotend products">
    <div class="container">
      <div class="section-head">
        <h2 class="section-head-label">Hotends to consider</h2>
        <span style="font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--g2)">{voronHotends.length} products</span>
      </div>
      <div class="grid-3">
        {voronHotends.map(product => {
          const buyVendor = product.vendors[0];
          return (
            <div class="product-card product-card--link" id={product.slug} data-compatible={product.models.join(',')}>
              <div class="product-card-img" style="height:140px"><TypeCover eyebrow={product.brand ?? ''} title={product.name} /></div>
              <div class="product-card-body">
                {product.verdict && <span class={`verdict-badge ${product.verdict.cls}`}>{product.verdict.label}</span>}
                {product.brand && <div class="product-card-brand">{product.brand}</div>}
                <div class="product-card-name"><a href={`/hardware/hotends/${product.slug}`} class="product-card-link">{product.name}</a></div>
                <div class="product-card-specs">
                  {product.maxTemp && <span class="spec-chip">{product.maxTemp}°C max</span>}
                  {product.maxFlow && <span class="spec-chip">{product.maxFlow}mm³/s</span>}
                  {product.thermistor && <span class="spec-chip">{product.thermistor}</span>}
                </div>
                {product.description && <p style="font-family:'Lora',serif;font-size:12px;color:var(--g1);line-height:1.65;margin-bottom:10px">{product.description}</p>}
                {product.toolheads.length > 0 && (
                  <div style="margin-bottom:12px">
                    <div style="font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--g2);margin-bottom:5px">Fits</div>
                    <div style="display:flex;flex-wrap:wrap;gap:4px">
                      {product.toolheads.map(t => (
                        <span style="font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--g1);background:var(--bg);border:1px solid var(--border);border-radius:3px;padding:2px 6px">{t}</span>
                      ))}
                    </div>
                  </div>
                )}
                {buyVendor && (
                  <a href={buyVendor.url} class="btn-buy" target="_blank" rel={relOf(buyVendor)} style="position:relative;z-index:1">
                    Buy at {buyVendor.name} →
                  </a>
                )}
                {product.price && (
                  <div class="product-card-footer" style="margin-top:12px">
                    <div>
                      <span class="product-card-price">${fmtPrice(product.price)}</span>
                      <span style="font-size:10px;color:var(--g2);margin-left:4px">USD</span>
                    </div>
                  </div>
                )}
                {product.vendors.length > 1 && (
                  <div style="margin-top:8px;padding-top:8px;border-top:1px solid var(--border)">
                    <span style="font-size:10px;color:var(--g2);margin-right:6px">Also at:</span>
                    {product.vendors.slice(1).map(vendor => (
                      <a href={vendor.url} style="position:relative;z-index:1;font-size:10px;color:var(--accent-dk);margin-right:10px;font-family:'JetBrains Mono',monospace" target="_blank" rel={relOf(vendor)}>{vendor.name}</a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
      <AffiliateDisclosure />
    </div>
  </section>

  <!-- COMPATIBILITY MATRIX -->
  <section class="section" style="background:#fff;border-top:1px solid var(--border)" aria-label="Compatibility matrix">
    <div class="container">
      <div class="section-head">
        <h2 class="section-head-label">Toolhead compatibility</h2>
      </div>
      <div style="background:var(--bg);border-radius:10px;border:1px solid var(--border);overflow-x:auto;position:relative" tabindex="0" role="region" aria-label="Toolhead compatibility table">
        <table style="width:100%;border-collapse:collapse;font-size:12px;font-family:'Barlow',sans-serif">
          <thead>
            <tr style="background:var(--black)">
              <th scope="col" style="text-align:left;padding:10px 16px;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--on-dark-muted);border-right:1px solid rgba(255,255,255,.08);white-space:nowrap">Hotend</th>
              {toolheadCols.map(th => (
                <th scope="col" style="text-align:center;padding:10px 12px;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--on-dark-muted);white-space:nowrap">{th}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {voronHotends.map((p, i) => (
              <tr style={`border-bottom:1px solid var(--border);background:${i%2===0 ? '#fff' : 'var(--bg)'}`}>
                <th scope="row" style="text-align:left;padding:10px 16px;font-weight:600;color:var(--black);border-right:1px solid var(--border);white-space:nowrap">{p.name}</th>
                {toolheadCols.map(th => {
                  const yes = p.toolheads.includes(th);
                  return <td style={`text-align:center;padding:10px 12px;color:${yes ? 'var(--verdict-wh-ink)' : 'var(--g2)'};font-weight:${yes ? '600' : '400'}`}><span aria-hidden="true">{yes ? '✓' : '—'}</span><span class="sr-only">{yes ? 'Compatible' : 'Not listed'}</span></td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="font-size:11px;color:var(--g2);margin-top:10px">✓ = listed as compatible in the hotend's record. — = not listed.</p>
    </div>
  </section>

  <!-- COMMUNITY MODS -->
  <section class="section" style="background:var(--bg);border-top:1px solid var(--border)" aria-label="Community hotend mods">
    <div class="container">
      <div class="section-head">
        <h2 class="section-head-label">Community mods</h2>
        <span style="font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;background:#E8F5E9;color:var(--verdict-wh-ink);border:1px solid #A5D6A7;padding:2px 8px;border-radius:3px">Free / Printables</span>
      </div>
      <div class="grid-3">
        {[
          { name:'Stealthburner Toolhead', creator:'VoronDesign', desc:'The official Voron toolhead. Accepts Rapido 2, Dragon HF, and most standard hotends natively.', href:'https://github.com/VoronDesign/Voron-Stealthburner' },
          { name:'Xol Toolhead', creator:'Armchair Engineering', desc:'Lighter than Stealthburner, better cooling. Growing community adoption for high-speed printing.', href:'https://github.com/Armchair-Engineering/Xol-Toolhead' },
          { name:'Dragon Burner', creator:'chirpy2605', desc:'Compact, lightweight, and aggressively optimized for the Dragon hotend family. Popular for 0.2 builds.', href:'https://github.com/chirpy2605/voron-user-mods/tree/main/Dragon_Burner' }
        ].map(mod => (
          <a href={mod.href} target="_blank" rel="noopener">
            <div class="product-card community" style="background:#fff">
              <div class="product-card-body">
                <span class="community-badge">Community · Free</span>
                <div class="product-card-name" style="font-size:16px">{mod.name}</div>
                <div style="font-size:11px;color:var(--g2);margin-bottom:8px;font-family:'JetBrains Mono',monospace">by {mod.creator}</div>
                <div style="font-family:'Lora',serif;font-size:12px;color:var(--g1);line-height:1.6;margin-bottom:12px">{mod.desc}</div>
                <div class="product-card-footer" style="border-top:none;padding-top:0">
                  <span class="btn-printables">View on GitHub →</span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ItemList",
        "name": "Best Hotends for Voron 2.4 and Trident 2026",
        "url": `${siteBase}/voron/hotends`,
        "numberOfItems": voronHotends.length,
        "itemListElement": voronHotends.map((p, i) => ({ "@type": "ListItem", "position": i + 1, "name": p.name, "url": `${siteBase}/hardware/hotends/${p.slug}` }))
      }
    ]
  })}></script>
</VoronSubsystemLayout>

