---
// Build your printer: the ecosystem hubs lead (live ones as full cards, coming ones as a compact
// "Soon" row), then "Start here", three build guides from the guides collection.
// Replaces HomeEcosystemHubs and HomeBuilds.
import { getCollection } from 'astro:content';
import TypeCover from '../TypeCover.astro';
import SectionHead from './SectionHead.astro';
import data from '../../data/homepage.json';
const ecosystems = (data as any).ecosystems ?? [];
const live = ecosystems.filter((e: any) => e.status === 'live');
const coming = ecosystems.filter((e: any) => e.status === 'coming');
// Allow-list for the ?ref= referral param, derived from the actual data so it
// can't drift from the real slugs. Baked into the blocking script below via
// define:vars — never trust the raw query-string value against anything else.
const validEcoSlugs = ecosystems.map((e: any) => e.slug).filter(Boolean);

function bgStyle(eco: any) {
  return `background-image:url('${eco.image}');background-size:cover;background-position:center right;`;
}

// Start here: guides flagged `featured`, newest first; filled up to three with the newest
// "Builds" / "Hardware Setup" guides, then the newest of any category.
const guides = (await getCollection('guides')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const startHere: typeof guides = [];
for (const pool of [
  guides.filter((g) => g.data.featured),
  guides.filter((g) => g.data.guideCategory === 'Builds' || g.data.guideCategory === 'Hardware Setup'),
  guides,
]) for (const g of pool) if (startHere.length < 3 && !startHere.includes(g)) startHere.push(g);
---

<script is:inline define:vars={{ validEcoSlugs }}>
  // ── ECOSYSTEM REFERRAL PROMOTION — blocking, runs before this section paints ──
  // Reads ?ref= from the URL, validates it against the real ecosystem slugs
  // (passed in at build time, not hand-copied), and sets a data attribute on
  // <html> that CSS uses to set `order` on the matching card/row below. No
  // persistence (no cookie, no localStorage) — this is per-pageview only.
  // DOM order never changes, only the CSS `order` used to paint it, so every
  // request renders byte-identical markup for crawlers.
  (function () {
    var ref;
    try {
      ref = new URLSearchParams(location.search).get('ref');
    } catch (e) {
      return;
    }
    if (ref && validEcoSlugs.indexOf(ref) !== -1) {
      document.documentElement.setAttribute('data-ref-ecosystem', ref);
    }
  })();
</script>

<section class="byp" aria-labelledby="byp-heading">
  <div class="byp-container">
    <SectionHead id="byp-heading" title="Build your printer" dek="Parts directories, configurators and build guides for self-built CoreXY printers." href="/printers" what="printers" />

    <div class:list={['byp-live', { 'byp-live--many': live.length > 1 }]}>
      {live.map((eco: any) => (
        <a href={eco.href} class="eco-card" data-eco-slug={eco.slug}>
          <div class="eco-card-img">
            {eco.image ? (
              <div class="eco-card-img-bg" style={bgStyle(eco)} role="img" aria-label={eco.name}></div>
            ) : (
              <TypeCover eyebrow="Printer ecosystem" title={eco.name} />
            )}
          </div>
          <div class="eco-card-body">
            <h3 class="eco-card-name">{eco.name}</h3>
            {eco.variants && (
              <ul class="eco-variants" role="list" aria-label="Variants">
                {eco.variants.map((v: string) => <li class="eco-chip">{v}</li>)}
              </ul>
            )}
            <p class="eco-desc">{eco.description}</p>
            <span class="eco-cta">Explore the ecosystem <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>

    {coming.length > 0 && (
      <div class="byp-soon">
        <h3 class="byp-h3" id="byp-soon-heading">Coming soon</h3>
        <ul class="byp-soon-list" role="list" aria-labelledby="byp-soon-heading">
          {coming.map((eco: any) => (
            <li class="byp-soon-item" data-eco-slug={eco.slug}>
              <span class="byp-soon-name">{eco.name}</span>
              <span class="byp-soon-desc">{eco.description}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="byp-start">
      <h3 class="byp-h3" id="byp-start-heading">Start here</h3>
      <ul class="byp-guides" role="list" aria-labelledby="byp-start-heading">
        {startHere.map((g) => (
          <li>
            <a href={`/guides/${g.slug}`} class="byp-guide">
              <span class="byp-guide-cat">{g.data.guideCategory ?? 'Guide'}</span>
              <span class="byp-guide-title">{g.data.title}</span>
              <span class="byp-guide-meta">{g.data.readTime}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style is:global>
  /* Hallmark · component: build-your-printer section · genre: editorial · theme: DESIGN.md (light plane, --surface)
   * states: cards/rows default · hover (fine pointers) · focus-visible (global ring) · active (press system)
   * The section's one orange is the live card's "Explore the ecosystem" action (--accent-dk: small text on light). */
  .byp { background: var(--surface); padding: var(--section-y) 0; }
  .byp-container { max-width: var(--max-w); margin: 0 auto; padding: 0 40px; }

  /* Live ecosystems: image left, body right from 768px; stacked on phones. */
  .byp-live { display: flex; flex-direction: column; gap: 16px; }
  .byp .eco-card {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out), var(--press-release);
  }
  @media (hover: hover) and (pointer: fine) {
    .byp .eco-card:hover { border-color: var(--border-s); }
    .byp .eco-card:hover .eco-cta { text-decoration: underline; text-underline-offset: 3px; }
  }
  .byp .eco-card:active { border-color: var(--border-s); }
  .eco-card-img { position: relative; min-height: 220px; background: var(--dark-bg); }
  .eco-card-img-bg { position: absolute; inset: 0; }
  .byp .type-cover-eyebrow { color: var(--on-dark-muted); }
  .eco-card-body { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding: 24px; }
  .eco-card-name { margin: 0; font: 800 22px/1.1 var(--fd); letter-spacing: -0.2px; color: var(--black); }
  .eco-variants { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .eco-chip {
    font: 400 10px/1.4 var(--fm);
    color: var(--g1);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 2px 7px;
    white-space: nowrap;
  }
  .eco-desc { margin: 0; max-width: 60ch; font: 400 15px/1.6 var(--fb); color: var(--g1); }
  .eco-cta { margin-top: auto; padding-top: 4px; font: 700 13px/1.4 var(--fu); color: var(--accent-dk); }

  /* Coming soon: one compact row of names, not cards. Flex, so the referral `order` can promote one. */
  .byp-h3 { margin: 0 0 12px; font: 800 17px/1.1 var(--fd); color: var(--black); }
  .byp-soon { margin-top: 32px; }
  .byp-soon-list { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .byp-soon-item {
    display: flex; align-items: baseline; gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .byp-soon-name { font: 600 14px/1.3 var(--fu); color: var(--black); }
  .byp-soon-desc { font: 400 12px/1.3 var(--fu); color: var(--g2); }

  /* Start here: three guides, side by side from 768px, a hairline list on phones. */
  .byp-start { margin-top: 40px; }
  .byp-guides { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 0; padding: 0; list-style: none; }
  .byp-guide {
    display: flex; flex-direction: column; gap: 6px; height: 100%;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out), var(--press-release);
  }
  .byp-guide:active { border-color: var(--border-s); scale: var(--scale-press-card); }
  @media (hover: hover) and (pointer: fine) { .byp-guide:hover { border-color: var(--border-s); } }
  .byp-guide-cat { font: 700 10px/1.4 var(--fu); letter-spacing: .08em; text-transform: uppercase; color: var(--g2); }
  .byp-guide-title { font: 800 17px/1.15 var(--fd); color: var(--black); text-wrap: balance; }
  .byp-guide-meta { margin-top: auto; font: 400 11px/1.4 var(--fm); color: var(--g2); }
  @media (prefers-reduced-motion: reduce) { .byp-guide:active { scale: none; } }

  @media (max-width: 767px) {
    .byp-container { padding: 0 20px; }
    .byp .eco-card { grid-template-columns: minmax(0, 1fr); }
    .eco-card-img { min-height: 0; aspect-ratio: 16 / 7; }
    .eco-card-body { padding: 16px 20px 20px; }
    /* More than one live ecosystem: a swipe row, like the hotends. */
    .byp-live--many {
      flex-direction: row; gap: 12px;
      margin-inline: -20px; padding-inline: 20px; scroll-padding-inline: 20px;
      overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none;
    }
    .byp-live--many::-webkit-scrollbar { display: none; }
    .byp-live--many > .eco-card { flex: 0 0 calc((100% + 40px) * 0.82); scroll-snap-align: start; }
    .byp-soon { margin-top: 24px; }
    .byp-soon-desc { display: none; }
    .byp-start { margin-top: 32px; }
    .byp-guides { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .byp-guide { border: 0; border-top: 1px solid var(--border); border-radius: 0; padding: 14px 0; }
    .byp-guides > li:last-child .byp-guide { border-bottom: 1px solid var(--border); }
  }

  /* Referral promotion (Phase 1 personalization) — `order` only, never
     display/DOM. data-ref-ecosystem is set synchronously (before this
     section paints) by the blocking script above, from a validated ?ref=
     query param. Every request still renders the same DOM in the same
     order, so crawlers see identical markup regardless of the param. */
  :root[data-ref-ecosystem="voron"]  [data-eco-slug="voron"]  { order: -1; }
  :root[data-ref-ecosystem="ratrig"] [data-eco-slug="ratrig"] { order: -1; }
  :root[data-ref-ecosystem="vzbot"]  [data-eco-slug="vzbot"]  { order: -1; }
  :root[data-ref-ecosystem="hevort"] [data-eco-slug="hevort"] { order: -1; }
  :root[data-ref-ecosystem="k3"]     [data-eco-slug="k3"]     { order: -1; }
</style>
