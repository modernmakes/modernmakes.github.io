---
import BeehiivEmbed from './BeehiivEmbed.astro';
---
<div class="nl-capture-outer">
  <div class="newsletter-capture">
    <p class="newsletter-capture__label">Stay current</p>
    <h3 class="newsletter-capture__heading">The Modern Makes Brief</h3>
    <p class="newsletter-capture__sub">Printers, hardware, and builds worth knowing about. Weekly.</p>
    <div class="newsletter-capture__form">
      <BeehiivEmbed />
    </div>
  </div>
</div>

<style is:global>
.nl-capture-outer {
  background: var(--black);
  border-top: 1px solid var(--dark-border);
  margin-top: 64px;
}
.newsletter-capture {
  max-width: 600px;
  margin: 0 auto;
  padding: 48px 24px;
  text-align: center;
}
.newsletter-capture__label {
  font-family: var(--fu);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .1em;
  color: var(--accent);
  margin: 0 0 10px;
}
.newsletter-capture__heading {
  font-family: var(--fd);
  font-size: 28px;
  font-weight: 800;
  color: var(--surface);
  line-height: 1.05;
  margin: 0 0 10px;
}
.newsletter-capture__sub {
  font-family: var(--fb);
  font-size: 14px;
  color: var(--on-dark-muted);
  line-height: 1.65;
  margin: 0 0 24px;
}
.newsletter-capture__form {
  min-height: 48px;
}
@media (max-width: 640px) {
  .newsletter-capture { padding: 40px 20px; }
  .newsletter-capture__heading { font-size: 22px; }
}
</style>
