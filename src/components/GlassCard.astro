---
// GlassCard — reusable frosted backdrop-filter feature card.
// The whole card is a link; hover lift is CSS-only and reduced-motion safe.
// Needs a dark backdrop behind it for backdrop-filter to have anything to blur.
interface Props {
  category: string;
  name: string;
  description: string;
  /** Display label from the verdict taxonomy, e.g. "Workhorse" */
  verdict: string;
  /** Stable taxonomy key (benchmark | workhorse | bleeding-edge | skip) — drives the badge colour */
  verdictKey: string;
  price: number;
  href: string;
  /** Product-shot URL. Callers pass this only once they've confirmed the file exists,
   *  so an absent/missing image falls back to the solid band rather than a broken img. */
  imageSrc?: string | null;
  /** When set, the card joins the shared scroll-reveal with this stagger delay (ms) */
  revealDelay?: number;
}
const { category, name, description, verdict, verdictKey, price, href, imageSrc, revealDelay } = Astro.props;
---
<a
  class="glass-card"
  href={href}
  data-reveal={revealDelay !== undefined ? '' : undefined}
  data-reveal-delay={revealDelay}
>
  {imageSrc ? (
    <div class="gc-media">
      <img class="gc-media-img" src={imageSrc} alt={name} width="800" height="600" loading="lazy" decoding="async" />
    </div>
  ) : (
    <div class="gc-band" aria-hidden="true"></div>
  )}
  <div class="gc-body">
    <p class="gc-category">{category}</p>
    <h3 class="gc-name">{name}</h3>
    <p class="gc-desc">{description}</p>
    <div class="gc-foot">
      <span class:list={['gc-verdict', `gc-verdict--${verdictKey}`]}>{verdict}</span>
      <span class="gc-price">${price}</span>
    </div>
  </div>
</a>

<style>
  /* Hallmark · component: glass-card · genre: atmospheric · theme: brand-dark
   * states: default · hover · focus-visible · active  (disabled/loading/error/success N/A — content link)
   * pre-emit critique: P5 H5 E5 S5 R5 V4 · contrast: pass */

  .glass-card {
    display: block;
    position: relative;
    text-decoration: none;
    color: inherit;
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid var(--dark-border);
    border-radius: var(--radius-2xl);
    overflow: hidden; /* clips the top band to the card's rounded corners */
    /* Smooth ease-out (transitions.dev motion token), exact props — never `all` */
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
                border-color 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .glass-card:hover {
      transform: translateY(-4px);
      border-color: rgba(255, 255, 255, 0.14);
    }
  }
  .glass-card:active { transform: translateY(-2px); }
  .glass-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .gc-band {
    height: 120px;
    background: var(--dark-surface);
    border-top-left-radius: var(--radius-2xl);
    border-top-right-radius: var(--radius-2xl);
  }

  /* Product-shot panel. Same 120px height as .gc-band so swapping between the
     two never shifts the card's layout. The panel background is the colour the
     product WebPs are shot on, so `contain` letterboxing reads as one surface
     rather than an image sitting on a mismatched field. Hairline rule separates
     the panel from the glass body — no overlay, the shot carries itself. */
  .gc-media {
    height: 120px;
    padding: 12px;
    background: var(--surface-media);
    border-bottom: 1px solid var(--dark-border);
    border-top-left-radius: var(--radius-2xl);
    border-top-right-radius: var(--radius-2xl);
  }
  .gc-media-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gc-body { padding: 20px; }
  .gc-category {
    font-family: var(--fu);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--on-dark-muted);
    margin: 0 0 8px;
  }
  .gc-name {
    font-family: var(--fd);
    font-size: 22px;
    font-weight: 800;
    color: var(--on-dark);
    line-height: 1.1;
    margin: 0 0 6px;
    overflow-wrap: anywhere;
  }
  .gc-desc {
    font-family: var(--fu);
    font-size: 13px;
    line-height: 1.5;
    color: var(--on-dark-muted);
    margin: 0 0 16px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .gc-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .gc-verdict {
    font-family: var(--fu);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    border-radius: var(--radius-badge);
    white-space: nowrap;
  }
  /* Verdict taxonomy: Benchmark (ink, inverted to white on glass), Workhorse
     (green), Bleeding Edge (blue), Skip (burnt orange). Tuned for the dark
     glass backdrop — brighter fills than the light-mode index badges, same hues. */
  .gc-verdict--benchmark {
    background: var(--surface);
    border: 1px solid var(--surface);
    color: var(--black);
  }
  .gc-verdict--workhorse {
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.4);
    color: var(--verdict-wh-on-dark);
  }
  .gc-verdict--bleeding-edge {
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.4);
    color: var(--verdict-be-on-dark);
  }
  .gc-verdict--skip {
    background: color-mix(in srgb, var(--verdict-skip) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--verdict-skip) 40%, transparent);
    color: var(--verdict-skip-on-dark);
  }
  .gc-price {
    font-family: var(--fd);
    font-size: 18px;
    font-weight: 700;
    color: var(--on-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    .glass-card { transition: none; }
    .glass-card:hover, .glass-card:active { transform: none; }
  }
</style>
