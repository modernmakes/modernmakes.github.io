---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const siteBase = Astro.site
  ? new URL(Astro.site).href.replace(/\/$/, '')
  : 'https://modernmakes.github.io';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Editorial Policy — Modern Makes',
  url: `${siteBase}/editorial-policy`,
  description: 'How Modern Makes forms verdicts, handles affiliate relationships, and maintains editorial independence from commercial interests.',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteBase}/` },
    { '@type': 'ListItem', position: 2, name: 'Editorial Policy', item: `${siteBase}/editorial-policy` },
  ],
};

const sections = [
  { id: 'independence',  label: 'Our Independence' },
  { id: 'verdicts',      label: 'How We Form Verdicts' },
  { id: 'affiliate',     label: 'Affiliate Relationships' },
  { id: 'sponsored',     label: 'Sponsored Content' },
  { id: 'corrections',   label: 'Corrections Policy' },
  { id: 'contact',       label: 'Contact' },
];
---
<Base
  title="Editorial Policy — Modern Makes"
  description="How Modern Makes forms verdicts, handles affiliate relationships, and maintains editorial independence from commercial interests."
  hasPageH1={true}
>
  <Nav slot="nav" currentPath="/" />

  <div class="lg-wrap">
    <div class="lg-inner">

      <nav class="lg-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>Editorial Policy</span>
      </nav>

      <div class="lg-layout">

        <aside class="lg-sidebar" aria-label="Table of contents">
          <div class="lg-toc">
            <p class="lg-toc-label">On this page</p>
            <nav>
              {sections.map(s => (
                <a class="lg-toc-link" href={`#${s.id}`}>{s.label}</a>
              ))}
            </nav>
          </div>
        </aside>

        <main class="lg-content" id="lg-main">
          <h1 class="lg-title">Editorial Policy</h1>
          <p class="lg-meta">Last updated June 2026</p>

          <section id="independence">
            <h2>Our Independence</h2>
            <p>Modern Makes accepts no payment in exchange for editorial verdicts, hardware ratings, or recommendations. No manufacturer, distributor, or affiliate partner has influence over the verdicts published on this site. Period.</p>
            <p>We have affiliate relationships with a number of hardware vendors (listed below). These relationships generate revenue that helps maintain the site. A vendor having an affiliate program does not make them more likely to receive a positive verdict — and vendors without affiliate programs are not penalised. The relationship between affiliate revenue and editorial coverage is zero.</p>
            <p>No free hardware samples have been accepted in exchange for coverage. If that policy changes, it will be disclosed explicitly on the relevant page.</p>
          </section>

          <section id="verdicts">
            <h2>How We Form Verdicts</h2>
            <p>Modern Makes is an editorial publication, not a testing lab. We synthesize community experience rather than producing first-person reviews. Our verdicts are informed by:</p>
            <ul>
              <li><strong>Reddit</strong> — particularly r/voroncorexy, r/FixMyPrint, r/3Dprinting, and equipment-specific communities where owners report long-term experience.</li>
              <li><strong>Discord communities</strong> — Voron Design, RatRig, VzBot, and manufacturer-run servers where build problems and solutions surface in real time.</li>
              <li><strong>YouTube</strong> — in-depth installation and comparison videos from trusted community creators.</li>
              <li><strong>CNCKitchen and similar technical sources</strong> — where empirical testing data exists (flow rates, temperature accuracy, etc.), we reference it with attribution.</li>
            </ul>
            <p>We never write "we tested this hotend and found…" unless a member of the Modern Makes team has personally tested the hardware. All synthesis-based verdicts are framed as community consensus, not first-person experience.</p>
            <p>Verdict values — BUY, CONSIDER, SKIP, UPDATED — represent our editorial judgment of whether a product is a strong recommendation, a contextual pick, not recommended, or previously recommended but now superseded by newer options.</p>
          </section>

          <section id="affiliate">
            <h2>Affiliate Relationships</h2>
            <p>Modern Makes has active affiliate or referral relationships with the following vendors. Links to their products on this site may earn us a commission:</p>
            <ul>
              <li><strong>Fabreeko</strong> — US retailer for Voron-adjacent hardware</li>
              <li><strong>West3D</strong> — US retailer for printing hardware and toolheads</li>
              <li><strong>KB3D</strong> — US retailer for prosumer parts</li>
              <li><strong>Amazon</strong> — via the Amazon Associates program (Canada)</li>
              <li><strong>Micro Swiss</strong> — direct affiliate program for their hotend and extruder products</li>
              <li><strong>Mellow3D</strong> — AliExpress affiliate via their store program</li>
            </ul>
            <p>This list is updated as relationships are added or ended. Not every link to these vendors is an affiliate link — links within editorial copy are selected editorially; affiliate links appear primarily in "Where to Buy" sections.</p>
          </section>

          <section id="sponsored">
            <h2>Sponsored Content</h2>
            <p>Modern Makes occasionally publishes sponsored content — long-form articles or guides that are funded by a hardware vendor or partner. All sponsored content is clearly labeled at the top of the page with a disclosure like "This article is sponsored by [Vendor]."</p>
            <p>Sponsorship means a vendor paid to have a topic covered. It does not mean the verdict or any factual claim in the article is pre-approved by the sponsor. Sponsors do not receive editorial review rights over published content.</p>
            <p>We decline sponsorships that would require us to make positive claims we don't believe are accurate, or to avoid covering competing products honestly.</p>
          </section>

          <section id="corrections">
            <h2>Corrections Policy</h2>
            <p>When we get something wrong, we fix it and say so. Corrections are noted inline in the article with a brief note of what changed and when. We do not silently edit factual errors without disclosure.</p>
            <p>If you find a factual error — wrong spec, outdated pricing, incorrect compatibility claim — email us and we will review it within 5 business days. If we confirm the error, we correct it and credit the reader who flagged it (unless they prefer anonymity).</p>
            <p>Opinion-based verdicts are not subject to correction requests from vendors — we maintain editorial independence over our assessments. However, we do update verdicts when new information warrants it, and we label updated assessments with the UPDATED verdict badge.</p>
            <p>Contact for corrections: <a href="mailto:modernmakesco@gmail.com" class="lg-email-link">modernmakesco@gmail.com</a></p>
          </section>

          <section id="contact">
            <h2>Contact</h2>
            <p>For questions about editorial policy, corrections, or sponsorship enquiries:</p>
            <p><a href="mailto:modernmakesco@gmail.com" class="lg-email-link">modernmakesco@gmail.com</a></p>
          </section>

        </main>
      </div>
    </div>
  </div>

  <Footer slot="footer" />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify(pageSchema)}></script>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)}></script>
</Base>

<script>
(function () {
  const sections = document.querySelectorAll<HTMLElement>('.lg-content section[id]');
  const links    = document.querySelectorAll<HTMLAnchorElement>('.lg-toc-link');
  if (!sections.length || !links.length) return;
  const obs = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        links.forEach(l => l.removeAttribute('aria-current'));
        const active = document.querySelector<HTMLAnchorElement>(`.lg-toc-link[href="#${entry.target.id}"]`);
        if (active) active.setAttribute('aria-current', 'true');
      }
    }
  }, { rootMargin: '-15% 0px -75% 0px' });
  sections.forEach(s => obs.observe(s));
})();
</script>
