---
// HomeNewsletterCTA — compact editorial callout strip between Latest and Ecosystems
---
<section class="nlcta-section" aria-label="Newsletter signup">
  <div class="nlcta-container">
    <div class="nlcta-inner">
      <div class="nlcta-text" data-reveal>
        <p class="nlcta-eyebrow">Free Weekly Newsletter</p>
        <p class="nlcta-headline">The 3D printing briefing</p>
        <p class="nlcta-sub">What's worth buying, building, and following — every Tuesday.</p>
      </div>
      <div class="nlcta-form-wrap" data-reveal data-reveal-delay="100">
        <form class="beehiiv-fallback-form" id="nlcta-form">
          <input type="email" name="email" id="nlcta-email"
            placeholder="your@email.com" required />
          <button type="submit" id="nlcta-btn">Subscribe →</button>
        </form>
        <p class="nlcta-note" id="nlcta-msg" style="display:none;"></p>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .nlcta-section {
    background: var(--bg);
    padding: 24px 40px;
  }
  .nlcta-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .nlcta-inner {
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 20px 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-sizing: border-box;
    width: 100%;
  }
  .nlcta-text {
    flex: 1;
    min-width: 0;
  }
  .nlcta-eyebrow {
    font-family: var(--fm);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 4px;
  }
  .nlcta-headline {
    font-family: var(--fd);
    font-size: clamp(20px, 2vw + 10px, 28px);
    font-weight: 800;
    color: var(--black);
    line-height: 1.05;
    margin: 0 0 4px;
  }
  .nlcta-sub {
    font-family: var(--fb);
    font-style: italic;
    font-size: 13px;
    color: var(--grey-1);
    line-height: 1.5;
    margin: 0;
  }
  .nlcta-form-wrap {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 320px;
    flex-shrink: 0;
  }
  .beehiiv-fallback-form {
    display: flex;
    gap: 8px;
    width: 100%;
  }
  .beehiiv-fallback-form input[type="email"] {
    flex: 1;
    height: 40px;
    padding: 0 14px;
    font-size: 13px;
    font-family: var(--fu);
    background: var(--surface);
    color: var(--black);
    border: 1px solid var(--border);
    border-radius: 5px;
    outline-color: transparent;
    transition: border-color 150ms;
    min-width: 0;
    box-sizing: border-box;
  }
  .beehiiv-fallback-form input[type="email"]::placeholder { color: var(--grey-2); }
  .beehiiv-fallback-form input[type="email"]:focus { border-color: var(--accent); }
  .beehiiv-fallback-form button[type="submit"] {
    height: 40px;
    padding: 0 18px;
    background: var(--accent);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    font-family: var(--fu);
    border: none;
    border-radius: 5px;
    cursor: pointer;
    white-space: nowrap;
    transition: background 150ms;
    flex-shrink: 0;
  }
  .beehiiv-fallback-form button[type="submit"]:hover { background: var(--accent-dk); }
  .nlcta-note {
    font-size: 11px;
    color: var(--grey-2);
    font-family: var(--fu);
    margin: 0;
  }

  @media (max-width: 900px) {
    .nlcta-section { padding: 20px 24px; }
    .nlcta-inner { gap: 24px; }
    .nlcta-form-wrap { width: 280px; }
  }
  @media (max-width: 768px) {
    .nlcta-section { padding: 20px; }
    .nlcta-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding: 20px;
    }
    .nlcta-form-wrap { width: 100%; }
    .beehiiv-fallback-form { flex-direction: column; }
    .beehiiv-fallback-form input[type="email"],
    .beehiiv-fallback-form button[type="submit"] {
      width: 100%;
      box-sizing: border-box;
    }
    .beehiiv-fallback-form button[type="submit"] { height: 44px; }
  }
</style>

<!-- Entrance is handled by the shared [data-reveal] observer in Base.astro (M1). -->

<script is:inline>
(function() {
  var form = document.getElementById('nlcta-form');
  var btn = document.getElementById('nlcta-btn');
  var msg = document.getElementById('nlcta-msg');
  var email = document.getElementById('nlcta-email');
  if (!form) return;
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    btn.textContent = 'Subscribing...';
    btn.disabled = true;
    fetch('https://hook.us1.make.com/rb9wcdyixxygfhoihhr0mnjpm1k61hu4', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: email.value,
        utm_source: 'website',
        utm_medium: 'subscribe_form',
        utm_campaign: 'homepage_cta'
      })
    })
    .then(function(res) { return res.json(); })
    .then(function() {
      form.style.display = 'none';
      msg.textContent = "You're in. Welcome to The Modern Makes Brief.";
      msg.style.display = 'block';
      msg.style.color = 'var(--accent)';
      msg.style.fontSize = '14px';
    })
    .catch(function() {
      btn.textContent = 'Subscribe →';
      btn.disabled = false;
    });
  });
})();
</script>
