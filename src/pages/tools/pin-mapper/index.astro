function renderTable() {
  const boardId = (document.getElementById('boardSel') as HTMLSelectElement).value;
  const search  = (document.getElementById('pinSearch') as HTMLInputElement).value.toLowerCase().trim();
  const board   = BOARDS[boardId];
  if (!board) return;

  (document.getElementById('boardMcu') as HTMLElement).textContent = board.mcu;

  const tbody = document.getElementById('pinTableBody') as HTMLTableSectionElement;
  const rows  = board.pins;
  let html = '';
  let hasMatch = false;

  for (const row of rows) {
    if (row.section !== undefined) {
      if (search) continue;
      html += `<tr class="pm-section-row"><td class="pm-section-label" colspan="5">${row.section}</td></tr>`;
      continue;
    }
    if (search) {
      const haystack = `${row.func} ${row.key} ${row.pin} ${row.note}`.toLowerCase();
      if (!haystack.includes(search)) continue;
    }
    hasMatch = true;
    const isNegative = row.pin.startsWith('!');
    const pinDisplay = isNegative ? row.pin.slice(1) : row.pin;
    html += `<tr>
      <td><div class="pm-func">${row.func}</div></td>
      <td><div class="pm-key">${row.key}</div></td>
      <td><span class="pm-pin${isNegative ? ' pm-pin-neg' : ''}">${isNegative ? '!' : ''}${pinDisplay}</span></td>
      <td><div class="pm-note">${row.note}</div></td>
      <td><button class="pm-copy-pin" data-pin="${row.key}: ${row.pin}">Copy</button></td>
    </tr>`;
  }

  if (!hasMatch && search) {
    html = `<tr><td colspan="5" class="pm-no-results">No pins match "${search}"</td></tr>`;
  }

  tbody.innerHTML = html;

  tbody.querySelectorAll<HTMLButtonElement>('.pm-copy-pin').forEach(btn => {
    btn.addEventListener('click', async () => {
      const pinVal = (btn.dataset.pin ?? '').split(':').pop()?.trim() ?? '';
      try {
        await navigator.clipboard.writeText(pinVal);
        btn.textContent = 'Copied ✓';
        btn.classList.add('copied');
        setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 1800);
      } catch {}
    });
  });
}

document.getElementById('boardSel')?.addEventListener('change', renderTable);
document.getElementById('pinSearch')?.addEventListener('input', renderTable);
renderTable();
</script>
