---
// Running list of everything picked. In-memory only for this phase — no
// localStorage, no save/share, no URL persistence. The client script owns
// all of the actual list-building; this is just the static shell it fills.
---
<aside class="cfg-summary" aria-label="Your build so far">
  <h2 class="cfg-summary-title">Your build</h2>
  <p class="cfg-summary-empty" data-summary-empty>Nothing picked yet — selections you make below show up here.</p>
  <ul class="cfg-summary-list" data-summary-list></ul>
  <div class="cfg-summary-total" data-summary-total hidden>
    <span>Estimated total</span>
    <span data-summary-total-value>$0</span>
  </div>
</aside>

<style>
  .cfg-summary {
    position: sticky;
    top: 90px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 18px;
  }
  .cfg-summary-title {
    font-family: var(--fd);
    font-size: 18px;
    font-weight: 800;
    color: var(--black);
    margin: 0 0 10px;
  }
  .cfg-summary-empty {
    font-family: var(--fb);
    font-size: 13px;
    color: var(--g2);
    margin: 0;
  }
  .cfg-summary-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cfg-summary-list:empty { display: none; }
  .cfg-summary-item {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-family: var(--fu);
    font-size: 13px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }
  .cfg-summary-item-label {
    color: var(--g1);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .04em;
    display: block;
  }
  .cfg-summary-item-name {
    color: var(--black);
    font-weight: 700;
  }
  .cfg-summary-item-remove {
    background: none;
    border: none;
    color: var(--g2);
    cursor: pointer;
    font-size: 12px;
  }
  .cfg-summary-item-remove:hover { color: var(--accent); }
  .cfg-summary-total {
    display: flex;
    justify-content: space-between;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    font-family: var(--fu);
    font-size: 14px;
    font-weight: 800;
    color: var(--black);
  }
</style>
