---
// /search: the full-page form of the command palette, and its no-JS fallback (the nav search icon is a
// plain link here). Same index, ranking and rows as the palette (src/scripts/search-core.ts), so a query
// gives the same results in the same order. Without JS it is a GET form plus browse links.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const siteBase = Astro.site
  ? new URL(Astro.site).href.replace(/\/$/, '')
  : 'https://modernmakes.github.io';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Search — Modern Makes',
  url: `${siteBase}/search`,
};

const browse: [string, string][] = [
  ['Hardware', '/hardware'],
  ['Printers', '/printers'],
  ['Guides', '/guides'],
  ['News', '/news'],
  ['Tools', '/tools'],
];
---
<Base
  title="Search"
  description="Search Modern Makes: hardware specs and verdicts, guides, news, comparisons and tools."
  hasPageH1={true}
>
  <Nav slot="nav" currentPath="/search" />

  <div class="srch-wrap">
    <div class="srch-inner">
      <h1 class="srch-h1">Search</h1>

      <form class="srch-form" id="srch-form" action="/search" method="get" role="search">
        <label class="sr-only" for="srch-input">Search hardware, articles and tools</label>
        <svg class="srch-glass" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input
          class="srch-input"
          id="srch-input"
          name="q"
          type="search"
          placeholder="Hardware, articles, tools"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="search"
        />
        <button class="srch-go" type="submit">Search</button>
      </form>

      <p class="srch-meta" id="srch-meta" role="status" aria-live="polite"></p>
      <div class="srch-results" id="srch-results"></div>

      <nav class="srch-browse" id="srch-browse" aria-labelledby="srch-browse-h">
        <h2 class="cp-g srch-gh" id="srch-browse-h">Browse</h2>
        <ul>
          {browse.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </nav>
    </div>
  </div>

  <Footer slot="footer" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(pageSchema)}></script>
</Base>

<script>
  import { loadIndex, search, rowHtml, esc, GROUP_LABEL, freshness } from '../../scripts/search-core';

  const form = document.getElementById('srch-form') as HTMLFormElement;
  const input = document.getElementById('srch-input') as HTMLInputElement;
  const results = document.getElementById('srch-results') as HTMLElement;
  const meta = document.getElementById('srch-meta') as HTMLElement;
  const browse = document.getElementById('srch-browse') as HTMLElement;

  input.value = new URLSearchParams(location.search).get('q') ?? '';
  let ready = false;
  let statusT = 0;

  const section = (label: string, html: string) => `<section class="srch-g"><h2 class="cp-g srch-gh">${label}</h2>${html}</section>`;

  function say(text: string) {
    clearTimeout(statusT);
    statusT = window.setTimeout(() => { meta.textContent = text; }, 300); // don't announce every keystroke
  }

  function render() {
    const raw = input.value.trim();
    browse.hidden = !!raw;
    if (!raw) { results.innerHTML = ''; say(''); return; }
    if (!ready) { results.innerHTML = '<p class="srch-note">Loading…</p>'; return; }
    const res = search(raw);
    if (res.count) {
      results.innerHTML = res.groups
        .filter(([, rs]) => rs.length)
        .map(([g, rs]) => section(GROUP_LABEL[g], rs.map((r) => rowHtml(r, res.terms)).join('')))
        .join('');
      say(`${res.count} result${res.count === 1 ? '' : 's'}${freshness() ? ` · ${freshness()}` : ''}`);
    } else {
      results.innerHTML = `<p class="srch-note">Nothing matched “${esc(raw)}”.</p>` +
        (res.closest.length ? section('Closest hardware', res.closest.map((r) => rowHtml(r)).join('')) : '');
      say('No matches');
    }
  }

  // Linkable: the address bar always holds the current query.
  function syncUrl() {
    const url = new URL(location.href);
    const q = input.value.trim();
    if (q) url.searchParams.set('q', q); else url.searchParams.delete('q');
    history.replaceState(history.state, '', url);
  }

  input.addEventListener('input', () => { syncUrl(); render(); });
  form.addEventListener('submit', (e) => {
    e.preventDefault(); // results are already live; Enter just hides the phone keyboard
    syncUrl();
    render();
    if (matchMedia('(pointer: coarse)').matches) input.blur();
  });

  render();
  loadIndex().then(
    () => { ready = true; render(); },
    () => { results.innerHTML = '<p class="srch-note">Search didn’t load. Try again in a moment, or browse below.</p>'; browse.hidden = false; },
  );
</script>

<style is:global>
/* Hallmark · redesign: /search · genre: editorial · theme: DESIGN.md (Workshop Press, dark plane)
 * pre-emit critique: P4 H5 E4 S4 R5 V4
 * The full-page form of the palette: the same dark plane and the same rows, so results look and rank the
 * same in both. One column; the field is the only large element. No orange outside the focus ring and caret.
 * states: field default · hover · focus-visible · filled; rows default · hover · focus-visible · active;
 *         loading · error (index failed) · empty (no query: browse) · no hits (closest hardware). */
.srch-wrap {
  background: var(--dark-bg);
  color: #fff;
  min-height: calc(100vh - 80px);
  padding: 56px 24px 96px;
  overflow-x: clip;
}
.srch-inner { max-width: 720px; margin: 0 auto; }
.srch-h1 { font: 800 clamp(40px, 6vw, 56px)/1 var(--fd); color: #fff; margin: 0 0 24px; }

.srch-form {
  position: relative;
  display: flex; align-items: center; gap: 8px;
  padding: 0 6px 0 16px;
  background: var(--dark-surface);
  border: 1px solid var(--dark-border);
  border-radius: var(--radius-md);
  transition: border-color var(--dur-fast) var(--ease-out);
}
.srch-form:focus-within { border-color: rgba(255, 255, 255, 0.4); }
@media (hover: hover) and (pointer: fine) { .srch-form:hover { border-color: rgba(255, 255, 255, 0.3); } }
.srch-glass { flex: none; color: var(--on-dark-muted); }
.srch-input {
  flex: 1; min-width: 0; height: 56px;
  background: transparent; border: 0; outline: none; /* the field's border is the focus mark */
  color: #fff; caret-color: var(--accent);
  font: 500 17px var(--fu);
  appearance: none; -webkit-appearance: none;
}
.srch-input::placeholder { color: var(--on-dark-muted); }
.srch-input::-webkit-search-cancel-button { -webkit-appearance: none; }
.srch-go {
  position: relative; flex: none;
  min-height: 44px; padding: 0 14px;
  background: transparent; color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.2); border-radius: var(--radius-sm);
  font: 700 14px var(--fu); cursor: pointer;
  transition: background-color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), var(--press-release);
}
.srch-go:active { scale: var(--scale-press-btn); background: rgba(255, 255, 255, 0.08); transition-duration: var(--dur-press); }
@media (hover: hover) and (pointer: fine) { .srch-go:hover { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.35); } }
@media (prefers-reduced-motion: reduce) { .srch-go:active { scale: none; } }

.srch-meta { min-height: 18px; margin: 12px 0 8px; font: 400 11px/1.6 var(--fm); color: var(--on-dark-muted); }
.srch-note { margin: 16px 0 4px; font: 400 16px/1.6 var(--fb); color: var(--on-dark-soft); overflow-wrap: anywhere; }

.srch-g + .srch-g { margin-top: 8px; }
.srch-gh { margin: 0; padding-left: 0; }
.srch-results .cp-row { margin: 0 -10px; }
.srch-results .cp-row:focus-visible { outline-offset: -2px; }
@media (hover: hover) and (pointer: fine) { .srch-results .cp-row:hover { background: rgba(255, 255, 255, 0.08); } }

.srch-browse { margin-top: 24px; }
.srch-browse ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 28px; }
.srch-browse a {
  display: inline-flex; align-items: center; min-height: 44px;
  font: 600 16px var(--fu); color: #fff; white-space: nowrap;
  text-decoration: underline; text-decoration-color: rgba(255, 255, 255, 0.3); text-underline-offset: 5px;
  transition: text-decoration-color var(--dur-fast) var(--ease-out);
}
@media (hover: hover) and (pointer: fine) { .srch-browse a:hover { text-decoration-color: #fff; } }

@media (max-width: 600px) {
  .srch-wrap { padding: 32px 16px 72px; }
}
</style>
