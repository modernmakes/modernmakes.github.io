---
/* Hallmark · macrostructure: Long Document (vendor-pitch variant) · tone: direct-editorial · anchor hue: warm-orange
 * transitions: texts-reveal (18) on partner chips entrance
 * pre-emit critique: P5 H4 E5 S4 R5 V5 — distinct from /advertise: no hero, no stats band
 */
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const siteBase = Astro.site
  ? new URL(Astro.site).href.replace(/\/$/, '')
  : 'https://modernmakes.github.io';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Partner With Us — Modern Makes',
  url: `${siteBase}/partners`,
  description: 'Affiliate and affiliate partnership information for 3D printing hardware vendors. How we work with Fabreeko, West3D, KB3D, Amazon, Micro Swiss, Mellow3D.',
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',    item: `${siteBase}/` },
    { '@type': 'ListItem', position: 2, name: 'Partners', item: `${siteBase}/partners` },
  ],
};

const currentPartners = ['Fabreeko', 'West3D', 'KB3D', 'Amazon', 'Micro Swiss', 'Mellow3D'];

const whatWeOffer = [
  {
    title: 'Hardware detail page links',
    body: 'Your product appears in the "Where to Buy" section on its dedicated hardware page — hotends, extruders, bed probes, and other categories. This is high-intent traffic: readers researching before they buy.',
  },
  {
    title: 'Guide and roundup mentions',
    body: 'When a guide or buying roundup covers a product we\'re affiliated with, we link to the best vendor. Editorial selection — we pick the right vendor for the reader, not the highest commission.',
  },
  {
    title: 'Newsletter mentions',
    body: 'The Modern Makes Brief occasionally recommends hardware directly. Affiliate partners with genuinely good pricing or availability are mentioned in context.',
  },
];

const whatWeNeed = [
  'Access to your affiliate program — a direct referral link or account in your affiliate platform.',
  'Accurate product specifications we can reference on detail pages (gear ratios, weights, temperatures, compatibility).',
  'Spec sheets or documentation rather than physical samples — we\'re synthesizers, not a test lab.',
];
---
<Base
  title="Partner With Us — Modern Makes"
  description="How Modern Makes works with 3D printing hardware vendors on affiliate partnerships. Apply to become a partner."
  hasPageH1={true}
>
  <Nav slot="nav" currentPath="/partners" />

  <!-- HEADER -->
  <div class="prt-header">
    <div class="prt-inner">
      <nav class="prt-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>Partner With Us</span>
      </nav>
      <h1 class="prt-title">Partner With Us</h1>
      <p class="prt-sub">For 3D printing hardware vendors, component makers, and filament brands that want editorial exposure on a publication their customers actually trust.</p>
    </div>
  </div>

  <!-- MODEL EXPLANATION -->
  <section class="prt-section prt-section-white">
    <div class="prt-inner prt-model">
      <div class="prt-model-text">
        <h2 class="prt-h2">How our affiliate model works</h2>
        <p>Modern Makes links to products we would recommend anyway. When we have an affiliate relationship with a vendor, their products get purchase links on hardware detail pages. When we don't, those products still get covered editorially — they just don't get buy buttons.</p>
        <p>Affiliate commissions fund the publication. They don't determine which products we recommend. Our readers come to us because our verdicts are independent — the moment we trade that for a commission, the readership disappears. That's not a sacrifice we're willing to make.</p>
        <p>This means we apply to affiliate programs selectively. If a product isn't something we'd link to on merit, we won't apply. If it is, being affiliated makes it easier to give readers a direct purchase path.</p>
      </div>
      <div class="prt-model-callout">
        <div class="prt-callout-value">~10K</div>
        <div class="prt-callout-label">monthly readers</div>
        <div class="prt-callout-divider"></div>
        <div class="prt-callout-value">3,400+</div>
        <div class="prt-callout-label">newsletter subscribers</div>
        <div class="prt-callout-divider"></div>
        <p class="prt-callout-note">Prosumer enthusiast audience — Voron builders, multi-machine owners, high-spend hobbyists.</p>
      </div>
    </div>
  </section>

  <!-- WHAT WE OFFER -->
  <section class="prt-section">
    <div class="prt-inner">
      <h2 class="prt-h2">What we offer partners</h2>
      <div class="prt-offer-grid" id="prt-offers">
        {whatWeOffer.map((item, i) => (
          <div
            class="prt-offer-item"
            style={`transition-delay:calc(var(--stagger-stagger) * ${i})`}
          >
            <h3 class="prt-offer-title">{item.title}</h3>
            <p class="prt-offer-body">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT WE NEED -->
  <section class="prt-section prt-section-white">
    <div class="prt-inner prt-need-wrap">
      <h2 class="prt-h2">What we need from you</h2>
      <ul class="prt-need-list">
        {whatWeNeed.map(item => <li>{item}</li>)}
      </ul>
      <p class="prt-need-note">We don't require free samples, review units, or anything that creates a reciprocal obligation. The relationship is simple: you run an affiliate program, we apply, and we link editorially where it makes sense.</p>
    </div>
  </section>

  <!-- CURRENT PARTNERS -->
  <section class="prt-section">
    <div class="prt-inner">
      <h2 class="prt-h2">Current partners</h2>
      <div class="prt-partner-chips" id="prt-chips">
        {currentPartners.map((p, i) => (
          <span
            class="prt-chip"
            style={`transition-delay:calc(var(--stagger-stagger) * ${i})`}
          >{p}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- APPLY FORM -->
  <section class="prt-section prt-section-white" id="apply">
    <div class="prt-inner prt-form-wrap">
      <h2 class="prt-h2">Apply to partner</h2>
      <p class="prt-form-intro">Tell us about your product and affiliate program. We review applications within 5 business days.</p>
      <form
        class="prt-form"
        onsubmit="return prtSubmit(this)"
        action="mailto:modernmakesco@gmail.com"
        method="get"
        enctype="text/plain"
      >
        <div class="prt-form-row">
          <div class="prt-form-group">
            <label class="prt-label" for="prt-company">Company / Brand</label>
            <input class="prt-input" type="text" id="prt-company" name="company" placeholder="Your company name" required />
          </div>
          <div class="prt-form-group">
            <label class="prt-label" for="prt-category">Product category</label>
            <select class="prt-input" id="prt-category" name="category">
              <option value="">Select...</option>
              <option value="hotends">Hotends</option>
              <option value="extruders">Extruders</option>
              <option value="motion">Motion Systems</option>
              <option value="electronics">Electronics / Boards</option>
              <option value="filament">Filament</option>
              <option value="probes">Bed Probes</option>
              <option value="other">Other</option>
            </select>
          </div>
        </div>
        <div class="prt-form-row">
          <div class="prt-form-group">
            <label class="prt-label" for="prt-website">Website</label>
            <input class="prt-input" type="url" id="prt-website" name="website" placeholder="https://yoursite.com" />
          </div>
          <div class="prt-form-group">
            <label class="prt-label" for="prt-affiliate-url">Affiliate program URL</label>
            <input class="prt-input" type="url" id="prt-affiliate-url" name="affiliate_url" placeholder="https://affiliate-platform.com/..." />
          </div>
        </div>
        <div class="prt-form-group">
          <label class="prt-label" for="prt-msg">Message</label>
          <textarea class="prt-input prt-textarea" id="prt-msg" name="body" placeholder="What products are you hoping to get exposure for? Commission structure? Anything else we should know?" rows="4"></textarea>
        </div>
        <button class="prt-submit" type="submit">Send application →</button>
        <p class="prt-form-note">Opens your email client with fields pre-filled.</p>
      </form>
    </div>
  </section>

  <Footer slot="footer" />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify(pageSchema)}></script>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)}></script>
</Base>

<script is:inline>
function prtSubmit(form) {
  var company  = form.company.value;
  var category = form.category.value;
  var website  = form.website.value;
  var affUrl   = form.affiliate_url.value;
  var msg      = form.body.value;
  var subject  = encodeURIComponent('Modern Makes Partner Application — ' + company);
  var body = encodeURIComponent(
    'Company: ' + company + '\n' +
    'Category: ' + category + '\n' +
    'Website: ' + website + '\n' +
    'Affiliate URL: ' + affUrl + '\n\n' +
    msg
  );
  window.location.href = 'mailto:modernmakesco@gmail.com?subject=' + subject + '&body=' + body;
  return false;
}
</script>

<script>
(function () {
  /* texts-reveal stagger on chips + offer cards */
  function revealOnEnter(id: string, cls: string) {
    const el = document.getElementById(id);
    if (!el) return;
    const obs = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) { el.classList.add(cls); obs.disconnect(); }
    }, { threshold: 0.15 });
    obs.observe(el);
  }
  revealOnEnter('prt-chips',  'prt-chips-visible');
  revealOnEnter('prt-offers', 'prt-offers-visible');
})();
</script>

<style is:global>
/* ── PARTNERS PAGE ───────────────────────── */

.prt-header {
  background: var(--surface);
  border-bottom: 2px solid var(--black);
  padding: 40px 0 32px;
}
.prt-inner {
  max-width: 1000px;
  margin: 0 auto;
  padding: 0 40px;
}
.prt-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--fm);
  font-size: 10px;
  color: var(--g2);
  margin-bottom: 16px;
}
.prt-breadcrumb a { color: var(--g2); }
.prt-breadcrumb a:hover { color: var(--accent); }
.prt-title {
  font-family: var(--fd);
  font-size: 44px;
  font-weight: 800;
  color: var(--black);
  line-height: 1;
  letter-spacing: -.5px;
  margin-bottom: 12px;
}
.prt-sub {
  font-family: var(--fb);
  font-size: 15px;
  color: var(--g1);
  line-height: 1.75;
  max-width: 560px;
}

/* Sections */
.prt-section { padding: 48px 0; border-bottom: 1px solid var(--border); }
.prt-section-white { background: var(--surface); }
.prt-section:not(.prt-section-white) { background: var(--bg); }

.prt-h2 {
  font-family: var(--fd);
  font-size: 28px;
  font-weight: 800;
  color: var(--black);
  letter-spacing: -.3px;
  margin-bottom: 20px;
  line-height: 1;
}

/* Model 2-col */
.prt-model {
  display: grid;
  grid-template-columns: 1fr 200px;
  gap: 48px;
  align-items: start;
}
.prt-model-text p {
  font-family: var(--fb);
  font-size: 15px;
  color: var(--g1);
  line-height: 1.8;
  margin-bottom: 14px;
}
.prt-model-callout {
  padding: 24px 20px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 8px;
}
.prt-callout-value {
  font-family: var(--fd);
  font-size: 36px;
  font-weight: 800;
  color: var(--black);
  line-height: 1;
}
.prt-callout-label {
  font-family: var(--fm);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--g2);
  margin-bottom: 12px;
}
.prt-callout-divider {
  height: 1px;
  background: var(--border);
  margin: 12px 0;
}
.prt-callout-note {
  font-family: var(--fb);
  font-size: 12px;
  color: var(--g1);
  line-height: 1.6;
}

/* Offer grid */
.prt-offer-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.prt-offer-item {
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 20px;
  background: var(--surface);
  /* stagger entrance */
  opacity: 0;
  transform: translateY(var(--stagger-distance));
  filter: blur(var(--stagger-blur));
  transition:
    opacity   var(--stagger-dur) var(--stagger-ease),
    transform var(--stagger-dur) var(--stagger-ease),
    filter    var(--stagger-dur) var(--stagger-ease);
}
.prt-offer-grid.prt-offers-visible .prt-offer-item {
  opacity: 1; transform: none; filter: none;
}
@media (prefers-reduced-motion: reduce) {
  .prt-offer-item { transition: none !important; opacity: 1 !important; transform: none !important; filter: none !important; }
}
.prt-offer-title {
  font-family: var(--fd);
  font-size: 16px;
  font-weight: 800;
  color: var(--black);
  margin-bottom: 10px;
}
.prt-offer-body {
  font-family: var(--fb);
  font-size: 13px;
  color: var(--g1);
  line-height: 1.75;
}

/* Need */
.prt-need-wrap { max-width: 680px; }
.prt-need-list {
  padding-left: 20px;
  margin-bottom: 16px;
}
.prt-need-list li {
  font-family: var(--fb);
  font-size: 15px;
  color: var(--g1);
  line-height: 1.8;
  margin-bottom: 10px;
}
.prt-need-note {
  font-family: var(--fb);
  font-size: 13px;
  color: var(--g2);
  line-height: 1.7;
  border-left: 2px solid var(--border);
  padding-left: 14px;
}

/* Partner chips */
.prt-partner-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.prt-chip {
  font-family: var(--fm);
  font-size: 13px;
  font-weight: 700;
  color: var(--black);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 5px;
  padding: 6px 14px;
  /* stagger entrance */
  opacity: 0;
  transform: translateY(var(--stagger-distance));
  filter: blur(var(--stagger-blur));
  transition:
    opacity   var(--stagger-dur) var(--stagger-ease),
    transform var(--stagger-dur) var(--stagger-ease),
    filter    var(--stagger-dur) var(--stagger-ease);
}
.prt-partner-chips.prt-chips-visible .prt-chip {
  opacity: 1; transform: none; filter: none;
}
@media (prefers-reduced-motion: reduce) {
  .prt-chip { transition: none !important; opacity: 1 !important; transform: none !important; filter: none !important; }
}

/* Form */
.prt-form-wrap { max-width: 680px; }
.prt-form-intro {
  font-family: var(--fb);
  font-size: 15px;
  color: var(--g1);
  line-height: 1.7;
  margin-bottom: 24px;
}
.prt-form { display: flex; flex-direction: column; gap: 14px; }
.prt-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.prt-form-group { display: flex; flex-direction: column; gap: 5px; }
.prt-label {
  font-family: var(--fm);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--g2);
}
.prt-input {
  font-family: var(--fu);
  font-size: 13px;
  color: var(--black);
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 5px;
  padding: 9px 12px;
  width: 100%;
  box-sizing: border-box;
  transition: border-color .12s;
  outline-color: var(--accent);
}
.prt-input:focus { border-color: var(--accent); }
.prt-textarea { resize: vertical; min-height: 100px; }
.prt-submit {
  font-family: var(--fd);
  font-size: 15px;
  font-weight: 800;
  letter-spacing: .03em;
  text-transform: uppercase;
  padding: 12px 28px;
  background: var(--black);
  color: #fff;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  align-self: flex-start;
  transition: background .12s;
}
.prt-submit:hover { background: var(--accent); }
.prt-form-note {
  font-family: var(--fm);
  font-size: 10px;
  color: var(--g2);
  margin-top: -6px;
}

/* Responsive */
@media (max-width: 900px) {
  .prt-model { grid-template-columns: 1fr; }
  .prt-offer-grid { grid-template-columns: 1fr; }
}
@media (max-width: 768px) {
  .prt-inner { padding: 0 24px; }
  .prt-form-row { grid-template-columns: 1fr; }
  .prt-title { font-size: 36px; }
}
@media (max-width: 480px) {
  .prt-inner { padding: 0 20px; }
  .prt-title { font-size: 30px; }
}
</style>
