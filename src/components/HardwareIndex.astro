---
import TypeCover from './TypeCover.astro';
import Sheet from './Sheet.astro';
import HardwareViewControls from './HardwareViewControls.astro';
import Icon from './icons/Icon.astro';
// Reusable hardware category index — the exact /hardware/hotends grid pattern
// (dark hero, sticky verdict filter, count summary, card grid, ItemList schema,
// fade-filter script). Every hardware category renders through this so the UI
// stays identical without copy-pasting ~350 lines of CSS per page.
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import synced from '../data/hardware/_synced.json';
import { resolveVerdict, buildVerdictTabs, VERDICT_BUCKETS, toSlug, resolveFlowClass, FLOW_CLASSES, imageOf, getSourceUrl } from '../lib/hardware';
import { jsonLd } from '../lib/jsonld';
import { transformSync } from 'esbuild';
const minify = (js: string) => transformSync(js, { minify: true, target: 'es2020' }).code;
import { DEFAULT_SORT, SORTS, SORT_TEXT, bandLabel, chooseBands, inBand, num, sortItems, type ViewItem } from '../scripts/hardware-view';

interface Props {
  records: any[];
  route: string;          // e.g. 'extruders' (under /hardware/ unless basePath is set)
  basePath?: string;      // index/detail URL prefix; default `/hardware/${route}`
  navPath?: string;       // Nav currentPath; default '/hardware'
  parent?: { label: string; href: string }; // breadcrumb parent; default Hardware
  categoryLabel: string;  // card image label, e.g. 'EXTRUDER'
  crumb: string;          // breadcrumb + h1 text, e.g. 'Extruders'
  heading: string;        // visible H1
  sub: string;            // hero subtitle
  nounSingular: string;   // count text, e.g. 'extruder'
  nounPlural: string;     // count text, e.g. 'extruders'
  title: string;          // <title> / meta
  description: string;    // meta description
  schemaName: string;     // ItemList schema name
  chips?: (r: any) => string[];        // spec chips per card
  excerptOf?: (r: any) => string;      // card excerpt
  flowOf?: (r: any) => unknown;        // max flow (mm³/s) source (sorting); default Hotends' column
  flowClassOf?: (r: any) => unknown;   // editorial flow class source; default Hotends' column
  showVerdict?: boolean;               // false hides verdict badges and tabs (no verdict pass yet)
  priceOf?: (r: any) => unknown;       // price (USD) source for sorting and price bands
}

const {
  records: raw,
  route,
  basePath = `/hardware/${route}`,
  navPath = '/hardware',
  parent = { label: 'Hardware', href: '/hardware' },
  categoryLabel,
  crumb,
  heading,
  sub,
  nounSingular,
  nounPlural,
  title,
  description,
  schemaName,
  chips = () => [],
  excerptOf = (r: any) => r['Verdict Label'] ?? r['Description'] ?? '',
  flowOf = (r: any) => r['Max Flow (mm³/s)'],
  flowClassOf = (r: any) => r['Editorial Flow Class'],
  showVerdict = true,
  priceOf = (r: any) => r['Price (USD)'],
} = Astro.props;

// Verdict badges/tabs resolve through the shared taxonomy helper, so every category renders
// Benchmark / Value Pick / Contender / Skip in that order (legacy stored values map in hardware.ts).
const verdictRank = (rawV: any) => {
  const t = resolveVerdict(rawV);
  const i = t ? VERDICT_BUCKETS.findIndex((b) => b.key === t.key) : -1;
  return i === -1 ? 99 : i;
};

const records = (raw as any[])
  .filter((r: any) => typeof r['Name'] === 'string' && r['Name'].trim())
  .sort((a: any, b: any) => (showVerdict ? verdictRank(a['Verdict']) - verdictRank(b['Verdict']) : 0));

const verdictTabs = showVerdict ? buildVerdictTabs(records) : [];

// Flow row only exists when the category has flow data (today: Hotends).
const flowCounts: Record<string, number> = { standard: 0, high: 0, extreme: 0 };
for (const r of records) {
  const fc = resolveFlowClass(flowClassOf(r));
  if (fc) flowCounts[fc.key]++;
}
const hasFlow = Object.values(flowCounts).some((n) => n > 0);

// Sort/filter data (src/scripts/hardware-view.ts). Every card carries what the page needs as data
// attributes, so the script never reads card text: name, brand slug, price, flow, Recommended rank,
// price band, and its position under each sort (data-o-<sort>), which the pre-paint script uses.
type Item = ViewItem & { r: any; band: string; o: Record<string, number> };
const items: Item[] = records.map((r: any, i: number) => ({
  r,
  name: String(r['Name']).trim(),
  brand: toSlug(String(r['Brand'] ?? '').trim()),
  price: num(priceOf(r)),
  flow: num(flowOf(r)),
  rank: i,
  verdict: showVerdict ? (resolveVerdict(r['Verdict'])?.key ?? '') : '',
  flowClass: resolveFlowClass(flowClassOf(r))?.key ?? '',
  band: '',
  o: {},
}));
const sorts = SORTS.filter((s) => !s.when || s.when(items))
  .map((s) => ({ ...s, label: SORT_TEXT[s.key]?.[0] ?? s.key, short: SORT_TEXT[s.key]?.[1] ?? s.key }));
for (const s of sorts) {
  if (s.key !== DEFAULT_SORT) sortItems(items, s.key).forEach((it, pos) => { it.o[s.key] = pos; });
}
const bands = chooseBands(items.flatMap((it) => (it.price === null ? [] : [it.price])));
for (const it of items) it.band = bands.find((b) => inBand(it.price, b)) ?? '';
const orderAttrs = (it: Item) => Object.fromEntries(Object.entries(it.o).map(([k, v]) => [`data-o-${k}`, v]));

// Filter options. Brand needs at least two brands; price needs at least two non-empty bands.
// Cards with no brand are never a brand option (they show while no brand is picked).
const coll = new Intl.Collator('en', { sensitivity: 'base', numeric: true });
const brandMap = new Map<string, { label: string; count: number }>();
for (const it of items) {
  if (!it.brand) continue;
  const b = brandMap.get(it.brand);
  if (b) b.count++;
  else brandMap.set(it.brand, { label: String(it.r['Brand']).trim(), count: 1 });
}
const brandOpts = brandMap.size >= 2
  ? [...brandMap].map(([value, b]) => ({ value, ...b })).sort((a, b) => coll.compare(a.label, b.label))
  : [];
const priceOpts = bands
  .map((b) => ({ value: b, label: bandLabel(b), count: items.filter((it) => it.band === b).length }))
  .filter((o) => o.count > 0);
const filterGroups = [
  ...(brandOpts.length ? [{ key: 'brand', label: 'Brand', multi: true, options: brandOpts }] : []),
  ...(priceOpts.length >= 2 ? [{ key: 'price', label: 'Price', multi: true, options: priceOpts }] : []),
];
// Phones: the flow filter moves from the bar into the Sort & filter sheet, as its first group.
const flowGroup = hasFlow ? [{
  key: 'flow', label: 'Flow', single: true,
  options: [{ value: '', label: 'All', count: records.length },
    ...FLOW_CLASSES.map((f) => ({ value: f.key, label: f.label, chip: f.chipLabel, count: flowCounts[f.key] }))],
}] : [];
const hasControls = records.length > 1 && (sorts.length > 1 || filterGroups.length > 0);
// What the URL may hold for each filter and sort; the page script and the pre-paint script both check it.
const viewCfg = {
  sort: sorts.map((s) => s.key),
  ...Object.fromEntries(filterGroups.map((g) => [g.key, g.options.map((o) => o.value)])),
};

// Pre-paint filter: the inline script at the top of the grid copies the URL's verdict, flow, sort,
// brand and price (checked against #hw-view-cfg) onto #hw-grid, and these rules hide non-matching
// cards as they stream in, before first paint. Brand and price hold space-separated lists, so a
// card hides when its value is not in the list (and cards with no value hide once one is picked).
const q = (v: string) => v.replace(/["\\]/g, '\\$&');
const prepaintCss = [
  ...verdictTabs.map((t: any) => `#hw-grid[data-verdict="${q(t.key)}"] .gf-card:not([data-verdict="${q(t.key)}"])`),
  ...FLOW_CLASSES.map((f) => `#hw-grid[data-flow="${f.key}"] .gf-card:not([data-flow="${f.key}"])`),
  ...filterGroups.flatMap((g) => {
    const attr = g.key === 'price' ? 'band' : g.key;
    return [
      ...g.options.map((o) => `#hw-grid[data-${g.key}]:not([data-${g.key}~="${q(o.value)}"]) .gf-card[data-${attr}="${q(o.value)}"]`),
      `#hw-grid[data-${g.key}] .gf-card[data-${attr}=""]`,
    ];
  }),
].map((sel) => `${sel}{display:none}`).join('')
  // A sorted grid stays invisible (still laid out, so nothing shifts) until the cards are in order:
  // WebKit can paint between the end of the grid and the inline reorder after it.
  + '#hw-grid[data-sort]:not([data-ordered]){visibility:hidden}';

// The two inline pre-paint scripts (top of the grid, right after it). They run on every load of
// every index, so they ship minified.
const prepaintStartJs = minify(`
(function () {
  var q = new URLSearchParams(location.search), g = document.getElementById('hw-grid'), c = {};
  try { c = JSON.parse(document.getElementById('hw-view-cfg').textContent); } catch (e) {}
  var v = q.get('verdict') || location.hash.slice(1), f = q.get('flow'), s = q.get('sort');
  if (v) g.dataset.verdict = v;
  if (f) g.dataset.flow = f;
  var w = q.get('view');
  if (w !== 'grid' && w !== 'list') { w = ''; try { w = localStorage.getItem('mm-hw-view'); } catch (e) {} }
  if (w === 'grid') g.dataset.view = 'grid';
  if (s && s !== 'recommended' && (c.sort || []).indexOf(s) > -1) g.dataset.sort = s;
  ['brand', 'price'].forEach(function (k) {
    var x = (q.get(k) || '').split(',').filter(function (y) { return (c[k] || []).indexOf(y) > -1; });
    if (x.length) g.dataset[k] = x.join(' ');
  });
})();
`);
const prepaintSortJs = minify(`
(function () {
  var g = document.getElementById('hw-grid'), s = g.dataset.sort;
  if (!s) return;
  var a = 'data-o-' + s, c = [].filter.call(g.children, function (e) { return e.hasAttribute(a); });
  c.sort(function (x, y) { return x.getAttribute(a) - y.getAttribute(a); });
  c.forEach(function (e) { g.appendChild(e); });
  g.dataset.ordered = '';
})();
`);

const noun = (n: number) => (n === 1 ? nounSingular : nounPlural);

const siteBase = Astro.site
  ? new URL(Astro.site).href.replace(/\/$/, '')
  : 'https://modernmakes.github.io';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: schemaName,
  url: `${siteBase}${basePath}`,
  itemListElement: records.map((r: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: r['Name'] as string,
    url: `${siteBase}${basePath}/${toSlug(r['Name'] as string)}`,
    description: (r['Verdict Label'] as string | undefined) ?? (r['Description'] as string | undefined) ?? '',
  })),
};
---
<Base title={title} description={description} heroPage={false} hasPageH1={true}>
  <Nav slot="nav" currentPath={navPath} />

  <header class="hot-hero">
    <div class="hot-hero-inner">
      <nav class="breadcrumb hot-hero-crumbs" aria-label="Breadcrumb">
        <a href={parent.href}>{parent.label}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{crumb}</span>
      </nav>
      <h1 class="hot-hero-title" data-nav-title>{heading}</h1>
      <p class="hot-hero-sub">{sub}</p>
      <!-- Relative time is computed in the browser (scripts/synced.js); hidden when missing or over 72 h old. -->
      <p class="hot-hero-fresh" id="hot-hero-fresh" data-synced={synced.synced ?? ''} hidden></p>
    </div>
  </header>

  <slot name="intro" />

  <!-- FILTER BAR: verdict tabs + flow row, one sticky unit under the nav.
       The sentinel sits just above it; the script watches it to set .stuck. -->
  <div class="gf-sentinel" id="gf-sentinel" aria-hidden="true"></div>
  <div class="gf-bar" id="gf-bar" data-route={route}>
    <div class="gf-bar-inner">
      <div class="gf-row">
      {showVerdict && <div class="gf-cats" role="group" aria-label="Filter by verdict">
        <button type="button" class="gf-tab is-active" data-f="verdict" data-v="" aria-pressed="true">
          All
          <span class="gf-badge" data-n>{records.length}</span>
        </button>
        {verdictTabs.map((t) => (
          <button type="button" class="gf-tab" data-f="verdict" data-v={t.key} data-label={t.label} aria-pressed="false">
            {t.label}
            <span class="gf-badge" data-n>{t.count}</span>
          </button>
        ))}
        <span class="gf-tab-ind" aria-hidden="true"></span>
      </div>}
      {hasControls && (
        <div class="gf-ctl">
          {/* Phone: one button opens the Sort & filter sheet. The badge counts non-default choices in it. */}
          <button type="button" class="gf-ctl-btn gf-ctl-phone" data-sheet="hw-view" data-haptic
                  aria-haspopup="dialog" aria-expanded="false" aria-controls="hw-view">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10" /><circle cx="16" cy="7" r="2" /><circle cx="8" cy="17" r="2" /></svg>
            <span>Sort &amp; filter</span>
            <span class="gf-ctl-n" data-ctl-n="all" aria-hidden="true" hidden></span><span class="sr-only" data-ctl-sr="all"></span>
          </button>
          {/* Phone row 2: the live result count beside the button (#hw-count announces it). */}
          <span class="gf-ctl-count" data-bar-count aria-hidden="true">{records.length} {noun(records.length)}</span>
          {/* Desktop: Sort and Filters menus, anchored popovers. */}
          <button type="button" class="gf-ctl-btn gf-ctl-desk" data-sheet="hw-sort"
                  aria-haspopup="dialog" aria-expanded="false" aria-controls="hw-sort">
            <span class="gf-ctl-k">Sort:</span> <span data-sort-label>{sorts[0].short}</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          </button>
          {filterGroups.length > 0 && (
            <button type="button" class="gf-ctl-btn gf-ctl-desk" data-sheet="hw-filters"
                    aria-haspopup="dialog" aria-expanded="false" aria-controls="hw-filters">
              <span>Filters</span>
              <span class="gf-ctl-n" data-ctl-n="filters" aria-hidden="true" hidden></span><span class="sr-only" data-ctl-sr="filters"></span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
            </button>
          )}
          {/* List / grid: one preference for every hardware index (localStorage mm-hw-view, ?view=). */}
          <div class="gf-view" role="radiogroup" aria-label="Layout">
            <button type="button" class="gf-view-btn is-active" role="radio" aria-checked="true" aria-label="List view" data-view="list"><Icon name="list" size={18} /></button>
            <button type="button" class="gf-view-btn" role="radio" aria-checked="false" aria-label="Grid view" data-view="grid" tabindex="-1"><Icon name="grid" size={18} /></button>
          </div>
        </div>
      )}
      </div>
      {hasFlow && (
        <div class="gf-flow" role="group" aria-label="Filter by flow class">
          <span class="gf-flow-lbl" aria-hidden="true">Flow</span>
          <button type="button" class="gf-flow-btn is-active" data-f="flow" data-v="" aria-pressed="true">
            All
            <span class="gf-flow-n" data-n>{records.length}</span>
          </button>
          {FLOW_CLASSES.map((f) => (
            <button type="button" class="gf-flow-btn" data-f="flow" data-v={f.key} data-label={f.chipLabel} aria-pressed="false" disabled={flowCounts[f.key] === 0}>
              {f.label}
              <span class="gf-flow-n" data-n>{flowCounts[f.key]}</span>
            </button>
          ))}
        </div>
      )}
    </div>
  </div>

  {/* Outside the sticky bar, so it scrolls away with the page. */}
  <slot name="afterFilters" />

  <section class="section gf-list-section">
    <div class="container">
      {/* Live count, then the active non-default choices as removable chips (built by the script). */}
      <div class="gf-status">
        <p class="gf-summary" id="hw-count" aria-live="polite" aria-atomic="true"
           data-noun-singular={nounSingular} data-noun-plural={nounPlural}>
          Showing {records.length} of {records.length} {noun(records.length)}
        </p>
        <div class="gf-active" id="hw-active" hidden>
          <ul class="gf-active-list" id="hw-active-list" aria-label="Active sort and filters"></ul>
          <button type="button" class="gf-clear-all" id="hw-clear-all">Clear all</button>
          <template id="hw-chip-x"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg></template>
        </div>
      </div>
      <script type="application/json" id="hw-view-cfg" set:html={JSON.stringify(viewCfg)}></script>
      {records.length > 0 ? (<>
        <style is:inline set:html={prepaintCss}></style>
        <div class="gf-list" id="hw-grid" data-view="list">
          <script is:inline set:html={prepaintStartJs}></script>
          {items.map((it, i: number) => {
            const r = it.r;
            const slug = toSlug(r['Name']);
            const v = showVerdict ? resolveVerdict(r['Verdict']) : null;
            const fc = resolveFlowClass(flowClassOf(r));
            const imgSrc = imageOf(r);
            const hasImg = imgSrc !== '';
            const brand = String(r['Brand'] ?? '').trim();
            const excerpt = String(excerptOf(r) ?? '').trim();
            const specChips = chips(r);
            return (
              <a href={`${basePath}/${slug}`} class="card gf-card" data-verdict={it.verdict} data-flow={it.flowClass}
                 data-name={it.name} data-brand={it.brand} data-price={it.price ?? ''} data-flow-n={it.flow ?? ''}
                 data-rank={it.rank} data-band={it.band} {...orderAttrs(it)}>
                <div class="card-img">
                  {/* The monogram is the base layer: it shows while the image loads and if a hotlinked image fails. */}
                  <TypeCover compact label={brand || it.name} />
                  <TypeCover />
                  {hasImg && (
                    <img src={imgSrc} alt="" width="112" height="112" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" onerror="this.parentElement.classList.add('card-img--failed')" />
                  )}
                </div>
                <div class="card-body">
                  <div class="card-cat">{brand}</div>
                  <h2 class="card-title">{r['Name']}</h2>
                  {excerpt && <p class="card-excerpt">{excerpt}</p>}
                  {specChips.length > 0 && <div class="gf-chips">{specChips.map((c) => <span class="spec-chip">{c}</span>)}</div>}
                  <div class="card-footer">
                    {v && <span class={`verdict ${v.cls}`}>{v.label}</span>}
                    {fc && <span class="flow-chip">{fc.label}<span class="gf-flow-sfx"> flow</span></span>}
                    {/* whole dollars, as on the detail page; no price: a community project (it has a source link) or simply unlisted */}
                    {it.price !== null
                      ? <span class="gf-price">~${Math.round(it.price)}</span>
                      : <span class="gf-price gf-price--none">{getSourceUrl(r) ? 'Community project' : 'No listed price'}</span>}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
        {/* A sorted URL paints sorted: put the cards in that sort's build-time order now, before the
            first frame (the page script would otherwise do it after load). */}
        <script is:inline set:html={prepaintSortJs}></script>
      </>) : (
        <p style="font-family:var(--fb);font-size:15px;color:var(--g2);padding:40px 0">
          No {nounPlural} listed yet — check back after the next Airtable sync.
        </p>
      )}
      <div class="gf-nomatch" id="hw-nomatch" hidden>
        <h2 class="gf-nomatch-title">Nothing matches these filters</h2>
        <p>No {nounPlural} are in that combination.</p>
        <button type="button" class="gf-clear" id="hw-clear">Clear all</button>
      </div>
    </div>
  </section>

  {hasControls && (
    <>
      {/* Phone (under 768px): everything in one sheet; changes apply live underneath, "Show N" closes it. */}
      <Sheet id="hw-view" title="Sort & filter" detent="medium">
        <HardwareViewControls ns="m" parts={['sort', 'filters']} sorts={sorts} groups={[...flowGroup, ...filterGroups]} defaultSort={DEFAULT_SORT} />
        <button slot="footer" type="button" class="hv-show" data-sheet-close data-show-n>Show {records.length} {noun(records.length)}</button>
      </Sheet>
      {/* Desktop: two anchored menus. */}
      <Sheet id="hw-sort" title="Sort" desktop="popover">
        <HardwareViewControls ns="s" parts={['sort']} sorts={sorts} groups={filterGroups} defaultSort={DEFAULT_SORT} />
      </Sheet>
      {filterGroups.length > 0 && (
        <Sheet id="hw-filters" title="Filters" desktop="popover">
          <HardwareViewControls ns="f" parts={['filters']} sorts={sorts} groups={filterGroups} defaultSort={DEFAULT_SORT} />
        </Sheet>
      )}
    </>
  )}

  <Footer slot="footer" />
  <script type="application/ld+json" slot="head" set:html={jsonLd(itemListSchema)}></script>
</Base>

<script>
  import { syncedLabel } from '../scripts/synced.js';
  import { DEFAULT_SORT, FILTERS, SORTS, matchesAll, sortItems, type FilterState, type ViewItem } from '../scripts/hardware-view';
  import { closeSheet, holdScroll } from '../scripts/sheet';
  const freshEl = document.getElementById('hot-hero-fresh');
  const freshText = freshEl && syncedLabel(freshEl.dataset.synced);
  if (freshEl && freshText) { freshEl.textContent = freshText; freshEl.hidden = false; }

  // ── State: one sort and the registry's filters (an empty list = no filter) ──
  type Card = ViewItem & { el: HTMLElement; o: Record<string, number> };
  const state = { view: document.getElementById('hw-grid')?.dataset.view === 'grid' ? 'grid' : 'list', sort: DEFAULT_SORT, f: Object.fromEntries(FILTERS.map((f) => [f.key, [] as string[]])) as FilterState };
  const FILTER = Object.fromEntries(FILTERS.map((f) => [f.key, f]));

  const bar      = document.getElementById('gf-bar')!;
  const sentinel = document.getElementById('gf-sentinel')!;
  const grid     = document.getElementById('hw-grid');
  const region   = grid?.parentElement ?? null; // count line + grid
  const countEl  = document.getElementById('hw-count');
  const noMatch  = document.getElementById('hw-nomatch');
  const activeWrap = document.getElementById('hw-active');
  const activeList = document.getElementById('hw-active-list');
  const viewSheet  = document.getElementById('hw-view') as HTMLDialogElement | null;
  const showNs     = Array.from(document.querySelectorAll<HTMLElement>('[data-show-n]'));
  const sortLabels = Array.from(document.querySelectorAll<HTMLElement>('[data-sort-label]'));
  const ctlNs      = Array.from(document.querySelectorAll<HTMLElement>('[data-ctl-n]'));
  const barCounts  = Array.from(document.querySelectorAll<HTMLElement>('[data-bar-count]'));
  const nounS    = countEl?.dataset.nounSingular ?? 'item';
  const nounP    = countEl?.dataset.nounPlural ?? 'items';
  const cats     = document.querySelector<HTMLElement>('.gf-cats');
  const ind      = document.querySelector<HTMLElement>('.gf-tab-ind');
  const tabs     = Array.from(document.querySelectorAll<HTMLButtonElement>('.gf-tab'));
  const reduced  = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const noun     = (n: number) => (n === 1 ? nounS : nounP);

  // Cards in Recommended order, described entirely by their build-time data attributes.
  const numAttr = (v?: string) => (v ? Number(v) : null);
  const cards: Card[] = Array.from(document.querySelectorAll<HTMLElement>('.gf-card'), (el) => {
    const d = el.dataset, o: Record<string, number> = {};
    for (const s of SORTS) { const a = el.getAttribute(`data-o-${s.key}`); if (a !== null) o[s.key] = +a; }
    return { el, o, name: d.name ?? '', brand: d.brand ?? '', price: numAttr(d.price), flow: numAttr(d.flowN), rank: +(d.rank ?? 0), verdict: d.verdict ?? '', flowClass: d.flow ?? '', band: d.band ?? '' };
  }).sort((a, b) => a.rank - b.rank);
  const total = cards.length;

  // Every option control (verdict tab, flow button, sort radio, filter chip) is [data-f][data-v];
  // data-v="" is a filter's "All". Its count, if any, is the [data-n] inside it.
  const ctrls = Array.from(document.querySelectorAll<HTMLElement>('[data-f][data-v]'));
  // The values this category offers, from the build (sorts it shows, brand slugs, price bands).
  let cfg: Record<string, string[]> = {};
  try { cfg = JSON.parse(document.getElementById('hw-view-cfg')?.textContent || '{}'); } catch {}
  const sortOk = (k: string) => k === DEFAULT_SORT || !!cfg.sort?.includes(k);
  const valueOk = (k: string, v: string) => !!cfg[k]?.includes(v) || ctrls.some((c) => c.dataset.f === k && c.dataset.v === v);

  // Stable order for the current sort: the build's ranks when it wrote them, the comparator otherwise.
  const ordered = (): Card[] => {
    const k = state.sort;
    if (k === DEFAULT_SORT) return cards;
    return cards.every((c) => k in c.o) ? cards.slice().sort((a, b) => a.o[k] - b.o[k]) : sortItems(cards, k);
  };

  // One layout step per filter change. A delayed hide (fade, then display:none)
  // changes the page height twice, which is what made a stuck bar twitch.
  // Inside a view transition the transition does the fade, so no opacity step.
  function showCard(card: HTMLElement, fade = true) {
    if (!card.classList.contains('gf-hidden')) return;
    card.classList.remove('gf-hidden');
    if (!fade) return;
    card.style.opacity = '0';
    void card.offsetHeight;
    card.style.opacity = '1';
  }
  const hideCard = (card: HTMLElement) => card.classList.add('gf-hidden');

  // ── URL ── ?verdict=&flow=&sort=&brand=a,b&price= (old #verdict links still work on load).
  // Invalid values are ignored.
  let hashConsumed = false;
  let viewInUrl = ['grid', 'list'].includes(new URLSearchParams(location.search).get('view') ?? ''); // ?view= is kept once present or toggled
  function readUrl() {
    const q = new URLSearchParams(location.search);
    const hash = location.hash.slice(1);
    for (const f of FILTERS) {
      let raw = q.get(f.key);
      if (f.key === 'verdict' && raw === null && hash) raw = hash;
      if (!raw) continue;
      let vals = [...new Set(raw.split(','))].filter((v) => v && valueOk(f.key, v));
      if (!f.multi) vals = vals.slice(0, 1);
      state.f[f.key] = vals;
      if (f.key === 'verdict' && vals.length && !q.has('verdict')) hashConsumed = true;
    }
    const s = q.get('sort');
    if (s && sortOk(s)) state.sort = s;
  }
  function writeUrl() {
    const q = new URLSearchParams(location.search);
    for (const k of ['verdict', 'flow', 'brand', 'price']) state.f[k].length ? q.set(k, state.f[k].join(',')) : q.delete(k);
    state.sort === DEFAULT_SORT ? q.delete('sort') : q.set('sort', state.sort);
    if (viewInUrl) q.set('view', state.view);
    const qs = q.toString().replace(/%2C/gi, ','); // brand=a,b reads better than a%2Cb
    history.replaceState(null, '', location.pathname + (qs ? `?${qs}` : '') + (hashConsumed ? '' : location.hash));
  }

  // Each option's count is what you'd see if you picked it, given the other filters.
  // Zero-match options are disabled unless they are the current one.
  function setOn(el: HTMLElement, on: boolean) {
    if (el instanceof HTMLInputElement) { el.checked = on; return; }
    el.classList.toggle('is-active', on);
    el.setAttribute('aria-pressed', String(on));
  }
  function syncControls() {
    for (const el of ctrls) {
      const k = el.dataset.f!, v = el.dataset.v!;
      if (k === 'sort') { setOn(el, state.sort === v); continue; }
      const f = FILTER[k];
      if (!f) continue;
      const cur = state.f[k];
      const on = v === '' ? cur.length === 0 : cur.includes(v);
      const n = cards.filter((c) => matchesAll(c, state.f, k) && (v === '' || f.test(c, [v]))).length;
      setOn(el, on);
      (el as HTMLButtonElement | HTMLInputElement).disabled = n === 0 && !on;
      const badge = el.querySelector('[data-n]') ?? el.parentElement?.querySelector('[data-n]');
      if (badge) badge.textContent = String(n);
    }
    moveIndicator(true);
  }

  // Sliding underline under the active verdict tab: one element, transform only
  // (translate to the tab, scaleX of a 1px line to its width). First placement and
  // resizes jump; tab changes slide (--dur-base / --ease-move, none under reduced motion).
  function moveIndicator(animate: boolean) {
    const a = tabs.find((t) => t.classList.contains('is-active'));
    if (!ind || !cats || !a) return;
    if (!animate) ind.style.transition = 'none';
    ind.style.transform = `translate(${a.offsetLeft}px, ${a.offsetTop + a.offsetHeight - 2}px) scaleX(${a.offsetWidth})`;
    if (!animate) { void ind.offsetWidth; ind.style.transition = ''; }
    cats.classList.add('has-ind');
  }

  // Label for a value: the control's data-label (sort short name, brand, band, verdict, flow class).
  const labelOf = (k: string, v: string) => ctrls.find((c) => c.dataset.f === k && c.dataset.v === v)?.dataset.label ?? v;
  // Filters each trigger's panel holds (its badge counts them): the phone sheet has flow too, the
  // desktop Filters menu only brand, price and anything added later.
  const keysIn = (id: string) => [...new Set(ctrls.filter((c) => c instanceof HTMLInputElement && c.dataset.f !== 'sort' && c.closest(`#${id}`)).map((c) => c.dataset.f!))];
  const sheetKeys: Record<string, string[]> = { all: keysIn('hw-view'), filters: keysIn('hw-filters') };

  // Active non-default choices as removable chips, then the trigger badges and labels.
  const X = document.getElementById('hw-chip-x') as HTMLTemplateElement | null; // the chip's × icon
  function renderChrome(visible: number) {
    const active: [string, string, string][] = [];
    if (state.sort !== DEFAULT_SORT) active.push(['sort', state.sort, `Sort: ${labelOf('sort', state.sort)}`]);
    for (const f of FILTERS) for (const v of state.f[f.key]) active.push([f.key, v, labelOf(f.key, v)]);
    if (activeList && activeWrap) {
      activeList.replaceChildren(...active.map(([k, v, label]) => {
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'gf-chip';
        b.dataset.rf = k;
        b.dataset.rv = v;
        b.setAttribute('aria-label', `Remove ${label}`);
        b.textContent = label;
        if (X) b.append(X.content.cloneNode(true));
        li.append(b);
        return li;
      }));
      activeWrap.hidden = active.length === 0;
    }
      for (const el of ctlNs) {
      const which = el.dataset.ctlN === 'all' ? 'all' : 'filters';
      const n = (sheetKeys[which] ?? []).reduce((m, k) => m + state.f[k].length, 0) + (which === 'all' && state.sort !== DEFAULT_SORT ? 1 : 0);
      el.textContent = String(n);
      el.hidden = n === 0;
      const sr = el.parentElement?.querySelector<HTMLElement>(`[data-ctl-sr="${el.dataset.ctlN}"]`);
      if (sr) sr.textContent = n ? `, ${n} active` : '';
    }
    for (const el of sortLabels) el.textContent = labelOf('sort', state.sort);
    for (const el of showNs) el.textContent = `Show ${visible} ${noun(visible)}`;
    for (const el of barCounts) el.textContent = visible === total ? `${total} ${noun(total)}` : `${visible} of ${total} ${noun(total)}`;
  }

  // Filter, order, count. `fade`: shown cards fade in (not inside a view transition).
  function render(fade: boolean) {
    let visible = 0;
    for (const c of cards) {
      if (matchesAll(c, state.f)) { showCard(c.el, fade); visible++; }
      else hideCard(c.el);
    }
    if (grid) {
      const order = ordered();
      const now = grid.querySelectorAll(':scope > .gf-card');
      if (order.some((c, i) => now[i] !== c.el)) grid.append(...order.map((c) => c.el));
      if (state.sort === DEFAULT_SORT) delete grid.dataset.sort; else grid.dataset.sort = state.sort;
      grid.dataset.ordered = ''; // releases the pre-paint guard even if the inline reorder never ran
    }
    if (countEl) countEl.textContent = `Showing ${visible} of ${total} ${noun(total)}`;
    if (noMatch) noMatch.hidden = visible > 0 || total === 0;
    renderChrome(visible);
    syncControls();
  }

  // Brings the results' top just under a stuck bar (never down, never when it is already below it).
  function alignResults() {
    if (!region || !bar.classList.contains('stuck')) return;
    const barBottom = bar.getBoundingClientRect().bottom;
    const regionTop = region.getBoundingClientRect().top;
    if (regionTop < barBottom) window.scrollTo({ top: Math.round(scrollY + regionTop - barBottom + 4), behavior: 'instant' });
  }

  // Changes made inside the phone sheet are aligned when it closes (the page is locked while open).
  let alignOnClose = false;
  viewSheet?.addEventListener('close', () => { if (alignOnClose) { alignOnClose = false; alignResults(); } });

  // ── GA4 ── One hardware_view_change per settled change of each control, sent 800ms after the
  // last change (or when the page is left), so running through options in the sheet sends one
  // event per control instead of one per step. A change undone before it settles sends nothing.
  const gaKeys = ['sort', ...FILTERS.map((f) => f.key)];
  const gaValue = (k: string) => (k === 'sort' ? state.sort : state.f[k].join(',') || 'all');
  const gaSent: Record<string, string> = {};
  let gaTimer = 0;
  function gaFlush() {
    clearTimeout(gaTimer);
    gaTimer = 0;
    const gtag = (window as any).gtag;
    for (const k of gaKeys) {
      const v = gaValue(k);
      if (v === gaSent[k]) continue;
      gaSent[k] = v;
      if (typeof gtag === 'function') gtag('event', 'hardware_view_change', { category: bar.dataset.route ?? '', control: k, value: v });
    }
  }
  addEventListener('pagehide', () => { if (gaTimer) gaFlush(); });

  function apply(fromTap: boolean, after?: () => void) {
    clearTimeout(gaTimer);
    gaTimer = window.setTimeout(gaFlush, 800);
    // With a sheet or menu open, cards change in place, without the view transition: it would draw
    // the moving cards over the open panel and hold input for its duration. A keyboard change in a
    // menu doesn't animate either (it only happens with the menu open).
    const open = document.querySelector<HTMLDialogElement>('dialog.sheet[open]');
    // Anti-jitter: while the bar is stuck, bring the grid's top just under it before the card count
    // changes, so the page never has to clamp scrollY mid-filter. A popover stays open through it;
    // a modal sheet locks the page, so that alignment waits for it to close.
    if (fromTap && open && open.dataset.mode !== 'popover') alignOnClose = true;
    else if (fromTap) { if (open) holdScroll(); alignResults(); }
    const vt = fromTap && !open && typeof document.startViewTransition === 'function' && !reduced();
    writeUrl();
    if (!vt) { render(true); after?.(); return; }
    vtRun(() => render(false), after);
  }

  // Cards filter and move inside a same-document view transition. The scroll step has already
  // happened, outside it. Names exist only for the transition.
  function vtRun(update: () => void, after?: () => void) {
    const html = document.documentElement;
    cards.forEach((c, i) => { c.el.style.viewTransitionName = `gf-card-${i}`; });
    html.classList.add('vt-filter');
    const t = document.startViewTransition(update);
    t.updateCallbackDone.then(() => after?.(), () => after?.());
    t.finished.finally(() => {
      cards.forEach((c) => { c.el.style.viewTransitionName = ''; });
      html.classList.remove('vt-filter');
    });
  }

  // ── List / grid ── data-view on #hw-grid is the whole layout switch (CSS only). The pre-paint
  // script already set it from ?view= or localStorage; this keeps the toggle, URL and storage in step.
  const viewBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.gf-view-btn'));
  function syncView() {
    if (grid) grid.dataset.view = state.view;
    for (const b of viewBtns) {
      const on = b.dataset.view === state.view;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-checked', String(on));
      b.tabIndex = on ? 0 : -1;
    }
  }
  function setView(v: string) {
    if (v === state.view) return;
    state.view = v; // before writeUrl below; the DOM swap may run later, inside the transition
    const swap = syncView;
    const open = document.querySelector('dialog.sheet[open]');
    if (typeof document.startViewTransition === 'function' && !reduced() && !open) vtRun(swap); else swap();
    viewInUrl = true;
    writeUrl();
    try { localStorage.setItem('mm-hw-view', v); } catch {}
    const gtag = (window as any).gtag;
    if (typeof gtag === 'function') gtag('event', 'hardware_view_mode', { category: bar.dataset.route ?? '', view: v });
  }
  viewBtns.forEach((b, i) => {
    b.addEventListener('click', () => setView(b.dataset.view!));
    // Radiogroup keys: arrows move and select, as native radios do.
    b.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      const n = viewBtns[(i + d + viewBtns.length) % viewBtns.length];
      setView(n.dataset.view!);
      n.focus();
    });
  });

  // Bar buttons (verdict tabs, flow): one value at a time, "" = All.
  for (const el of ctrls) {
    if (!(el instanceof HTMLButtonElement)) continue;
    el.addEventListener('click', () => {
      const k = el.dataset.f!, v = el.dataset.v!;
      state.f[k] = v ? [v] : [];
      apply(true);
    });
  }

  // Sheet and menu options (radios and checkboxes). Every copy is kept in step by syncControls.
  let pointerAt = -1e9;
  addEventListener('pointerdown', (e) => { pointerAt = e.timeStamp; }, true);
  for (const el of ctrls) {
    if (!(el instanceof HTMLInputElement)) continue;
    el.addEventListener('change', (e) => {
      const k = el.dataset.f!, v = el.dataset.v!;
      if (k === 'sort') {
        if (!el.checked) return;
        state.sort = v;
        // The desktop Sort menu works like a menu: a click picks and closes it (at once, so the
        // cards can animate). Arrow keys move through the options with it open; Enter closes it.
        const menu = el.closest<HTMLDialogElement>('dialog');
        if (menu?.dataset.mode === 'popover' && e.timeStamp - pointerAt < 1000) closeSheet(menu, true);
      } else {
        const rest = state.f[k].filter((x) => x !== v);
        state.f[k] = !el.checked ? rest : !v ? [] : FILTER[k]?.multi ? [...rest, v] : [v]; // v "" = All (radio groups)
      }
      apply(true);
    });
    if (el.dataset.f === 'sort') el.addEventListener('keydown', (e) => {
      const menu = el.closest<HTMLDialogElement>('dialog');
      if (e.key === 'Enter' && menu?.dataset.mode === 'popover') { e.preventDefault(); closeSheet(menu); }
    });
  }

  // The visible sort & filter trigger (phone or desktop), for focus after everything is cleared.
  const trigger = () => Array.from(document.querySelectorAll<HTMLElement>('.gf-ctl-btn')).find((b) => b.offsetParent !== null);
  function clearAll() {
    for (const f of FILTERS) state.f[f.key] = [];
    state.sort = DEFAULT_SORT;
    apply(true, () => trigger()?.focus({ preventScroll: true }));
  }
  document.getElementById('hw-clear')?.addEventListener('click', clearAll);
  document.getElementById('hw-clear-all')?.addEventListener('click', clearAll);

  // Removing one chip: focus moves to the chip that takes its place, else Clear all's target.
  activeList?.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('.gf-chip');
    if (!b) return;
    const k = b.dataset.rf!, v = b.dataset.rv!;
    const i = Array.from(activeList.querySelectorAll('.gf-chip')).indexOf(b);
    if (k === 'sort') state.sort = DEFAULT_SORT;
    else state.f[k] = state.f[k].filter((x) => x !== v);
    apply(true, () => {
      const left = activeList.querySelectorAll<HTMLElement>('.gf-chip');
      (left[Math.min(i, left.length - 1)] ?? trigger())?.focus({ preventScroll: true });
    });
  });

  // .stuck = the bar is pinned under the nav. IntersectionObserver on a 1px
  // sentinel just above it, no scroll listener. The root margin is the compact
  // nav height, so it is rebuilt when the nav breakpoints change.
  let io: IntersectionObserver | undefined;
  function watchStuck() {
    io?.disconnect();
    const navH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-h')) || 56;
    io = new IntersectionObserver(
      ([e]) => bar.classList.toggle('stuck', !e.isIntersecting && e.boundingClientRect.top < navH),
      { rootMargin: `-${navH}px 0px 0px 0px` },
    );
    io.observe(sentinel);
  }
  ['(max-width: 1023px)', '(max-width: 767px)'].forEach((q) =>
    matchMedia(q).addEventListener('change', watchStuck));
  watchStuck();

  readUrl();
  syncView();
  for (const k of gaKeys) gaSent[k] = gaValue(k); // what the URL opened with is not a change
  render(false);
  moveIndicator(false);
  document.fonts?.ready.then(() => moveIndicator(false));
  addEventListener('resize', () => moveIndicator(false), { passive: true });
  // The pre-paint attributes did their job; .gf-hidden takes over from here.
  if (grid) { delete grid.dataset.verdict; delete grid.dataset.flow; delete grid.dataset.brand; delete grid.dataset.price; }
</script>

<style is:global>
/* ── DARK PAGE HEADER ── tokenised; white text kept ≥4.5:1 on --black ── */
.hot-hero {
  background: var(--black);
  padding: 48px 0 44px;
  border-bottom: 1px solid rgba(255,255,255,.08);
}
.hot-hero-inner {
  max-width: var(--max-w, 1200px);
  margin: 0 auto;
  padding: 0 40px;
}
.hot-hero-crumbs {
  display: flex;
  gap: 8px;
  align-items: center;
  margin-bottom: 16px;
}
.hot-hero-crumbs a {
  color: rgba(255,255,255,.62);
  transition: color .15s;
}
@media (hover: hover) and (pointer: fine) {
  .hot-hero-crumbs a:hover { color: var(--accent); }
}
.hot-hero-crumbs span[aria-current] { color: rgba(255,255,255,.72); }
.hot-hero-crumbs span[aria-hidden] { color: var(--on-dark-muted); }
.hot-hero-title {
  font-family: var(--fd);
  font-size: 48px;
  font-weight: 800;
  color: #fff;
  line-height: 1;
  letter-spacing: -.5px;
  margin: 0 0 12px;
  text-wrap: balance;
}
.hot-hero-sub {
  font-family: var(--fb);
  font-size: 15px;
  color: rgba(255,255,255,.7);
  line-height: 1.7;
  max-width: 480px;
  margin: 0;
}

.hot-hero-fresh {
  font-family: var(--fm);
  font-size: 11px;
  color: var(--on-dark-muted);
  margin: 14px 0 0;
  line-height: 1.4;
  min-height: 1.4em;
}
/* The label is filled in by the browser; its line is reserved so filling it never pushes the page down. */
.hot-hero-fresh[hidden] { display: block; visibility: hidden; }


/* ── HARDWARE FILTER BAR: verdict tabs + flow row as one sticky unit ──
   .stuck swaps the background and adds a shadow. It must never touch height,
   padding or font size: a bar that resizes while pinned moves the grid under
   the finger. */
html { overflow-anchor: none; }
.gf-sentinel { height: 1px; margin-bottom: -1px; pointer-events: none; }
.gf-bar {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: calc(env(safe-area-inset-top, 0px) + var(--nav-h));
  z-index: 10;
  transition: background-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
}
.gf-bar.stuck {
  background: color-mix(in srgb, var(--surface) 94%, transparent);
  -webkit-backdrop-filter: saturate(160%) blur(18px);
  backdrop-filter: saturate(160%) blur(18px);
  box-shadow: 0 6px 18px color-mix(in srgb, var(--black) 8%, transparent);
}
.gf-bar-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px;
}
.gf-tab:disabled, .gf-flow-btn:disabled { opacity: .4; cursor: default; }

.gf-flow {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 0;
  border-top: 1px solid var(--border);
  overflow-x: auto;
  overflow-y: hidden;
  overscroll-behavior-x: contain;
  scrollbar-width: none;
}
.gf-flow::-webkit-scrollbar { display: none; }
.gf-flow-lbl {
  flex-shrink: 0;
  margin-right: 4px;
  font-family: var(--fm);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--g1);
}
.gf-flow-btn {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 44px; /* hit target (Apple HIG) */
  padding: 0 14px;
  font-family: var(--fu);
  font-size: 13px;
  font-weight: 600;
  color: var(--g1);
  background: var(--surface);
  border: 1px solid var(--border-s);
  border-radius: var(--radius-sm);
  cursor: pointer;
  white-space: nowrap;
  transition: background-color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), var(--press-release);
}
.gf-flow-n { font-family: var(--fm); font-size: 10px; font-weight: 500; color: var(--g1); }
/* Pressed state is ink fill, not orange: orange stays on the verdict tab underline (Pointer Rule). */
.gf-flow-btn[aria-pressed="true"] { background: var(--black); border-color: var(--black); color: var(--surface); }
.gf-flow-btn[aria-pressed="true"] .gf-flow-n { color: var(--on-dark-soft); }
@media (hover: hover) and (pointer: fine) {
  .gf-flow-btn:not([aria-pressed="true"]):not(:disabled):hover { border-color: var(--black); color: var(--black); }
}

.gf-summary {
  font-family: var(--fm);
  font-size: 12px;
  color: var(--g1);
  padding: 16px 0 12px;
  margin: 0;
}
.gf-card {
  opacity: 1;
  transition: opacity 0.15s ease, border-color .15s, transform .15s, var(--press-release);
}
.gf-card.gf-hidden { display: none; }
/* ── LIST ROWS (every width) ──
   One column up to 899px with a 96px square thumb, two columns of rows from 900px with 112px.
   A row is thumb | body: brand (mono), name on one line, then verdict badge, flow chip and price,
   the price pushed right. Titles stay <h2> for heading navigation. Price is data (Mono-Is-Data),
   ink not orange (Pointer Rule). The filter script only reads data attributes, so none of this
   is known to it; .gf-hidden and the pre-paint rules hide whole rows. */
