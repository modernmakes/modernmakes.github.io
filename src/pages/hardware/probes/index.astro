---
import HardwareIndex from '../../../components/HardwareIndex.astro';
import records from '../../../data/hardware/bed-probes.json';

const chips = (r: any) => [
  r['Type'] ? String(r['Type']) : null,
  r['Price (USD)'] != null ? `~$${r['Price (USD)']}` : null,
].filter(Boolean) as string[];
---
<HardwareIndex
  records={records}
  route="probes"
  categoryLabel="BED PROBE"
  crumb="Bed Probes"
  heading="Bed Probes"
  sub="Inductive, nozzle-contact, and eddy-current probes. Repeatability, Klipper support, and install difficulty."
  nounSingular="probe"
  nounPlural="probes"
  title="Best Bed Probes for Voron & Klipper Printers"
  description="Bed probe specs, repeatability, Klipper support, and where to buy — eddy-current, hall-effect, and nozzle-contact probes for CoreXY builds."
  schemaName="Best Bed Probes for Voron & Klipper Printers"
  chips={chips}
/>
