---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
const currentPath = '/voron/motion-system';

const products = [
  {
    id: 'ldo-motor-kit',
    name: 'LDO Motor Kit',
    brand: 'LDO',
    price: 65,
    priceNote: 'per kit',
    badge: { label: 'TOP PICK', cls: 'verdict-best' },
    specs: ['NEMA17 high-temp', 'BOM spec', 'Voron-certified'],
    description: 'The official BOM-recommended motor kit. LDO\'s Voron-edition steppers are wound for 60°C+ chamber temps — standard motors can demagnetize in an enclosed, heated build. Pre-matched A/B and Z motor sets available for both printer sizes.',
    compatible: '2.4,trident',
    vendor: 'Fabreeko',
    vendorUrl: '#',
  },
  {
    id: 'fabreeko-motors',
    name: 'Fabreeko Steppers',
    brand: 'Fabreeko',
    price: 55,
    priceNote: 'per kit',
    badge: { label: 'COMMUNITY FAV', cls: 'verdict-comm' },
    specs: ['NEMA17 high-temp', 'High holding torque', 'Community validated'],
    description: 'Fabreeko\'s house-brand high-temp motors have become the community-favorite alternative to LDO. Slightly lower price with comparable high-temperature ratings. Strong Voron Discord consensus on long-term reliability.',
    compatible: '2.4,trident',
    vendor: 'Fabreeko',
    vendorUrl: '#',
  },
  {
    id: 'gates-gt2-belt',
    name: 'Gates GT2 6mm Belt',
    brand: 'Gates',
    price: 8,
    priceNote: 'per meter',
    badge: { label: 'POPULAR', cls: 'verdict-rec' },
    specs: ['6mm width', 'GT2 pitch', 'BOM spec'],
    description: 'The BOM-specified belt for all Voron motion systems. Gates is the reference manufacturer — cheap clones stretch inconsistently and cause resonance artifacts. Buy per-meter from a trusted supplier. A 2.4 350 needs roughly 4m total.',
    compatible: '2.4,trident',
    vendor: 'West3D',
    vendorUrl: '#',
  },
  {
    id: 'mrw-rails',
    name: 'MGN9H / MGN12H Rails',
    brand: 'Mandala Rose Works',
    price: 25,
    priceNote: 'per rail, avg',
    badge: { label: 'TOP PICK', cls: 'verdict-best' },
    specs: ['Prepped & cleaned', 'MGN9H / MGN12H', '$15–35 range'],
    description: 'Mandala Rose Works pre-cleans and inspects every rail before shipping — out-of-spec carriage play and contamination are the two biggest rail quality issues, and MRW eliminates both. The Voron community standard for linear rails.',
    compatible: '2.4,trident',
    vendor: 'Mandala Rose Works',
    vendorUrl: '#',
  },
];
---
<Base hasPageH1={true} title="Motion System Parts for Voron 2.4 & Trident" description="Motors, belts, and linear rails for Voron 2.4 and Trident builds. LDO motor kits, Gates GT2 belts, and Mandala Rose Works rails — BOM-accurate sourcing guide.">
  <Nav slot="nav" currentPath={currentPath} />

  <!-- HEADER -->
  <div style="background:var(--black);padding:40px 0">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px">
        <a href="/" style="font-size:11px;color:rgba(255,255,255,.3);font-family:'JetBrains Mono',monospace">Home</a>
        <span style="color:rgba(255,255,255,.2)">/</span>
        <a href="/voron" style="font-size:11px;color:rgba(255,255,255,.3);font-family:'JetBrains Mono',monospace">Voron</a>
        <span style="color:rgba(255,255,255,.2)">/</span>
        <span style="font-size:11px;color:rgba(255,255,255,.55);font-family:'JetBrains Mono',monospace">Motion System</span>
      </div>
      <div class="eyebrow" style="margin-bottom:10px">Voron · Motion System</div>
      <h1 style="font-family:'Barlow Condensed',sans-serif;font-size:48px;font-weight:800;color:#fff;line-height:1;letter-spacing:-.5px;margin-bottom:12px">Motion System for Voron 2.4 &amp; Trident</h1>
      <p style="font-family:'Lora',serif;font-size:15px;color:rgba(255,255,255,.45);line-height:1.7;max-width:560px;margin-bottom:20px">Motors, belts, and linear rails form the mechanical backbone of a Voron. The BOM is well-specified — the main decisions are sourcing quality components, not choosing alternatives. This page covers what matters and where to get it.</p>
    </div>
  </div>

  <!-- MODEL CONTEXT BAR -->
  <div style="background:var(--surface);border-bottom:1px solid var(--border);padding:12px 0">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div class="model-context-bar" id="model-context">
        <span class="model-context-label">Showing parts for:</span>
        <span id="active-model-label" class="model-context-value">Voron 2.4</span>
        <a href="/voron" class="model-context-switch">Switch model →</a>
      </div>
    </div>
  </div>

  <!-- CONTEXT CALLOUT -->
  <div style="background:#f0efe9;border-bottom:1px solid var(--border);padding:20px 0">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div class="callout callout-orange" style="margin:0">
        <strong>Don't cheap out on motors or rails</strong>
        High-temp steppers aren't optional in an enclosed Voron — standard motors demagnetize above ~50°C chamber temp. Cheap linear rails have loose carriages and contamination that appear as layer artifacts and ringing that no input shaper tune can fix. The BOM specs exist for a reason.
      </div>
    </div>
  </div>

  <!-- PRODUCTS -->
  <section class="section" aria-label="Voron motion system products">
    <div class="container">
      <div class="section-head">
        <h2 class="section-head-label">Motion system components</h2>
        <span style="font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--g2)">{products.length} products</span>
      </div>
      <div class="grid-3">
        {products.map(product => (
          <div class="product-card" data-compatible={product.compatible}>
            <div class="product-card-img" style="background:linear-gradient(135deg,#1e1e1e,#111);height:140px;display:flex;align-items:center;justify-content:center">
              <div style="text-align:center">
                <div style="font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:800;color:rgba(255,255,255,.15)">{product.brand}</div>
                <div style="font-family:'Barlow Condensed',sans-serif;font-size:16px;font-weight:700;color:rgba(255,255,255,.1)">{product.name}</div>
              </div>
            </div>
            <div class="product-card-body">
              <span class={`verdict-badge ${product.badge.cls}`}>{product.badge.label}</span>
              <div class="product-card-brand">{product.brand}</div>
              <div class="product-card-name">{product.name}</div>
              <div class="product-card-specs">
                {product.specs.map(s => <span class="spec-chip">{s}</span>)}
              </div>
              <p style="font-family:'Lora',serif;font-size:12px;color:var(--g1);line-height:1.65;margin-bottom:10px">{product.description}</p>
              <a href={product.vendorUrl} class="btn-buy" target="_blank" rel="noopener sponsored">
                Buy at {product.vendor} →
              </a>
              <div class="product-card-footer" style="margin-top:12px">
                <div>
                  <span class="product-card-price">${product.price}</span>
                  <span style="font-size:10px;color:var(--g2);margin-left:4px">{product.priceNote}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p style="font-size:11px;color:var(--g2);margin-top:20px;font-family:'Barlow',sans-serif">Affiliate links used — Modern Makes may earn a commission on purchases. This doesn't affect our recommendations. <a href="/about#affiliate" style="color:var(--accent)">See disclosure.</a></p>
    </div>
  </section>

  <!-- RAIL SPEC REFERENCE TABLE -->
  <section class="section" style="background:#fff;border-top:1px solid var(--border)" aria-label="Rail spec reference">
    <div class="container">
      <div class="section-head">
        <h2 class="section-head-label">Rail specification by axis</h2>
      </div>
      <div style="background:var(--bg);border-radius:10px;overflow:hidden;border:1px solid var(--border)">
        <table style="width:100%;border-collapse:collapse;font-size:12px;font-family:'Barlow',sans-serif">
          <thead>
            <tr style="background:var(--black)">
              <th style="text-align:left;padding:10px 16px;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.4);border-right:1px solid rgba(255,255,255,.08)">Axis</th>
              {['Rail type','250 build','300 build','350 build','Qty'].map(h => (
                <th style="text-align:center;padding:10px 12px;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.4)">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {[
              { axis:'X (gantry)',         type:'MGN9H',  s250:'200mm', s300:'250mm', s350:'300mm', qty:'1' },
              { axis:'Y (gantry)',          type:'MGN9H',  s250:'200mm', s300:'250mm', s350:'300mm', qty:'2' },
              { axis:'Z — Voron 2.4',       type:'MGN12H', s250:'250mm', s300:'300mm', s350:'350mm', qty:'4' },
              { axis:'Z — Voron Trident',   type:'MGN12H', s250:'200mm', s300:'250mm', s350:'300mm', qty:'3' },
            ].map((row, i) => (
              <tr style={`border-bottom:1px solid var(--border);background:${i%2===0 ? '#fff' : 'var(--bg)'}`}>
                <td style="padding:10px 16px;font-weight:600;color:var(--black);border-right:1px solid var(--border)">{row.axis}</td>
                <td style="text-align:center;padding:10px 12px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--g1)">{row.type}</td>
                <td style="text-align:center;padding:10px 12px;color:var(--g1)">{row.s250}</td>
                <td style="text-align:center;padding:10px 12px;color:var(--g1)">{row.s300}</td>
                <td style="text-align:center;padding:10px 12px;color:var(--g1)">{row.s350}</td>
                <td style="text-align:center;padding:10px 12px;font-weight:600;color:var(--black)">{row.qty}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="font-size:11px;color:var(--g2);margin-top:10px">Rail lengths are approximate — verify against your specific frame size in the official Voron BOM before ordering.</p>
    </div>
  </section>

  <!-- COMMUNITY MODS -->
  <section class="section" style="background:var(--bg);border-top:1px solid var(--border)" aria-label="Community motion system resources">
    <div class="container">
      <div class="section-head">
        <h2 class="section-head-label">Community mods</h2>
        <span style="font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;background:#E8F5E9;color:#2E7D32;border:1px solid #A5D6A7;padding:2px 8px;border-radius:3px">Free / Printables</span>
      </div>
      <div class="grid-3">
        {[
          { name:'Frame Alignment Jig', creator:'Community (Printables)', desc:'Print-before-you-build jigs that help square your frame during assembly — the most critical step for a properly printing Voron. Highly recommended for first builds.', href:'https://www.printables.com/model/search?q=voron+frame+alignment' },
          { name:'XY Joint Print Files', creator:'VoronDesign', desc:'Official XY joint STLs that route CoreXY belts cleanly through the gantry. These are structural prints — use the recommended filament (ABS/ASA) and wall count.', href:'https://github.com/VoronDesign/Voron-2' },
          { name:'Belt Tension Reference', creator:'VoronDesign Docs', desc:'The official guide for tuning belt tension using resonance frequency measurement. Required reading for getting consistent first layers and eliminating ringing.', href:'https://docs.vorondesign.com/tuning/secondary_printer_tuning.html' },
        ].map(mod => (
          <a href={mod.href} target="_blank" rel="noopener">
            <div class="product-card community" style="background:#fff">
              <div class="product-card-body">
                <span class="community-badge">Community · Free</span>
                <div class="product-card-name" style="font-size:16px">{mod.name}</div>
                <div style="font-size:11px;color:var(--g2);margin-bottom:8px;font-family:'JetBrains Mono',monospace">by {mod.creator}</div>
                <div style="font-family:'Lora',serif;font-size:12px;color:var(--g1);line-height:1.6;margin-bottom:12px">{mod.desc}</div>
                <div class="product-card-footer" style="border-top:none;padding-top:0">
                  <span class="btn-printables">View resource →</span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [{
      "@type": "ItemList",
      "name": "Motion System Parts for Voron 2.4 and Trident 2026",
      "url": "https://modernmakes.github.io/voron/motion-system",
      "numberOfItems": 4,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "LDO Motor Kit" },
        { "@type": "ListItem", "position": 2, "name": "Fabreeko Steppers" },
        { "@type": "ListItem", "position": 3, "name": "Gates GT2 6mm Belt" },
        { "@type": "ListItem", "position": 4, "name": "Mandala Rose Works MGN Rails" },
      ]
    }]
  })}></script>
</Base>

<script>
  (function() {
    const STORAGE_KEY = 'voron-model';
    const params = new URLSearchParams(window.location.search);
    const model = params.get('model') || localStorage.getItem(STORAGE_KEY) || '2.4';
    localStorage.setItem(STORAGE_KEY, model);

    const label = document.getElementById('active-model-label');
    if (label) label.textContent = model === '2.4' ? 'Voron 2.4' : 'Voron Trident';

    document.querySelectorAll<HTMLElement>('[data-compatible]').forEach(el => {
      const compatible = (el.dataset.compatible ?? '').split(',');
      el.style.display = compatible.includes(model) ? '' : 'none';
    });
  })();
</script>
