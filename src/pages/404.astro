---
// 404. GitHub Pages serves this file for every missing path, so everything that depends on the bad
// URL runs in the browser from location.pathname (Astro.url is always /404 at build time).
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Page Not Found"
  description="This page doesn't exist. Search Modern Makes or browse hardware and guides."
  hasPageH1={true}
  heroPage={true}
>
  <Nav slot="nav" currentPath="/" />

  <div class="nf-wrap">
    <div class="nf-inner">
      <h1 class="nf-h1">This page didn’t stick to the bed.</h1>
      <p class="nf-line">The link may be old, or the page moved.</p>

      <!-- Without JS: a link to /search. With JS: opens the palette prefilled with words from the URL. -->
      <a href="/search" class="nf-field" id="nf-field" data-palette aria-label="Search Modern Makes">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <span class="nf-field-q" id="nf-q">Search hardware, articles, tools</span>
      </a>

      <div class="nf-near" id="nf-near" hidden>
        <h2 class="cp-g nf-near-h">Closest hardware</h2>
        <div id="nf-rows"></div>
      </div>

      <nav class="nf-links" aria-label="Elsewhere on Modern Makes">
        <a href="/hardware">Hardware</a>
        <a href="/guides">Guides</a>
        <a href="/">Home</a>
      </nav>
    </div>
  </div>

  <Footer slot="footer" />
</Base>

<script>
  import { loadIndex, guessHardware, rowHtml } from '../scripts/search-core';

  // "/hotends/rapido-hf-old.html" → "hotends rapido hf old": hyphens and slashes to spaces, file extensions
  // and plain numbers dropped.
  let path = location.pathname;
  try { path = decodeURIComponent(path); } catch {}
  const q = path
    .replace(/\.[a-z0-9]{1,5}$/i, '')
    .split(/[\/\-_.+\s]+/)
    .filter((w) => w && !/^\d+$/.test(w))
    .join(' ')
    .toLowerCase();

  const field = document.getElementById('nf-field') as HTMLAnchorElement;
  if (q) {
    field.dataset.paletteQ = q;
    field.href = `/search?q=${encodeURIComponent(q)}`;
    field.setAttribute('aria-label', `Search for ${q}`);
    document.getElementById('nf-q')!.textContent = q;
    field.classList.add('has-q');

    loadIndex().then(() => {
      const hits = guessHardware(q);
      if (!hits.length) return;
      document.getElementById('nf-rows')!.innerHTML = hits.map((r) => rowHtml(r)).join('');
      document.getElementById('nf-near')!.hidden = false;
    }, () => { /* no index: the search field and links still work */ });
  }
</script>

<style is:global>
/* Hallmark · redesign: 404 · genre: editorial · theme: DESIGN.md (Workshop Press, dark plane)
 * pre-emit critique: P4 H5 E4 S5 R5 V4
 * One column on the dark plane: the headline, one line, a search field already holding the broken URL's
 * words, the closest hardware in the palette's own row style, then three plain links. No orange: the focus
 * ring and the palette caret are the only accent here. The giant numeral and three-card grid are gone. */
.nf-wrap {
  background: var(--dark-bg);
  color: #fff;
  min-height: 100vh;
  padding: 136px 24px 96px;
  overflow-x: clip;
}
.nf-inner { max-width: 640px; margin: 0 auto; }
.nf-h1 {
  font: 800 clamp(40px, 6.5vw, 68px)/0.98 var(--fd);
  letter-spacing: -0.01em;
  color: #fff;
  margin: 0 0 14px;
  overflow-wrap: anywhere;
  min-width: 0;
}
.nf-line { font: 400 17px/1.6 var(--fb); color: var(--on-dark-soft); margin: 0 0 36px; }

.nf-field {
  position: relative;
  display: flex; align-items: center; gap: 12px;
  min-height: 56px; padding: 0 18px;
  background: var(--dark-surface);
  border: 1px solid var(--dark-border);
  border-radius: var(--radius-md);
  color: var(--on-dark-muted);
  text-decoration: none;
  font: 500 17px var(--fu);
  transition: border-color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out), var(--press-release);
}
.nf-field.has-q { color: #fff; }
.nf-field svg { flex: none; color: var(--on-dark-muted); }
.nf-field-q { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nf-field:active { scale: var(--scale-press-btn); background: rgba(255, 255, 255, 0.06); transition-duration: var(--dur-press); }
@media (hover: hover) and (pointer: fine) { .nf-field:hover { border-color: rgba(255, 255, 255, 0.3); } }
@media (prefers-reduced-motion: reduce) { .nf-field:active { scale: none; } }

.nf-near { margin-top: 28px; }
.nf-near-h { margin: 0; padding-left: 0; }
.nf-near .cp-row { margin: 0 -10px; }
.nf-near .cp-row:focus-visible { outline-offset: -2px; }
@media (hover: hover) and (pointer: fine) { .nf-near .cp-row:hover { background: rgba(255, 255, 255, 0.08); } }

.nf-links {
  display: flex; flex-wrap: wrap; gap: 8px 28px;
  margin-top: 40px; padding-top: 24px;
  border-top: 1px solid var(--dark-border);
}
.nf-links a {
  display: inline-flex; align-items: center; min-height: 44px;
  font: 600 16px var(--fu); color: #fff;
  text-decoration: underline; text-decoration-color: rgba(255, 255, 255, 0.3); text-underline-offset: 5px;
  white-space: nowrap;
  transition: text-decoration-color var(--dur-fast) var(--ease-out);
}
@media (hover: hover) and (pointer: fine) { .nf-links a:hover { text-decoration-color: #fff; } }

@media (max-width: 600px) {
  .nf-wrap { padding: 112px 16px 72px; }
  .nf-line { font-size: 16px; margin-bottom: 28px; }
}
</style>
