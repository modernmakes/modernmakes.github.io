---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface PrinterEntry     { name: string; notes?: string; }
interface ToolheadEntry    { name: string; notes?: string; }
interface CommunityResource {
  name: string;
  url: string;
  type: 'GitHub' | 'BOM' | 'Discord' | 'Print Files' | 'Wiki' | 'Printables';
}

interface Props {
  title: string;
  creator: string;
  creatorUrl: string;
  projectUrl: string;
  projectLabel: string;
  license?: string;
  targetPrinters: PrinterEntry[];
  alsoFitsOn?: PrinterEntry[];
  motionType: string;
  motors: string;
  beltSpec: string;
  railSpec?: string;
  difficulty: string;
  printTime?: string;
  printedParts?: number;
  compatibleToolheads: ToolheadEntry[];
  communityResources: CommunityResource[];
  tags?: string[];
  excerpt?: string;
}

const {
  title,
  creator,
  creatorUrl,
  projectUrl,
  projectLabel,
  license,
  targetPrinters,
  alsoFitsOn = [],
  motionType,
  motors,
  beltSpec,
  railSpec,
  difficulty,
  printTime,
  printedParts,
  compatibleToolheads,
  communityResources,
  tags = [],
  excerpt = '',
} = Astro.props;

const difficultyColor =
  difficulty === 'Beginner'     ? '#2E7D32' :
  difficulty === 'Intermediate' ? '#E65100' : '#C62828';

const resourceStyles: Record<string, string> = {
  GitHub:        'rgba(36,41,47,.85)',
  BOM:           '#2E7D32',
  Discord:       '#5865F2',
  'Print Files': 'var(--accent)',
  Wiki:          'var(--g1)',
  Printables:    '#FF6C00',
};
const resourceIcons: Record<string, string> = {
  GitHub:        '⌥',
  BOM:           '📋',
  Discord:       '💬',
  'Print Files': '🖨',
  Wiki:          '📖',
  Printables:    '🐙',
};
---
<Base
  title={`${title} — Gantry Mod`}
  description={excerpt || `${title} — ${motionType} gantry mod by @${creator}. Target: ${targetPrinters.map(p => p.name).join(', ')}.`}
  heroPage={true}
  hasHero={true}
>
  <Nav slot="nav" currentPath="/hardware" />

  <!-- ── HERO ── -->
  <section class="ms-hero">
    <div class="ms-hero-inner">
      <div class="ms-hero-badges">
        <span class="ms-hero-type-badge">{motionType}</span>
        <span
          class="ms-hero-diff-badge"
          style={`background:${difficultyColor}22;color:${difficultyColor};border-color:${difficultyColor}44`}
        >
          {difficulty}
        </span>
      </div>
      <h1 class="ms-hero-title">{title}</h1>
      <a href={creatorUrl} class="ms-hero-credit" target="_blank" rel="noopener noreferrer">
        by @{creator}
      </a>
      <div class="ms-hero-stats">
        <div class="ms-hero-stat">
          <span class="ms-hero-stat-label">Motors</span>
          <span class="ms-hero-stat-val">{motors}</span>
        </div>
        <div class="ms-hero-stat">
          <span class="ms-hero-stat-label">Belt</span>
          <span class="ms-hero-stat-val">{beltSpec}</span>
        </div>
        <div class="ms-hero-stat">
          <span class="ms-hero-stat-label">Fits</span>
          <span class="ms-hero-stat-val">{targetPrinters.length} printer{targetPrinters.length !== 1 ? 's' : ''}</span>
        </div>
        {printedParts && (
          <div class="ms-hero-stat">
            <span class="ms-hero-stat-label">Printed Parts</span>
            <span class="ms-hero-stat-val">{printedParts}</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ── BREADCRUMB ── -->
  <div class="ms-breadcrumb-bar">
    <div class="ms-breadcrumb-inner">
      <nav class="ms-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/hardware">Hardware</a>
        <span>/</span>
        <a href="/hardware/motion">Motion Mods</a>
        <span>/</span>
        <span>{title}</span>
      </nav>
    </div>
  </div>

  <!-- ── BODY ── -->
  <div class="ms-body">
    <div class="ms-body-inner">
      <div class="ms-layout">

        <!-- MAIN COLUMN -->
        <div class="ms-main">

          <!-- PROJECT ATTRIBUTION -->
          <section class="ms-section" aria-labelledby="attribution-heading">
            <div class="ms-attribution-card">
              <div class="ms-attr-meta">
                <div class="ms-attr-row">
                  <span class="ms-attr-key">Creator</span>
                  <a href={creatorUrl} class="ms-attr-creator" target="_blank" rel="noopener noreferrer">
                    @{creator}
                  </a>
                </div>
                {license && (
                  <div class="ms-attr-row">
                    <span class="ms-attr-key">License</span>
                    <span class="ms-attr-val">{license}</span>
                  </div>
                )}
                <div class="ms-attr-row">
                  <span class="ms-attr-key">Motion Type</span>
                  <span class="ms-attr-val">{motionType}</span>
                </div>
              </div>
              <a
                href={projectUrl}
                class="ms-attr-btn"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`View ${projectLabel}`}
              >
                {projectLabel}
                <span class="ms-attr-btn-arrow">→</span>
              </a>
            </div>
          </section>

          <!-- FITS ON -->
          <section class="ms-section" aria-labelledby="fits-heading">
            <h2 class="ms-section-title" id="fits-heading">Fits On</h2>
            <div class="ms-printer-grid">
              {targetPrinters.map(p => (
                <div class="ms-printer-card ms-printer-primary">
                  <span class="ms-printer-name">{p.name}</span>
                  {p.notes && <span class="ms-printer-note">{p.notes}</span>}
                </div>
              ))}
            </div>
            {alsoFitsOn.length > 0 && (
              <div class="ms-also-fits">
                <div class="ms-also-fits-label">Can also fit (with modifications)</div>
                <div class="ms-printer-grid">
                  {alsoFitsOn.map(p => (
                    <div class="ms-printer-card ms-printer-secondary">
                      <span class="ms-printer-name">{p.name}</span>
                      {p.notes && <span class="ms-printer-note">{p.notes}</span>}
                    </div>
                  ))}
                </div>
              </div>
            )}
          </section>

          <!-- COMPATIBLE TOOLHEADS -->
          {compatibleToolheads.length > 0 && (
            <section class="ms-section" aria-labelledby="toolheads-heading">
              <h2 class="ms-section-title" id="toolheads-heading">Compatible Toolheads</h2>
              <div class="ms-toolhead-list">
                {compatibleToolheads.map(t => (
                  <span class="ms-toolhead-chip">
                    {t.name}
                    {t.notes && <span class="ms-toolhead-note">{t.notes}</span>}
                  </span>
                ))}
              </div>
            </section>
          )}

          <!-- MOTION SYSTEM DETAILS -->
          <section class="ms-section" aria-labelledby="specs-heading">
            <h2 class="ms-section-title" id="specs-heading">Motion System Details</h2>
            <div class="ms-spec-table-wrap">
              <table class="ms-spec-table">
                <tbody>
                  <tr><td class="ms-spec-label">Motion Type</td><td class="ms-spec-val">{motionType}</td></tr>
                  <tr><td class="ms-spec-label">Motors</td><td class="ms-spec-val">{motors}</td></tr>
                  <tr><td class="ms-spec-label">Belt Spec</td><td class="ms-spec-val">{beltSpec}</td></tr>
                  {railSpec && <tr><td class="ms-spec-label">Rail Spec</td><td class="ms-spec-val">{railSpec}</td></tr>}
                </tbody>
              </table>
            </div>
          </section>

          <!-- BUILD COMPLEXITY -->
          <section class="ms-section" aria-labelledby="complexity-heading">
            <h2 class="ms-section-title" id="complexity-heading">Build Complexity</h2>
            <div class="ms-complexity-strip">
              <div class="ms-complexity-item">
                <span class="ms-complexity-label">Difficulty</span>
                <span
                  class="ms-complexity-badge"
                  style={`background:${difficultyColor}18;color:${difficultyColor};border-color:${difficultyColor}44`}
                >
                  {difficulty}
                </span>
              </div>
              {printedParts && (
                <div class="ms-complexity-item">
                  <span class="ms-complexity-label">Printed Parts</span>
                  <span class="ms-complexity-val">{printedParts} parts</span>
                </div>
              )}
              {printTime && (
                <div class="ms-complexity-item">
                  <span class="ms-complexity-label">Print Time</span>
                  <span class="ms-complexity-val">{printTime}</span>
                </div>
              )}
            </div>
          </section>

          <!-- PROSE CONTENT -->
          <section class="ms-section ms-prose-section">
            <slot />
          </section>

          <!-- COMMUNITY RESOURCES -->
          {communityResources.length > 0 && (
            <section class="ms-section" aria-labelledby="resources-heading">
              <h2 class="ms-section-title" id="resources-heading">Community Resources</h2>
              <div class="ms-resources-grid">
                {communityResources.map(r => (
                  <a
                    href={r.url}
                    class="ms-resource-card"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="ms-resource-icon">{resourceIcons[r.type] ?? '🔗'}</span>
                    <div class="ms-resource-info">
                      <span class="ms-resource-type" style={`color:${resourceStyles[r.type] ?? 'var(--g1)'}`}>{r.type}</span>
                      <span class="ms-resource-name">{r.name}</span>
                    </div>
                    <span class="ms-resource-arrow">→</span>
                  </a>
                ))}
              </div>
            </section>
          )}

          <!-- RELATED MODS -->
          <section class="ms-section" aria-labelledby="related-heading">
            <h2 class="ms-section-title" id="related-heading">Related Mods</h2>
            <div class="ms-related-grid">
              <a href="/hardware/motion" class="ms-related-card ms-related-browse">
                <span class="ms-related-browse-label">Browse all motion mods →</span>
              </a>
              <div class="ms-related-card ms-related-soon">
                <span class="ms-related-soon-label">More mods</span>
                <span class="ms-related-soon-tag">Coming Soon</span>
              </div>
              <div class="ms-related-card ms-related-soon">
                <span class="ms-related-soon-label">More mods</span>
                <span class="ms-related-soon-tag">Coming Soon</span>
              </div>
            </div>
          </section>

        </div><!-- /ms-main -->

        <!-- SIDEBAR -->
        <aside class="ms-sidebar" aria-label="Mod sidebar">
          <div class="ms-sb-box">
            <div class="ms-sb-label">Quick Facts</div>
            <div class="ms-sb-inner">
              <div class="ms-sb-row">
                <span class="ms-sb-key">Type</span>
                <span class="ms-sb-val">{motionType}</span>
              </div>
              <div class="ms-sb-row">
                <span class="ms-sb-key">Difficulty</span>
                <span class="ms-sb-val" style={`color:${difficultyColor}`}>{difficulty}</span>
              </div>
              <div class="ms-sb-row">
                <span class="ms-sb-key">Fits</span>
                <span class="ms-sb-val">{targetPrinters[0]?.name ?? '—'}</span>
              </div>
              {printedParts && (
                <div class="ms-sb-row">
                  <span class="ms-sb-key">Parts</span>
                  <span class="ms-sb-val">{printedParts}</span>
                </div>
              )}
              {printTime && (
                <div class="ms-sb-row">
                  <span class="ms-sb-key">Print Time</span>
                  <span class="ms-sb-val">{printTime}</span>
                </div>
              )}
            </div>
          </div>

          <div class="ms-sb-box">
            <div class="ms-sb-label">Project</div>
            <div class="ms-sb-proj">
              <a href={creatorUrl} class="ms-sb-creator" target="_blank" rel="noopener noreferrer">
                @{creator}
              </a>
              {license && <span class="ms-sb-license">{license}</span>}
              <a href={projectUrl} class="ms-sb-proj-btn" target="_blank" rel="noopener noreferrer">
                View on GitHub →
              </a>
            </div>
          </div>

          {tags.length > 0 && (
            <div class="ms-sb-box">
              <div class="ms-sb-label">Tags</div>
              <div class="ms-sb-tags">
                {tags.map(t => <span class="ms-sb-tag">{t}</span>)}
              </div>
            </div>
          )}
        </aside>

      </div>
    </div>
  </div>

  <Footer slot="footer" />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    "name": title,
    "description": excerpt,
    "author": { "@type": "Person", "name": creator, "url": creatorUrl },
    "license": license ? `https://spdx.org/licenses/${license}` : undefined,
    "codeRepository": projectUrl,
    "programmingLanguage": "Hardware mod",
    "publisher": { "@type": "Organization", "name": "Modern Makes", "url": "https://modernmakes.com" }
  })}></script>
</Base>

<style is:global>
/* ── HERO ── */
.ms-hero {
  background: var(--black);
  /* 80px nav + 56px design spacing */
  padding: 136px 0 52px;
  border-bottom: 1px solid rgba(255,255,255,.06);
}
.ms-hero-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px;
}
.ms-hero-badges {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 16px;
}
.ms-hero-type-badge {
  font-family: var(--fu);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--accent);
  background: rgba(255,90,31,.12);
  border: 1px solid rgba(255,90,31,.25);
  border-radius: 4px;
  padding: 4px 12px;
}
.ms-hero-diff-badge {
  font-family: var(--fu);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .08em;
  border: 1px solid;
  border-radius: 4px;
  padding: 4px 12px;
}
.ms-hero-title {
  font-family: var(--fd);
  font-size: 52px;
  font-weight: 800;
  color: #fff;
  line-height: 1;
  letter-spacing: -.5px;
  margin-bottom: 10px;
}
.ms-hero-credit {
  display: inline-block;
  font-family: var(--fm);
  font-size: 13px;
  color: rgba(255,255,255,.45);
  margin-bottom: 28px;
  transition: color .15s;
}
.ms-hero-credit:hover { color: rgba(255,255,255,.75); }
.ms-hero-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 28px;
}
.ms-hero-stat { display: flex; flex-direction: column; gap: 3px; }
.ms-hero-stat-label {
  font-family: var(--fu);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: rgba(255,255,255,.3);
}
.ms-hero-stat-val {
  font-family: var(--fm);
  font-size: 13px;
  font-weight: 700;
  color: rgba(255,255,255,.85);
}

/* ── BREADCRUMB ── */
.ms-breadcrumb-bar {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
}
.ms-breadcrumb-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px;
  height: 44px;
  display: flex;
  align-items: center;
}
.ms-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
}
.ms-breadcrumb a,
.ms-breadcrumb span {
  font-family: var(--fm);
  font-size: 11px;
  color: var(--g2);
  transition: color .15s;
}
.ms-breadcrumb a:hover { color: var(--accent); }

/* ── BODY ── */
.ms-body {
  background: var(--bg);
  padding: 48px 0 64px;
  position: relative;
  z-index: 2;
}
.ms-body-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px;
}
.ms-layout {
  display: grid;
  grid-template-columns: 1fr 260px;
  gap: 48px;
  align-items: start;
}
.ms-main { min-width: 0; }

/* ── SECTIONS ── */
.ms-section { margin-bottom: 48px; }
.ms-section-title {
  font-family: var(--fd);
  font-size: 20px;
  font-weight: 800;
  color: var(--black);
  margin-bottom: 16px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--black);
}

/* ── PROJECT ATTRIBUTION ── */
.ms-attribution-card {
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 20px 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.ms-attr-meta { display: flex; flex-direction: column; gap: 8px; }
.ms-attr-row { display: flex; align-items: baseline; gap: 10px; }
.ms-attr-key {
  font-family: var(--fu);
  font-size: 11px;
  color: var(--g2);
  width: 80px;
  flex-shrink: 0;
}
.ms-attr-creator {
  font-family: var(--fm);
  font-size: 13px;
  font-weight: 700;
  color: var(--accent);
  transition: opacity .15s;
}
.ms-attr-creator:hover { opacity: .75; }
.ms-attr-val { font-family: var(--fm); font-size: 13px; color: var(--black); }
.ms-attr-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--black);
  color: #fff;
  border-radius: var(--radius-md);
  padding: 12px 18px;
  font-family: var(--fm);
  font-size: 12px;
  font-weight: 700;
  transition: background .15s;
  word-break: break-all;
  gap: 12px;
}
.ms-attr-btn:hover { background: #2a2a2a; }
.ms-attr-btn-arrow { flex-shrink: 0; opacity: .6; }

/* ── FITS ON ── */
.ms-printer-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}
.ms-printer-card {
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: var(--radius-md);
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.ms-printer-primary { border-color: var(--border-s); }
.ms-printer-name { font-family: var(--fd); font-size: 15px; font-weight: 800; color: var(--black); }
.ms-printer-note { font-family: var(--fu); font-size: 11px; color: var(--g2); line-height: 1.4; }
.ms-also-fits { margin-top: 16px; }
.ms-also-fits-label {
  font-family: var(--fu);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--g2);
  margin-bottom: 10px;
}

/* ── TOOLHEADS ── */
.ms-toolhead-list { display: flex; flex-wrap: wrap; gap: 8px; }
.ms-toolhead-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--fu);
  font-size: 12px;
  font-weight: 600;
  color: var(--accent-dk);
  background: rgba(255,90,31,.08);
  border: 1.5px solid rgba(255,90,31,.2);
  border-radius: 20px;
  padding: 5px 14px;
}
.ms-toolhead-note {
  font-family: var(--fm);
  font-size: 10px;
  color: var(--g2);
  font-weight: 400;
}

/* ── SPEC TABLE ── */
.ms-spec-table-wrap {
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.ms-spec-table { width: 100%; border-collapse: collapse; }
.ms-spec-table tr { border-bottom: 1px solid var(--border); }
.ms-spec-table tr:last-child { border-bottom: none; }
.ms-spec-table tr:nth-child(even) { background: #fafaf9; }
.ms-spec-label { padding: 11px 18px; font-family: var(--fu); font-size: 12px; color: var(--g1); width: 38%; font-weight: 600; }
.ms-spec-val { padding: 11px 18px; font-family: var(--fm); font-size: 13px; color: var(--black); }

/* ── COMPLEXITY ── */
.ms-complexity-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 18px 24px;
}
.ms-complexity-item { display: flex; flex-direction: column; gap: 4px; }
.ms-complexity-label {
  font-family: var(--fu);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--g2);
}
.ms-complexity-badge {
  font-family: var(--fu);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .04em;
  border: 1px solid;
  border-radius: 4px;
  padding: 3px 12px;
  align-self: flex-start;
}
.ms-complexity-val { font-family: var(--fm); font-size: 13px; font-weight: 700; color: var(--black); }

/* ── PROSE ── */
.ms-prose-section p { font-family: var(--fb); font-size: 16px; line-height: 1.8; color: var(--g1); margin-bottom: 18px; }
.ms-prose-section h3 { font-family: var(--fd); font-size: 18px; font-weight: 800; color: var(--black); margin: 24px 0 10px; }
.ms-prose-section ul, .ms-prose-section ol { padding-left: 24px; margin-bottom: 18px; }
.ms-prose-section li { font-family: var(--fb); font-size: 16px; line-height: 1.75; color: var(--g1); margin-bottom: 6px; }
.ms-prose-section strong { color: var(--black); font-weight: 700; }
.ms-prose-section code { font-family: var(--fm); font-size: 13px; background: #fff; border: 1px solid var(--border); border-radius: 3px; padding: 1px 6px; }

/* ── COMMUNITY RESOURCES ── */
.ms-resources-grid {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.ms-resource-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 14px 18px;
  display: flex;
  align-items: center;
  gap: 12px;
  transition: border-color .15s, transform .15s;
}
.ms-resource-card:hover { border-color: var(--border-s); transform: translateY(-1px); }
.ms-resource-icon { font-size: 16px; flex-shrink: 0; }
.ms-resource-info { display: flex; flex-direction: column; gap: 1px; flex: 1; min-width: 0; }
.ms-resource-type { font-family: var(--fu); font-size: 9px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
.ms-resource-name { font-family: var(--fm); font-size: 12px; color: var(--black); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
