---
// HomeBuilds.astro
// Dark-register prosumer section. Feature article left, 3 build cards right.
//
// Feature + first two build cards pull real title/excerpt/date/readTime from
// their content collection entries (previously hardcoded placeholder text
// pointing at articles that were never published, 404ing on every visit).
// The third card links to a real hardware detail page, not a content
// collection entry, so its copy stays hand-authored — that link was never dead.
import { getEntry } from 'astro:content';
import TypeCover from '../TypeCover.astro';

const featureEntry = await getEntry('guides', 'voron-2-4-vs-trident');
const cardEntryA = await getEntry('guides', 'corexy-motion-system');
const cardEntryB = await getEntry('comparisons', 'rapido2-vs-dragon-hf-comparison');

function formatCardDate(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}
---

<section class="builds" aria-labelledby="builds-heading">
  <div class="builds-inner">

    <header class="builds-head">
      <span class="builds-eyebrow" data-reveal>Builds &amp; Prosumer</span>
      <h2 id="builds-heading" class="builds-title" data-reveal data-reveal-delay="80">For the people who read the BOM twice.</h2>
      <a href="/guides" class="builds-all" data-reveal data-reveal-delay="160">All build content <span class="arrow">→</span></a>
    </header>

    <div class="builds-grid">

      <!-- Feature article -->
      <a href={`/guides/${featureEntry.slug}`} class="build-feature" data-reveal data-reveal-delay="120">
        <article>
          <div class="build-feature-img" aria-hidden="true">
            {featureEntry.data.heroImage
              ? <img src={featureEntry.data.heroImage} alt="" loading="lazy" decoding="async" />
              : <TypeCover title={featureEntry.data.title} eyebrow="Voron · Build guide" size="hero" />}
          </div>
          <div class="build-feature-body">
            <h3 class="build-feature-title">{featureEntry.data.title}</h3>
            <p class="build-feature-excerpt">{featureEntry.data.excerpt}</p>
            <span class="build-feature-meta">
              <span class="build-feature-date">{formatCardDate(featureEntry.data.date)}</span>
              <span class="build-feature-read">{featureEntry.data.readTime}</span>
            </span>
          </div>
        </article>
      </a>

      <!-- Side cards -->
      <div class="build-cards">

        <a href="/voron/hotends#rapido-2" class="build-card" data-reveal="right" data-reveal-delay="200">
          <article>
            <div class="build-card-img img-rapido" aria-hidden="true"></div>
            <div class="build-card-body">
              <span class="build-card-cat">Hotends · Verdict</span>
              <h3 class="build-card-title">Phaetus Rapido 2: The High-Temp Hotend That Earns Its Spot</h3>
              <div class="build-card-meta">
                <span>May 18, 2026</span>
                <span class="build-card-dot" aria-hidden="true"></span>
                <span>9 min</span>
              </div>
            </div>
          </article>
        </a>

        <a href={`/guides/${cardEntryA.slug}`} class="build-card" data-reveal="right" data-reveal-delay="280">
          <article>
            <div class="build-card-img img-pa12" aria-hidden="true"></div>
            <div class="build-card-body">
              <span class="build-card-cat">Motion · Guide</span>
              <h3 class="build-card-title">{cardEntryA.data.title}</h3>
              <div class="build-card-meta">
                <span>{formatCardDate(cardEntryA.data.date)}</span>
                <span class="build-card-dot" aria-hidden="true"></span>
                <span>{cardEntryA.data.readTime}</span>
              </div>
            </div>
          </article>
        </a>

        <a href={`/comparisons/${cardEntryB.slug}`} class="build-card" data-reveal="right" data-reveal-delay="360">
          <article>
            <div class="build-card-img img-mod-hotend" aria-hidden="true"></div>
            <div class="build-card-body">
              <span class="build-card-cat">Hotends · Comparison</span>
              <h3 class="build-card-title">{cardEntryB.data.title}</h3>
              <div class="build-card-meta">
                <span>{formatCardDate(cardEntryB.data.date)}</span>
                <span class="build-card-dot" aria-hidden="true"></span>
                <span>{cardEntryB.data.readTime}</span>
              </div>
            </div>
          </article>
        </a>

      </div>
    </div>
  </div>
</section>

<style is:global>
/* ── HomeBuilds ── */
.builds {
  background: #0a0a0a;
  padding: 52px 0;
}
.builds-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px;
}

/* Header row */
.builds-head {
  display: flex;
  align-items: baseline;
  gap: 14px;
  margin-bottom: 24px;
  padding-bottom: 14px;
  border-bottom: 1px solid rgba(255,255,255,.09);
}
.builds-eyebrow {
  font-family: var(--fu);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--accent);
}
.builds-title {
  font-family: var(--fd);
  font-size: clamp(18px, 1.8vw + 8px, 24px);
  font-weight: 800;
  color: #fff;
  letter-spacing: -.2px;
  margin: 0;
}
.builds-all {
  font-family: var(--fu);
  font-size: 12px;
  font-weight: 600;
  color: var(--on-dark-muted);
  margin-left: auto;
  transition: color .15s;
  white-space: nowrap;
}
@media (hover: hover) and (pointer: fine) {
  .builds-all:hover { color: var(--on-dark-soft); }
}

/* 2-col grid: feature left (wider), cards right (narrower) */
.builds-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 14px;
  align-items: stretch;
}

/* Feature article — section-scoped (0,2,0) so this transition wins over the
   shared reveal utility's :where() transition; hover stays crisp while
   opacity + filter carry the 600ms reveal. */
.builds .build-feature {
  display: block;
  background: #1c1c1c;
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 10px;
  overflow: hidden;
  transition:
    border-color .15s var(--stagger-ease),
    transform    .15s var(--stagger-ease),
    opacity      var(--stagger-dur) var(--stagger-ease),
    filter       var(--stagger-dur) var(--stagger-ease),
    var(--press-release);
  height: 100%;
}
@media (hover: hover) and (pointer: fine) {
  .builds .build-feature:hover {
    border-color: rgba(255,255,255,.18);
    transform: translateY(-2px);
  }
}
.build-feature article {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.build-feature-img {
  position: relative;
  width: 100%;
  /* Fixed height instead of aspect-ratio so it doesn't balloon */
  height: 220px;
  background: var(--dark-surface);
  overflow: hidden;
  flex-shrink: 0;
}
.build-feature-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

.build-feature-body {
  padding: 20px;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.build-feature-title {
  font-family: var(--fd);
  font-size: clamp(18px, 1.6vw + 8px, 26px);
  font-weight: 800;
  color: #fff;
  line-height: 1.1;
  letter-spacing: -.2px;
  margin: 0 0 10px;
}
.build-feature-excerpt {
  font-family: var(--fb);
  font-size: 13px;
  color: var(--on-dark-muted);
  line-height: 1.7;
  margin: 0 0 16px;
  flex: 1;
}
.build-feature-meta {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--fm);
  font-size: 10px;
  color: var(--on-dark-muted);
}
.build-feature-read::before {
  content: '·';
  margin-right: 10px;
}

/* Side build cards — stretch to fill column height evenly */
.build-cards {
  display: flex;
  flex-direction: column;
  gap: 8px;
  height: 100%;
}
.builds .build-card {
  display: block;
  background: #222;
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 10px;
  overflow: hidden;
  transition:
    border-color .15s var(--stagger-ease),
    transform    .15s var(--stagger-ease),
    opacity      var(--stagger-dur) var(--stagger-ease),
    filter       var(--stagger-dur) var(--stagger-ease),
    var(--press-release);
  flex: 1;
}
@media (hover: hover) and (pointer: fine) {
  .builds .build-card:hover {
    border-color: rgba(255,255,255,.18);
    transform: translateX(2px);
  }
}
.build-card article {
  display: grid;
  grid-template-columns: 88px 1fr;
  height: 100%;
}
.build-card-img {
  background: var(--dark-surface);
  width: 88px;
  min-height: 80px;
  height: 100%;
  flex-shrink: 0;
  overflow: hidden;
  align-self: stretch;
}
.build-card-body {
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 5px;
  justify-content: center;
}
.build-card-cat {
  font-family: var(--fu);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .09em;
  text-transform: uppercase;
  color: var(--accent);
}
.build-card-title {
  font-family: var(--fd);
  font-size: 15px;
  font-weight: 800;
  color: #fff;
  line-height: 1.15;
  margin: 0;
}
.build-card-meta {
  font-family: var(--fm);
  font-size: 10px;
  color: var(--on-dark-muted);
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 2px;
}
.build-card-dot {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: rgba(255,255,255,.2);
  flex-shrink: 0;
}

/* ── Responsive ── */
@media (max-width: 900px) {
  .builds-grid { grid-template-columns: 1fr; }
  .build-feature { height: auto; }
  .build-cards { flex-direction: row; height: auto; }
  .build-card { flex: 1; }
  .build-card article { grid-template-columns: 72px 1fr; }
  .build-card-img { width: 72px; }
}
@media (max-width: 768px) {
  .builds-inner { padding: 0 20px; }
  .builds-head { flex-wrap: wrap; gap: 8px; }
  .builds-all { margin-left: 0; }
  .build-cards { flex-direction: column; }
  .build-card { flex: none; }
}
</style>
