---
/* Hallmark · macrostructure: Long Document (2-col prose + sticky sidebar TOC)
 * transitions: IntersectionObserver active section highlight
 */
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const siteBase = Astro.site
  ? new URL(Astro.site).href.replace(/\/$/, '')
  : 'https://modernmakes.github.io';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Terms of Service — Modern Makes',
  url: `${siteBase}/legal/terms-of-service`,
  description: 'Terms of Service for Modern Makes. Effective June 2026. Jurisdiction: British Columbia, Canada.',
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',             item: `${siteBase}/` },
    { '@type': 'ListItem', position: 2, name: 'Terms of Service', item: `${siteBase}/legal/terms-of-service` },
  ],
};

const sections = [
  { id: 'acceptance',   label: 'Acceptance of Terms' },
  { id: 'what-we-are',  label: 'What Modern Makes Is' },
  { id: 'affiliate',    label: 'Affiliate Links & Sponsored Content' },
  { id: 'ip',           label: 'Intellectual Property' },
  { id: 'conduct',      label: 'User Conduct' },
  { id: 'tools',        label: 'Tools and Calculators' },
  { id: 'newsletter',   label: 'Newsletter' },
  { id: 'links',        label: 'Third-Party Links' },
  { id: 'disclaimer',   label: 'Disclaimer of Warranties' },
  { id: 'liability',    label: 'Limitation of Liability' },
  { id: 'changes',      label: 'Changes to These Terms' },
  { id: 'governing',    label: 'Governing Law' },
  { id: 'contact',      label: 'Contact' },
];
---
<Base
  title="Terms of Service — Modern Makes"
  description="Terms of Service for Modern Makes. Effective June 2026. Jurisdiction: British Columbia, Canada."
  hasPageH1={true}
>
  <Nav slot="nav" currentPath="/" />

  <div class="lg-wrap">
    <div class="lg-inner">

      <nav class="lg-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <span>Legal</span>
        <span aria-hidden="true">›</span>
        <span>Terms of Service</span>
      </nav>

      <div class="lg-layout">

        <aside class="lg-sidebar" aria-label="Table of contents">
          <div class="lg-toc">
            <p class="lg-toc-label">On this page</p>
            <nav>
              {sections.map(s => (
                <a class="lg-toc-link" href={`#${s.id}`}>{s.label}</a>
              ))}
            </nav>
          </div>
        </aside>

        <main class="lg-content" id="lg-main">
          <h1 class="lg-title">Terms of Service</h1>
          <p class="lg-meta">Effective June 2026 · Jurisdiction: British Columbia, Canada</p>

          <section id="acceptance">
            <h2>Acceptance of Terms</h2>
            <p>By accessing or using Modern Makes, you agree to these Terms of Service. If you do not agree, do not use the site. These terms apply to all visitors, subscribers, and anyone who interacts with our content or tools.</p>
          </section>

          <section id="what-we-are">
            <h2>What Modern Makes Is</h2>
            <p>Modern Makes is an independent editorial publication covering prosumer and enthusiast FDM 3D printing. We publish news, guides, hardware analysis, and curated community content. We are not a retailer, manufacturer, or repair service. Nothing on this site constitutes professional engineering advice.</p>
          </section>

          <section id="affiliate">
            <h2>Affiliate Links and Sponsored Content</h2>
            <p>Modern Makes participates in affiliate programs. When you click a link to purchase a product, we may earn a commission at no additional cost to you. Our current affiliate relationships include: Fabreeko, West3D, KB3D, Amazon Associates, Micro Swiss, and Mellow3D. Affiliate relationships do not influence our editorial verdicts. Sponsored content is always clearly labeled.</p>
          </section>

          <section id="ip">
            <h2>Intellectual Property</h2>
            <p>All original content on Modern Makes — including articles, guides, tools, graphics, and site design — is owned by Modern Makes and protected under applicable copyright law. You may share links freely. You may not reproduce, republish, or scrape content without written permission. Brief quotations with attribution and a link are permitted under fair dealing.</p>
          </section>

          <section id="conduct">
            <h2>User Conduct</h2>
            <p>You agree not to: attempt to access the site through automated means without permission; use our tools or content to build competing products without attribution; submit false information through any form; attempt to interfere with the site's operation.</p>
          </section>

          <section id="tools">
            <h2>Tools and Calculators</h2>
            <p>Tools on this site (pressure advance calculators, retraction tools, motor simulators, etc.) are provided for informational purposes. Results are estimates. Modern Makes is not responsible for print failures, hardware damage, or any outcome resulting from use of these tools. Always verify settings with your specific hardware.</p>
          </section>

          <section id="newsletter">
            <h2>Newsletter</h2>
            <p>By subscribing to The Modern Makes Brief, you agree to receive periodic emails. You can unsubscribe at any time using the link in any email. We use Beehiiv to manage the newsletter. Your email is never sold to third parties.</p>
          </section>

          <section id="links">
            <h2>Third-Party Links</h2>
            <p>This site links to external sites including vendor stores, GitHub repositories, and community resources. We are not responsible for the content, privacy practices, or availability of any third-party site.</p>
          </section>

          <section id="disclaimer">
            <h2>Disclaimer of Warranties</h2>
            <p>Modern Makes is provided as-is without warranties of any kind. We make no guarantees that the site will be available at all times, that content is error-free, or that product information is current. Hardware specifications, prices, and availability change — always verify with the vendor before purchasing.</p>
          </section>

          <section id="liability">
            <h2>Limitation of Liability</h2>
            <p>To the maximum extent permitted under BC law, Modern Makes and its operators shall not be liable for any indirect, incidental, or consequential damages arising from use of the site, including hardware damage, data loss, or financial loss resulting from purchasing decisions influenced by our content.</p>
          </section>

          <section id="changes">
            <h2>Changes to These Terms</h2>
            <p>We may update these terms at any time. The effective date at the top of this page reflects the most recent revision. Continued use of the site after changes constitutes acceptance.</p>
          </section>

          <section id="governing">
            <h2>Governing Law</h2>
            <p>These terms are governed by the laws of British Columbia, Canada.</p>
          </section>

          <section id="contact">
            <h2>Contact</h2>
            <p>Questions: <a href="mailto:modernmakesco@gmail.com" class="lg-email-link">modernmakesco@gmail.com</a></p>
          </section>

        </main>
      </div>
    </div>
  </div>

  <Footer slot="footer" />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify(pageSchema)}></script>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)}></script>
</Base>

<script>
(function () {
  const sections = document.querySelectorAll<HTMLElement>('.lg-content section[id]');
  const links    = document.querySelectorAll<HTMLAnchorElement>('.lg-toc-link');
  if (!sections.length || !links.length) return;
  const obs = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        links.forEach(l => l.removeAttribute('aria-current'));
        const active = document.querySelector<HTMLAnchorElement>(`.lg-toc-link[href="#${entry.target.id}"]`);
        if (active) active.setAttribute('aria-current', 'true');
      }
    }
  }, { rootMargin: '-15% 0px -75% 0px' });
  sections.forEach(s => obs.observe(s));
})();
</script>

<style is:global>
/* ── LEGAL PAGES ─────────────────────────── */
.lg-wrap {
  background: var(--bg);
  min-height: calc(100vh - 80px);
  padding: 40px 0 80px;
}
.lg-inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 40px;
}
.lg-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--fm);
  font-size: 10px;
  color: var(--g2);
  margin-bottom: 32px;
}
.lg-breadcrumb a { color: var(--g2); }
.lg-breadcrumb a:hover { color: var(--accent); }
.lg-layout {
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: 56px;
  align-items: start;
}
.lg-sidebar { position: sticky; top: 96px; }
.lg-toc { padding-right: 16px; }
.lg-toc-label {
  font-family: var(--fm);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--g2);
  margin-bottom: 12px;
}
.lg-toc-link {
  display: block;
  font-family: var(--fu);
  font-size: 12px;
  color: var(--g1);
  padding: 4px 0 4px 10px;
  border-left: 2px solid transparent;
  line-height: 1.45;
  transition: color .12s, border-color .12s;
}
.lg-toc-link:hover { color: var(--black); }
.lg-toc-link[aria-current="true"] {
  color: var(--black);
  border-left-color: var(--accent);
  font-weight: 600;
}
.lg-content { min-width: 0; }
.lg-title {
  font-family: var(--fd);
  font-size: 40px;
  font-weight: 800;
  color: var(--black);
  line-height: 1;
  letter-spacing: -.5px;
  margin-bottom: 8px;
}
.lg-meta {
  font-family: var(--fm);
  font-size: 11px;
  color: var(--g2);
  margin-bottom: 36px;
}
.lg-content section {
  border-top: 1px solid var(--border);
  padding-top: 28px;
  margin-bottom: 28px;
}
.lg-content h2 {
  font-family: var(--fd);
  font-size: 22px;
  font-weight: 800;
  color: var(--black);
  margin-bottom: 14px;
  letter-spacing: -.2px;
}
.lg-content p, .lg-content li {
  font-family: var(--fb);
  font-size: 15px;
  color: var(--g1);
  line-height: 1.8;
  margin-bottom: 12px;
}
.lg-content ul { padding-left: 20px; margin-bottom: 12px; }
.lg-content li { margin-bottom: 6px; }
.lg-callout {
  background: rgba(255, 90, 31, .06);
  border-left: 3px solid var(--accent);
  border-radius: 0 4px 4px 0;
  padding: 14px 18px !important;
  margin-bottom: 12px !important;
}
.lg-callout strong { color: var(--black); }
.lg-email-link {
  font-family: var(--fm);
  font-size: 14px;
  color: var(--accent);
  font-weight: 700;
}
.lg-email-link:hover { text-decoration: underline; }
@media (max-width: 900px) {
  .lg-layout { grid-template-columns: 1fr; gap: 32px; }
  .lg-sidebar { position: static; }
  .lg-toc { display: flex; flex-wrap: wrap; gap: 0; border: 1px solid var(--border); border-radius: 6px; padding: 12px 16px; background: var(--surface); }
  .lg-toc-label { width: 100%; }
  .lg-toc-link { padding: 3px 8px; border-left: none; font-size: 11px; }
}
@media (max-width: 480px) {
  .lg-inner { padding: 0 20px; }
  .lg-title { font-size: 32px; }
  .lg-wrap { padding: 28px 0 60px; }
}
</style>
