---
---
<form class="beehiiv-fallback-form" id="newsletter-form" data-subscribe>
  <input type="email" name="email" id="newsletter-email" placeholder="Enter your email" aria-label="Email address" aria-describedby="newsletter-msg" required />
  <button type="submit" id="newsletter-btn" class="sub-btn"><span class="sub-label">Subscribe →</span><span class="sub-spin" aria-hidden="true"></span></button>
</form>
<p class="beehiiv-open-note" id="newsletter-msg" role="status" data-subscribe-msg></p>

<script>import '../scripts/subscribe';</script>

<style>
  .beehiiv-fallback-form {
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .beehiiv-fallback-form input[type="email"] {
    flex: 1;
    min-width: 220px;
    max-width: 320px;
    padding: 12px 16px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 4px;
    color: #fff;
    font-family: var(--fb);
    font-size: 14px;
  }
  .beehiiv-fallback-form input[type="email"]::placeholder {
    color: var(--on-dark-muted);
  }
  .beehiiv-fallback-form button {
    padding: 12px 24px;
    background: var(--accent);
    color: var(--on-accent);
    border: none;
    border-radius: 4px;
    font-family: var(--fd);
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .05em;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color var(--dur-fast) var(--ease-out), var(--press-release);
  }
  .beehiiv-fallback-form button:active { background: var(--accent-mid); }
  .beehiiv-fallback-form input[type="email"][aria-invalid="true"] { border-color: var(--sub-error-on-dark); }
  @media (hover: hover) and (pointer: fine) {
    .beehiiv-fallback-form button:hover {
      background: var(--accent-mid);
    }
  }
  .beehiiv-fallback-form button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .beehiiv-open-note:empty { margin: 0; }
  .beehiiv-open-note[data-state="error"] { color: var(--sub-error-on-dark); }
  .beehiiv-open-note[data-state="success"] { color: #fff; font-size: 15px; justify-content: center; }
  .beehiiv-open-note {
    font-size: 13px;
    color: var(--on-dark-muted);
    font-family: var(--fb);
    text-align: center;
    margin: 8px 0 0;
  }
</style>
