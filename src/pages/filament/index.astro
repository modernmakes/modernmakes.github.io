---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const FILAMENT_CATEGORIES: Record<string, string> = {
  'pla':       'Standard',
  'petg':      'Standard',
  'silk-pla':  'Standard',
  'matte-pla': 'Standard',
  'abs':       'Engineering',
  'asa':       'Engineering',
  'pc':        'Engineering',
  'pla-cf':    'Engineering',
  'petg-cf':   'Engineering',
  'pa-cf':     'Engineering',
  'pa12':      'Engineering',
  'tpu':       'Flexible',
  'tpe':       'Flexible',
  'pva':       'Support',
  'hips':      'Support',
};

// Prescribed display order (pla is a static page — not in collection)
const SORT_ORDER = [
  'petg', 'matte-pla', 'silk-pla',
  'pla-cf', 'petg-cf', 'asa', 'abs', 'pa-cf', 'pa12', 'pc',
  'tpu', 'tpe',
  'pva', 'hips',
];

const entries = await getCollection('filament');
const sorted = [...entries].sort((a, b) => {
  const ai = SORT_ORDER.indexOf(a.slug);
  const bi = SORT_ORDER.indexOf(b.slug);
  // Unknown slugs go to end
  if (ai === -1 && bi === -1) return a.slug.localeCompare(b.slug);
  if (ai === -1) return 1;
  if (bi === -1) return -1;
  return ai - bi;
});

// Category counts from actual collection entries
const categoryCounts: Record<string, number> = {};
for (const entry of sorted) {
  const cat = FILAMENT_CATEGORIES[entry.slug] ?? 'Other';
  categoryCounts[cat] = (categoryCounts[cat] ?? 0) + 1;
}

const FILTER_TABS = [
  { label: 'All',         key: 'All' },
  { label: 'Standard',    key: 'Standard' },
  { label: 'Engineering', key: 'Engineering' },
  { label: 'Flexible',    key: 'Flexible' },
  { label: 'Support',     key: 'Support' },
];

function verdictClass(v: string): string {
  const u = v.toUpperCase();
  if (u === 'BEST IN CLASS' || u === 'BEST')    return 'verdict-best';
  if (u === 'AVOID' || u === 'NOT RECOMMENDED') return 'verdict-avoid';
  return 'verdict-rec';
}

const difficultyColor: Record<string, string> = {
  Beginner:     '#16a34a',
  Intermediate: '#d97706',
  Advanced:     '#dc2626',
};

const totalCount = sorted.length;
---
<Base hasPageH1={true}
  title="Filament Reviews & Material Guides — Modern Makes"
  description="Independent filament reviews and material guides — PETG, ASA, ABS, PA-CF, TPU and more. Real settings, real prints, real verdicts."
  heroPage={true}
>
  <Nav slot="nav" currentPath="/filament" />

  <!-- HERO -->
  <section class="pg-hero">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div class="eyebrow" style="margin-bottom:12px">Modern Makes</div>
      <h1 style="font-family:'Barlow Condensed',sans-serif;font-size:56px;font-weight:800;color:#fff;line-height:1;letter-spacing:-.5px;margin-bottom:16px">
        Filament
      </h1>
      <p style="font-family:'Lora',serif;font-size:16px;color:rgba(255,255,255,.45);line-height:1.7;max-width:560px">
        Material guides, brand recommendations, and troubleshooting — every filament type we cover, with real print settings.
      </p>
    </div>
  </section>

  <!-- MATERIALS GRID -->
  <section class="section" style="background:var(--bg)">
    <div class="container">

      <div class="section-head">
        <span class="section-head-label">Materials</span>
        <span style="font-family:var(--fm);font-size:11px;color:var(--g2)">{totalCount} guides</span>
      </div>

      <!-- Filter strip -->
      <div class="fil-filter-strip" role="group" aria-label="Filter by category">
        {FILTER_TABS.map(tab => {
          const count = tab.key === 'All' ? totalCount : (categoryCounts[tab.key] ?? 0);
          return (
            <button
              class={`fil-filter-btn${tab.key === 'All' ? ' active' : ''}`}
              data-filter={tab.key}
              type="button"
            >
              {tab.label} <span class="fil-filter-count">({count})</span>
            </button>
          );
        })}
      </div>

      <!-- Results count -->
      <p id="filament-count" class="fil-results-count">
        Showing {totalCount} of {totalCount} materials
      </p>

      <!-- Cards grid -->
      <div class="fil-index-grid" id="filament-grid">
        {sorted.map(entry => {
          const { material, materialFull, verdict, verdictLabel, summary, stats } = entry.data;
          const category = FILAMENT_CATEGORIES[entry.slug] ?? 'Other';
          return (
            <a
              href={`/filament/${entry.slug}`}
              class="fil-index-card"
              data-category={category}
              data-slug={entry.slug}
            >
              <div class="fil-index-card-head">
                <div>
                  <p class="fil-index-full">{materialFull}</p>
                  <h2 class="fil-index-name">{material}</h2>
                </div>
                <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex-shrink:0">
                  <span class={`verdict ${verdictClass(verdict)}`}>{verdict}</span>
                  <span class="fil-cat-badge">{category}</span>
                </div>
              </div>
              <p class="fil-index-summary">{summary}</p>
              <div class="fil-index-chips">
                <span class="fil-index-chip">{stats.nozzleTemp}</span>
                <span class="fil-index-chip">{stats.bedTemp} bed</span>
                <span class="fil-index-chip" style={`color:${difficultyColor[stats.difficulty] ?? 'inherit'}`}>
                  {stats.difficulty}
                </span>
              </div>
              <div class="fil-index-footer">
                <span class="fil-index-verdict-label">{verdictLabel}</span>
                <span class="fil-index-arrow">→</span>
              </div>
            </a>
          );
        })}
      </div>

    </div>
  </section>

  <!-- BRIDGE TO NEWS -->
  <section class="section" style="background:var(--surface);border-top:1px solid var(--border)">
    <div class="container" style="max-width:720px">
      <div style="display:flex;align-items:flex-start;gap:20px;border:1px solid rgba(255,90,31,.2);border-radius:10px;padding:28px 32px;background:rgba(255,90,31,.04)">
        <div style="flex-shrink:0;width:40px;height:40px;background:var(--accent);border-radius:8px;display:flex;align-items:center;justify-content:center">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2z"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
        </div>
        <div>
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-size:20px;font-weight:800;color:var(--black);margin:0 0 8px;line-height:1">
            Filament launches and news
          </h3>
          <p style="font-family:'Lora',serif;font-size:14px;color:var(--g1);line-height:1.7;margin:0 0 14px">
            New filament releases, brand announcements, and material coverage also appear in our News section.
          </p>
          <a href="/news" style="display:inline-flex;align-items:center;gap:6px;font-family:'Barlow',sans-serif;font-size:13px;font-weight:700;color:var(--accent)">
            Browse News →
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "CollectionPage",
        "name": "Filament Reviews & Guides — Modern Makes",
        "description": "Independent filament reviews, buying guides, and comparisons for PETG, ASA, ABS, PA-CF, TPU and more.",
        "url": "https://modernmakes.github.io/filament",
        "isPartOf": { "@type": "WebSite", "url": "https://modernmakes.github.io" },
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home",     "item": "https://modernmakes.github.io" },
          { "@type": "ListItem", "position": 2, "name": "Filament", "item": "https://modernmakes.github.io/filament" },
        ],
      },
    ],
  })}></script>
</Base>

<style is:global>
/* ── FILTER STRIP ── */
.fil-filter-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
}
.fil-filter-btn {
  font-family: var(--fm);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .06em;
  text-transform: uppercase;
  padding: 6px 14px;
  border-radius: 20px;
  border: 1px solid var(--border-s);
  background: var(--surface);
  color: var(--g1);
  cursor: pointer;
  transition: background .12s, color .12s, border-color .12s;
  white-space: nowrap;
}
.fil-filter-btn:hover {
  border-color: var(--accent);
  color: var(--accent);
}
.fil-filter-btn.active {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}
.fil-filter-count {
  opacity: .75;
  font-size: 10px;
}

/* Results count */
.fil-results-count {
  font-family: var(--fm);
  font-size: 11px;
  color: var(--g2);
  margin-bottom: 20px;
}

/* ── CATEGORY BADGE ON CARDS ── */
.fil-cat-badge {
  font-family: var(--fm);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: var(--g2);
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 3px;
  padding: 2px 6px;
  white-space: nowrap;
}

/* ── MATERIAL GRID ── */
.fil-index-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.fil-index-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 22px 24px;
  text-decoration: none;
  color: inherit;
  transition: border-color .15s, transform .15s, box-shadow .15s;
  position: relative;
  overflow: hidden;
}
.fil-index-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: var(--accent);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .2s ease;
}
.fil-index-card:hover {
  border-color: var(--accent);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(255,90,31,.08);
}
.fil-index-card:hover::before { transform: scaleX(1); }
.fil-index-card[style*="display:none"] { transform: none !important; }

.fil-index-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}
.fil-index-full {
  font-family: var(--fm);
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--g2);
  margin: 0 0 3px;
}
.fil-index-name {
  font-family: var(--fd);
  font-size: 28px;
  font-weight: 800;
  color: var(--black);
  line-height: 1;
  margin: 0;
}
.fil-index-summary {
  font-family: var(--fb);
  font-size: 13px;
  color: var(--g1);
  line-height: 1.6;
  margin: 0;
  flex: 1;
}
.fil-index-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.fil-index-chip {
  font-family: var(--fm);
  font-size: 10px;
  color: var(--g1);
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 3px;
  padding: 2px 7px;
}
.fil-index-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12px;
  border-top: 1px solid var(--border);
  margin-top: auto;
}
.fil-index-verdict-label {
  font-family: var(--fu);
  font-size: 12px;
  color: var(--g2);
  font-style: italic;
}
.fil-index-arrow {
  font-size: 16px;
  color: var(--g2);
  transition: color .15s, transform .15s;
}
.fil-index-card:hover .fil-index-arrow { color: var(--accent); transform: translateX(3px); }

@media (max-width: 1024px) {
  .fil-index-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .fil-index-grid { grid-template-columns: 1fr; }
  .fil-filter-btn { font-size: 10px; padding: 5px 11px; }
}
</style>

<script>
  const TOTAL = document.querySelectorAll<HTMLElement>('.fil-index-card').length;

  document.querySelectorAll<HTMLButtonElement>('.fil-filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active button
      document.querySelectorAll<HTMLButtonElement>('.fil-filter-btn')
        .forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.dataset.filter ?? 'All';
      let visible = 0;

      document.querySelectorAll<HTMLElement>('.fil-index-card').forEach(card => {
        const match = filter === 'All' || card.dataset.category === filter;
        card.style.display = match ? '' : 'none';
        if (match) visible++;
      });

      const countEl = document.getElementById('filament-count');
      if (countEl) {
        countEl.textContent = filter === 'All'
          ? `Showing ${visible} of ${TOTAL} materials`
          : `Showing ${visible} of ${TOTAL} materials — ${filter}`;
      }
    });
  });
</script>
