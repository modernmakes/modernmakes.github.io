---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
const currentPath = '/voron/probe-system';

const products = [
  {
    id: 'voron-tap',
    name: 'Voron Tap',
    brand: 'VoronDesign',
    price: 20,
    priceNote: 'PCB only',
    badge: { label: 'TOP PICK', cls: 'verdict-best' },
    specs: ['Nozzle-contact', 'Official design', 'No dock required'],
    description: 'The current recommended default from the Voron team. Uses the nozzle itself as the probe — no dock, no offset error, no magnetic debris attraction. Requires Stealthburner or a compatible toolhead. The most consistent Z calibration method available for Voron.',
    compatible: '2.4,trident',
    vendor: 'West3D',
    vendorUrl: '#',
  },
  {
    id: 'klicky-pcb',
    name: 'Klicky PCB',
    brand: 'jlas1 / Community',
    price: 8,
    priceNote: 'PCB kit',
    badge: { label: 'POPULAR', cls: 'verdict-rec' },
    specs: ['Magnetic dock', 'Endstop-based', 'Frame-mounted dock'],
    description: 'The original community magnetic probe for Voron. Docks on the frame, attaches magnetically before probing, and detaches cleanly. Repeatability is excellent when calibrated. The Klicky PCB version is significantly more reliable than earlier wire-mount designs.',
    compatible: '2.4,trident',
    vendor: 'Lab4450',
    vendorUrl: '#',
  },
  {
    id: 'euclid-probe',
    name: 'Euclid Probe',
    brand: 'Euclid / Community',
    price: 15,
    priceNote: 'PCB kit',
    badge: { label: 'POPULAR', cls: 'verdict-rec' },
    specs: ['Magnetic dock', 'Open source', 'Board-to-board connection'],
    description: 'Open-source magnetic probe emphasizing dock reliability. Uses a board-to-board magnetic connection rather than SMD magnets, making the attach/detach motion more predictable. Excellent alternative when Klicky deploy reliability has been an issue.',
    compatible: '2.4,trident',
    vendor: 'Euclid Probe',
    vendorUrl: '#',
  },
  {
    id: 'beacon',
    name: 'Beacon',
    brand: 'Beacon3D',
    price: 60,
    badge: { label: 'COMMUNITY FAV', cls: 'verdict-comm' },
    specs: ['Eddy current', 'No contact', 'Contact mode support'],
    description: 'Eddy current proximity probe with exceptional repeatability and the fastest mesh scan speeds available. No physical contact means no nozzle wear during probing. Newer models add contact mode for absolute Z offset. Premium price, premium performance.',
    compatible: '2.4,trident',
    vendor: 'Beacon3D',
    vendorUrl: '#',
  },
];
---
<Base title="Probe Systems for Voron 2.4 & Trident" description="Z probe options for Voron 2.4 and Trident — Voron Tap, Klicky PCB, Euclid, and Beacon. Accuracy, repeatability, and community consensus compared.">
  <Nav slot="nav" currentPath={currentPath} />

  <!-- HEADER -->
  <div style="background:var(--black);padding:40px 0">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px">
        <a href="/" style="font-size:11px;color:rgba(255,255,255,.3);font-family:'JetBrains Mono',monospace">Home</a>
        <span style="color:rgba(255,255,255,.2)">/</span>
        <a href="/voron" style="font-size:11px;color:rgba(255,255,255,.3);font-family:'JetBrains Mono',monospace">Voron</a>
        <span style="color:rgba(255,255,255,.2)">/</span>
        <span style="font-size:11px;color:rgba(255,255,255,.55);font-family:'JetBrains Mono',monospace">Probe System</span>
      </div>
      <div class="eyebrow" style="margin-bottom:10px">Voron · Probe System</div>
      <h1 style="font-family:'Barlow Condensed',sans-serif;font-size:48px;font-weight:800;color:#fff;line-height:1;letter-spacing:-.5px;margin-bottom:12px">Probe Systems for Voron 2.4 &amp; Trident</h1>
      <p style="font-family:'Lora',serif;font-size:15px;color:rgba(255,255,255,.45);line-height:1.7;max-width:560px;margin-bottom:20px">Your Z probe determines first-layer consistency across every print. The Voron team recommends Tap as the default — but Klicky and Beacon remain strong choices depending on your toolhead and priorities.</p>
    </div>
  </div>

  <!-- MODEL CONTEXT BAR -->
  <div style="background:var(--surface);border-bottom:1px solid var(--border);padding:12px 0">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div class="model-context-bar" id="model-context">
        <span class="model-context-label">Showing parts for:</span>
        <span id="active-model-label" class="model-context-value">Voron 2.4</span>
        <a href="/voron" class="model-context-switch">Switch model →</a>
      </div>
    </div>
  </div>

  <!-- CONTEXT CALLOUT -->
  <div style="background:#f0efe9;border-bottom:1px solid var(--border);padding:20px 0">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div class="callout callout-orange" style="margin:0">
        <strong>Tap is the current recommended default</strong>
        Voron Tap eliminates the probe offset error inherent to dock-based probes and requires no calibration drift compensation. If you're running Stealthburner or XOL, Tap is the straightforward choice. Dock probes (Klicky, Euclid) are excellent when your toolhead doesn't support Tap. Beacon is the premium option for maximum scan speed and accuracy.
      </div>
    </div>
  </div>

  <!-- PRODUCTS -->
  <section class="section" aria-label="Voron probe system products">
    <div class="container">
      <div class="section-head">
        <h2 class="section-head-label">Probe options to consider</h2>
        <span style="font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--g2)">{products.length} products</span>
      </div>
      <div class="grid-3">
        {products.map(product => (
          <div class="product-card" data-compatible={product.compatible}>
            <div class="product-card-img" style="background:linear-gradient(135deg,#1e1e1e,#111);height:140px;display:flex;align-items:center;justify-content:center">
              <div style="text-align:center">
                <div style="font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:800;color:rgba(255,255,255,.15)">{product.brand}</div>
                <div style="font-family:'Barlow Condensed',sans-serif;font-size:16px;font-weight:700;color:rgba(255,255,255,.1)">{product.name}</div>
              </div>
            </div>
            <div class="product-card-body">
              <span class={`verdict-badge ${product.badge.cls}`}>{product.badge.label}</span>
              <div class="product-card-brand">{product.brand}</div>
              <div class="product-card-name">{product.name}</div>
              <div class="product-card-specs">
                {product.specs.map(s => <span class="spec-chip">{s}</span>)}
              </div>
              <p style="font-family:'Lora',serif;font-size:12px;color:var(--g1);line-height:1.65;margin-bottom:10px">{product.description}</p>
              <a href={product.vendorUrl} class="btn-buy" target="_blank" rel="noopener sponsored">
                Buy at {product.vendor} →
              </a>
              <div class="product-card-footer" style="margin-top:12px">
                <div>
                  <span class="product-card-price">${product.price}</span>
                  <span style="font-size:10px;color:var(--g2);margin-left:4px">{product.priceNote ?? 'USD'}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p style="font-size:11px;color:var(--g2);margin-top:20px;font-family:'Barlow',sans-serif">Affiliate links used — Modern Makes may earn a commission on purchases. This doesn't affect our recommendations. <a href="/about#affiliate" style="color:var(--accent)">See disclosure.</a></p>
    </div>
  </section>

  <!-- PROBE COMPARISON TABLE -->
  <section class="section" style="background:#fff;border-top:1px solid var(--border)" aria-label="Probe comparison">
    <div class="container">
      <div class="section-head">
        <h2 class="section-head-label">Probe method comparison</h2>
      </div>
      <div style="background:var(--bg);border-radius:10px;overflow:hidden;border:1px solid var(--border)">
        <table style="width:100%;border-collapse:collapse;font-size:12px;font-family:'Barlow',sans-serif">
          <thead>
            <tr style="background:var(--black)">
              <th style="text-align:left;padding:10px 16px;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.4);border-right:1px solid rgba(255,255,255,.08)">Probe</th>
              {['Method','Dock required','Offset error','Repeatability','Cost'].map(h => (
                <th style="text-align:center;padding:10px 12px;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.4)">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {[
              { name:'Voron Tap',  method:'Nozzle contact', dock:'No',  offset:'None',   repeat:'~0.5µm', cost:'~$20' },
              { name:'Klicky PCB', method:'Magnetic switch', dock:'Yes', offset:'XY + Z', repeat:'~1µm',   cost:'~$8' },
              { name:'Euclid',     method:'Magnetic switch', dock:'Yes', offset:'XY + Z', repeat:'~1µm',   cost:'~$15' },
              { name:'Beacon',     method:'Eddy current',   dock:'No',  offset:'Z only', repeat:'~0.2µm', cost:'~$60' },
            ].map((row, i) => (
              <tr style={`border-bottom:1px solid var(--border);background:${i%2===0 ? '#fff' : 'var(--bg)'}`}>
                <td style="padding:10px 16px;font-weight:600;color:var(--black);border-right:1px solid var(--border)">{row.name}</td>
                <td style="text-align:center;padding:10px 12px;color:var(--g1)">{row.method}</td>
                <td style={`text-align:center;padding:10px 12px;font-weight:600;color:${row.dock==='No' ? '#2E7D32' : 'var(--g1)'}`}>{row.dock}</td>
                <td style={`text-align:center;padding:10px 12px;color:${row.offset==='None' ? '#2E7D32' : 'var(--g1)'};font-weight:${row.offset==='None' ? '600' : '400'}`}>{row.offset}</td>
                <td style="text-align:center;padding:10px 12px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--g1)">{row.repeat}</td>
                <td style="text-align:center;padding:10px 12px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--g1)">{row.cost}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="font-size:11px;color:var(--g2);margin-top:10px">Repeatability figures are approximate community-reported values under controlled conditions. Your results depend on printer tuning and environment.</p>
    </div>
  </section>

  <!-- COMMUNITY MODS -->
  <section class="section" style="background:var(--bg);border-top:1px solid var(--border)" aria-label="Community probe resources">
    <div class="container">
      <div class="section-head">
        <h2 class="section-head-label">Community resources</h2>
        <span style="font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;background:#E8F5E9;color:#2E7D32;border:1px solid #A5D6A7;padding:2px 8px;border-radius:3px">Free / Open Source</span>
      </div>
      <div class="grid-3">
        {[
          { name:'Voron Tap', creator:'VoronDesign', desc:'Official print files, PCB design, and Klipper config for Voron Tap. Required reading before sourcing your PCB — the BOM has changed between Tap versions (RC8 vs Tap v2).', href:'https://github.com/VoronDesign/Voron-Tap' },
          { name:'Klicky Probe', creator:'jlas1', desc:'Full print files, BOM, and Klipper macros for Klicky and Klicky PCB. Includes dock designs for Voron 2.4 and Trident — the most comprehensive probe documentation in the community.', href:'https://github.com/jlas1/Klicky-Probe' },
          { name:'Euclid Probe', creator:'nionio6915', desc:'Open-source probe with detailed installation guides for Voron printers. Particularly useful reference for dock placement geometry and macro configuration.', href:'https://github.com/nionio6915/Euclid_Probe' },
        ].map(mod => (
          <a href={mod.href} target="_blank" rel="noopener">
            <div class="product-card community" style="background:#fff">
              <div class="product-card-body">
                <span class="community-badge">Community · Free</span>
                <div class="product-card-name" style="font-size:16px">{mod.name}</div>
                <div style="font-size:11px;color:var(--g2);margin-bottom:8px;font-family:'JetBrains Mono',monospace">by {mod.creator}</div>
                <div style="font-family:'Lora',serif;font-size:12px;color:var(--g1);line-height:1.6;margin-bottom:12px">{mod.desc}</div>
                <div class="product-card-footer" style="border-top:none;padding-top:0">
                  <span class="btn-printables">View on GitHub →</span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [{
      "@type": "ItemList",
      "name": "Probe Systems for Voron 2.4 and Trident 2026",
      "url": "https://modernmakes.github.io/voron/probe-system",
      "numberOfItems": 4,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Voron Tap" },
        { "@type": "ListItem", "position": 2, "name": "Klicky PCB" },
        { "@type": "ListItem", "position": 3, "name": "Euclid Probe" },
        { "@type": "ListItem", "position": 4, "name": "Beacon" },
      ]
    }]
  })}></script>
</Base>

<script>
  (function() {
    const STORAGE_KEY = 'voron-model';
    const params = new URLSearchParams(window.location.search);
    const model = params.get('model') || localStorage.getItem(STORAGE_KEY) || '2.4';
    localStorage.setItem(STORAGE_KEY, model);

    const label = document.getElementById('active-model-label');
    if (label) label.textContent = model === '2.4' ? 'Voron 2.4' : 'Voron Trident';

    document.querySelectorAll<HTMLElement>('[data-compatible]').forEach(el => {
      const compatible = (el.dataset.compatible ?? '').split(',');
      el.style.display = compatible.includes(model) ? '' : 'none';
    });
  })();
</script>
