---
/* Hallmark · macrostructure: Long Document (2-col prose + sticky sidebar TOC)
 * pre-emit critique: P5 H4 E5 S4 R5 V5
 */
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const siteBase = Astro.site
  ? new URL(Astro.site).href.replace(/\/$/, '')
  : 'https://modernmakes.github.io';

const sections = [
  { id: 'audience',     label: 'Our Audience' },
  { id: 'partnerships', label: 'Partnership Options' },
  { id: 'standards',    label: 'Our Standards' },
  { id: 'contact',      label: 'Get in Touch' },
];

const tracks = [
  {
    label: 'Sponsored Content',
    body: 'A dedicated long-form article or guide featuring your product, written in our editorial voice. Clearly labeled as sponsored. Included in the weekly newsletter send. Permanent on-site placement.',
    price: 'Contact for rates',
    note: 'Min. 2-week lead time',
  },
  {
    label: 'Newsletter Sponsorship',
    body: "A dedicated sponsor section inside The Modern Makes Brief — our weekly newsletter to opted-in subscribers. Text + link, matched to the issue's topic where possible.",
    price: 'Contact for rates',
    note: 'Slots book 4–6 weeks out',
  },
  {
    label: 'Affiliate Partnership',
    body: "Performance-based. We apply to your affiliate program and editorially promote your products on hardware detail pages, guides, and roundups where they're genuinely the right recommendation. No upfront cost.",
    price: 'No upfront cost',
    note: 'Editorial placement only — we choose where',
  },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Advertise — Modern Makes',
  url: `${siteBase}/advertise`,
  description: 'Reach the most serious 3D printing enthusiasts on the internet. Sponsored content, newsletter partnerships, and affiliate programs.',
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',      item: `${siteBase}/` },
    { '@type': 'ListItem', position: 2, name: 'Advertise', item: `${siteBase}/advertise` },
  ],
};
---
<Base
  title="Advertise — Modern Makes"
  description="Reach the most serious 3D printing enthusiasts on the internet. Sponsored content, newsletter partnerships, and affiliate programs."
  hasPageH1={true}
>
  <Nav slot="nav" currentPath="/advertise" />

  <div class="lg-wrap">
    <div class="lg-inner">

      <nav class="lg-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <span>Advertise</span>
      </nav>

      <div class="lg-layout">

        <aside class="lg-sidebar" aria-label="Table of contents">
          <div class="lg-toc">
            <p class="lg-toc-label">On this page</p>
            <nav>
              {sections.map(s => (
                <a class="lg-toc-link" href={`#${s.id}`}>{s.label}</a>
              ))}
            </nav>
          </div>
        </aside>

        <main class="lg-content" id="lg-main">
          <h1 class="lg-title">Advertise</h1>
          <p class="lg-meta">Reach the most serious 3D printing enthusiasts on the internet</p>

          <section id="audience">
            <h2>Our Audience</h2>
            <p>Modern Makes is read by prosumer and enthusiast FDM 3D printing builders — people who buy Voron kits, source hotends from specialty vendors, follow CoreXY development, and care about the difference between a well-tuned and a badly-tuned machine.</p>
            <p>Our readers research before they spend, and they spend significantly. They are not casual hobbyists looking for cheap beginner printers. They are the community members who post on r/voroncorexy, hang out in Discord build servers, and read teardown threads.</p>
            <p>Audience metrics available on request.</p>
          </section>

          <section id="partnerships">
            <h2>Partnership Options</h2>
            <p>Three ways to work with us. Each is structured to protect both your commercial goals and our editorial credibility.</p>

            <div class="adv-track-list">
              {tracks.map(t => (
                <div class="adv-track-card">
                  <div class="adv-track-head">
                    <span class="adv-track-name">{t.label}</span>
                    <span class="adv-track-price">{t.price}</span>
                  </div>
                  <p class="adv-track-body">{t.body}</p>
                  <div class="adv-track-note">{t.note}</div>
                </div>
              ))}
            </div>
          </section>

          <section id="standards">
            <h2>Our Standards</h2>
            <p>We decline partnerships that conflict with editorial independence. Every commercial relationship we enter is disclosed to readers — either on the relevant content page or in our affiliate disclosure.</p>
            <ul>
              <li>Sponsored content is always labeled. Readers are never deceived about its commercial nature.</li>
              <li>We don't write positive verdicts in exchange for payment. Ever.</li>
              <li>Affiliate links are editorial. We link to what we'd link to anyway.</li>
              <li>We won't take a partnership that requires us to hide the relationship or imply an endorsement we don't hold.</li>
            </ul>
            <p>If your ask requires us to hide the relationship or imply an editorial endorsement we don't hold, we'll decline politely. That's not a negotiating position — it's how we've kept reader trust.</p>
          </section>

          <section id="contact">
            <h2>Get in Touch</h2>
            <p>Tell us what you're looking for. We respond within 2 business days.</p>

            <form class="lg-form" id="adv-form">
              <div class="lg-form-row">
                <div class="lg-form-group">
                  <label class="lg-form-label" for="adv-name">Name</label>
                  <input class="lg-form-input" type="text" id="adv-name" placeholder="Your name" required />
                </div>
                <div class="lg-form-group">
                  <label class="lg-form-label" for="adv-company">Company</label>
                  <input class="lg-form-input" type="text" id="adv-company" placeholder="Company or brand" required />
                </div>
              </div>
              <div class="lg-form-row">
                <div class="lg-form-group">
                  <label class="lg-form-label" for="adv-email">Email</label>
                  <input class="lg-form-input" type="email" id="adv-email" placeholder="you@company.com" required />
                </div>
                <div class="lg-form-group">
                  <label class="lg-form-label" for="adv-ptype">Partnership type</label>
                  <select class="lg-form-input" id="adv-ptype">
                    <option value="">Select...</option>
                    <option value="Sponsored Content">Sponsored Content</option>
                    <option value="Newsletter Sponsorship">Newsletter Sponsorship</option>
                    <option value="Affiliate Partnership">Affiliate Partnership</option>
                    <option value="Other">Other</option>
                  </select>
                </div>
              </div>
              <div class="lg-form-group">
                <label class="lg-form-label" for="adv-msg">Message</label>
                <textarea class="lg-form-input lg-form-textarea" id="adv-msg" placeholder="What are you looking for? Budget, timeline, product details…" rows="5" required></textarea>
              </div>
              <button class="lg-form-submit" type="submit" id="adv-btn">Send Inquiry</button>
              <p class="lg-form-msg" id="adv-msg-out" style="display:none"></p>
            </form>
          </section>

        </main>
      </div>
    </div>
  </div>

  <Footer slot="footer" />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify(pageSchema)}></script>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)}></script>
</Base>

<script>
(function () {
  const sections = document.querySelectorAll<HTMLElement>('.lg-content section[id]');
  const links    = document.querySelectorAll<HTMLAnchorElement>('.lg-toc-link');
  if (!sections.length || !links.length) return;
  const obs = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        links.forEach(l => l.removeAttribute('aria-current'));
        const active = document.querySelector<HTMLAnchorElement>(`.lg-toc-link[href="#${entry.target.id}"]`);
        if (active) active.setAttribute('aria-current', 'true');
      }
    }
  }, { rootMargin: '-15% 0px -75% 0px' });
  sections.forEach(s => obs.observe(s));
})();
</script>

<script is:inline>
(function () {
  var form = document.getElementById('adv-form');
  var btn  = document.getElementById('adv-btn');
  var out  = document.getElementById('adv-msg-out');
  if (!form) return;

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var name    = document.getElementById('adv-name').value;
    var company = document.getElementById('adv-company').value;
    var email   = document.getElementById('adv-email').value;
    var ptype   = document.getElementById('adv-ptype').value;
    var message = document.getElementById('adv-msg').value;

    btn.textContent = 'Sending…';
    btn.disabled = true;

    fetch('https://hook.us1.make.com/xxkrs4kgfwvgp0d83ve2oylwy6pntes2', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ type: 'advertise', name: name, company: company, email: email, partnershipType: ptype, message: message, page: 'advertise' })
    })
    .then(function () {
      form.style.display = 'none';
      out.textContent = 'Inquiry sent. We'll follow up within a few business days.';
      out.style.color = 'var(--g1)';
      out.style.display = 'block';
    })
    .catch(function () {
      btn.textContent = 'Send Inquiry';
      btn.disabled = false;
      out.textContent = 'Something went wrong. Email modernmakesco@gmail.com directly.';
      out.style.color = 'var(--accent)';
      out.style.display = 'block';
    });
  });
})();
</script>

<style>
.adv-track-list { display: flex; flex-direction: column; gap: 14px; margin-top: 20px; }
.adv-track-card {
  border: 1px solid var(--border);
  border-top: 3px solid var(--accent);
  border-radius: 6px;
  padding: 20px;
  background: var(--surface);
}
.adv-track-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 10px;
}
.adv-track-name {
  font-family: var(--fd);
  font-size: 18px;
  font-weight: 800;
  color: var(--black);
  line-height: 1.1;
}
.adv-track-price {
  font-family: var(--fm);
  font-size: 10px;
  font-weight: 700;
  color: var(--accent);
  background: rgba(255,90,31,.08);
  border: 1px solid rgba(255,90,31,.2);
  border-radius: 3px;
  padding: 2px 8px;
  white-space: nowrap;
  flex-shrink: 0;
}
.adv-track-body {
  font-family: var(--fb);
  font-size: 14px;
  color: var(--g1);
  line-height: 1.75;
  margin-bottom: 10px;
}
.adv-track-note {
  font-family: var(--fm);
  font-size: 10px;
  color: var(--g2);
  border-top: 1px solid var(--border);
  padding-top: 8px;
}
</style>
