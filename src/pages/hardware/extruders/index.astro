---
import HardwareIndex from '../../../components/HardwareIndex.astro';
import records from '../../../data/hardware/extruders.json';

const chips = (r: any) => [
  r['Gear Ratio'] ? String(r['Gear Ratio']) : null,
  r['Price (USD)'] != null ? `~$${r['Price (USD)']}` : null,
].filter(Boolean) as string[];
---
<HardwareIndex
  records={records}
  route="extruders"
  categoryLabel="EXTRUDER"
  crumb="Extruders"
  heading="Extruders"
  sub="Direct-drive and Bowden extruders. Gear ratios, weight, and toolhead fit."
  nounSingular="extruder"
  nounPlural="extruders"
  title="Best Extruders for Voron & Prosumer Printers"
  description="Extruder specs, compatibility, and where to buy — gear ratios, weight, and toolhead fit for Voron and other CoreXY builds."
  schemaName="Best Extruders for Voron & Prosumer Printers"
  chips={chips}
/>
