const COLORS = ['#FF5A1F', '#3B82F6', '#10B981', '#8B5CF6'];
const SPEED_MAX = 1200;
const SPEED_STEP = 20;
const SPEED_LABELS = Array.from({ length: SPEED_MAX / SPEED_STEP + 1 }, (_, i) => i * SPEED_STEP);

// ── PHYSICS ──────────────────────────────────────────────────────────────────
function torqueAt(motor: Motor, speedMms: number, voltage: number, driveCurrent: number, pulleyTeeth: number): number {
  const stepsPerRev = 360 / motor.stepDeg;
  const mmPerStep   = (pulleyTeeth * 2) / stepsPerRev; // GT2 2mm pitch
  const stepsPerSec = speedMms / mmPerStep;
  const fCoil       = stepsPerSec / 4; // electrical cycles/s for bipolar stepper
  const inductH     = motor.inductMH / 1000;
  const xCoil       = 2 * Math.PI * fCoil * inductH;
  const zCoil       = Math.sqrt(motor.resistOhm ** 2 + xCoil ** 2);
  const vGen        = driveCurrent * zCoil;
  const vAvail      = Math.max(0, voltage - vGen);
  const iAvail      = vAvail / motor.resistOhm;
  const iActual     = Math.min(iAvail, driveCurrent);
  return Math.max(0, motor.holdNcm * (iActual / motor.ratedA));
}

function computeCurve(motor: Motor, voltage: number, driveCurrent: number, pulleyTeeth: number): number[] {
  return SPEED_LABELS.map(s =>
    s === 0
      ? motor.holdNcm * Math.min(driveCurrent, voltage / motor.resistOhm) / motor.ratedA
      : torqueAt(motor, s, voltage, driveCurrent, pulleyTeeth)
  );
}

function torqueRequired(massG: number, accelMms2: number, pulleyTeeth: number): number {
  const forceN        = (massG / 1000) * (accelMms2 / 1000);
  const pitchRadiusCm = (pulleyTeeth * 2) / (2 * Math.PI) / 10; // mm → cm
  return forceN * pitchRadiusCm;
}

function maxUsableSpeed(curve: number[], reqNcm: number): number | null {
  for (let i = 1; i < curve.length; i++) {
    if (curve[i] < reqNcm && curve[i - 1] >= reqNcm) {
      const t = (reqNcm - curve[i - 1]) / (curve[i] - curve[i - 1]);
      return (i - 1 + t) * SPEED_STEP;
    }
  }
  return curve[curve.length - 1] >= reqNcm ? null : 0; // null = ">1200"
}

// ── CHART ────────────────────────────────────────────────────────────────────
function buildChartConfig(datasets: any[]) {
  return {
    type: 'line',
    data: { labels: SPEED_LABELS, datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 200 },
      interaction: { mode: 'index', intersect: false },
      scales: {
        x: {
          title: { display: true, text: 'Speed (mm/s)', color: '#666', font: { family: "'JetBrains Mono', monospace", size: 11 } },
          grid: { color: '#222' },
          ticks: { color: '#555', font: { family: "'JetBrains Mono', monospace", size: 10 }, maxTicksLimit: 13 },
        },
        y: {
          title: { display: true, text: 'Torque (N·cm)', color: '#666', font: { family: "'JetBrains Mono', monospace", size: 11 } },
          min: 0,
          grid: { color: '#222' },
          ticks: { color: '#555', font: { family: "'JetBrains Mono', monospace", size: 10 } },
        },
      },
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            color: '#888',
            font: { family: "'JetBrains Mono', monospace", size: 10 },
            usePointStyle: true,
            pointStyleWidth: 12,
            boxHeight: 2,
            padding: 16,
          },
        },
        tooltip: {
          backgroundColor: '#1a1a1a',
          borderColor: '#333',
          borderWidth: 1,
          titleColor: '#ccc',
          bodyColor: '#999',
          titleFont: { family: "'JetBrains Mono', monospace", size: 11 },
          bodyFont: { family: "'JetBrains Mono', monospace", size: 11 },
          callbacks: {
            title: (items: any[]) => `${items[0].label} mm/s`,
            label: (item: any) => ` ${item.dataset.label}: ${Number(item.raw).toFixed(1)} N·cm`,
          },
        },
      },
    },
  };
}

// ── MAIN ─────────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  let voltage     = 24;
  const selected  = new Set<string>(['ldo-42sth48-2504ac', 'omc-17hs19-2004s1']);
  let chart: any  = null;
  let maxMsgTimer: ReturnType<typeof setTimeout> | null = null;

  const canvasEl = document.getElementById('torqueChart') as HTMLCanvasElement;

  function getInputs() {
    const driveA    = parseFloat((document.getElementById('driveCurrent') as HTMLInputElement).value) || 2.0;
    const pulley    = parseInt((document.getElementById('pulleyTeeth') as HTMLSelectElement).value) || 20;
    const accel     = parseFloat((document.getElementById('accelInput') as HTMLInputElement).value) || 10000;
    const mass      = parseFloat((document.getElementById('massInput') as HTMLInputElement).value) || 500;
    return { driveA, pulley, accel, mass };
  }

  function showMaxMsg() {
    const el = document.getElementById('maxMsg') as HTMLElement;
    el.classList.add('visible');
    if (maxMsgTimer) clearTimeout(maxMsgTimer);
    maxMsgTimer = setTimeout(() => el.classList.remove('visible'), 2200);
  }

  function renderMotorList() {
    const search    = ((document.getElementById('motorSearch') as HTMLInputElement).value || '').toLowerCase();
    const container = document.getElementById('motorList') as HTMLElement;
    const filtered  = MOTORS.filter(m =>
      !search || m.brand.toLowerCase().includes(search) || m.model.toLowerCase().includes(search)
    );
    container.innerHTML = filtered.map(m =>
      `<button type="button" class="ms-motor-item${selected.has(m.id) ? ' selected' : ''}" data-id="${m.id}">
        <span class="ms-motor-item-brand">${m.brand} · NEMA${m.nema} · ${m.bodyMm}mm</span>
        ${m.model}
      </button>`
    ).join('');
    container.querySelectorAll<HTMLButtonElement>('.ms-motor-item').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.id ?? '';
        if (selected.has(id)) {
          selected.delete(id);
        } else if (selected.size < 4) {
          selected.add(id);
        } else {
          showMaxMsg();
          return;
        }
        renderAll();
      });
    });
  }

  function buildDatasets(driveA: number, pulley: number, reqNcm: number) {
    const selectedMotors = MOTORS.filter(m => selected.has(m.id));
    const datasets: any[] = selectedMotors.map((motor, i) => ({
      label: `${motor.brand} ${motor.model}`,
      data: computeCurve(motor, voltage, driveA, pulley),
      borderColor: COLORS[i],
      backgroundColor: 'transparent',
      borderWidth: 2.5,
      pointRadius: 0,
      tension: 0.35,
    }));
    // Torque required line
    datasets.push({
      label: `Torque required (${reqNcm.toFixed(2)} N·cm)`,
      data: SPEED_LABELS.map(() => reqNcm),
      borderColor: '#EF4444',
      borderDash: [6, 4],
      borderWidth: 1.5,
      pointRadius: 0,
      backgroundColor: 'transparent',
      tension: 0,
    });
    return { datasets, selectedMotors };
  }

  function updateChart(driveA: number, pulley: number, reqNcm: number) {
    const { datasets } = buildDatasets(driveA, pulley, reqNcm);
    const allTorques   = datasets.flatMap(ds => ds.data as number[]).filter(v => isFinite(v));
    const yMax         = Math.ceil(Math.max(...allTorques, reqNcm, 10) / 5) * 5 + 5;

    if (!chart) {
      const cfg = buildChartConfig(datasets);
      (cfg.options as any).scales.y.max = yMax;
      chart = new Chart(canvasEl, cfg);
    } else {
      chart.data.datasets   = datasets;
      chart.options.scales.y.max = yMax;
      chart.update('none');
    }
  }

  function updateSummary(driveA: number, pulley: number, reqNcm: number) {
    const selectedMotors = MOTORS.filter(m => selected.has(m.id));
    const tbody          = document.getElementById('summaryBody') as HTMLTableSectionElement;
    if (!selectedMotors.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="ms-empty">Select motors to see summary.</td></tr>';
      return;
    }
    const suit48 = (m: Motor) => {
      const ratio = 48 / (m.ratedA * m.resistOhm);
      if (ratio > 4) return '<span class="ms-48v-good">Great</span>';
      if (ratio > 2) return '<span class="ms-48v-ok">OK</span>';
      return '<span class="ms-48v-not">Not ideal</span>';
    };
    tbody.innerHTML = selectedMotors.map((m, i) => {
      const curve   = computeCurve(m, voltage, driveA, pulley);
      const maxSpd  = maxUsableSpeed(curve, reqNcm);
      const t100idx = Math.round(100 / SPEED_STEP);
      const t300idx = Math.round(300 / SPEED_STEP);
      const spdLabel = maxSpd === null ? '<span class="ms-speed-val capped">&gt;1200 mm/s</span>' :
                       maxSpd === 0    ? '<span class="ms-speed-val capped">— (below req.)</span>' :
                       `<span class="ms-speed-val" style="color:${COLORS[i]}">${maxSpd.toFixed(0)} mm/s</span>`;
      return `<tr>
        <td><span class="ms-motor-dot" style="background:${COLORS[i]}"></span>${m.brand} ${m.model}</td>
        <td>${spdLabel}</td>
        <td style="font-family:var(--fm);font-size:12px">${(curve[t100idx] ?? 0).toFixed(1)} N·cm</td>
        <td style="font-family:var(--fm);font-size:12px">${(curve[t300idx] ?? 0).toFixed(1)} N·cm</td>
        <td>${suit48(m)}</td>
      </tr>`;
    }).join('');
  }

  function updateSpecTable() {
    const selectedMotors = MOTORS.filter(m => selected.has(m.id));
    const tbody = document.getElementById('specBody') as HTMLTableSectionElement;
    if (!selectedMotors.length) {
      tbody.innerHTML = '<tr><td colspan="8" class="ms-empty">Select motors above.</td></tr>';
      return;
    }
    tbody.innerHTML = selectedMotors.map((m, i) =>
      `<tr>
        <td><span class="ms-motor-dot" style="background:${COLORS[i]}"></span>${m.brand} ${m.model}</td>
        <td>NEMA ${m.nema}</td>
        <td>${m.bodyMm}mm</td>
        <td>${m.stepDeg}°</td>
        <td>${m.ratedA}A</td>
        <td>${m.holdNcm}</td>
        <td>${m.inductMH}</td>
        <td>${m.resistOhm}</td>
      </tr>`
    ).join('');
  }

  function renderAll() {
    const { driveA, pulley, accel, mass } = getInputs();
    const reqNcm = torqueRequired(mass, accel, pulley);

    // Update computed display
    (document.getElementById('torqueRequiredDisplay') as HTMLElement).textContent = `${reqNcm.toFixed(2)} N·cm`;
    (document.getElementById('chartSubtitle') as HTMLElement).textContent =
      `${voltage}V · ${pulley}T pulley · ${driveA}A drive`;

    updateChart(driveA, pulley, reqNcm);
    updateSummary(driveA, pulley, reqNcm);
    updateSpecTable();
    renderMotorList();
  }

  // Wire inputs
  document.getElementById('btn24')?.addEventListener('click', () => {
    voltage = 24;
    document.getElementById('btn24')?.classList.add('active');
    document.getElementById('btn48')?.classList.remove('active');
    renderAll();
  });
  document.getElementById('btn48')?.addEventListener('click', () => {
    voltage = 48;
    document.getElementById('btn48')?.classList.add('active');
    document.getElementById('btn24')?.classList.remove('active');
    renderAll();
  });
  ['driveCurrent', 'pulleyTeeth', 'accelInput', 'massInput'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', renderAll);
  });
  document.getElementById('motorSearch')?.addEventListener('input', renderMotorList);

  renderAll();
});
</script>
