---
import HardwareIndex from '../../../components/HardwareIndex.astro';
import records from '../../../data/hardware/toolboards.json';

const chips = (r: any) => [
  r['MCU'] ? String(r['MCU']) : null,
  r['Driver'] ? String(r['Driver']) : null,
  r['Price (USD)'] != null ? `~$${r['Price (USD)']}` : null,
].filter(Boolean) as string[];
---
<HardwareIndex
  records={records}
  route="toolboards"
  categoryLabel="TOOLBOARD"
  crumb="Toolboards"
  heading="Toolboards"
  sub="CAN-bus toolhead boards. MCU, onboard driver, accelerometer, and Neopixel support."
  nounSingular="toolboard"
  nounPlural="toolboards"
  title="Best CAN Toolhead Boards for Voron & Klipper Printers"
  description="Toolboard specs, MCU, onboard driver, accelerometer, and where to buy — CAN-bus toolhead boards for Voron and CoreXY builds."
  schemaName="Best CAN Toolhead Boards for Voron & Klipper Printers"
  chips={chips}
/>
