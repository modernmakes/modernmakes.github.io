---
// Old Voron toolhead URLs now live under /hardware/toolheads. GitHub Pages has no server redirects,
// so each old path is a meta refresh plus canonical and a visible link.
import toolheads from '../../../data/toolheads.json';

// Voron guide slug -> hardware slug. Mini-Stealthburner has no Airtable record, so it lands on the index.
const TARGET: Record<string, string> = {
  stealthburner: '/hardware/toolheads/stealthburner',
  xol: '/hardware/toolheads/xol',
  'dragon-burner': '/hardware/toolheads/dragon-burner-2-4-trident-v0',
  archetype: '/hardware/toolheads/archetype',
  'mini-stealthburner': '/hardware/toolheads',
};

export function getStaticPaths() {
  return Object.keys(toolheads).map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const target = TARGET[slug as string] ?? '/hardware/toolheads';
const canonical = new URL(target, Astro.site ?? 'https://modernmakes.github.io').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved: Toolheads — Modern Makes</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>This page has moved to <a href={target}>{target}</a>.</p>
  </body>
</html>
