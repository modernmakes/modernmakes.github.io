---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import hotendsData from '../../data/products/hotends.json';
const currentPath = '/voron/hotends';
const voronHotends = hotendsData.products.filter(p =>
  p.compatibility.some(c => c.startsWith('voron'))
);

// Verdict badges for top of each card
const badges: Record<string, { label: string; cls: string }> = {
  'rapido-2':              { label: 'OUR PICK',    cls: 'verdict-best' },
  'dragon-hf':             { label: 'RECOMMENDED', cls: 'verdict-rec'  },
  'revo-voron':            { label: 'RECOMMENDED', cls: 'verdict-rec'  },
  'nf-crazy':              { label: 'BUDGET',      cls: 'verdict-upd'  },
  'bambu-hardened-nozzle': { label: 'BAMBU ONLY',  cls: 'verdict-skip' },
};
---
<Base title="Best Hotends for Voron 2.4 & Trident" description="Every hotend worth considering for Voron 2.4 and Trident builds — Rapido 2, Dragon HF, Revo Voron, and more. Compatibility matrix, community consensus, and affiliate links.">
  <Nav slot="nav" currentPath={currentPath} />

  <!-- HEADER -->
  <div style="background:var(--black);padding:40px 0">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <!-- Breadcrumb -->
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px">
        <a href="/" style="font-size:11px;color:rgba(255,255,255,.3);font-family:'JetBrains Mono',monospace">Home</a>
        <span style="color:rgba(255,255,255,.2)">/</span>
        <a href="/voron" style="font-size:11px;color:rgba(255,255,255,.3);font-family:'JetBrains Mono',monospace">Voron</a>
        <span style="color:rgba(255,255,255,.2)">/</span>
        <span style="font-size:11px;color:rgba(255,255,255,.55);font-family:'JetBrains Mono',monospace">Hotends</span>
      </div>
      <div class="eyebrow" style="margin-bottom:10px">Voron · Hotends</div>
      <h1 style="font-family:'Barlow Condensed',sans-serif;font-size:48px;font-weight:800;color:#fff;line-height:1;letter-spacing:-.5px;margin-bottom:12px">Hotends for Voron 2.4 &amp; Trident</h1>
      <p style="font-family:'Lora',serif;font-size:15px;color:rgba(255,255,255,.45);line-height:1.7;max-width:560px;margin-bottom:20px">The hotend is the most consequential upgrade on a Voron build. Max temp, flow rate, and toolhead compatibility all matter. The community has largely settled on the Rapido 2 as the default — but the right choice depends on your use case.</p>
    </div>
  </div>

  <!-- MODEL CONTEXT BAR (Step 2) -->
  <div style="background:var(--surface);border-bottom:1px solid var(--border);padding:12px 0">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div class="model-context-bar" id="model-context">
        <span class="model-context-label">Showing parts for:</span>
        <span id="active-model-label" class="model-context-value">Voron 2.4</span>
        <a href="/voron" class="model-context-switch">Switch model →</a>
      </div>
    </div>
  </div>

  <!-- CONTEXT CALLOUT -->
  <div style="background:#f0efe9;border-bottom:1px solid var(--border);padding:20px 0">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div class="callout callout-orange" style="margin:0">
        <strong>What to know before you choose</strong>
        Flow rate (mm³/s) is the number that matters for speed. Max temp matters for engineering materials — PA12, PC, and PEEK need 280°C+. Thermistor type affects accuracy at high temps: PT1000 is more accurate than NTC 100K above 250°C. Toolhead compatibility: check that your chosen hotend works with your toolhead before ordering.
      </div>
    </div>
  </div>

  <!-- PRODUCTS -->
  <section class="section" aria-label="Voron hotend products">
    <div class="container">
      <div class="section-head">
        <h2 class="section-head-label">Hotends to consider</h2>
        <span style="font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--g2)">{voronHotends.length} products</span>
      </div>
      <div class="grid-3">
        {voronHotends.map(product => {
          const badge = badges[product.id];
          const buyVendor = product.primaryVendor ?? product.vendors.find(v => v.primary) ?? product.vendors[0];
          return (
            <div class="product-card" data-compatible={product.compatible.join(',')}>
              <div class="product-card-img" style="background:linear-gradient(135deg,#1e1e1e,#111);height:140px;display:flex;align-items:center;justify-content:center">
                <div style="text-align:center">
                  <div style="font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:800;color:rgba(255,255,255,.15)">{product.brand}</div>
                  <div style="font-family:'Barlow Condensed',sans-serif;font-size:16px;font-weight:700;color:rgba(255,255,255,.1)">{product.name}</div>
                </div>
              </div>
              <div class="product-card-body">
                {/* Verdict badge at top of card */}
                {badge && (
                  <span class={`verdict-badge ${badge.cls}`}>{badge.label}</span>
                )}
                <div class="product-card-brand">{product.brand}</div>
                <div class="product-card-name">{product.name}</div>
                <div class="product-card-specs">
                  {product.maxTemp && <span class="spec-chip">{product.maxTemp}°C max</span>}
                  {product.maxFlow && <span class="spec-chip">{product.maxFlow}mm³/s</span>}
                  {product.thermistor && <span class="spec-chip">{product.thermistor}</span>}
                </div>
                <p style="font-family:'Lora',serif;font-size:12px;color:var(--g1);line-height:1.65;margin-bottom:10px">{product.description}</p>
                {product.toolheads && product.toolheads.length > 0 && (
                  <div style="margin-bottom:12px">
                    <div style="font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--g2);margin-bottom:5px">Fits</div>
                    <div style="display:flex;flex-wrap:wrap;gap:4px">
                      {product.toolheads.map(t => (
                        <span style="font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--g1);background:var(--bg);border:1px solid var(--border);border-radius:3px;padding:2px 6px">{t}</span>
                      ))}
                    </div>
                  </div>
                )}
                {/* Primary buy CTA */}
                <a href={buyVendor?.url ?? '#'}
                   class="btn-buy"
                   target="_blank"
                   rel="noopener sponsored">
                  Buy at {buyVendor?.name ?? 'vendor'} →
                </a>
                {/* Full review link */}
                <a href={product.reviewPath} class="btn-review">
                  Full review →
                </a>
                <!-- Footer: price + verdict -->
                <div class="product-card-footer" style="margin-top:12px">
                  <div>
                    <span class="product-card-price">${product.price}</span>
                    <span style="font-size:10px;color:var(--g2);margin-left:4px">USD</span>
                  </div>
                  {product.verdict && (
                    <span class={`verdict verdict-${product.verdict}`}>{product.verdictLabel}</span>
                  )}
                </div>
                {product.vendors.length > 1 && (
                  <div style="margin-top:8px;padding-top:8px;border-top:1px solid var(--border)">
                    <span style="font-size:10px;color:var(--g2);margin-right:6px">Also at:</span>
                    {product.vendors.filter(v => !v.primary).map(vendor => (
                      <a href={vendor.url} style="font-size:10px;color:var(--accent);margin-right:10px;font-family:'JetBrains Mono',monospace" target="_blank" rel="noopener nofollow">{vendor.name}</a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
      <p style="font-size:11px;color:var(--g2);margin-top:20px;font-family:'Barlow',sans-serif">Affiliate links used — Modern Makes may earn a commission on purchases. This doesn't affect our recommendations. <a href="/about#affiliate" style="color:var(--accent)">See disclosure.</a></p>
    </div>
  </section>

  <!-- COMPATIBILITY MATRIX -->
  <section class="section" style="background:#fff;border-top:1px solid var(--border)" aria-label="Compatibility matrix">
    <div class="container">
      <div class="section-head">
        <h2 class="section-head-label">Toolhead compatibility</h2>
      </div>
      <div style="background:var(--bg);border-radius:10px;overflow:hidden;border:1px solid var(--border)">
        <table style="width:100%;border-collapse:collapse;font-size:12px;font-family:'Barlow',sans-serif">
          <thead>
            <tr style="background:var(--black)">
              <th style="text-align:left;padding:10px 16px;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.4);border-right:1px solid rgba(255,255,255,.08)">Hotend</th>
              {['Stealthburner','Xol','Dragon Burner','Mini-SB'].map(th => (
                <th style="text-align:center;padding:10px 12px;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.4)">{th}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {[
              { name:'Rapido 2', sb:'✓ Native', xol:'✓', db:'✓', msb:'✗' },
              { name:'Dragon HF', sb:'✓ Native', xol:'✓', db:'✓', msb:'✓' },
              { name:'Revo Voron', sb:'✓ Native', xol:'Adapter', db:'Adapter', msb:'✗' },
              { name:'NF-Crazy', sb:'✓', xol:'✓', db:'✓', msb:'✗' }
            ].map((row, i) => (
              <tr style={`border-bottom:1px solid var(--border);background:${i%2===0 ? '#fff' : 'var(--bg)'}`}>
                <td style="padding:10px 16px;font-weight:600;color:var(--black);border-right:1px solid var(--border)">{row.name}</td>
                {[row.sb, row.xol, row.db, row.msb].map(val => (
                  <td style={`text-align:center;padding:10px 12px;color:${val.startsWith('✓') ? '#2E7D32' : val === '✗' ? 'var(--accent-dk)' : '#E65100'};font-weight:${val.startsWith('✓') ? '600' : '400'}`}>{val}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="font-size:11px;color:var(--g2);margin-top:10px">✓ Native = fits without adapter. Adapter = community-printed adapter required. ✗ = not compatible.</p>
    </div>
  </section>

  <!-- COMMUNITY MODS -->
  <section class="section" style="background:var(--bg);border-top:1px solid var(--border)" aria-label="Community hotend mods">
    <div class="container">
      <div class="section-head">
        <h2 class="section-head-label">Community mods</h2>
        <span style="font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;background:#E8F5E9;color:#2E7D32;border:1px solid #A5D6A7;padding:2px 8px;border-radius:3px">Free / Printables</span>
      </div>
      <div class="grid-3">
        {[
          { name:'Stealthburner Toolhead', creator:'VoronDesign', desc:'The official Voron toolhead. Accepts Rapido 2, Dragon HF, and most standard hotends natively.', href:'https://github.com/VoronDesign/Voron-Stealthburner' },
          { name:'Xol Toolhead', creator:'Armchair Engineering', desc:'Lighter than Stealthburner, better cooling. Growing community adoption for high-speed printing.', href:'https://github.com/Armchair-Engineering/Xol-Toolhead' },
          { name:'Dragon Burner', creator:'chirpy2605', desc:'Compact, lightweight, and aggressively optimized for the Dragon hotend family. Popular for 0.2 builds.', href:'https://github.com/chirpy2605/voron-user-mods/tree/main/Dragon_Burner' }
        ].map(mod => (
          <a href={mod.href} target="_blank" rel="noopener">
            <div class="product-card community" style="background:#fff">
              <div class="product-card-body">
                <span class="community-badge">Community · Free</span>
                <div class="product-card-name" style="font-size:16px">{mod.name}</div>
                <div style="font-size:11px;color:var(--g2);margin-bottom:8px;font-family:'JetBrains Mono',monospace">by {mod.creator}</div>
                <div style="font-family:'Lora',serif;font-size:12px;color:var(--g1);line-height:1.6;margin-bottom:12px">{mod.desc}</div>
                <div class="product-card-footer" style="border-top:none;padding-top:0">
                  <span class="btn-printables">View on GitHub →</span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ItemList",
        "name": "Best Hotends for Voron 2.4 and Trident 2026",
        "url": "https://modernmakes.com/voron/hotends",
        "numberOfItems": 5,
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Rapido 2" },
          { "@type": "ListItem", "position": 2, "name": "Dragon HF" },
          { "@type": "ListItem", "position": 3, "name": "Revo Voron" },
          { "@type": "ListItem", "position": 4, "name": "NF-Crazy" },
          { "@type": "ListItem", "position": 5, "name": "Bambu Hardened Nozzle Kit" }
        ]
      }
    ]
  })}></script>
</Base>

<script>
  // ── Model-aware: reads ?model= and syncs localStorage ──
  (function() {
    const STORAGE_KEY = 'voron-model';
    const params = new URLSearchParams(window.location.search);
    const model = params.get('model') || localStorage.getItem(STORAGE_KEY) || '2.4';
    localStorage.setItem(STORAGE_KEY, model);

    const label = document.getElementById('active-model-label');
    if (label) label.textContent = model === '2.4' ? 'Voron 2.4' : 'Voron Trident';

    document.querySelectorAll<HTMLElement>('[data-compatible]').forEach(el => {
      const compatible = (el.dataset.compatible ?? '').split(',');
      el.style.display = compatible.includes(model) ? '' : 'none';
    });
  })();
</script>

<style is:global>
/* ── Verdict badge (top of card) ── */
.verdict-badge {
  display: inline-block;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  padding: 3px 8px;
  border-radius: 4px;
  margin-bottom: 8px;
  font-family: var(--fm);
}

/* ── Review link ── */
.btn-review {
  display: inline-block;
  margin-top: 8px;
  margin-left: 12px;
  font-size: 12px;
  color: var(--g2);
  text-decoration: none;
  font-family: var(--fm);
}
.btn-review:hover { color: var(--accent); }
</style>
