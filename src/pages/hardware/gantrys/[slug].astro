---
import HardwareDetail from '../../../components/HardwareDetail.astro';
import records from '../../../data/hardware/gantrys.json';
import { staticPathsFor, type DetailConfig } from '../../../lib/hardware';

const config: DetailConfig = {
  categoryLabel: 'GANTRY',
  componentType: 'Gantry',
  titleNoun: 'Gantry',
  quickSpecs: [
    { label: 'Kinematic', fields: ['Kinematic', 'Kinematics'] },
    { label: 'Extrusion Size', fields: ['Extrusion Size'] },
    { label: 'Motor Count', fields: ['Motor Count'] },
  ],
  specs: [
    { label: 'Kinematic', fields: ['Kinematic', 'Kinematics'] },
    { label: 'Extrusion Size', fields: ['Extrusion Size'] },
    { label: 'Motor Count', fields: ['Motor Count'] },
    { label: 'Drop-in Replacement', fields: ['Drop-in Replacement', 'Drop-in'] },
    { label: 'Printed Parts Required', fields: ['Printed Parts Required'] },
  ],
};

export function getStaticPaths() {
  return staticPathsFor(records as any[]);
}

const { record } = Astro.props as { record: any };
---
<HardwareDetail record={record} config={config} />
