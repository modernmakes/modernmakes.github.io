---
import data from '../../data/homepage.json';
const ecosystems = (data as any).ecosystems ?? [];
const live = ecosystems.filter((e: any) => e.status === 'live');
const coming = ecosystems.filter((e: any) => e.status === 'coming');

function bgStyle(eco: any) {
  if (eco.image) return `background-image:url('${eco.image}');background-size:cover;background-position:center right;`;
  return `background:${eco.gradient};`;
}
---

<section class="eco-section" aria-label="Printer ecosystem hubs">
  <div class="eco-container">

    <header class="eco-header">
      <p class="eco-eyebrow">Printer Ecosystems</p>
      <h2 class="eco-headline">Build your printer.<br/>We've mapped every part.</h2>
      <p class="eco-sub">Complete self-build resources for the most capable CoreXY printers. Parts directories, configurators, subsystem guides, and community mods — all in one place.</p>
    </header>

    <div class="eco-content">

      <!-- Live ecosystem cards -->
      <div class="eco-live">
        {live.map((eco: any) => (
          <a href={eco.href} class="eco-card" aria-label={`Explore the ${eco.name} ecosystem`}>
            <!-- Printer image area -->
            <div class="eco-card-img" style={bgStyle(eco)}>
              <div class="eco-card-img-overlay"></div>
              <span class="eco-card-img-label">{eco.name}</span>
            </div>
            <!-- Card content -->
            <div class="eco-card-body">
              <div class="eco-card-top">
                <span class="eco-card-name">{eco.name}</span>
                <span class="eco-badge">{eco.badge}</span>
              </div>
              {eco.variants && (
                <div class="eco-variants">
                  {eco.variants.map((v: string) => (
                    <span class="eco-chip">{v}</span>
                  ))}
                </div>
              )}
              <p class="eco-desc">{eco.description}</p>
              <div class="eco-card-footer">
                <span class="eco-cta">Explore the ecosystem →</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Coming soon panel -->
      <div class="eco-coming">
        <p class="eco-coming-label">On the roadmap</p>
        {coming.map((eco: any) => (
          <div class="eco-coming-item">
            <div class="eco-coming-item-left">
              <span class="eco-coming-name">{eco.name}</span>
              <span class="eco-coming-desc">{eco.description}</span>
            </div>
            <span class="eco-coming-badge">{eco.badge}</span>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style is:global>
  /* Distinct background — slightly lighter than builds (#0f0f0f) */
  .eco-section {
    background: #161616;
    padding: 56px 0;
    border-top: 1px solid rgba(255,255,255,.06);
  }
  .eco-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 400ms cubic-bezier(0.4,0,0.2,1),
                transform 400ms cubic-bezier(0.4,0,0.2,1);
  }
  .eco-container.eco-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Header */
  .eco-header { margin-bottom: 36px; }
  .eco-eyebrow {
    font-family: var(--fu);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 12px;
  }
  .eco-headline {
    font-family: var(--fd);
    font-size: clamp(26px, 2.5vw + 12px, 40px);
    font-weight: 800;
    color: #fff;
    line-height: 1.0;
    letter-spacing: -.4px;
    margin: 0 0 12px;
  }
  .eco-sub {
    font-family: var(--fb);
    font-size: 14px;
    color: rgba(255,255,255,.38);
    max-width: 560px;
    line-height: 1.7;
    margin: 0;
  }

  /* Two-column layout */
  .eco-content {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: 32px;
    align-items: start;
  }

  /* Live ecosystem cards */
  .eco-live {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .eco-card {
    display: flex;
    flex-direction: column;
    background: #1e1e1e;
    border: 1px solid rgba(255,90,31,.2);
    border-left: 3px solid var(--accent);
    border-radius: 0 12px 12px 0;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 200ms, box-shadow 200ms, transform 200ms;
  }
  .eco-card:hover {
    border-color: rgba(255,90,31,.45);
    border-left-color: var(--accent);
    box-shadow: 0 12px 40px rgba(0,0,0,.4);
    transform: translateX(2px);
  }

  /* Printer image */
  .eco-card-img {
    width: 100%;
    height: 200px;
    position: relative;
    background-size: cover;
    background-position: center right;
    display: flex;
    align-items: flex-end;
    flex-shrink: 0;
  }
  .eco-card-img-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(30,30,30,.95) 0%, rgba(30,30,30,.4) 50%, transparent 100%),
      linear-gradient(to top, rgba(0,0,0,.6) 0%, transparent 60%);
  }
  .eco-card-img-label {
    position: relative;
    z-index: 1;
    font-family: var(--fd);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 800;
    color: rgba(255,255,255,.08);
    padding: 16px 24px;
    letter-spacing: -.5px;
    /* Visible only when no image — acts as watermark */
  }

  /* Card content */
  .eco-card-body {
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .eco-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .eco-card-name {
    font-family: var(--fd);
    font-size: clamp(20px, 1.8vw + 8px, 26px);
    font-weight: 800;
    color: #fff;
  }
  .eco-badge {
    font-size: 9px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 3px;
    letter-spacing: .05em;
    text-transform: uppercase;
    white-space: nowrap;
    background: rgba(255,90,31,.18);
    color: var(--accent-mid);
    border: 1px solid rgba(255,90,31,.25);
    flex-shrink: 0;
  }
  .eco-variants {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .eco-chip {
    font-family: var(--fm);
    font-size: 10px;
    color: rgba(255,255,255,.35);
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 3px;
    padding: 3px 9px;
    white-space: nowrap;
  }
  .eco-desc {
    font-size: 13px;
    color: rgba(255,255,255,.4);
    line-height: 1.6;
    margin: 0;
  }
  .eco-card-footer {
    padding-top: 12px;
    border-top: 1px solid rgba(255,255,255,.07);
  }
  .eco-cta {
    font-family: var(--fu);
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
  }

  /* Coming soon panel */
  .eco-coming {
    padding-top: 4px;
  }
  .eco-coming-label {
    font-family: var(--fu);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: rgba(255,255,255,.2);
    margin: 0 0 14px;
  }
  .eco-coming-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 11px 0;
    border-bottom: 1px solid rgba(255,255,255,.05);
    opacity: 0.45;
  }
  .eco-coming-item:first-of-type { border-top: 1px solid rgba(255,255,255,.05); }
  .eco-coming-item-left {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .eco-coming-name {
    font-family: var(--fd);
    font-size: 14px;
    font-weight: 800;
    color: rgba(255,255,255,.5);
    white-space: nowrap;
  }
  .eco-coming-desc {
    font-family: var(--fm);
    font-size: 10px;
    color: rgba(255,255,255,.2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .eco-coming-badge {
    font-size: 9px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 3px;
    letter-spacing: .05em;
    text-transform: uppercase;
    background: rgba(255,255,255,.04);
    color: rgba(255,255,255,.2);
    border: 1px solid rgba(255,255,255,.07);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .eco-content { grid-template-columns: 1fr; }
    .eco-coming { display: none; }
    .eco-card-img { height: 240px; }
  }
  @media (max-width: 768px) {
    .eco-section { padding: 40px 0; }
    .eco-container { padding: 0 20px; }
    .eco-card-img { height: 180px; }
    .eco-card-body { padding: 16px 20px; }
  }
  @media (max-width: 480px) {
    .eco-card-img { height: 140px; }
  }
</style>

<script>
  const container = document.querySelector('.eco-container');
  if (container) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          container.classList.add('eco-visible');
          observer.disconnect();
        }
      },
      { threshold: 0.05 }
    );
    observer.observe(container);
  }
</script>
