  .mc-divider { display: none; }
}
</style>

<script>
  // ── MODEL SELECTOR — persists choice to localStorage ──
  const modelBtns = document.querySelectorAll<HTMLButtonElement>('.model-btn');
  const STORAGE_KEY = 'voron-model';

  const printerImg = document.getElementById('printer-img') as HTMLImageElement | null;
  const infoName   = document.getElementById('model-info-name');
  const infoSizes  = document.getElementById('model-info-sizes');
  const specZ      = document.getElementById('spec-z');
  const specSize   = document.getElementById('spec-size');
  const specBuild  = document.getElementById('spec-build');
  const specDiff   = document.getElementById('spec-diff');
  const taglineEl  = document.getElementById('model-tagline');
  const mcbModel   = document.getElementById('mcb-model');
  const subHead    = document.getElementById('subsystem-heading');

  interface ModelMeta {
    src: string; label: string; sizes: string;
    z: string; size: string; build: string; diff: string;
    tagline: string;
  }

  const modelMeta: Record<string, ModelMeta> = {
    '2.4': {
      src:     '/Media/ecosystems/Voron/voron-2-4.webp',
      label:   'Voron 2.4',
      sizes:   '250mm · 300mm · 350mm',
      z:       '4-point quad gantry',
      size:    '350mm³',
      build:   '40–60 hrs',
      diff:    'Intermediate',
      tagline: 'The flying-gantry flagship. Maximum build volume, deepest mod ecosystem, quad Z levelling.',
    },
    'trident': {
      src:     '/Media/ecosystems/Voron/voron-trident.webp',
      label:   'Trident',
      sizes:   '250mm · 300mm · 350mm',
      z:       '3-point belt driven',
      size:    '350mm³',
      build:   '30–45 hrs',
      diff:    'Beginner-friendly',
      tagline: 'Fixed gantry, three-point self-levelling. Faster to build, easier to tune, excellent for 250–300mm work.',
    },
  };

  function setModel(model: string) {
    localStorage.setItem(STORAGE_KEY, model);

    // Button active states
    modelBtns.forEach(btn => {
      const active = btn.dataset.model === model;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-pressed', String(active));
    });

    // Model info + image
    const meta = modelMeta[model];
    if (meta) {
      if (printerImg) { printerImg.style.display = ''; printerImg.src = meta.src; printerImg.alt = meta.label; }
      if (infoName)  infoName.textContent  = meta.label;
      if (infoSizes) infoSizes.textContent = meta.sizes;
      if (specZ)     specZ.textContent     = meta.z;
      if (specSize)  specSize.textContent  = meta.size;
      if (specBuild) specBuild.textContent = meta.build;
      if (specDiff)  specDiff.textContent  = meta.diff;
      if (taglineEl) taglineEl.textContent = meta.tagline;
    }

    // Selection pulse animation
    const heroEl = document.querySelector<HTMLElement>('.model-hero');
    if (heroEl) {
      heroEl.classList.remove('model-selected');
      void heroEl.offsetWidth;
      heroEl.classList.add('model-selected');
    }

    // Context bar + subsystem heading
    if (mcbModel) mcbModel.textContent = model === '2.4' ? 'Voron 2.4' : 'Trident';
    if (subHead)  subHead.textContent  = (model === '2.4' ? 'Voron 2.4' : 'Trident') + ' — Browse by subsystem';

    // Subsystem card filtering + link hrefs
    updateSubsystemCards(model);
    document.querySelectorAll<HTMLAnchorElement>('a[data-subsystem-link]').forEach(link => {
      const base = link.dataset.href ?? link.getAttribute('href') ?? '';
      link.href = base + '?model=' + model;
    });
  }

  function updateSubsystemCards(model: string) {
    document.querySelectorAll<HTMLElement>('.subsystem-card[data-parts24]').forEach(card => {
      const count = model === '2.4' ? card.dataset.parts24 : card.dataset.partsTrident;
      const countEl = card.querySelector<HTMLElement>('.subsystem-parts');
      if (countEl && count) countEl.textContent = count + ' parts →';
    });
    document.querySelectorAll<HTMLElement>('[data-models]').forEach(el => {
      const models = (el.dataset.models ?? '').split(',');
      el.style.display = models.includes(model) ? '' : 'none';
    });
  }

  modelBtns.forEach(btn => {
    btn.addEventListener('click', () => setModel(btn.dataset.model ?? '2.4'));
  });

  const saved = localStorage.getItem(STORAGE_KEY) ?? '2.4';
  setModel(saved);
</script>
