---
import data from '../../data/homepage.json';
const ecosystems = (data as any).ecosystems ?? [];
const live = ecosystems.filter((e: any) => e.status === 'live');
const coming = ecosystems.filter((e: any) => e.status === 'coming');
// Allow-list for the ?ref= referral param, derived from the actual data so it
// can't drift from the real slugs. Baked into the blocking script below via
// define:vars — never trust the raw query-string value against anything else.
const validEcoSlugs = ecosystems.map((e: any) => e.slug).filter(Boolean);

function bgStyle(eco: any) {
  if (eco.image) return `background-image:url('${eco.image}');background-size:cover;background-position:center right;`;
  return `background:${eco.gradient};`;
}
---

<script is:inline define:vars={{ validEcoSlugs }}>
  // ── ECOSYSTEM REFERRAL PROMOTION — blocking, runs before this section paints ──
  // Reads ?ref= from the URL, validates it against the real ecosystem slugs
  // (passed in at build time, not hand-copied), and sets a data attribute on
  // <html> that CSS uses to set `order` on the matching card/row below. No
  // persistence (no cookie, no localStorage) — this is per-pageview only.
  // DOM order never changes, only the CSS `order` used to paint it, so every
  // request renders byte-identical markup for crawlers.
  (function () {
    var ref;
    try {
      ref = new URLSearchParams(location.search).get('ref');
    } catch (e) {
      return;
    }
    if (ref && validEcoSlugs.indexOf(ref) !== -1) {
      document.documentElement.setAttribute('data-ref-ecosystem', ref);
    }
  })();
</script>

<section class="eco-section" aria-label="Printer ecosystem hubs">
  <div class="eco-container">

    <header class="eco-header">
      <p class="eco-eyebrow" data-reveal>Printer Ecosystems</p>
      <h2 class="eco-headline" data-reveal data-reveal-delay="80">Build your printer.<br/>We've mapped every part.</h2>
      <p class="eco-sub" data-reveal data-reveal-delay="160">Complete self-build resources for the most capable CoreXY printers. Parts directories, configurators, subsystem guides, and community mods — all in one place.</p>
    </header>

    <div class="eco-content">

      <!-- Live ecosystem cards -->
      <div class="eco-live">
        {live.map((eco: any, i: number) => (
          <a href={eco.href} class="eco-card" data-eco-slug={eco.slug} data-reveal data-reveal-delay={240 + i * 120} aria-label={`Explore the ${eco.name} ecosystem`}>
            <!-- Printer image area -->
            <div class="eco-card-img">
              <div class="eco-card-img-bg" style={bgStyle(eco)}></div>
              <div class="eco-card-img-overlay"></div>
              <span class="eco-card-img-label">{eco.name}</span>
            </div>
            <!-- Card content -->
            <div class="eco-card-body">
              <div class="eco-card-top">
                <span class="eco-card-name">{eco.name}</span>
                <span class="eco-badge">{eco.badge}</span>
              </div>
              {eco.variants && (
                <div class="eco-variants">
                  {eco.variants.map((v: string) => (
                    <span class="eco-chip">{v}</span>
                  ))}
                </div>
              )}
              <p class="eco-desc">{eco.description}</p>
              <div class="eco-card-footer">
                <span class="eco-cta">Explore the ecosystem <span class="arrow">→</span></span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Coming soon panel -->
      <div class="eco-coming" data-reveal data-reveal-delay="500">
        <p class="eco-coming-label">On the roadmap</p>
        {coming.map((eco: any) => (
          <div class="eco-coming-item" data-eco-slug={eco.slug}>
            <div class="eco-coming-item-left">
              <span class="eco-coming-name">{eco.name}</span>
              <span class="eco-coming-desc">{eco.description}</span>
            </div>
            <span class="eco-coming-badge">{eco.badge}</span>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style is:global>
  /* Distinct background — slightly lighter than builds (#0f0f0f) */
  .eco-section {
    background: #161616;
    padding: 56px 0;
    /* Orange seam glow ties dark-band edges to the brand identity (M8) */
    border-top: 1px solid transparent;
    border-image: linear-gradient(90deg, transparent, rgba(255,90,31,.35), transparent) 1;
  }
  .eco-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* Header */
  .eco-header { margin-bottom: 36px; }
  .eco-eyebrow {
    font-family: var(--fu);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 12px;
  }
  .eco-headline {
    font-family: var(--fd);
    font-size: clamp(26px, 2.5vw + 12px, 40px);
    font-weight: 800;
    color: #fff;
    line-height: 1.0;
    letter-spacing: -.4px;
    margin: 0 0 12px;
  }
  .eco-sub {
    font-family: var(--fb);
    font-size: 14px;
    color: rgba(255,255,255,.38);
    max-width: 560px;
    line-height: 1.7;
    margin: 0;
  }

  /* Two-column layout */
  .eco-content {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: 32px;
    align-items: start;
  }

  /* Live ecosystem cards */
  .eco-live {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Section-scoped (0,2,0) so this transition wins over the shared reveal
     utility's :where() transition — keeps hover crisp while opacity + filter
     carry the 600ms reveal. */
  .eco-section .eco-card {
    display: flex;
    flex-direction: column;
    background: #1e1e1e;
    border: 1px solid rgba(255,90,31,.2);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 200ms var(--stagger-ease),
      box-shadow   200ms var(--stagger-ease),
      transform    200ms var(--stagger-ease),
      opacity      var(--stagger-dur) var(--stagger-ease),
      filter       var(--stagger-dur) var(--stagger-ease);
  }
  .eco-section .eco-card:hover {
    border-color: rgba(255,90,31,.45);
    box-shadow: 0 12px 40px rgba(0,0,0,.4);
    transform: translateY(-2px);
  }

  /* Printer image */
  .eco-card-img {
    width: 100%;
    height: 200px;
    position: relative;
    display: flex;
    align-items: flex-end;
    flex-shrink: 0;
    overflow: hidden;
  }
  /* Signature editorial hover — slow zoom on the bg layer only, so the
     watermark label stays pinned (F7 / M4). Card + this element clip it.
     Origin right: images are right-positioned. */
  .eco-card-img-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center right;
    transition: transform 600ms var(--stagger-ease);
    transform-origin: center right;
  }
  .eco-section .eco-card:hover .eco-card-img-bg { transform: scale(1.04); }
  .eco-card-img-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(30,30,30,.95) 0%, rgba(30,30,30,.4) 50%, transparent 100%),
      linear-gradient(to top, rgba(0,0,0,.6) 0%, transparent 60%);
  }
  .eco-card-img-label {
    position: relative;
    z-index: 1;
    font-family: var(--fd);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 800;
    color: rgba(255,255,255,.08);
    padding: 16px 24px;
    letter-spacing: -.5px;
    transition: color 400ms var(--stagger-ease);
    /* Visible only when no image — acts as watermark */
  }
  /* Subliminal watermark lift on hover (M4) */
  .eco-section .eco-card:hover .eco-card-img-label { color: rgba(255,255,255,.14); }

  /* Card content */
  .eco-card-body {
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .eco-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .eco-card-name {
    font-family: var(--fd);
    font-size: clamp(20px, 1.8vw + 8px, 26px);
    font-weight: 800;
    color: #fff;
  }
  .eco-badge {
    font-size: 9px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 3px;
    letter-spacing: .05em;
    text-transform: uppercase;
    white-space: nowrap;
    background: rgba(255,90,31,.18);
    color: var(--accent-mid);
    border: 1px solid rgba(255,90,31,.25);
    flex-shrink: 0;
  }
  .eco-variants {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .eco-chip {
    font-family: var(--fm);
    font-size: 10px;
    color: rgba(255,255,255,.35);
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 3px;
    padding: 3px 9px;
    white-space: nowrap;
  }
  .eco-desc {
    font-size: 13px;
    color: rgba(255,255,255,.4);
    line-height: 1.6;
    margin: 0;
  }
  .eco-card-footer {
    padding-top: 12px;
    border-top: 1px solid rgba(255,255,255,.07);
  }
  .eco-cta {
    font-family: var(--fu);
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
  }

  /* Coming soon panel */
  .eco-coming {
    padding-top: 4px;
    /* Flex column so the referral `order` rules below can promote a row —
       visual position only, DOM order is untouched. */
    display: flex;
    flex-direction: column;
  }
  .eco-coming-label {
    font-family: var(--fu);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: rgba(255,255,255,.2);
    margin: 0 0 7px;
    padding-bottom: 7px;
    /* Was a :first-of-type border-top on .eco-coming-item — moved here so the
       divider always sits above the list regardless of which row is
       reordered to the front (order: -2 always keeps this label first). */
    border-bottom: 1px solid rgba(255,255,255,.05);
    order: -2;
  }
  .eco-coming-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 11px 0;
    border-bottom: 1px solid rgba(255,255,255,.05);
    opacity: 0.45;
  }
  .eco-coming-item-left {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .eco-coming-name {
    font-family: var(--fd);
    font-size: 14px;
    font-weight: 800;
    color: rgba(255,255,255,.5);
    white-space: nowrap;
  }
  .eco-coming-desc {
    font-family: var(--fm);
    font-size: 10px;
    color: rgba(255,255,255,.2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .eco-coming-badge {
    font-size: 9px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 3px;
    letter-spacing: .05em;
    text-transform: uppercase;
    background: rgba(255,255,255,.04);
    color: rgba(255,255,255,.2);
    border: 1px solid rgba(255,255,255,.07);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .eco-content { grid-template-columns: 1fr; }
    .eco-coming { display: none; }
    .eco-card-img { height: 240px; }
  }
  @media (max-width: 768px) {
    .eco-section { padding: 40px 0; }
    .eco-container { padding: 0 20px; }
    .eco-card-img { height: 180px; }
    .eco-card-body { padding: 16px 20px; }
  }
  @media (max-width: 480px) {
    .eco-card-img { height: 140px; }
  }

  /* Image zoom + watermark lift are motion — hold still for reduce users. */
  @media (prefers-reduced-motion: reduce) {
    .eco-card-img-bg { transition: none; }
    .eco-section .eco-card:hover .eco-card-img-bg { transform: none; }
    .eco-card-img-label { transition: none; }
  }

  /* Referral promotion (Phase 1 personalization) — `order` only, never
     display/DOM. data-ref-ecosystem is set synchronously (before this
     section paints) by the blocking script above, from a validated ?ref=
     query param. Every request still renders the same DOM in the same
     order, so crawlers see identical markup regardless of the param. */
  :root[data-ref-ecosystem="voron"]  [data-eco-slug="voron"]  { order: -1; }
  :root[data-ref-ecosystem="ratrig"] [data-eco-slug="ratrig"] { order: -1; }
  :root[data-ref-ecosystem="vzbot"]  [data-eco-slug="vzbot"]  { order: -1; }
  :root[data-ref-ecosystem="hevort"] [data-eco-slug="hevort"] { order: -1; }
  :root[data-ref-ecosystem="k3"]     [data-eco-slug="k3"]     { order: -1; }
</style>

<!-- Entrance is handled by the shared [data-reveal] observer in Base.astro (M1). -->
