---
import HardwareIndex from '../../../components/HardwareIndex.astro';
import records from '../../../data/hardware/hotends.json';

const chips = (r: any) => [
  r['Max Temp (°C)'] != null ? `${r['Max Temp (°C)']}°C` : null,
  r['Max Flow (mm³/s)'] != null ? `${r['Max Flow (mm³/s)']} mm³/s` : null,
  r['Price (USD)'] != null ? `~$${r['Price (USD)']} USD` : null,
].filter(Boolean) as string[];
---
<HardwareIndex
  records={records}
  route="hotends"
  categoryLabel="HOTEND"
  crumb="Hotends"
  heading="Hotends"
  sub="High-flow, standard, and specialty hotends. Specs, compatibility, and where to buy."
  nounSingular="hotend"
  nounPlural="hotends"
  title="Best FDM Hotends for Voron & Prosumer Printers"
  description="Hotend reviews, specs, and where to buy — high-flow, standard, and specialty hotends for CoreXY and other 3D printer builds."
  schemaName="Best FDM Hotends for Voron & Prosumer Printers"
  chips={chips}
/>
