---
import data from '../data/homepage.json';

// Same ecosystem list as HomeEcosystemHubs: an entry becomes a link when its status flips to "live".
const ecosystems = (data as any).ecosystems ?? [];
---

<footer class="footer" role="contentinfo" data-reveal>
  <div class="footer-inner">
    <div class="footer-top">

      <!-- Brand -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Modern Makes home">
          <img src="/images/wordmark.svg" alt="Modern Makes" class="footer-wordmark" />
        </a>
        <p class="footer-tagline" id="footer-tagline">Never stop tinkering.</p>
      </div>

      <!-- Link columns -->
      <div class="footer-cats">
        <details class="footer-sec" open>
          <summary class="footer-cat-label">3D Printers</summary>
          <div class="footer-links">
          {ecosystems.map((eco: any) => eco.status === 'live'
            ? <a href={eco.href} class="footer-link">{eco.name}</a>
            : (
              <span class="footer-link footer-soon">
                {eco.name}<span class="sr-only">, coming soon</span>
                <span class="footer-soon-hover" aria-hidden="true">Coming soon</span>
                <span class="footer-soon-tag" aria-hidden="true">Soon</span>
              </span>
            )
          )}
          </div>
        </details>
        <details class="footer-sec" open>
          <summary class="footer-cat-label">Editorial</summary>
          <div class="footer-links">
          <a href="/filament" class="footer-link">Filament</a>
          <a href="/guides"   class="footer-link">Guides</a>
          <a href="/news"     class="footer-link">News</a>
          <a href="/tools"    class="footer-link">Tools</a>
          </div>
        </details>
        <details class="footer-sec" open>
          <summary class="footer-cat-label">Parts</summary>
          <div class="footer-links">
          <a href="/hotends"        class="footer-link">Hotends</a>
          <a href="/extruders"      class="footer-link">Extruders</a>
          <a href="/electronics"    class="footer-link">Electronics</a>
          <a href="/motion-system"  class="footer-link">Motion system</a>
          <a href="/build-surfaces" class="footer-link">Build surfaces</a>
          </div>
        </details>
        <details class="footer-sec" open>
          <summary class="footer-cat-label">Publication</summary>
          <div class="footer-links">
          <a href="/newsletter"        class="footer-link">Newsletter</a>
          <a href="/newsletter/archive" class="footer-link">Newsletter Archive</a>
          <a href="/about"             class="footer-link">About</a>
          <a href="/editorial"          class="footer-link">Editorial policy</a>
          <a href="/advertise"         class="footer-link">Advertise</a>
          <a href="/partners"          class="footer-link">Partner With Us</a>
          <a href="/search"            class="footer-link">Search</a>
          <a href="/sitemap"           class="footer-link">Sitemap</a>
          <a href="mailto:modernmakesco@gmail.com" class="footer-link footer-link-email">modernmakesco@gmail.com</a>
          </div>
        </details>
      </div>
      <!-- Sections render open (desktop + no-JS); this runs before first paint to collapse them on mobile. -->
      <script is:inline>
        (function () {
          var mq = matchMedia('(max-width: 768px)');
          var secs = document.querySelectorAll('.footer-sec');
          function sync() {
            secs.forEach(function (d) {
              d.open = !mq.matches;
              d.firstElementChild.tabIndex = mq.matches ? 0 : -1; // not a control on desktop
            });
          }
          secs.forEach(function (d) {
            d.firstElementChild.addEventListener('click', function (e) { if (!mq.matches) e.preventDefault(); });
          });
          sync();
          mq.addEventListener('change', sync);
        })();
      </script>

    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <div class="footer-legal">
        &copy; 2026 Modern Makes.
        <a href="/legal/terms-of-service">Terms</a> &middot; <a href="/legal/cookie-policy">Cookies</a>
      </div>
      <div class="footer-disclosure">
        Modern Makes uses affiliate links. We may earn a commission when you buy through links on this site. This never influences our editorial recommendations.
      </div>
    </div>
  </div>
</footer>

<style is:global>
  /* Entrance is handled by the shared [data-reveal] observer in Base.astro (M1). */

  /* ─── SHELL ─── */
  .footer {
    background: var(--dark-bg);
    padding: 56px 0 0;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ─── TOP SECTION ─── */
  .footer-top {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 48px;
    padding-bottom: 48px;
  }

  /* ─── LOGO ─── */
  /* wordmark.svg has ~31% empty space left of the glyphs; crop to the glyph box
     (x 313, y 60, 556x79 of 1000x200) so the wordmark lines up with the tagline and the content column. */
  .footer-logo {
    --wm-h: 18px;
    display: block; line-height: 0; margin-bottom: 16px;
    height: var(--wm-h); width: calc(var(--wm-h) * 556 / 79); overflow: hidden;
  }

  .footer-wordmark {
    height: calc(var(--wm-h) * 200 / 79);
    width: auto; max-width: none;
    display: block;
    transform: translate(calc(var(--wm-h) * -313 / 79), calc(var(--wm-h) * -60 / 79));
    opacity: 0.9;
    transition: opacity 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .footer-wordmark:hover { opacity: 1; }
  }

  /* ─── TAGLINE ─── */
  .footer-tagline {
    font-family: var(--fb);
    font-size: 13px;
    color: var(--on-dark-soft);
    line-height: 1.6;
    max-width: 180px;
  }

  /* ─── COLUMNS ─── */
  .footer-cats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  /* <summary>: a plain heading on desktop, the disclosure toggle on mobile. */
  .footer-cat-label {
    display: block;
    list-style: none;
    font-family: var(--fu);
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    margin-bottom: 12px;
  }
  .footer-cat-label::-webkit-details-marker { display: none; }

  .footer-link {
    display: block;
    font-family: var(--fu);
    font-size: 13px;
    color: var(--on-dark-muted);
    padding: 3px 0;
    transition: color 150ms ease;
    line-height: 1.5;
  }
  @media (hover: hover) and (pointer: fine) {
    .footer-link:hover { color: rgba(255, 255, 255, 0.8); }
  }
  .footer-link-email { font-family: var(--fm); font-size: 11px; margin-top: 6px; }

  /* ─── COMING-SOON ENTRIES (plain text, not focusable) ─── */
  .footer-soon { position: relative; width: fit-content; cursor: default; }
  @media (hover: hover) and (pointer: fine) {
    .footer-link.footer-soon:hover { color: var(--on-dark-muted); }
  }
  .footer-soon-hover,
  .footer-soon-tag {
    font-family: var(--fm);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .06em;
    margin-left: 8px;
  }
  /* Touch / no-hover: a static tag so it never reads as a broken link. */
  .footer-soon-hover { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .footer-soon-tag { display: none; }
    .footer-soon-hover {
      display: inline;
      position: absolute; /* out of flow: no layout shift */
      left: 100%;
      top: 50%;
      margin-left: 0;
      transform: translateY(-50%);
      padding-left: 8px;
      white-space: nowrap;
      opacity: 0;
      transition: opacity var(--dur-fast) var(--ease-out);
    }
    .footer-soon:hover .footer-soon-hover { opacity: 1; }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: reduce) {
    .footer-soon-hover { transition: none; }
  }

  /* ─── BOTTOM BAR ─── */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    flex-wrap: wrap;
  }

  .footer-legal {
    font-family: var(--fu);
    font-size: 11px;
    color: var(--on-dark-muted);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .footer-legal a {
    color: var(--on-dark-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .footer-legal a:hover { color: var(--on-dark-soft); }
  }

  .footer-disclosure {
    font-family: var(--fu);
    font-size: 11px;
    color: var(--on-dark-muted);
    max-width: 480px;
    text-align: right;
    line-height: 1.5;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 1024px) {
    .footer-top { grid-template-columns: 1fr; gap: 32px; }
    .footer-cats { grid-template-columns: repeat(2, 1fr); }
    .footer-tagline { max-width: 100%; }
  }

  @media (max-width: 768px) {
    :root { interpolate-size: allow-keywords; }
    .footer { padding-top: 0; }
    .footer-inner { padding: 0 20px; }
    .footer-top { gap: 0; padding-bottom: 0; }

    /* Brand band: full-bleed, so the wordmark lines up with the 20px content column. */
    .footer-brand { margin: 0 -20px; padding: 28px 20px; background: var(--dark-surface); }
    .footer-logo { margin-bottom: 14px; }
    .footer-tagline { margin-top: 0; font-size: 14px; }

    /* Collapsible sections: one hairline between rows. Height tweens via ::details-content (progressive; instant elsewhere). */
    .footer-cats { display: block; }
    .footer-cat-label:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
    .footer-sec + .footer-sec { border-top: 1px solid var(--dark-border); }
    .footer-cat-label {
      display: flex; align-items: center; justify-content: space-between;
      min-height: 48px; margin: 0; cursor: pointer;
    }
    .footer-cat-label::after {
      content: ''; width: 7px; height: 7px; margin-right: 4px;
      border: solid var(--on-dark-muted); border-width: 0 1.5px 1.5px 0;
      transform: rotate(45deg) translateY(-2px);
      transition: transform var(--dur-base) var(--ease-out);
    }
    .footer-sec[open] > .footer-cat-label::after { transform: rotate(-135deg) translateY(-2px); }
    .footer-sec::details-content {
      block-size: 0; overflow: hidden;
      transition: block-size var(--dur-base) var(--ease-out), content-visibility var(--dur-base) allow-discrete;
    }
    .footer-sec[open]::details-content { block-size: auto; }
    .footer-links { padding-bottom: 12px; }
    .footer-link { padding: 10px 0; font-size: 14px; }
    .footer-link-email { margin-top: 0; }

    .footer-bottom { flex-direction: column; align-items: flex-start; gap: 12px; padding: 20px 0 28px; border-top-color: var(--dark-border); }
    .footer-legal, .footer-disclosure { font-size: 11px; }
    .footer-disclosure { text-align: left; max-width: 100%; }
  }

  @media (max-width: 768px) and (prefers-reduced-motion: reduce) {
    .footer-cat-label::after, .footer-sec::details-content { transition: none; }
  }
</style>

<script>
  const taglines = [
    "Never stop tinkering.",
    "Still calibrating. Always will be.",
    "We read the changelogs so you don't have to.",
    "Chasing the next 0.1mm.",
    "Built for people who never call a print \"finished.\"",
    "For people who read Discord before bed.",
    "Always one upgrade away from done.",
    "Never satisfied with stock firmware.",
    "The build is never actually finished.",
    "Made for people with too many nozzles.",
    "Print first, sleep later.",
    "Still tuning. Still tinkering.",
    "For the ones who source their own BOM.",
    "Obsessed with the details nobody else covers."
  ];

  const ROTATION_HOURS = 4;
  const bucket = Math.floor(Date.now() / (ROTATION_HOURS * 60 * 60 * 1000));
  const index = bucket % taglines.length;

  const el = document.getElementById('footer-tagline');
  if (el) el.textContent = taglines[index];
</script>
