---
import HardwareDetail from '../../../components/HardwareDetail.astro';
import records from '../../../data/hardware/bed-probes.json';
import { staticPathsFor, type DetailConfig } from '../../../lib/hardware';

const yesNo = (v: any) => (v === true ? 'Yes' : v === false ? 'No' : String(v));

const config: DetailConfig = {
  categoryLabel: 'BED PROBE',
  componentType: 'Bed Probe',
  titleNoun: 'Bed Probe',
  quickSpecs: [
    { label: 'Type', fields: ['Type'] },
    { label: 'Repeatability', fields: ['Repeatability', 'Accuracy (mm)'] },
    { label: 'Klipper Native', fields: ['Klipper Native'], fmt: yesNo },
    { label: 'Install Complexity', fields: ['Installation Complexity', 'Install Complexity'] },
  ],
  specs: [
    { label: 'Type', fields: ['Type'] },
    { label: 'Repeatability', fields: ['Repeatability', 'Accuracy (mm)'] },
    { label: 'Klipper Native', fields: ['Klipper Native'], fmt: yesNo },
    { label: 'Installation Complexity', fields: ['Installation Complexity', 'Install Complexity'] },
    { label: 'Open Source', fields: ['Open Source'], fmt: yesNo },
  ],
};

export function getStaticPaths() {
  return staticPathsFor(records as any[]);
}

const { record } = Astro.props as { record: any };
---
<HardwareDetail record={record} config={config} />
