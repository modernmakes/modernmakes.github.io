  { id: 'omc-17hs24-2104s',    brand: 'OMC',     model: '17HS24-2104S',               nema: 17, bodyMm: 60,   stepDeg: 1.8, ratedA: 2.1,  holdNcm: 65,    inductMH: 3,    resistOhm: 1.6  },
