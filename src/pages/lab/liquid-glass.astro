---
// Internal design lab — NOT linked from nav, NOT indexed, NOT for production.
// Pure-CSS frosted glass via backdrop-filter. Zero external deps, no WebGL,
// no html2canvas, nothing npm-installed. A fixed decorative background gives
// the glass something to blur; cards scroll over it in real time.
import Base from '../../layouts/Base.astro';
---
<Base
  title="Design Lab — Liquid Glass Test"
  description="Internal design lab — pure-CSS backdrop-filter frosted glass on the Modern Makes dark aesthetic. Not for production."
  hasPageH1={true}
  heroPage={true}
>
  <meta name="robots" content="noindex, nofollow" slot="head" />

  <!-- ── Fixed background field: the blur source ── -->
  <div class="lab-bg" aria-hidden="true">
    <div class="lab-bg-stripes"></div>
    <div class="lab-bg-glow lab-bg-glow--1"></div>
    <div class="lab-bg-glow lab-bg-glow--2"></div>
    <div class="lab-bg-glow lab-bg-glow--3"></div>
    <span class="lab-ghost lab-ghost--a">RAPIDO</span>
    <span class="lab-ghost lab-ghost--b">CHUBE</span>
    <span class="lab-ghost lab-ghost--c">VORON</span>
    <span class="lab-ghost lab-ghost--d">RATRIG</span>
    <span class="lab-ghost lab-ghost--e">VZBOT</span>
    <span class="lab-ghost lab-ghost--f">RAPIDO</span>
  </div>

  <div class="lab-warn glass" role="note">⚠️ Lab page — not for production. Test at /lab/liquid-glass</div>

  <div class="lab-content">
    <header class="lab-hero">
      <p class="lab-eyebrow">Internal · backdrop-filter × Modern Makes</p>
      <h1 class="lab-title">Design Lab — Liquid&nbsp;Glass Test</h1>
      <p class="lab-sub">
        Pure CSS frosted glass — no WebGL, no libraries. Scroll the page and watch the
        orange glow and ghost wordmarks blur through each card in real time.
      </p>
      <p class="lab-scrollcue">Scroll ↓</p>
    </header>

    <section class="lab-stage" aria-label="Glass component tests">
      <!-- 1 — Verdict card -->
      <article class="lab-row lab-row--left">
        <div class="glass card-content">
          <span class="g-badge g-buy">BUY</span>
          <h2 class="g-name">Rapido 2 UHF</h2>
          <p class="g-brand">Phaetus · ultra-high-flow hotend</p>
          <div class="g-price">$84</div>
        </div>
      </article>

      <!-- 2 — Spec panel -->
      <article class="lab-row lab-row--right">
        <div class="glass modal-content">
          <div class="g-modal-head">
            <span class="g-eyebrow">Specs</span>
            <h2 class="g-name">Rapido 2 UHF</h2>
          </div>
          <table class="g-spec"><tbody>
            <tr><th>Max temp</th><td>360 °C</td></tr>
            <tr><th>Max flow</th><td>55 mm³/s</td></tr>
            <tr><th>Heat break</th><td>Bi-metal</td></tr>
            <tr><th>Nozzle thread</th><td>M6</td></tr>
            <tr><th>Weight</th><td>38 g</td></tr>
          </tbody></table>
        </div>
      </article>

      <!-- 3 — Community verdict -->
      <article class="lab-row lab-row--center">
        <div class="glass note-content">
          <span class="g-eyebrow">Community Verdict</span>
          <h2 class="g-name">What the builders say</h2>
          <p class="g-body">
            Placeholder copy for the glass lab. Drop-in body text sits on the frosted
            surface to check legibility while the background scrolls underneath. Lorem-free
            filler so we can judge contrast, line length, and how the blur reads against
            warm orange glow versus flat dark zones as the card travels up the viewport.
          </p>
        </div>
      </article>
    </section>
  </div>

  <!-- ── Floating glass nav ── -->
  <nav class="lab-nav glass" aria-label="Glass nav test">
    <button type="button" class="lab-pill is-active" data-pill="0">Hotends</button>
    <button type="button" class="lab-pill" data-pill="1">Extruders</button>
    <button type="button" class="lab-pill" data-pill="2">Toolheads</button>
  </nav>

  <script is:inline>
    (function () {
      var pills = document.querySelectorAll('.lab-pill');
      pills.forEach(function (pill) {
        pill.addEventListener('click', function () {
          pills.forEach(function (p) { p.classList.remove('is-active'); });
          pill.classList.add('is-active');
        });
      });
    })();
  </script>
</Base>

<style is:global>
  /* Hallmark · component-lab: backdrop-filter glass · genre: atmospheric · theme: brand-dark
   * pre-emit critique: P5 H4 E5 S5 R4 V4
   * scope: this style block ships only on /lab/liquid-glass */

  /* Dark-first page; override the site's off-white body just here. */
  html, body { background: var(--dark-bg); overflow-x: clip; }

  /* ── Fixed background field (what the glass blurs) ───────────────── */
  .lab-bg {
    position: fixed; inset: 0; z-index: 0; overflow: hidden;
    pointer-events: none; background: var(--dark-bg);
  }
  .lab-bg-stripes {
    position: absolute; inset: -20%;
    background: repeating-linear-gradient(
      135deg,
      transparent 0 60px,
      rgba(255, 90, 31, 0.15) 60px 120px);
  }
  .lab-bg-glow {
    position: absolute; border-radius: 50%; filter: blur(10px);
  }
  .lab-bg-glow--1 {
    width: 70vw; height: 70vw; top: -10vh; left: -15vw;
    background: radial-gradient(circle, rgba(255, 90, 31, 0.38), transparent 60%);
  }
  .lab-bg-glow--2 {
    width: 60vw; height: 60vw; top: 38vh; right: -18vw;
    background: radial-gradient(circle, rgba(201, 59, 8, 0.42), transparent 62%);
  }
  .lab-bg-glow--3 {
    width: 65vw; height: 65vw; bottom: -18vh; left: 20vw;
    background: radial-gradient(circle, rgba(255, 122, 69, 0.30), transparent 60%);
  }
  .lab-ghost {
    position: absolute; white-space: nowrap;
    font-family: var(--fd); font-weight: 800; letter-spacing: -2px;
    line-height: 1; color: rgba(255, 255, 255, 0.06);
    font-size: clamp(56px, 12vw, 170px);
  }
  .lab-ghost--a { top: 6%;  left: 4%;   transform: rotate(-5deg); }
  .lab-ghost--b { top: 24%; right: 6%;  transform: rotate(4deg); }
  .lab-ghost--c { top: 46%; left: 8%;   transform: rotate(-3deg); color: rgba(255, 90, 31, 0.07); }
  .lab-ghost--d { top: 64%; right: 4%;  transform: rotate(6deg); }
  .lab-ghost--e { top: 82%; left: 10%;  transform: rotate(-4deg); }
  .lab-ghost--f { top: 92%; right: 12%; transform: rotate(3deg); color: rgba(255, 90, 31, 0.06); }

  /* ── Shared frosted-glass treatment ─────────────────────────────── */
  .glass {
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  /* ── Warning banner ─────────────────────────────────────────────── */
  .lab-warn {
    position: fixed; top: 14px; left: 50%; transform: translateX(-50%);
    z-index: 40; max-width: calc(100vw - 24px); text-align: center;
    font-family: var(--fm); font-size: 12px; letter-spacing: 0.2px;
    color: #ffd9c9; border-radius: 999px; padding: 8px 18px; white-space: nowrap;
  }

  /* ── Scrollable content layer ───────────────────────────────────── */
  .lab-content {
    position: relative; z-index: 1;
    max-width: 1000px; margin: 0 auto;
    padding: 0 20px 200px;
  }

  .lab-hero {
    min-height: 78vh; display: flex; flex-direction: column;
    justify-content: center; align-items: center; text-align: center;
  }
  .lab-eyebrow {
    font-family: var(--fm); font-size: 11px; text-transform: uppercase;
    letter-spacing: 2px; color: var(--accent-mid); margin: 0 0 14px;
  }
  .lab-title {
    font-family: var(--fd); font-weight: 800; letter-spacing: -1px;
    line-height: 1.02; color: #fff; margin: 0;
    font-size: clamp(40px, 8vw, 80px);
    overflow-wrap: anywhere; min-width: 0;
  }
  .lab-sub {
    font-family: var(--fu); color: rgba(255, 255, 255, 0.66);
    max-width: 48ch; margin: 18px auto 0; line-height: 1.55; font-size: 15px;
  }
  .lab-scrollcue {
    font-family: var(--fm); font-size: 12px; letter-spacing: 1px;
    color: var(--accent-mid); margin-top: 34px; text-transform: uppercase;
    animation: lab-bob 1.8s var(--ease-in-out, ease-in-out) infinite;
  }
  @keyframes lab-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(6px); } }

  /* ── Card rows — spread vertically so cards travel through the glow ── */
  .lab-row { min-height: 76vh; display: flex; align-items: center; }
  .lab-row--left   { justify-content: flex-start; }
  .lab-row--right  { justify-content: flex-end; }
  .lab-row--center { justify-content: center; }

  .card-content, .modal-content, .note-content {
    color: #fff; font-family: var(--fu);
  }
  .card-content { width: 300px; padding: 22px 24px 26px; }
  .modal-content { width: 320px; padding: 22px 24px 18px; }
  .note-content { width: 360px; max-width: 100%; padding: 24px 26px 26px; }

  .g-badge {
    display: inline-block; font-family: var(--fm); font-size: 11px;
    font-weight: 700; letter-spacing: 1px; padding: 3px 9px;
    border-radius: 5px; margin-bottom: 14px;
  }
  .g-buy {
    color: #7dffa8; background: rgba(34, 197, 94, 0.18);
    border: 1px solid rgba(34, 197, 94, 0.4);
  }
  .g-name {
    font-family: var(--fd); font-weight: 800; font-size: 26px;
    line-height: 1.06; margin: 0; color: #fff; overflow-wrap: anywhere;
  }
  .g-brand {
    font-family: var(--fu); font-size: 13px; margin: 6px 0 0;
    color: rgba(255, 255, 255, 0.66);
  }
  .g-price {
    font-family: var(--fm); font-size: 22px; font-weight: 500;
    color: var(--accent-mid); margin-top: 18px;
  }
  .g-modal-head { margin-bottom: 14px; }
  .g-eyebrow {
    font-family: var(--fm); font-size: 10px; text-transform: uppercase;
    letter-spacing: 2px; color: var(--accent-mid); display: block; margin-bottom: 6px;
  }
  .g-spec { width: 100%; border-collapse: collapse; }
  .g-spec th, .g-spec td {
    text-align: left; padding: 9px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1); font-size: 13px;
  }
  .g-spec tr:last-child th, .g-spec tr:last-child td { border-bottom: 0; }
  .g-spec th { font-family: var(--fu); font-weight: 400; color: rgba(255, 255, 255, 0.66); }
  .g-spec td { font-family: var(--fm); color: #fff; text-align: right; white-space: nowrap; }
  .g-body {
    font-family: var(--fb); font-size: 14px; line-height: 1.65;
    color: rgba(255, 255, 255, 0.78); margin: 12px 0 0;
  }

  /* ── Floating glass nav ─────────────────────────────────────────── */
  .lab-nav {
    position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%);
    z-index: 30; display: flex; gap: 6px; padding: 7px;
    border-radius: 999px; max-width: calc(100vw - 24px);
  }
  .lab-pill {
    font-family: var(--fu); font-size: 14px; color: rgba(255, 255, 255, 0.8);
    background: transparent; border: 1px solid transparent; border-radius: 999px;
    padding: 8px 18px; cursor: pointer;
    transition: color 0.18s ease, background 0.18s ease, border-color 0.18s ease;
  }
  .lab-pill:hover { color: #fff; background: rgba(255, 255, 255, 0.06); }
  .lab-pill:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .lab-pill.is-active {
    color: #fff;
    background: rgba(255, 90, 31, 0.3);
    border-color: rgba(255, 90, 31, 0.5);
  }

  @media (max-width: 560px) {
    .lab-content { padding-bottom: 160px; }
    .card-content, .modal-content, .note-content { width: min(86vw, 340px); }
    .lab-row--left, .lab-row--right, .lab-row--center { justify-content: center; }
    .lab-warn {
      font-size: 11px; padding: 7px 14px;
      white-space: normal; line-height: 1.35; border-radius: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lab-scrollcue { animation: none; }
    .lab-pill { transition: none; }
  }
</style>
