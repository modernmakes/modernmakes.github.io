---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeTicker from '../components/home/HomeTicker.astro';
import HomeNewsletterCTA from '../components/home/HomeNewsletterCTA.astro';
import HomeLatestArticles from '../components/home/HomeLatestArticles.astro';
import HomeEcosystemHubs from '../components/home/HomeEcosystemHubs.astro';
import HomeBuilds from '../components/home/HomeBuilds.astro';
import HomeToolsTeaser from '../components/home/HomeToolsTeaser.astro';
import AdSlot from '../components/AdSlot.astro';
import GlassCard from '../components/GlassCard.astro';
import { resolveVerdict } from '../lib/hardware';
import hotends from '../data/hardware/hotends.json';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
const currentPath = '/';

// Slug + first-sentence helpers (defined inline per project convention)
function toSlug(name: string) {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}
function firstSentence(text: string) {
  const m = (text ?? '').match(/^.*?[.!?](\s|$)/);
  return m ? m[0].trim() : (text ?? '');
}

// Top three hotends → featured glass cards
const featuredHotends = (hotends as any[]).slice(0, 3);
const featuredTopColors = [
  'linear-gradient(135deg, #FF5A1F 0%, #C93B08 100%)',
  'linear-gradient(135deg, #2a2a2a 0%, #FF5A1F22 100%)',
  'linear-gradient(135deg, #1a1a2e 0%, #FF5A1F11 100%)',
];

// The record already carries the resolved product-shot path (Image URL, e.g.
// /media/hardware/hotends/rapido-2f.webp) — same field /hardware/hotends reads,
// so no slug→path derivation is needed here. Verify the file is actually on disk
// at build time; a record pointing at a missing asset falls back to its gradient
// band rather than shipping a broken image. Note this check is case-sensitive on
// the Linux CI runner but not on Windows dev, so a case-mismatched path would
// silently degrade to the gradient in production — the paths are verified
// lowercase today, and `npm run fetch-data` writes them from Airtable.
const publicDir = join(process.cwd(), 'public');
const featuredImages = featuredHotends.map((rec: any) => {
  const url = typeof rec['Image URL'] === 'string' ? rec['Image URL'].trim() : '';
  if (!url.startsWith('/')) return null;
  return existsSync(join(publicDir, url)) ? url : null;
});
---
<Base title="The 3D Printing Enthusiast's Publication" description="Modern Makes — editorial coverage of 3D printers, filament, mods, and the builds that matter." heroPage={true} hasHero={true}>
  <Nav slot="nav" currentPath={currentPath} />
  <HomeHero />
  <HomeTicker />
  <HomeLatestArticles />
  <section class="fhw" aria-labelledby="fhw-heading">
    <div class="fhw-container">
      <header class="fhw-header">
        <div class="fhw-header-text">
          <p class="fhw-eyebrow" data-reveal>Featured Hardware</p>
          <h2 id="fhw-heading" class="fhw-headline" data-reveal data-reveal-delay="80">Hotends worth building around.</h2>
        </div>
        <a href="/hardware/hotends" class="fhw-all" data-reveal data-reveal-delay="160">All hotends <span class="arrow">→</span></a>
      </header>
      <div class="fhw-grid">
        {featuredHotends.map((rec: any, i: number) => {
          const v = resolveVerdict(rec.Verdict);
          return (
            <GlassCard
              category="HOTEND"
              name={rec.Name}
              description={firstSentence(rec.Description)}
              verdict={v?.label ?? ''}
              verdictKey={v?.key ?? ''}
              price={rec['Price (USD)']}
              href={`/hardware/hotends/${toSlug(rec.Name)}`}
              topColor={featuredTopColors[i]}
              imageSrc={featuredImages[i]}
              revealDelay={200 + i * 90}
            />
          );
        })}
      </div>
    </div>
  </section>
  <HomeEcosystemHubs />
  <HomeNewsletterCTA />
  <HomeToolsTeaser />
  <HomeBuilds />
  <AdSlot slotName="home-above-footer" />
  <Footer slot="footer" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Modern Makes — The 3D Printing Enthusiast's Publication",
    "description": "Editorial coverage of 3D printers, filament, mods, and builds that matter.",
    "url": new URL('/', Astro.site).href,
    "isPartOf": { "@type": "WebSite", "url": new URL('/', Astro.site).href },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL('/', Astro.site).href }
      ]
    }
  })}></script>
</Base>

<style>
  /* Featured hardware — dark band so the GlassCards' backdrop-filter has depth to blur */
  .fhw {
    position: relative;
    overflow: hidden;
    background: var(--dark-bg);
    padding: 64px 0;
    /* Orange seam glow ties dark-band edges to the brand identity (M8) */
    border-top: 1px solid transparent;
    border-image: linear-gradient(90deg, transparent, rgba(255, 90, 31, 0.35), transparent) 1;
  }
  .fhw::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(55% 55% at 50% 35%, rgba(255, 90, 31, 0.08), transparent 70%);
  }
  /* Living glow — a slow breathe makes the whole band feel alive (M3) */
  @media (prefers-reduced-motion: no-preference) {
    .fhw::before { animation: glow-breathe 9s ease-in-out infinite alternate; }
  }
  @keyframes glow-breathe {
    from { opacity: 0.65; transform: scale(1); }
    to   { opacity: 1;    transform: scale(1.15); }
  }
  .fhw-container {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .fhw-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }
  .fhw-eyebrow {
    font-family: var(--fu);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 8px;
  }
  .fhw-headline {
    font-family: var(--fd);
    font-size: clamp(22px, 2vw + 10px, 32px);
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.3px;
    line-height: 1.05;
    margin: 0;
  }
  .fhw-all {
    font-family: var(--fu);
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.15s ease;
  }
  .fhw-all:hover { color: var(--accent-mid); }
  .fhw-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  @media (max-width: 1024px) {
    .fhw-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fhw-header { flex-direction: column; align-items: flex-start; gap: 12px; }
  }
  @media (max-width: 768px) {
    .fhw-container { padding: 0 20px; }
  }
  @media (max-width: 560px) {
    .fhw-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>