---
// Internal design lab — NOT linked from nav, NOT indexed, NOT for production.
// Pure-CSS frosted glass via backdrop-filter over a fixed background field.
// Zero external deps. Showcases three reusable glass UI patterns on one scroll.
import Base from '../../layouts/Base.astro';
---
<Base
  title="Design Lab — Liquid Glass Test"
  description="Internal design lab — three production-ready backdrop-filter glass patterns on the Modern Makes dark aesthetic. Not for production."
  hasPageH1={true}
  heroPage={true}
>
  <meta name="robots" content="noindex, nofollow" slot="head" />

  <!-- ── Fixed background field: the blur source for every glass surface ── -->
  <div class="lab-bg" aria-hidden="true">
    <div class="lab-bg-stripes"></div>
    <div class="lab-bg-glow lab-bg-glow--1"></div>
    <div class="lab-bg-glow lab-bg-glow--2"></div>
    <div class="lab-bg-glow lab-bg-glow--3"></div>
    <span class="lab-ghost lab-ghost--a">RAPIDO</span>
    <span class="lab-ghost lab-ghost--b">CHUBE</span>
    <span class="lab-ghost lab-ghost--c">VORON</span>
    <span class="lab-ghost lab-ghost--d">RATRIG</span>
    <span class="lab-ghost lab-ghost--e">VZBOT</span>
    <span class="lab-ghost lab-ghost--f">RAPIDO</span>
  </div>

  <div class="lab-warn glass" role="note">⚠️ Lab page — not for production. Test at /lab/liquid-glass</div>

  <div class="lab-content">
    <header class="lab-hero">
      <p class="lab-eyebrow">Internal · backdrop-filter × Modern Makes</p>
      <h1 class="lab-title">Design Lab — Liquid&nbsp;Glass Test</h1>
      <p class="lab-sub">
        Three production-ready frosted-glass patterns, pure CSS. Scroll the whole page —
        the orange field blurs through every surface in real time.
      </p>
    </header>

    <!-- ════ PATTERN 01 — Hardware Detail Sidebar ════ -->
    <section class="lab-section">
      <p class="sec-eyebrow">Pattern 01 — Hardware Sidebar</p>
      <div class="p01-grid">
        <div class="p01-prose">
          <h2 class="p01-name">Rapido 2 UHF</h2>
          <p class="p01-lede">
            The Rapido 2 UHF is where most ultra-high-flow builds end up. It pairs a
            bi-metal heat break with a beefy 75 W heater to push melt rates that comfortably
            outrun a 0.6 mm nozzle, and the community consensus has settled: if you are
            chasing volumetric throughput on a CoreXY, this is the safe default.
          </p>
          <p>
            Rated to 55 mm³/s, real-world numbers land lower once you account for filament,
            slicer, and cooling — but the headroom is the point. The bi-metal break keeps the
            transition zone short, which is the single biggest lever against heat creep on
            long high-temp prints. Builders running ABS and ASA in an enclosure report the
            fewest jams of any hotend in this class.
          </p>
          <p>
            The M6 nozzle thread keeps it compatible with the enormous Volcano-adjacent
            ecosystem, so swapping between a hardened 0.4 mm for everyday PLA and a 0.6 mm
            for fast drafts is a two-minute job. The 3010 fan mount is a touch unusual, but
            replacement blowers are cheap and quiet, and the stock unit moves enough air to
            keep the heat break cool at the flow rates people actually run.
          </p>
          <p>
            Where it loses points: the price creeps above budget hotends, and the proprietary
            cartridge means you are buying into Phaetus consumables rather than generic
            spares. For a high-flow toolhead that has to just work for years, most builders
            decide that trade is worth making — and so do we.
          </p>
        </div>

        <aside class="p01-aside">
          <div class="glass p01-side">
            <span class="sub-eyebrow">Specs</span>
            <dl class="spec-list">
              <div class="spec-row"><dt>Max temp</dt><dd>360 °C</dd></div>
              <div class="spec-row"><dt>Max flow</dt><dd>55 mm³/s</dd></div>
              <div class="spec-row"><dt>Heat break</dt><dd>Bi-metal</dd></div>
              <div class="spec-row"><dt>Nozzle thread</dt><dd>M6</dd></div>
              <div class="spec-row"><dt>Weight</dt><dd>38 g</dd></div>
              <div class="spec-row"><dt>Fan size</dt><dd>3010</dd></div>
            </dl>
            <hr class="side-divider" />
            <div class="side-price">$84</div>
            <button type="button" class="btn-primary btn-full">Buy</button>
            <p class="side-also">Also available at</p>
            <p class="side-vendors">
              <a href="#" rel="noopener">West3D</a>
              <span aria-hidden="true">·</span>
              <a href="#" rel="noopener">Fabreeko</a>
            </p>
          </div>
        </aside>
      </div>
    </section>

    <!-- ════ PATTERN 02 — Verdict & Buy Box ════ -->
    <section class="lab-section">
      <p class="sec-eyebrow">Pattern 02 — Verdict &amp; Buy Box</p>
      <div class="glass p02-box">
        <div class="p02-head">
          <span class="big-badge bb-buy">BUY</span>
          <div class="p02-id">
            <h2 class="p02-name">Rapido 2 UHF</h2>
            <p class="p02-brand">Phaetus</p>
            <p class="p02-verdict">The default high-flow hotend for prosumer CoreXY builds.</p>
          </div>
        </div>
        <div class="p02-actions">
          <div class="p02-price">$84</div>
          <button type="button" class="btn-primary">Buy now</button>
          <button type="button" class="btn-ghost">Compare</button>
        </div>
        <div class="p02-chips">
          <span class="chip">360 °C</span>
          <span class="chip">55 mm³/s</span>
          <span class="chip">38 g</span>
        </div>
      </div>
    </section>

    <!-- ════ PATTERN 03 — Homepage Feature Cards ════ -->
    <section class="lab-section">
      <p class="sec-eyebrow">Pattern 03 — Homepage Feature Cards</p>
      <div class="p03-grid">
        <article class="glass feat-card">
          <div class="feat-band band-orange"></div>
          <div class="feat-body">
            <span class="sub-eyebrow">Hotend</span>
            <h3 class="feat-name">Rapido 2 UHF</h3>
            <p class="feat-desc">Bi-metal high-flow workhorse for fast, hot prints.</p>
            <div class="feat-foot">
              <span class="badge badge-buy">BUY</span>
              <span class="feat-price">$84</span>
            </div>
          </div>
        </article>

        <article class="glass feat-card">
          <div class="feat-band band-steel"></div>
          <div class="feat-body">
            <span class="sub-eyebrow">Extruder</span>
            <h3 class="feat-name">Sherpa V3</h3>
            <p class="feat-desc">Lightweight dual-gear drive with a strong grip on TPU.</p>
            <div class="feat-foot">
              <span class="badge badge-consider">CONSIDER</span>
              <span class="feat-price">$46</span>
            </div>
          </div>
        </article>

        <article class="glass feat-card">
          <div class="feat-band band-sand"></div>
          <div class="feat-body">
            <span class="sub-eyebrow">Toolhead</span>
            <h3 class="feat-name">Stealthburner</h3>
            <p class="feat-desc">The Voron standard — great cooling, endless mod support.</p>
            <div class="feat-foot">
              <span class="badge badge-buy">BUY</span>
              <span class="feat-price">$39</span>
            </div>
          </div>
        </article>
      </div>
    </section>
  </div>

  <!-- ── Floating glass nav ── -->
  <nav class="lab-nav glass" aria-label="Glass nav test">
    <button type="button" class="lab-pill is-active" data-pill="0">Hotends</button>
    <button type="button" class="lab-pill" data-pill="1">Extruders</button>
    <button type="button" class="lab-pill" data-pill="2">Toolheads</button>
  </nav>

  <script is:inline>
    (function () {
      var pills = document.querySelectorAll('.lab-pill');
      pills.forEach(function (pill) {
        pill.addEventListener('click', function () {
          pills.forEach(function (p) { p.classList.remove('is-active'); });
          pill.classList.add('is-active');
        });
      });
    })();
  </script>
</Base>

<style is:global>
  /* Hallmark · component-lab: backdrop-filter glass ×3 patterns · genre: atmospheric · theme: brand-dark
   * pre-emit critique: P5 H5 E5 S5 R4 V4
   * scope: this style block ships only on /lab/liquid-glass */

  html, body { background: var(--dark-bg); overflow-x: clip; }

  /* ── Fixed background field (blur source) ───────────────────────── */
  .lab-bg {
    position: fixed; inset: 0; z-index: 0; overflow: hidden;
    pointer-events: none; background: var(--dark-bg);
  }
  .lab-bg-stripes {
    position: absolute; inset: -20%;
    background: repeating-linear-gradient(
      135deg, transparent 0 60px, rgba(255, 90, 31, 0.15) 60px 120px);
  }
  .lab-bg-glow { position: absolute; border-radius: 50%; filter: blur(10px); }
  .lab-bg-glow--1 {
    width: 70vw; height: 70vw; top: -10vh; left: -15vw;
    background: radial-gradient(circle, rgba(255, 90, 31, 0.38), transparent 60%);
  }
  .lab-bg-glow--2 {
    width: 60vw; height: 60vw; top: 40vh; right: -18vw;
    background: radial-gradient(circle, rgba(201, 59, 8, 0.42), transparent 62%);
  }
  .lab-bg-glow--3 {
    width: 65vw; height: 65vw; bottom: -18vh; left: 20vw;
    background: radial-gradient(circle, rgba(255, 122, 69, 0.30), transparent 60%);
  }
  .lab-ghost {
    position: absolute; white-space: nowrap;
    font-family: var(--fd); font-weight: 800; letter-spacing: -2px;
    line-height: 1; color: rgba(255, 255, 255, 0.06);
    font-size: clamp(56px, 12vw, 170px);
  }
  .lab-ghost--a { top: 5%;  left: 4%;   transform: rotate(-5deg); }
  .lab-ghost--b { top: 22%; right: 6%;  transform: rotate(4deg); }
  .lab-ghost--c { top: 44%; left: 8%;   transform: rotate(-3deg); color: rgba(255, 90, 31, 0.07); }
  .lab-ghost--d { top: 62%; right: 4%;  transform: rotate(6deg); }
  .lab-ghost--e { top: 80%; left: 10%;  transform: rotate(-4deg); }
  .lab-ghost--f { top: 92%; right: 12%; transform: rotate(3deg); color: rgba(255, 90, 31, 0.06); }

  /* ── Shared frosted-glass treatment ─────────────────────────────── */
  .glass {
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  /* ── Warning banner ─────────────────────────────────────────────── */
  .lab-warn {
    position: fixed; top: 14px; left: 50%; transform: translateX(-50%);
    z-index: 40; max-width: calc(100vw - 24px); text-align: center;
    font-family: var(--fm); font-size: 12px; letter-spacing: 0.2px;
    color: #ffd9c9; border-radius: 999px; padding: 8px 18px; white-space: nowrap;
  }

  /* ── Content layer ──────────────────────────────────────────────── */
  .lab-content {
    position: relative; z-index: 1;
    max-width: 1080px; margin: 0 auto;
    padding: 0 24px 220px;
  }
  .lab-hero {
    min-height: 64vh; display: flex; flex-direction: column;
    justify-content: center; text-align: center; align-items: center;
  }
  .lab-eyebrow {
    font-family: var(--fm); font-size: 11px; text-transform: uppercase;
    letter-spacing: 2px; color: var(--accent-mid); margin: 0 0 14px;
  }
  .lab-title {
    font-family: var(--fd); font-weight: 800; letter-spacing: -1px;
    line-height: 1.02; color: #fff; margin: 0;
    font-size: clamp(40px, 8vw, 80px); overflow-wrap: anywhere; min-width: 0;
  }
  .lab-sub {
    font-family: var(--fu); color: rgba(255, 255, 255, 0.66);
    max-width: 50ch; margin: 18px auto 0; line-height: 1.55; font-size: 15px;
  }

  /* section rhythm — generous gaps so the glass reads between patterns */
  .lab-section { margin-top: 160px; }
  .sec-eyebrow {
    font-family: var(--fu); font-size: 12px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 2.5px;
    color: var(--accent); margin: 0 0 28px;
  }
  .sub-eyebrow {
    display: block; font-family: var(--fm); font-size: 10px;
    text-transform: uppercase; letter-spacing: 2px;
    color: var(--accent-mid); margin-bottom: 8px;
  }

  /* ════ PATTERN 01 — Hardware sidebar ════ */
  .p01-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 48px;
    align-items: start;
  }
  .p01-prose { color: rgba(255, 255, 255, 0.82); }
  .p01-name {
    font-family: var(--fd); font-weight: 800; font-size: clamp(34px, 5vw, 52px);
    line-height: 1.04; letter-spacing: -0.5px; color: #fff; margin: 0 0 20px;
    overflow-wrap: anywhere;
  }
  .p01-prose p { font-family: var(--fb); font-size: 16px; line-height: 1.7; margin: 0 0 18px; }
  .p01-lede { color: #fff; font-size: 18px !important; }

  .p01-aside { align-self: start; }
  .p01-side { position: sticky; top: 100px; padding: 24px; color: #fff; }
  .spec-list { margin: 0; }
  .spec-row {
    display: flex; justify-content: space-between; gap: 12px;
    padding: 9px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .spec-row:last-child { border-bottom: 0; }
  .spec-row dt { font-family: var(--fu); font-size: 13px; color: rgba(255, 255, 255, 0.66); margin: 0; }
  .spec-row dd { font-family: var(--fm); font-size: 13px; color: #fff; margin: 0; white-space: nowrap; }
  .side-divider { border: 0; border-top: 1px solid rgba(255, 255, 255, 0.12); margin: 18px 0; }
  .side-price {
    font-family: var(--fd); font-weight: 800; font-size: 40px;
    color: var(--accent); line-height: 1; margin-bottom: 16px;
  }
  .side-also {
    font-family: var(--fu); font-size: 12px; color: rgba(255, 255, 255, 0.55);
    margin: 18px 0 4px;
  }
  .side-vendors { margin: 0; font-family: var(--fu); font-size: 14px; }
  .side-vendors a { color: var(--accent-mid); text-decoration: none; }
  .side-vendors a:hover { text-decoration: underline; }
  .side-vendors span { color: rgba(255, 255, 255, 0.4); margin: 0 6px; }

  /* ════ PATTERN 02 — Verdict & buy box ════ */
  .p02-box {
    max-width: 600px; margin: 0 auto; padding: 28px; color: #fff;
  }
  .p02-head { display: flex; gap: 20px; align-items: center; }
  .big-badge {
    flex: none; font-family: var(--fu); font-weight: 800; font-size: 20px;
    letter-spacing: 1px; padding: 14px 22px; border-radius: 999px;
  }
  .bb-buy {
    color: #7dffa8; background: rgba(34, 197, 94, 0.2);
    border: 1px solid rgba(34, 197, 94, 0.45);
  }
  .p02-name {
    font-family: var(--fd); font-weight: 800; font-size: 30px; line-height: 1.05;
    margin: 0; color: #fff; overflow-wrap: anywhere;
  }
  .p02-brand { font-family: var(--fu); font-size: 13px; color: var(--accent-mid); margin: 4px 0 0; }
  .p02-verdict { font-family: var(--fb); font-size: 15px; color: rgba(255, 255, 255, 0.74); margin: 8px 0 0; }
  .p02-actions {
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    margin: 24px 0 4px;
  }
  .p02-price { font-family: var(--fd); font-weight: 800; font-size: 32px; color: var(--accent); }
  .p02-actions .btn-primary { flex: 1 1 auto; }
  .p02-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 20px; }
  .chip {
    font-family: var(--fm); font-size: 12px; color: rgba(255, 255, 255, 0.86);
    padding: 6px 12px; border-radius: 999px;
    background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* ════ PATTERN 03 — Feature cards ════ */
  .p03-grid {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px;
  }
  .feat-card {
    overflow: hidden; padding: 0; color: #fff;
    transition: transform 0.2s var(--ease-out, ease-out),
                box-shadow 0.2s var(--ease-out, ease-out),
                border-color 0.2s var(--ease-out, ease-out);
  }
  .feat-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: 0 16px 44px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .feat-band { height: 96px; }
  .band-orange { background: linear-gradient(135deg, var(--accent), var(--accent-dk)); }
  .band-steel  { background: linear-gradient(135deg, #3a4654, #222a33); }
  .band-sand   { background: linear-gradient(135deg, #6b5a48, #3a3026); }
  .feat-body { padding: 20px 22px 22px; }
  .feat-name {
    font-family: var(--fd); font-weight: 800; font-size: 24px; line-height: 1.08;
    margin: 0 0 8px; color: #fff; overflow-wrap: anywhere;
  }
  .feat-desc { font-family: var(--fb); font-size: 14px; line-height: 1.55; color: rgba(255, 255, 255, 0.72); margin: 0 0 18px; }
  .feat-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .feat-price { font-family: var(--fm); font-size: 15px; font-weight: 500; color: var(--accent); }

  .badge {
    font-family: var(--fm); font-size: 11px; font-weight: 700; letter-spacing: 1px;
    padding: 3px 9px; border-radius: 5px;
  }
  .badge-buy { color: #7dffa8; background: rgba(34, 197, 94, 0.18); border: 1px solid rgba(34, 197, 94, 0.4); }
  .badge-consider { color: #8ab4ff; background: rgba(59, 130, 246, 0.18); border: 1px solid rgba(59, 130, 246, 0.4); }

  /* ── Buttons ────────────────────────────────────────────────────── */
  .btn-primary {
    font-family: var(--fu); font-weight: 700; font-size: 15px; color: #fff;
    background: var(--accent); border: 1px solid transparent; border-radius: 12px;
    padding: 12px 20px; cursor: pointer;
    transition: background 0.18s var(--ease-out, ease-out);
  }
  .btn-primary:hover { background: var(--accent-dk); }
  .btn-primary:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .btn-full { display: block; width: 100%; margin-top: 4px; }
  .btn-ghost {
    font-family: var(--fu); font-weight: 600; font-size: 15px; color: #fff;
    background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 12px; padding: 12px 20px; cursor: pointer;
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    transition: border-color 0.18s var(--ease-out, ease-out), background 0.18s var(--ease-out, ease-out);
  }
  .btn-ghost:hover { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.28); }
  .btn-ghost:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* ── Floating glass nav ─────────────────────────────────────────── */
  .lab-nav {
    position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%);
    z-index: 30; display: flex; gap: 6px; padding: 7px;
    border-radius: 999px; max-width: calc(100vw - 24px);
  }
  .lab-pill {
    font-family: var(--fu); font-size: 14px; color: rgba(255, 255, 255, 0.8);
    background: transparent; border: 1px solid transparent; border-radius: 999px;
    padding: 8px 18px; cursor: pointer;
    transition: color 0.18s ease, background 0.18s ease, border-color 0.18s ease;
  }
  .lab-pill:hover { color: #fff; background: rgba(255, 255, 255, 0.06); }
  .lab-pill:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .lab-pill.is-active {
    color: #fff; background: rgba(255, 90, 31, 0.3); border-color: rgba(255, 90, 31, 0.5);
  }

  /* ── Responsive ─────────────────────────────────────────────────── */
  @media (max-width: 860px) {
    .p03-grid { grid-template-columns: minmax(0, 1fr); }
    .p01-grid { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    /* sidebar drops below prose and stops sticking on mobile */
    .p01-side { position: static; top: auto; }
  }

  @media (max-width: 560px) {
    .lab-content { padding-bottom: 170px; }
    .lab-section { margin-top: 104px; }
    .p02-head { flex-direction: column; align-items: flex-start; gap: 14px; }
    .p02-actions .btn-primary, .p02-actions .btn-ghost { flex: 1 1 100%; }
    .lab-warn {
      font-size: 11px; padding: 7px 14px;
      white-space: normal; line-height: 1.35; border-radius: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feat-card, .btn-primary, .btn-ghost, .lab-pill { transition: none; }
    .feat-card:hover { transform: none; }
  }
</style>
