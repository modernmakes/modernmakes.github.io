---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Brand {
  name: string;
  verdict: string;
  tier: 'top' | 'mid' | 'budget';
  notes: string;
}
interface FailureMode {
  name: string;
  cause: string;
  fix: string;
}
interface CompatItem {
  item: string;
  status: 'yes' | 'no' | 'sometimes';
  note?: string;
}

interface Props {
  title: string;
  fullName: string;
  tagline: string;
  category: string;
  difficulty: string;
  verdict: string;
  verdictLabel: 'RECOMMENDED' | 'ESSENTIAL' | 'SITUATIONAL' | 'AVOID';
  enclosureRequired: boolean;
  driedRequired: boolean;
  hardnessRequired: boolean;
  tempNozzle: string;
  tempBed: string;
  tempChamber?: string;
  coolingRequired: string;
  maxSpeed?: string;
  brands: Brand[];
  useCases: string[];
  failureModes: FailureMode[];
  compatibility: CompatItem[];
  pros: string[];
  cons: string[];
  excerpt: string;
}

const {
  title,
  fullName,
  tagline,
  category,
  difficulty,
  verdict,
  verdictLabel,
  enclosureRequired,
  driedRequired,
  hardnessRequired,
  tempNozzle,
  tempBed,
  tempChamber,
  coolingRequired,
  maxSpeed,
  brands = [],
  useCases = [],
  failureModes = [],
  compatibility = [],
  pros = [],
  cons = [],
  excerpt,
} = Astro.props;

const difficultyColor = {
  Beginner:     '#2E7D32',
  Intermediate: '#E65100',
  Advanced:     '#C62828',
}[difficulty] ?? '#E65100';

const verdictStyles = {
  ESSENTIAL:   { bg: 'rgba(255,90,31,.12)',  border: 'rgba(255,90,31,.35)',  text: '#FF5A1F' },
  RECOMMENDED: { bg: 'rgba(46,125,50,.10)',  border: 'rgba(46,125,50,.30)',  text: '#2E7D32' },
  SITUATIONAL: { bg: 'rgba(230,81,0,.10)',   border: 'rgba(230,81,0,.30)',   text: '#E65100' },
  AVOID:       { bg: 'rgba(198,40,40,.10)',  border: 'rgba(198,40,40,.30)',  text: '#C62828' },
}[verdictLabel] ?? { bg: 'rgba(255,90,31,.12)', border: 'rgba(255,90,31,.35)', text: '#FF5A1F' };

const relatedMaterials = [
  {
    name: 'PETG',
    desc: 'Tougher than PLA, easier than ABS. The daily driver for functional parts.',
    href: '/filament/petg',
    gradient: 'linear-gradient(135deg,#0d1a10,#1a1008)',
  },
  {
    name: 'ASA',
    desc: 'UV-stable, heat-resistant outdoor material. The true outdoor replacement.',
    href: '/filament/asa',
    gradient: 'linear-gradient(135deg,#1a1008,#201510)',
  },
  {
    name: 'PLA+',
    desc: 'More impact resistance, better layer adhesion. Still beginner-friendly.',
    href: '/filament/pla-plus',
    gradient: 'linear-gradient(135deg,#0d1520,#1a1020)',
  },
];

const siteBase = Astro.site
  ? new URL(Astro.site).href.replace(/\/$/, '')
  : 'https://modernmakes.github.io';
const canonicalUrl = siteBase + Astro.url.pathname;
const pathSegments = Astro.url.pathname.replace(/^\/|\/$/g, '').split('/').filter(Boolean);
const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteBase}/` },
  ...pathSegments.map((seg: string, i: number) => ({
    '@type': 'ListItem',
    position: i + 2,
    name: i === pathSegments.length - 1 ? title : seg.charAt(0).toUpperCase() + seg.slice(1),
    item: `${siteBase}/${pathSegments.slice(0, i + 1).join('/')}`,
  })),
];
---
<Base title={`${title} — Filament Guide`} description={excerpt} heroPage={true} hasHero={true} hasPageH1={true}>
  <Nav slot="nav" currentPath="/filament" />

  <!-- ── HERO ── -->
  <div class="fil-hero">
    <div class="fil-hero-bg"></div>
    <div class="fil-hero-content">
      <div class="fil-hero-inner">
        <div class="fil-hero-badges">
          <span class="fil-cat-badge">{category}</span>
          <span
            class="fil-diff-badge"
            style={`background:${difficultyColor}22;color:${difficultyColor};border-color:${difficultyColor}55`}
          >{difficulty}</span>
        </div>
        <h1 class="fil-hero-name">{title}</h1>
        <p class="fil-hero-fullname">{fullName}</p>
        <p class="fil-hero-tagline">{tagline}</p>
      </div>
    </div>
    <div class="fil-hero-stats-strip">
      <div class="fil-hero-inner">
        <div class="fil-stats-row">
          <div class="fil-stat">
            <span class="fil-stat-label">Nozzle</span>
            <span class="fil-stat-value">{tempNozzle}</span>
          </div>
          <div class="fil-stat-sep" aria-hidden="true"></div>
          <div class="fil-stat">
            <span class="fil-stat-label">Bed</span>
            <span class="fil-stat-value">{tempBed}</span>
          </div>
          <div class="fil-stat-sep" aria-hidden="true"></div>
          <div class="fil-stat">
            <span class="fil-stat-label">Cooling</span>
            <span class="fil-stat-value">{coolingRequired}</span>
          </div>
          <div class="fil-stat-sep" aria-hidden="true"></div>
          <div class="fil-stat">
            <span class="fil-stat-label">Enclosure</span>
            <span class={`fil-stat-chip ${enclosureRequired ? 'fil-chip-req' : 'fil-chip-no'}`}>
              {enclosureRequired ? 'Required' : 'Not needed'}
            </span>
          </div>
          <div class="fil-stat-sep" aria-hidden="true"></div>
          <div class="fil-stat">
            <span class="fil-stat-label">Dry Box</span>
            <span class={`fil-stat-chip ${driedRequired ? 'fil-chip-req' : 'fil-chip-opt'}`}>
              {driedRequired ? 'Recommended' : 'Optional'}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── BREADCRUMB ── -->
  <div class="fil-breadcrumb-bar">
    <div class="fil-container">
      <nav class="fil-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/filament">Filament</a>
        <span aria-hidden="true">/</span>
        <span>{title}</span>
      </nav>
    </div>
  </div>

  <!-- ── VERDICT BLOCK ── -->
  <div class="fil-verdict-wrap">
    <div class="fil-container">
      <div class="fil-verdict-block">
        <span
          class="fil-verdict-badge"
          style={`background:${verdictStyles.bg};color:${verdictStyles.text};border-color:${verdictStyles.border}`}
        >{verdictLabel}</span>
        <p class="fil-verdict-text">{verdict}</p>
      </div>
    </div>
  </div>

  <!-- ── BODY ── -->
  <div class="fil-body">
    <div class="fil-container">

      <!-- BEST USES -->
      {useCases.length > 0 && (
        <section class="fil-section">
          <h2 class="fil-section-heading">Best Uses</h2>
          <div class="fil-uses-grid">
            {useCases.map(uc => (
              <div class="fil-use-item">
                <span class="fil-use-dot" aria-hidden="true">◆</span>
                <span>{uc}</span>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- PRINT SETTINGS -->
      <section class="fil-section">
        <h2 class="fil-section-heading">Print Settings</h2>
        <div class="fil-settings-card">
          <div class="fil-setting-row">
            <span class="fil-setting-label">Nozzle Temp</span>
            <span class="fil-setting-value">{tempNozzle}</span>
          </div>
          <div class="fil-setting-row">
            <span class="fil-setting-label">Bed Temp</span>
            <span class="fil-setting-value">{tempBed}</span>
          </div>
          {tempChamber && (
            <div class="fil-setting-row">
              <span class="fil-setting-label">Chamber Temp</span>
              <span class="fil-setting-value">{tempChamber}</span>
            </div>
          )}
          <div class="fil-setting-row">
            <span class="fil-setting-label">Cooling</span>
            <span class="fil-setting-value">{coolingRequired}</span>
          </div>
          {maxSpeed && (
            <div class="fil-setting-row">
              <span class="fil-setting-label">Max Speed</span>
              <span class="fil-setting-value">{maxSpeed}</span>
            </div>
          )}
          <div class="fil-setting-row">
            <span class="fil-setting-label">Enclosure</span>
            <span class="fil-setting-value">{enclosureRequired ? 'Required' : 'Not required'}</span>
          </div>
          <div class="fil-setting-row">
            <span class="fil-setting-label">Dry Before Print</span>
            <span class="fil-setting-value">{driedRequired ? 'Recommended' : 'Usually not needed'}</span>
          </div>
          <div class="fil-setting-row">
            <span class="fil-setting-label">Hardened Nozzle</span>
            <span class="fil-setting-value">{hardnessRequired ? 'Required' : 'Not needed'}</span>
          </div>
        </div>
      </section>

      <!-- BRAND BREAKDOWN -->
      {brands.length > 0 && (
        <section class="fil-section">
          <h2 class="fil-section-heading">Brand Breakdown</h2>
          <div class="fil-brands-grid">
            {brands.map(brand => (
              <div class={`fil-brand-card fil-brand-${brand.tier}`}>
                <div class="fil-brand-header">
                  <span class="fil-brand-name">{brand.name}</span>
                  <span class={`fil-tier-badge fil-tier-${brand.tier}`}>{brand.tier.toUpperCase()}</span>
                </div>
                <p class="fil-brand-verdict">{brand.verdict}</p>
                {brand.notes && <p class="fil-brand-notes">{brand.notes}</p>}
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- HARDWARE COMPATIBILITY -->
      {compatibility.length > 0 && (
        <section class="fil-section">
          <h2 class="fil-section-heading">Hardware Compatibility</h2>
          <div class="fil-compat-wrap">
            <table class="fil-compat-table">
              <thead>
                <tr>
                  <th>Hardware</th>
                  <th>Status</th>
                  <th>Notes</th>
                </tr>
              </thead>
              <tbody>
                {compatibility.map(row => (
                  <tr>
                    <td class="fil-compat-item">{row.item}</td>
                    <td>
                      <span class={`fil-compat-chip fil-compat-${row.status}`}>
                        {row.status === 'yes' ? '✓ Yes' : row.status === 'no' ? '✗ No' : '~ Sometimes'}
                      </span>
                    </td>
                    <td class="fil-compat-note">{row.note ?? '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <!-- FAILURE MODES -->
      {failureModes.length > 0 && (
        <section class="fil-section">
          <h2 class="fil-section-heading">Common Failure Modes</h2>
          <div class="fil-failures-list">
            {failureModes.map(fm => (
              <div class="fil-failure-card">
                <h3 class="fil-failure-name">{fm.name}</h3>
                <div class="fil-failure-body">
                  <div class="fil-failure-row">
                    <span class="fil-failure-key">Cause</span>
                    <span class="fil-failure-val">{fm.cause}</span>
                  </div>
                  <div class="fil-failure-row">
                    <span class="fil-failure-key">Fix</span>
                    <span class="fil-failure-val">{fm.fix}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- PROS & CONS -->
      {(pros.length > 0 || cons.length > 0) && (
        <section class="fil-section">
          <h2 class="fil-section-heading">Pros &amp; Cons</h2>
          <div class="fil-procon-grid">
            {pros.length > 0 && (
              <div class="fil-procon-col fil-pros-col">
                <div class="fil-procon-col-head">Pros</div>
                <ul class="fil-procon-list">
                  {pros.map(p => <li>{p}</li>)}
                </ul>
              </div>
            )}
            {cons.length > 0 && (
              <div class="fil-procon-col fil-cons-col">
                <div class="fil-procon-col-head">Cons</div>
                <ul class="fil-procon-list">
                  {cons.map(c => <li>{c}</li>)}
                </ul>
              </div>
            )}
          </div>
        </section>
      )}

      <!-- PROSE SLOT -->
      <section class="fil-section fil-prose">
        <slot />
      </section>

    </div>
  </div>

  <!-- ── RELATED MATERIALS ── -->
  <section class="fil-related-section" aria-label="Related filament materials">
    <div class="fil-container">
      <div class="fil-related-head">
        <span class="fil-related-label">Related Materials</span>
        <a href="/filament" class="fil-related-all">All filaments →</a>
      </div>
      <div class="fil-related-grid">
        {relatedMaterials.map(mat => (
          <a href={mat.href} class="fil-related-card">
            <div class="fil-related-card-img" style={`background: ${mat.gradient}`}>
              <span class="fil-related-card-bigname">{mat.name}</span>
            </div>
            <div class="fil-related-card-body">
              <div class="fil-related-card-title">{mat.name}</div>
              <div class="fil-related-card-desc">{mat.desc}</div>
              <span class="fil-related-card-soon">Coming Soon</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": `${title} — Filament Guide`,
    "description": excerpt,
    "url": canonicalUrl,
    "publisher": {
      "@type": "Organization",
      "name": "Modern Makes",
      "url": siteBase,
      "logo": { "@type": "ImageObject", "url": `${siteBase}/images/wordmark.svg` }
    },
    "isPartOf": { "@type": "WebSite", "url": siteBase }
  })}></script>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbItems,
  })}></script>
</Base>

<style is:global>

/* ── HERO ── */
.fil-hero {
  position: relative;
  background: #0a0a0a;
  display: flex;
  flex-direction: column;
}
.fil-hero-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, #10080a 0%, #0d0d14 45%, #0a1210 100%);
  pointer-events: none;
}
.fil-hero-bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 70% 60% at 15% 40%, rgba(255,90,31,.07) 0%, transparent 70%);
}
.fil-hero-content {
  position: relative;
  flex: 1;
  display: flex;
  align-items: flex-end;
  padding: 80px 0 48px;
  min-height: 400px;
}
.fil-hero-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 40px;
  width: 100%;
}
.fil-hero-badges {
  display: flex;
  gap: 8px;
  margin-bottom: 20px;
}
.fil-cat-badge {
  font-family: var(--fu);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #fff;
  background: var(--accent);
  padding: 4px 12px;
  border-radius: 3px;
}
.fil-diff-badge {
  font-family: var(--fu);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  border: 1px solid;
  border-radius: 3px;
  padding: 4px 12px;
}
.fil-hero-name {
  font-family: var(--fd);
  font-size: clamp(80px, 14vw, 144px);
  font-weight: 800;
  color: #fff;
  line-height: .9;
  letter-spacing: -.02em;
  margin: 0 0 14px;
}
.fil-hero-fullname {
  font-family: var(--fu);
  font-size: 16px;
  font-weight: 500;
  color: rgba(255,255,255,.45);
  letter-spacing: .04em;
  text-transform: uppercase;
  margin-bottom: 18px;
}
.fil-hero-tagline {
  font-family: var(--fb);
  font-style: italic;
  font-size: 17px;
  color: rgba(255,255,255,.65);
  line-height: 1.55;
  max-width: 580px;
}
.fil-hero-stats-strip {
  position: relative;
  background: rgba(0,0,0,.55);
  border-top: 1px solid rgba(255,255,255,.07);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
.fil-stats-row {
  display: flex;
  align-items: center;
  gap: 0;
  height: 60px;
  flex-wrap: wrap;
}
.fil-stat {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 24px;
  flex-shrink: 0;
}
.fil-stat-sep {
  width: 1px;
  height: 24px;
  background: rgba(255,255,255,.1);
  flex-shrink: 0;
}
.fil-stat-label {
  font-family: var(--fu);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: rgba(255,255,255,.35);
}
.fil-stat-value {
  font-family: var(--fm);
  font-size: 13px;
  font-weight: 500;
  color: #fff;
}
.fil-stat-chip {
  font-family: var(--fu);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .06em;
  border-radius: 3px;
  padding: 3px 9px;
}
.fil-chip-req {
  background: rgba(198,40,40,.2);
  color: #EF9A9A;
  border: 1px solid rgba(198,40,40,.35);
}
.fil-chip-no {
  background: rgba(46,125,50,.15);
  color: #A5D6A7;
  border: 1px solid rgba(46,125,50,.3);
}
.fil-chip-opt {
  background: rgba(255,255,255,.07);
  color: rgba(255,255,255,.5);
  border: 1px solid rgba(255,255,255,.12);
}

/* ── SHARED CONTAINER ── */
.fil-container {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 40px;
}

/* ── BREADCRUMB ── */
.fil-breadcrumb-bar {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
}
.fil-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 14px 0;
  font-family: var(--fu);
  font-size: 12px;
  color: var(--g2);
}
.fil-breadcrumb a {
  color: var(--g1);
  transition: color .15s;
}
.fil-breadcrumb a:hover { color: var(--accent); }
.fil-breadcrumb span[aria-hidden] { color: var(--border-s); }

/* ── VERDICT BLOCK ── */
.fil-verdict-wrap {
  background: var(--surface);
  padding: 28px 0;
  border-bottom: 1px solid var(--border);
}
.fil-verdict-block {
  display: flex;
  align-items: center;
  gap: 24px;
  background: linear-gradient(135deg, #fff8f0, #fff2e8);
  border: 1.5px solid #FFCFBD;
  border-left: 4px solid var(--accent);
  border-radius: var(--radius-lg);
  padding: 22px 28px;
}
.fil-verdict-badge {
  font-family: var(--fu);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  border: 1px solid;
  border-radius: 3px;
  padding: 5px 12px;
  white-space: nowrap;
  flex-shrink: 0;
}
.fil-verdict-text {
  font-family: var(--fb);
  font-size: 16px;
  line-height: 1.65;
  color: var(--g1);
  margin: 0;
}

/* ── BODY ── */
.fil-body {
  background: var(--bg);
  padding: 0 0 16px;
}

/* ── SECTION HEADINGS ── */
.fil-section {
  padding: 48px 0 0;
}
.fil-section-heading {
  font-family: var(--fd);
  font-size: 26px;
  font-weight: 800;
  color: var(--black);
  letter-spacing: -.2px;
  margin-bottom: 20px;
  padding-bottom: 14px;
  border-bottom: 2px solid var(--border);
}

/* ── BEST USES GRID ── */
.fil-uses-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}
.fil-use-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 14px 16px;
  font-family: var(--fu);
  font-size: 14px;
  color: var(--g1);
  line-height: 1.4;
}
.fil-use-dot {
  color: var(--accent);
  font-size: 8px;
  flex-shrink: 0;
  margin-top: 4px;
}

/* ── PRINT SETTINGS ── */
.fil-settings-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.fil-setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 20px;
  border-bottom: 1px solid var(--border);
}
.fil-setting-row:last-child { border-bottom: none; }
.fil-setting-row:nth-child(even) { background: #fafaf9; }
.fil-setting-label {
  font-family: var(--fu);
  font-size: 13px;
  color: var(--g1);
}
.fil-setting-value {
  font-family: var(--fm);
  font-size: 13px;
  font-weight: 500;
  color: var(--black);
}

/* ── BRAND BREAKDOWN ── */
.fil-brands-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.fil-brand-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 20px;
}
.fil-brand-top {
  border-top: 3px solid var(--accent);
}
.fil-brand-mid {
  border-top: 3px solid var(--g2);
}
.fil-brand-budget {
  border-top: 3px solid var(--border-s);
}
.fil-brand-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 10px;
}
.fil-brand-name {
  font-family: var(--fd);
  font-size: 20px;
  font-weight: 800;
  color: var(--black);
}
.fil-tier-badge {
  font-family: var(--fu);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .1em;
  border-radius: 3px;
  padding: 3px 8px;
  flex-shrink: 0;
}
.fil-tier-top {
  background: rgba(255,90,31,.12);
  color: var(--accent);
  border: 1px solid rgba(255,90,31,.3);
}
.fil-tier-mid {
