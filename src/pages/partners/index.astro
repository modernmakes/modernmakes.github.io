---
/* Hallmark · macrostructure: Long Document (2-col prose + sticky sidebar TOC)
 * pre-emit critique: P5 H4 E5 S4 R5 V5
 */
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const siteBase = Astro.site
  ? new URL(Astro.site).href.replace(/\/$/, '')
  : 'https://modernmakes.github.io';

const sections = [
  { id: 'model',          label: 'How It Works' },
  { id: 'what-we-offer',  label: 'What We Offer' },
  { id: 'what-we-need',   label: 'What We Need' },
  { id: 'apply',          label: 'Apply' },
];

const whatWeOffer = [
  {
    title: 'Hardware detail page links',
    body: "Your product appears in the \"Where to Buy\" section on its dedicated hardware page — hotends, extruders, bed probes, and other categories. This is high-intent traffic: readers researching before they buy.",
  },
  {
    title: 'Guide and roundup mentions',
    body: "When a guide or buying roundup covers a product we're affiliated with, we link to the best vendor. Editorial selection — we pick the right vendor for the reader, not the highest commission.",
  },
  {
    title: 'Newsletter mentions',
    body: 'The Modern Makes Brief occasionally recommends hardware directly. Affiliate partners with genuinely good pricing or availability are mentioned in context.',
  },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Partner With Us — Modern Makes',
  url: `${siteBase}/partners`,
  description: 'How Modern Makes works with 3D printing hardware vendors on affiliate partnerships. Apply to become a partner.',
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',     item: `${siteBase}/` },
    { '@type': 'ListItem', position: 2, name: 'Partners', item: `${siteBase}/partners` },
  ],
};
---
<Base
  title="Partner With Us — Modern Makes"
  description="How Modern Makes works with 3D printing hardware vendors on affiliate partnerships. Apply to become a partner."
  hasPageH1={true}
>
  <Nav slot="nav" currentPath="/partners" />

  <div class="lg-wrap">
    <div class="lg-inner">

      <nav class="lg-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <span>Partner With Us</span>
      </nav>

      <div class="lg-layout">

        <aside class="lg-sidebar" aria-label="Table of contents">
          <div class="lg-toc">
            <p class="lg-toc-label">On this page</p>
            <nav>
              {sections.map(s => (
                <a class="lg-toc-link" href={`#${s.id}`}>{s.label}</a>
              ))}
            </nav>
          </div>
        </aside>

        <main class="lg-content" id="lg-main">
          <h1 class="lg-title">Partner With Us</h1>
          <p class="lg-meta">For 3D printing hardware vendors, component makers, and filament brands</p>

          <section id="model">
            <h2>How It Works</h2>
            <p>Modern Makes links to products we would recommend anyway. When we have an affiliate relationship with a vendor, their products get purchase links on hardware detail pages. When we don't, those products still get covered editorially — they just don't get buy buttons.</p>
            <p>Affiliate commissions fund the publication. They don't determine which products we recommend. Our readers come to us because our verdicts are independent — the moment we trade that for a commission, the readership disappears. That's not a sacrifice we're willing to make.</p>
            <p>This means we apply to affiliate programs selectively. If a product isn't something we'd link to on merit, we won't apply. If it is, being affiliated makes it easier to give readers a direct purchase path.</p>
            <p>We are actively building our affiliate partner network. If your products are a good fit for our audience, we'd like to hear from you.</p>
          </section>

          <section id="what-we-offer">
            <h2>What We Offer</h2>
            <p>Partners with affiliate programs get placement in three areas of the site.</p>

            <div class="prt-offer-list">
              {whatWeOffer.map(item => (
                <div class="prt-offer-card">
                  <p class="prt-offer-title">{item.title}</p>
                  <p class="prt-offer-body">{item.body}</p>
                </div>
              ))}
            </div>
          </section>

          <section id="what-we-need">
            <h2>What We Need</h2>
            <ul>
              <li>Access to your affiliate program — a direct referral link or account in your affiliate platform.</li>
              <li>Accurate product specifications we can reference on detail pages (gear ratios, weights, temperatures, compatibility).</li>
              <li>Spec sheets or documentation rather than physical samples — we're synthesizers, not a test lab.</li>
            </ul>
            <p>We don't require free samples, review units, or anything that creates a reciprocal obligation. The relationship is simple: you run an affiliate program, we apply, and we link editorially where it makes sense.</p>
          </section>

          <section id="apply">
            <h2>Apply</h2>
            <p>Tell us about your product and affiliate program. We review applications within 5 business days.</p>

            <form class="lg-form" id="prt-form">
              <div class="lg-form-row">
                <div class="lg-form-group">
                  <label class="lg-form-label" for="prt-company">Company / Brand</label>
                  <input class="lg-form-input" type="text" id="prt-company" placeholder="Your company name" required />
                </div>
                <div class="lg-form-group">
                  <label class="lg-form-label" for="prt-category">Product category</label>
                  <select class="lg-form-input" id="prt-category">
                    <option value="">Select...</option>
                    <option value="hotends">Hotends</option>
                    <option value="extruders">Extruders</option>
                    <option value="motion">Motion Systems</option>
                    <option value="electronics">Electronics / Boards</option>
                    <option value="filament">Filament</option>
                    <option value="probes">Bed Probes</option>
                    <option value="other">Other</option>
                  </select>
                </div>
              </div>
              <div class="lg-form-row">
                <div class="lg-form-group">
                  <label class="lg-form-label" for="prt-website">Website</label>
                  <input class="lg-form-input" type="url" id="prt-website" placeholder="https://yoursite.com" />
                </div>
                <div class="lg-form-group">
                  <label class="lg-form-label" for="prt-affiliate-url">Affiliate program URL</label>
                  <input class="lg-form-input" type="url" id="prt-affiliate-url" placeholder="https://affiliate-platform.com/..." />
                </div>
              </div>
              <div class="lg-form-group">
                <label class="lg-form-label" for="prt-contact-email">Contact email</label>
                <input class="lg-form-input" type="email" id="prt-contact-email" placeholder="you@company.com" required />
              </div>
              <div class="lg-form-group">
                <label class="lg-form-label" for="prt-msg">Message</label>
                <textarea class="lg-form-input lg-form-textarea" id="prt-msg" placeholder="What products are you hoping to get exposure for? Commission structure? Anything else we should know?" rows="4"></textarea>
              </div>
              <button class="lg-form-submit" type="submit" id="prt-btn">Send Application</button>
              <p class="lg-form-msg" id="prt-msg-out" style="display:none"></p>
            </form>
          </section>

        </main>
      </div>
    </div>
  </div>

  <Footer slot="footer" />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify(pageSchema)}></script>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)}></script>
</Base>

<script>
(function () {
  const sections = document.querySelectorAll<HTMLElement>('.lg-content section[id]');
  const links    = document.querySelectorAll<HTMLAnchorElement>('.lg-toc-link');
  if (!sections.length || !links.length) return;
  const obs = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        links.forEach(l => l.removeAttribute('aria-current'));
        const active = document.querySelector<HTMLAnchorElement>(`.lg-toc-link[href="#${entry.target.id}"]`);
        if (active) active.setAttribute('aria-current', 'true');
      }
    }
  }, { rootMargin: '-15% 0px -75% 0px' });
  sections.forEach(s => obs.observe(s));
})();
</script>

<script is:inline>
(function () {
  var form = document.getElementById('prt-form');
  var btn  = document.getElementById('prt-btn');
  var out  = document.getElementById('prt-msg-out');
  if (!form) return;

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var company      = document.getElementById('prt-company').value;
    var category     = document.getElementById('prt-category').value;
    var website      = document.getElementById('prt-website').value;
    var affiliateUrl = document.getElementById('prt-affiliate-url').value;
    var email        = document.getElementById('prt-contact-email').value;
    var message      = document.getElementById('prt-msg').value;

    btn.textContent = 'Sending…';
    btn.disabled = true;

    fetch('https://hook.us1.make.com/xxkrs4kgfwvgp0d83ve2oylwy6pntes2', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ type: 'partner', company: company, category: category, website: website, affiliateUrl: affiliateUrl, email: email, message: message, page: 'partners' })
    })
    .then(function () {
      form.style.display = 'none';
      out.textContent = 'Application sent. We'll review it within 5 business days.';
      out.style.color = 'var(--g1)';
      out.style.display = 'block';
    })
    .catch(function () {
      btn.textContent = 'Send Application';
      btn.disabled = false;
      out.textContent = 'Something went wrong. Email modernmakesco@gmail.com directly.';
      out.style.color = 'var(--accent)';
      out.style.display = 'block';
    });
  });
})();
</script>

<style>
.prt-offer-list { display: flex; flex-direction: column; gap: 12px; margin-top: 18px; }
.prt-offer-card {
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 18px;
  background: var(--surface);
}
.prt-offer-title {
  font-family: var(--fd);
  font-size: 17px;
  font-weight: 800;
  color: var(--black);
  margin-bottom: 6px;
  line-height: 1.2;
}
.prt-offer-body {
  font-family: var(--fb);
  font-size: 14px;
  color: var(--g1);
  line-height: 1.75;
  margin-bottom: 0;
}
</style>
