---
// Designed stand-in for a missing image: the category eyebrow on a neutral dot pattern, plus the
// mono date on article heroes. Never the title: every card and page shows its own title right
// beside it. Decorative, so it is hidden from assistive tech. Styles: .type-cover in global.css.
interface Props {
  eyebrow?: string;
  date?: string;
  size?: 'card' | 'hero';
}
const { eyebrow, date, size = 'card' } = Astro.props;
---
<div class:list={['type-cover', { 'type-cover--hero': size === 'hero' }]} aria-hidden="true">
  {eyebrow && <span class="type-cover-eyebrow">{eyebrow}</span>}
  {date && <span class="type-cover-date">{date}</span>}
</div>
