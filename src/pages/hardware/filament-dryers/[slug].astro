---
import HardwareDetail from '../../../components/HardwareDetail.astro';
import records from '../../../data/hardware/filament-dryers.json';
import { staticPathsFor, type DetailConfig } from '../../../lib/hardware';

const config: DetailConfig = {
  categoryLabel: 'FILAMENT DRYER',
  componentType: 'Filament Dryer',
  titleNoun: 'Filament Dryer',
  quickSpecs: [
    { label: 'Capacity', fields: ['Capacity'] },
    { label: 'Max Temp', fields: ['Max Temp', 'Max Temp (°C)'], fmt: (v) => `${v}°C` },
    { label: 'Timer', fields: ['Timer'] },
  ],
  specs: [
    { label: 'Capacity', fields: ['Capacity'] },
    { label: 'Max Temperature', fields: ['Max Temp', 'Max Temp (°C)'], fmt: (v) => `${v}°C` },
    { label: 'Active Circulation', fields: ['Active Circulation'] },
    { label: 'Print While Dry', fields: ['Print While Dry'] },
    { label: 'Display', fields: ['Display'] },
    { label: 'Timer', fields: ['Timer'] },
  ],
};

export function getStaticPaths() {
  return staticPathsFor(records as any[]);
}

const { record } = Astro.props as { record: any };
---
<HardwareDetail record={record} config={config} />
