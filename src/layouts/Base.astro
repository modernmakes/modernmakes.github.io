---
// Base layout — wraps every page on the site
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  heroPage?: boolean;
  /** Set true on pages with a full-bleed dark hero so the nav starts transparent */
  hasHero?: boolean;
  /** Set true on pages that render their own visible H1 to suppress the sr-only fallback */
  hasPageH1?: boolean;
}
const {
  title,
  description = "The editorial voice of the 3D printing enthusiast. Printers, filament, mods, and the culture that matters.",
  ogImage = "/og-default.jpg",
  heroPage = false,
  hasHero  = false,
  hasPageH1 = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site).href;
const siteURL = new URL('/', Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Mark JS available before paint. Scroll-reveal sections only hide when they can actually be revealed, so no-JS and crawlers stay visible. -->
  <script is:inline>document.documentElement.classList.add('js')</script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title} — Modern Makes</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title" content={`${title} — Modern Makes`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Modern Makes",
    "url": siteURL,
    "description": "Editorial coverage of 3D printers, filament, mods, and builds that matter.",
    "publisher": {
      "@type": "Organization",
      "name": "Modern Makes",
      "url": siteURL,
      "logo": {
        "@type": "ImageObject",
        "url": new URL('/images/wordmark.svg', Astro.site).href
      }
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": `${new URL('/search', Astro.site).href}?q={search_term_string}`
      },
      "query-input": "required name=search_term_string"
    }
  })}></script>
  <slot name="head" />
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-CGR4N532H6"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-CGR4N532H6');
  </script>
</head>
<body data-hero={hasHero ? "true" : undefined}>
  <slot name="nav" />
  <main class={heroPage ? 'main-has-hero' : ''}>
    {!hasPageH1 && <h1 class="sr-only">Modern Makes — Editorial coverage of 3D printers, filament, mods, and builds that matter</h1>}
    <slot />
  </main>
  <slot name="footer" />
  <script>
    // Shared scroll-reveal (M1) — one observer for every [data-reveal] on the page.
    // Adds .is-revealed, staggered by data-reveal-delay. Replaces the per-section
    // IO scripts. Elements only start hidden under .js + prefers-reduced-motion.
    const revealEls = document.querySelectorAll('[data-reveal]');
    if (revealEls.length) {
      // Compress staggers on narrow viewports so single-column reveals don't drag.
      const delayScale = window.innerWidth <= 640 ? 0.5 : 1;
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          const delay = Number(el.getAttribute('data-reveal-delay') ?? 0) * delayScale;
          setTimeout(() => el.classList.add('is-revealed'), delay);
          io.unobserve(el);
        }
      }, { threshold: 0.08, rootMargin: '0px 0px -48px 0px' });
      revealEls.forEach((el) => io.observe(el));
      // Failsafe: background tab / headless render / observer never fires.
      setTimeout(() => revealEls.forEach((el) => el.classList.add('is-revealed')), 1600);
    }
  </script>
  <script>
    document.querySelectorAll('form[data-nl]').forEach(form => {
      form.addEventListener('submit', e => {
        e.preventDefault();
        const input = form.querySelector('input[type="email"]') as HTMLInputElement;
        const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        if (input && input.value.includes('@')) {
          const orig = btn.textContent;
          btn.textContent = 'Subscribed ✓';
          btn.style.background = '#2E7D32';
          input.value = '';
          input.placeholder = "You're on the list";
          setTimeout(() => { btn.textContent = orig; btn.style.background = ''; }, 3000);
        } else if (input) {
          input.style.borderColor = 'rgba(255,90,31,.7)';
          setTimeout(() => input.style.borderColor = '', 1000);
        }
      });
    });
  </script>
</body>
</html>