---
import HardwareIndex from '../../components/HardwareIndex.astro';
import records from '../../data/hardware/printers.json';
import homepage from '../../data/homepage.json';

// Same ecosystem list as the footer and homepage: live entries link to their hub, the rest show "Soon".
const ecosystems = (homepage as any).ecosystems ?? [];

const chips = (r: any) => [
  r['Build Volume'] ? String(r['Build Volume']) : null,
  r['Motion System'] ? String(r['Motion System']) : null,
  (r['Price (USD)'] ?? r['BOM Cost']) != null ? `~$${r['Price (USD)'] ?? r['BOM Cost']}` : null,
].filter(Boolean) as string[];

// Printers are hero content — lead each card with build volume + motion system.
const excerptOf = (r: any) =>
  r['Verdict Label'] ?? r['Description'] ?? (r['Build Volume'] ? `${r['Build Volume']} build volume self-build printer.` : '');
---
<HardwareIndex
  records={records}
  route="printers"
  basePath="/printers"
  navPath="/printers"
  parent={{ label: 'Home', href: '/' }}
  categoryLabel="PRINTER"
  crumb="Printers"
  heading="Printers"
  sub="The self-build ecosystems we cover, and every printer model with build volume, frame, BOM cost, and difficulty."
  nounSingular="printer"
  nounPlural="printers"
  title="Self-Build CoreXY 3D Printers and Ecosystems"
  description="Self-build CoreXY printer ecosystems (Voron, Rat Rig, VzBot, HevORT, Annex K3) and every printer model with build volume, frame, BOM cost, and difficulty."
  schemaName="Self-Build CoreXY 3D Printers"
  chips={chips}
  excerptOf={excerptOf}
>
  <Fragment slot="intro">
    <section class="section" aria-labelledby="eco-heading">
      <div class="container">
        <div class="section-head">
          <h2 class="section-head-label" id="eco-heading">Ecosystems</h2>
        </div>
        <ul class="eco-list">
          {ecosystems.map((eco: any) => (
            <li class="eco-item">
              {eco.status === 'live'
                ? <a href={eco.href} class="eco-name">{eco.name}</a>
                : (
                  <span class="eco-name eco-soon">
                    {eco.name}<span class="sr-only">, coming soon</span>
                    <span class="eco-soon-tag" aria-hidden="true">Soon</span>
                  </span>
                )}
              <p class="eco-desc">{eco.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <section class="section printers-head" aria-labelledby="printers-heading">
      <div class="container">
        <div class="section-head">
          <h2 class="section-head-label" id="printers-heading">Printers</h2>
        </div>
      </div>
    </section>
  </Fragment>
</HardwareIndex>

<style is:global>
  .eco-list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 0 32px;
  }
  .eco-item { border-top: 1px solid var(--border); padding: 14px 0 20px; min-width: 0; }
  .eco-name {
    display: inline-block; font-family: var(--fd); font-size: 24px; font-weight: 800;
    line-height: 1.1; color: var(--black); text-decoration: none;
  }
  a.eco-name { transition: color var(--dur-fast) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { a.eco-name:hover { color: var(--accent-dk); } }
  .eco-soon { color: var(--g1); cursor: default; }
  .eco-soon-tag {
    margin-left: 10px; font-family: var(--fm); font-size: 10px; font-weight: 500;
    letter-spacing: .06em; text-transform: uppercase; color: var(--g1); vertical-align: middle;
  }
  .eco-desc { margin: 6px 0 0; font-family: var(--fb); font-size: 14px; line-height: 1.6; color: var(--g1); }
  .printers-head { padding-bottom: 0; }
  .printers-head .section-head { margin-bottom: 0; }
</style>
