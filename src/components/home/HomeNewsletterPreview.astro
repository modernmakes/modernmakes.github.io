---
// HomeNewsletterPreview.astro
// Dark section. Left: value prop + form. Right: sample issue card.
---

<section class="nlp-section" aria-labelledby="nlp-heading">
  <div class="nlp-inner">

    <!-- Left: copy + form -->
    <div class="nlp-left">
      <p class="nlp-eyebrow">Weekly Newsletter</p>
      <h2 id="nlp-heading" class="nlp-headline">The briefing your inbox has been missing.</h2>
      <p class="nlp-body">Every Tuesday — the most important launches, the best current deals, and one thing from the community worth your attention. 400–600 words. Never padded.</p>

      <ul class="nlp-features" aria-label="What's in every issue">
        <li class="nlp-feature">
          <span class="nlp-dot" aria-hidden="true"></span>
          <span><strong>One lead story</strong> — the week's most important development, in depth</span>
        </li>
        <li class="nlp-feature">
          <span class="nlp-dot" aria-hidden="true"></span>
          <span><strong>3–4 quick hits</strong> — launches, news, and deals worth knowing about</span>
        </li>
        <li class="nlp-feature">
          <span class="nlp-dot" aria-hidden="true"></span>
          <span><strong>Find of the week</strong> — one interesting thing from the community</span>
        </li>
        <li class="nlp-feature">
          <span class="nlp-dot" aria-hidden="true"></span>
          <span><strong>Free, always</strong> — no paywall, no paid placement in the editorial</span>
        </li>
      </ul>

      <form class="nlp-form" id="nlp-form" novalidate aria-label="Newsletter signup">
        <label class="sr-only" for="nlp-email">Email address</label>
        <input
          class="nlp-input"
          type="email"
          id="nlp-email"
          name="email"
          placeholder="your@email.com"
          autocomplete="email"
          required
        />
        <button class="nlp-btn" type="submit">Join the briefing →</button>
        <p class="nlp-note">Free. Unsubscribe any time.</p>
      </form>
    </div>

    <!-- Right: sample issue card -->
    <div class="nlp-card" aria-label="Sample newsletter issue preview">
      <div class="nlp-card-header">
        <div class="nlp-card-logo">Modern<span>Makes</span></div>
        <p class="nlp-card-tagline">The 3D printing enthusiast's weekly briefing</p>
      </div>
      <div class="nlp-card-body">
        <p class="nlp-card-issue">Issue #14 · May 20, 2026</p>
        <h3 class="nlp-card-title">Bambu's AMS Pro changes the multi-material calculus</h3>
        <p class="nlp-card-text">Sixteen spools. Active drying. Humidity monitoring. Two weeks with a unit — and the honest verdict is it's the enclosure for the AMS that should have shipped in 2023.</p>
        <a href="/newsletter" class="nlp-card-cta" tabindex="-1" aria-hidden="true">Read the full issue →</a>
        <hr class="nlp-card-hr" />
        <p class="nlp-card-hits-label">This week's quick hits</p>
        <ul class="nlp-card-hits" aria-label="Quick hits">
          <li class="nlp-card-hit"><span>Launch —</span> Prusa CORE One INDX 8-nozzle toolchanger orderable now</li>
          <li class="nlp-card-hit"><span>Deal —</span> Bambu PETG HF 1kg at $19.99 — 20% off this week only</li>
          <li class="nlp-card-hit"><span>Community —</span> Voron 2.4 BOM costs down 12% year-on-year</li>
        </ul>
      </div>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('nlp-form') as HTMLFormElement | null;
  if (form) {
    const input = form.querySelector<HTMLInputElement>('#nlp-email');
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!input || !btn) return;
      if (input.value && input.value.includes('@') && input.value.includes('.')) {
        btn.textContent = "You're in ✓";
        btn.classList.add('nlp-btn--success');
        btn.disabled = true;
        input.value = '';
        input.placeholder = 'Check your inbox';
        input.disabled = true;
        // GA4 tracking
        if (typeof gtag !== 'undefined') {
          gtag('event', 'newsletter_signup', { location: 'homepage_preview' });
        }
      } else {
        input.classList.add('nlp-input--error');
        input.focus();
        setTimeout(() => input.classList.remove('nlp-input--error'), 1200);
      }
    });
  }
</script>

<style is:global>
/* ── Section ── */
.nlp-section {
  background: #0f0f0f;
  padding: 64px 0;
  border-top: 1px solid rgba(255,255,255,.06);
}
.nlp-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px;
  display: grid;
  grid-template-columns: 1fr 340px;
  gap: 60px;
  align-items: center;
}

/* Left */
.nlp-eyebrow {
  font-family: var(--fu);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--accent);
  margin: 0 0 14px;
}
.nlp-headline {
  font-family: var(--fd);
  font-size: clamp(26px, 3vw + 8px, 42px);
  font-weight: 800;
  color: #fff;
  line-height: 1.0;
  letter-spacing: -.4px;
  margin: 0 0 16px;
}
.nlp-body {
  font-family: var(--fb);
  font-size: 14px;
  color: rgba(255,255,255,.42);
  line-height: 1.75;
  margin: 0 0 28px;
  max-width: 440px;
}

/* Feature list */
.nlp-features {
  list-style: none;
  padding: 0;
  margin: 0 0 32px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.nlp-feature {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font-family: var(--fu);
  font-size: 13px;
  color: rgba(255,255,255,.48);
  line-height: 1.5;
}
.nlp-feature strong { color: rgba(255,255,255,.8); font-weight: 600; }
.nlp-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
  margin-top: 5px;
}

/* Form */
.nlp-form {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-width: 400px;
}
.nlp-input {
  background: rgba(255,255,255,.07);
  border: 1.5px solid rgba(255,255,255,.12);
  border-radius: 7px;
  padding: 13px 16px;
  font-family: var(--fu);
  font-size: 14px;
  color: #fff;
  outline-color: transparent;
  transition: border-color .15s;
  box-sizing: border-box;
  width: 100%;
}
.nlp-input::placeholder { color: rgba(255,255,255,.28); }
.nlp-input:focus { border-color: rgba(255,255,255,.35); }
.nlp-input--error {
  border-color: rgba(255,90,31,.7) !important;
  animation: nlp-shake .3s ease;
}
@keyframes nlp-shake {
  0%,100% { transform: translateX(0); }
  25% { transform: translateX(-4px); }
  75% { transform: translateX(4px); }
}
.nlp-btn {
  background: var(--accent);
  color: #fff;
  font-family: var(--fu);
  font-size: 14px;
  font-weight: 700;
  padding: 13px 20px;
  border-radius: 7px;
  border: none;
  cursor: pointer;
  transition: background .15s, transform .1s;
  width: 100%;
  box-sizing: border-box;
}
.nlp-btn:hover:not(:disabled) { background: var(--accent-dk); transform: translateY(-1px); }
.nlp-btn--success { background: #16a34a !important; transform: none !important; cursor: default; }
.nlp-note {
  font-family: var(--fu);
  font-size: 11px;
  color: rgba(255,255,255,.2);
  margin: 0;
}

/* Sample card */
.nlp-card {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 24px 60px rgba(0,0,0,.5);
}
.nlp-card-header {
  background: #1A1A1A;
  border-bottom: 1px solid rgba(255,255,255,.08);
  padding: 16px 20px;
}
.nlp-card-logo {
  font-family: var(--fd);
  font-size: 17px;
  font-weight: 800;
  color: #fff;
  margin: 0 0 2px;
}
.nlp-card-logo span { color: var(--accent); }
.nlp-card-tagline {
  font-family: var(--fm);
  font-size: 9px;
  color: rgba(255,255,255,.28);
  margin: 0;
}
.nlp-card-body { padding: 18px 20px; }
.nlp-card-issue {
  font-family: var(--fu);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--grey-2);
  margin: 0 0 10px;
}
.nlp-card-title {
  font-family: var(--fd);
  font-size: 17px;
  font-weight: 800;
  color: var(--black);
  line-height: 1.1;
  margin: 0 0 8px;
}
.nlp-card-text {
  font-family: var(--fb);
  font-size: 12px;
  color: var(--grey-1);
  line-height: 1.65;
  margin: 0 0 12px;
}
.nlp-card-cta {
  display: inline-block;
  background: var(--accent);
  color: #fff;
  font-family: var(--fu);
  font-size: 11px;
  font-weight: 600;
  padding: 6px 12px;
  border-radius: 4px;
  transition: background .15s;
}
.nlp-card-cta:hover { background: var(--accent-dk); }
.nlp-card-hr {
  border: none;
  border-top: 1px solid var(--border);
  margin: 14px 0;
}
.nlp-card-hits-label {
  font-family: var(--fu);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--grey-2);
  margin: 0 0 8px;
}
.nlp-card-hits { list-style: none; padding: 0; margin: 0; }
.nlp-card-hit {
  font-family: var(--fu);
  font-size: 11px;
  color: var(--grey-1);
  padding: 5px 0;
  border-bottom: 1px solid var(--bg);
  line-height: 1.4;
}
.nlp-card-hit:last-child { border-bottom: none; }
.nlp-card-hit span { color: var(--accent); font-weight: 600; }

/* Responsive */
@media (max-width: 1024px) {
  .nlp-inner { grid-template-columns: 1fr; gap: 40px; }
  .nlp-card { max-width: 420px; }
}
@media (max-width: 768px) {
  .nlp-section { padding: 48px 0; }
  .nlp-inner { padding: 0 20px; gap: 32px; }
  .nlp-form { max-width: 100%; }
  .nlp-card { max-width: 100%; }
  .nlp-body { max-width: 100%; }
}
</style>
