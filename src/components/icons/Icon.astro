---
// The site's one line-icon set: 24×24, stroke currentColor at 1.75, round caps and joins, decorative
// (aria-hidden). The menu tiles and the /hardware category cards both draw from it, so they can't drift.
// To add one: a key here and its inner SVG. Keep it a simple drawing that reads at 24px.
const ICONS = {
  // Menu sections
  printers: '<rect x="3.5" y="3.5" width="17" height="17" rx="1.5"/><path d="M3.5 9h17"/><rect x="10" y="7" width="4" height="4" rx=".5"/><path d="M12 11v2.5M7 17h10"/>',
  hardware: '<path d="M8 3.5h8M8 6.5h8M8 9.5h8M12 9.5V12"/><rect x="7" y="12" width="10" height="4.5" rx="1"/><path d="M10 16.5l1 3.5h2l1-3.5"/>',
  filament: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="2.5"/><path d="M12 9.5v-6M9.8 13.3l-5.2 3M14.2 13.3l5.2 3"/>',
  guides: '<path d="M12 6.5C10 5 7 4.5 3.5 5v13c3.5-.5 6.5 0 8.5 1.5 2-1.5 5-2 8.5-1.5V5c-3.5-.5-6.5 0-8.5 1.5z"/><path d="M12 6.5v13"/>',
  tools: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 6.5h8v3.5H8z"/><path d="M8.5 14h.01M12 14h.01M15.5 14h.01M8.5 17.5h.01M12 17.5h.01M15.5 17.5h.01"/>',
  news: '<path d="M4 5h13v13a2 2 0 0 0 2 2H6a2 2 0 0 1-2-2z"/><path d="M17 9h3v9a2 2 0 0 1-2 2M7.5 9h6M7.5 12.5h6M7.5 16h3.5"/>',
  // Hardware categories
  hotend: '<path d="M10.5 3h3v6h-3z"/><rect x="5.5" y="9" width="13" height="7" rx="1"/><circle cx="9.5" cy="12.5" r="1.5"/><path d="M10 16l1 3.5h2l1-3.5"/>',
  extruder: '<circle cx="7.5" cy="12" r="3.5"/><circle cx="16.5" cy="12" r="3.5"/><path d="M12 3v18M7.5 12h.01M16.5 12h.01"/>',
  probe: '<rect x="9" y="3" width="6" height="10" rx="1.5"/><path d="M10.5 13v2.5h3V13M4 20.5h16"/>',
  nozzle: '<path d="M9.5 3h5v4h-5zM7 7h10v4H7z"/><path d="M8.5 11l2.5 7h2l2.5-7M12 18v2.5"/>',
  mainboard: '<rect x="3" y="5" width="18" height="14" rx="1.5"/><rect x="9" y="9" width="6" height="6" rx=".5"/><path d="M10.5 7v2M13.5 7v2M10.5 15v2M13.5 15v2M7 10.5h2M7 13.5h2M15 10.5h2M15 13.5h2"/>',
  toolboard: '<rect x="5" y="3" width="14" height="11" rx="1.5"/><rect x="10" y="6.5" width="4" height="4" rx=".5"/><path d="M12 14v3a3 3 0 0 0 3 3h5"/>',
  'part-cooling': '<path d="M12 4h8v8a8 8 0 1 1-8-8z"/><circle cx="12" cy="12" r="2.5"/><path d="M12 9.5V7M14.5 12H17M12 14.5V17M9.5 12H7"/>',
  'build-plate': '<path d="M7 7h14l-4 8H3z"/><path d="M3 15v2h14l4-8V7"/>',
  psu: '<rect x="3" y="6" width="18" height="12" rx="1.5"/><path d="M12.5 8.5l-3 4h4l-3 4"/>',
  motor: '<rect x="4" y="4" width="16" height="16" rx="2.5"/><circle cx="12" cy="12" r="3.5"/><path d="M12 12h.01M7.5 7.5h.01M16.5 7.5h.01M7.5 16.5h.01M16.5 16.5h.01"/>',
  heater: '<rect x="3" y="4.5" width="18" height="15" rx="1.5"/><path d="M6.5 8.5h11a1.75 1.75 0 0 1 0 3.5h-11a1.75 1.75 0 0 0 0 3.5h11"/>',
  'filament-dryer': '<rect x="3" y="8" width="18" height="13" rx="1.5"/><circle cx="12" cy="14.5" r="3.5"/><circle cx="12" cy="14.5" r="1"/><path d="M8 5.5c0-1 1-1 1-2M12 5.5c0-1 1-1 1-2M16 5.5c0-1 1-1 1-2"/>',
  'air-filtration': '<rect x="6" y="3" width="12" height="12" rx="1.5"/><path d="M6 7h12M6 11h12M10 3v12M14 3v12"/><path d="M4 19.5c1.5-1 2.5-1 4 0s2.5 1 4 0 2.5-1 4 0 2.5 1 4 0"/>',
  'lighting-camera': '<rect x="3" y="7" width="13" height="10" rx="1.5"/><path d="M16 11l5-3v8l-5-3"/><circle cx="9.5" cy="12" r="2"/>',
  gantry: '<path d="M5 3v18M19 3v18M5 10h14"/><rect x="10" y="8" width="4" height="4" rx=".5"/>',
  'motion-system': '<rect x="3" y="14" width="18" height="4" rx="1"/><rect x="8" y="9" width="8" height="5" rx="1"/><path d="M10.5 11.5h.01M13.5 11.5h.01M5.5 16h.01M18.5 16h.01"/>',
  enclosure: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/>',
} as const;
export type IconName = keyof typeof ICONS;
interface Props { name: IconName; class?: string; size?: number }
const { name, class: cls, size = 24 } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[name]} />
