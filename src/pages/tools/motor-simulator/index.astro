---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
const currentPath = '/tools';
---
<Base
  title="Stepper Motor Simulator — Torque vs Speed for Voron & Prosumer Printers"
  description="Physics-based stepper motor torque vs speed simulator for 3D printing. Compare 45 motors at 24V or 48V with real inductance and back-EMF calculations."
>
  <Nav slot="nav" currentPath={currentPath} />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js" slot="head"></script>

  <!-- HERO -->
  <div style="background:var(--black);padding:64px 0 40px;border-bottom:1px solid rgba(255,255,255,.1)">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
        <a href="/" style="font-size:11px;color:rgba(255,255,255,.3);font-family:'JetBrains Mono',monospace">Home</a>
        <span style="color:rgba(255,255,255,.2);font-size:11px">/</span>
        <a href="/tools" style="font-size:11px;color:rgba(255,255,255,.3);font-family:'JetBrains Mono',monospace">Tools</a>
        <span style="color:rgba(255,255,255,.2);font-size:11px">/</span>
        <span style="font-size:11px;color:rgba(255,255,255,.5);font-family:'JetBrains Mono',monospace">Motor Simulator</span>
      </div>
      <div class="eyebrow" style="margin-bottom:10px;color:var(--accent)">Physics Simulator</div>
      <h1 style="font-family:'Barlow Condensed',sans-serif;font-size:52px;font-weight:800;color:#fff;line-height:1;letter-spacing:-.5px;margin-bottom:12px">Motor Simulator</h1>
      <p style="font-family:'Lora',serif;font-size:15px;color:rgba(255,255,255,.45);line-height:1.7;max-width:600px">Real physics simulation — inductance, back-EMF, and coil impedance — to plot delivered torque across speeds. Compare up to 4 motors at 24V or 48V.</p>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:16px">
        <span style="font-family:'JetBrains Mono',monospace;font-size:10px;background:rgba(255,90,31,.15);color:var(--accent);border:1px solid rgba(255,90,31,.3);padding:3px 10px;border-radius:3px">45 motors</span>
        <span style="font-family:'JetBrains Mono',monospace;font-size:10px;background:rgba(255,255,255,.06);color:rgba(255,255,255,.5);border:1px solid rgba(255,255,255,.12);padding:3px 10px;border-radius:3px">24V · 48V</span>
        <span style="font-family:'JetBrains Mono',monospace;font-size:10px;background:rgba(255,255,255,.06);color:rgba(255,255,255,.5);border:1px solid rgba(255,255,255,.12);padding:3px 10px;border-radius:3px">LDO · Moons · OMC · Fysetc</span>
      </div>
    </div>
  </div>

  <!-- TOOL BODY -->
  <div class="ms-wrap">
    <div class="ms-inner">

      <!-- LEFT SIDEBAR -->
      <aside class="ms-sidebar">

        <div class="ms-section-label">Supply Voltage</div>
        <div class="ms-volt-toggle">
          <button type="button" class="ms-volt-btn active" id="btn24">24V</button>
          <button type="button" class="ms-volt-btn" id="btn48">48V</button>
        </div>

        <div class="ms-divider"></div>
        <div class="ms-section-label">Drive Settings</div>

        <div class="ms-field">
          <label class="ms-label" for="driveCurrent">Max Drive Current (A)</label>
          <input class="ms-input" type="number" id="driveCurrent" value="2.0" min="0.1" max="6.0" step="0.1">
        </div>
        <div class="ms-field">
          <label class="ms-label" for="pulleyTeeth">Pulley Size</label>
          <select class="ms-input" id="pulleyTeeth">
            <option value="16">16T (GT2)</option>
            <option value="20" selected>20T (GT2)</option>
            <option value="24">24T (GT2)</option>
          </select>
        </div>

        <div class="ms-divider"></div>
        <div class="ms-section-label">Load (Torque Required)</div>

        <div class="ms-field">
          <label class="ms-label" for="accelInput">Acceleration (mm/s²)</label>
          <input class="ms-input" type="number" id="accelInput" value="10000" min="100" max="100000" step="500">
        </div>
        <div class="ms-field">
          <label class="ms-label" for="massInput">Toolhead + Y Carriage Mass (g)</label>
          <input class="ms-input" type="number" id="massInput" value="500" min="50" max="5000" step="10">
        </div>

        <div class="ms-computed-box">
          <div class="ms-computed-label">Torque Required</div>
          <div class="ms-computed-val" id="torqueRequiredDisplay">— N·cm</div>
          <div class="ms-computed-note">Shown as red dashed line on chart</div>
        </div>

        <div class="ms-divider"></div>
        <div class="ms-section-label">Select Motors (up to 4)</div>
        <input class="ms-input" type="text" id="motorSearch" placeholder="Search brand or model…" autocomplete="off">
        <div class="ms-motor-list" id="motorList"></div>
        <div class="ms-max-msg" id="maxMsg">Max 4 motors selected</div>

      </aside>

      <!-- RIGHT MAIN -->
      <main class="ms-main">

        <!-- Chart -->
        <div class="ms-chart-card">
          <div class="ms-chart-header">
            <div class="ms-chart-title">Torque vs Speed</div>
            <div class="ms-chart-subtitle" id="chartSubtitle">24V · 20T pulley · 2.0A drive</div>
          </div>
          <div class="ms-canvas-wrap">
            <canvas id="torqueChart"></canvas>
          </div>
        </div>

        <!-- Max speed summary -->
        <div class="ms-table-card">
          <div class="ms-table-title">Performance Summary</div>
          <div style="overflow-x:auto">
            <table class="ms-table" id="summaryTable">
              <thead>
                <tr>
                  <th>Motor</th>
                  <th>Max usable speed</th>
                  <th>Torque @ 100 mm/s</th>
                  <th>Torque @ 300 mm/s</th>
                  <th>48V suitability</th>
                </tr>
              </thead>
              <tbody id="summaryBody">
                <tr><td colspan="5" class="ms-empty">Select motors to see summary.</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Spec comparison (collapsible) -->
        <details class="ms-specs-details">
          <summary class="ms-specs-summary">Motor specs ▾</summary>
          <div class="ms-table-card" style="margin-top:8px">
            <div style="overflow-x:auto">
              <table class="ms-table" id="specTable">
                <thead>
                  <tr>
                    <th>Motor</th>
                    <th>NEMA</th>
                    <th>Body</th>
                    <th>Step</th>
                    <th>Rated A</th>
                    <th>Hold N·cm</th>
                    <th>L (mH)</th>
                    <th>R (Ω)</th>
                  </tr>
                </thead>
                <tbody id="specBody">
                  <tr><td colspan="8" class="ms-empty">Select motors above.</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </details>

        <!-- Attribution -->
        <div class="ms-attribution">
          Physics model based on work by <strong>daveidmx</strong> and the
          <a href="https://github.com/MSzturc/the100" target="_blank" rel="noopener">MSzturc/the100 project</a>.
          Motor database from
          <a href="https://github.com/eddietheengineer/documentation" target="_blank" rel="noopener">eddietheengineer/documentation</a>.
        </div>

      </main>
    </div>
  </div>

  <Footer slot="footer" />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "SoftwareApplication",
        "name": "Stepper Motor Simulator",
        "description": "Physics-based stepper motor torque vs speed simulator for 3D printing with 45-motor database.",
        "url": "https://modernmakes.github.io/tools/motor-simulator",
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "Web",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://modernmakes.github.io" },
          { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://modernmakes.github.io/tools" },
          { "@type": "ListItem", "position": 3, "name": "Motor Simulator", "item": "https://modernmakes.github.io/tools/motor-simulator" }
        ]
      }
    ]
  })}></script>
</Base>

<style is:global>
.ms-wrap { background: var(--bg); padding: 40px 0 64px; }
.ms-inner {
  max-width: 1200px; margin: 0 auto; padding: 0 40px;
  display: grid; grid-template-columns: 300px 1fr; gap: 28px; align-items: start;
}

/* Sidebar */
.ms-sidebar {
  background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
  padding: 20px; position: sticky; top: 88px;
  max-height: calc(100vh - 108px); overflow-y: auto;
}
.ms-sidebar::-webkit-scrollbar { width: 4px; }
.ms-sidebar::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }
.ms-section-label {
  font-family: var(--fu); font-size: 10px; font-weight: 700; text-transform: uppercase;
  letter-spacing: .1em; color: var(--g2); margin-bottom: 10px;
}
.ms-divider { border: none; border-top: 1px solid var(--border); margin: 16px 0; }
.ms-field { display: flex; flex-direction: column; gap: 5px; margin-bottom: 12px; }
.ms-label { font-family: var(--fm); font-size: 10px; color: var(--g2); text-transform: uppercase; letter-spacing: .07em; }
.ms-input {
  font-family: var(--fm); font-size: 13px; color: var(--black); background: var(--bg);
  border: 1px solid var(--border); border-radius: 5px; padding: 7px 10px; width: 100%;
  transition: border-color .12s; appearance: none;
}
.ms-input:focus { outline: none; border-color: var(--accent); }

.ms-volt-toggle { display: flex; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; margin-bottom: 0; }
.ms-volt-btn {
  font-family: var(--fu); font-size: 14px; font-weight: 700; padding: 8px 0; flex: 1;
  background: var(--bg); color: var(--g2); border: none; cursor: pointer; transition: all .12s;
}
.ms-volt-btn.active { background: var(--black); color: #fff; }
.ms-volt-btn:not(.active):hover { background: var(--border); }

.ms-computed-box {
  background: rgba(255,90,31,.06); border: 1px solid rgba(255,90,31,.2);
  border-radius: 6px; padding: 12px 14px; margin-bottom: 2px;
}
.ms-computed-label { font-family: var(--fm); font-size: 10px; color: var(--accent); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 4px; }
.ms-computed-val { font-family: var(--fd); font-size: 24px; font-weight: 800; color: var(--black); line-height: 1.1; }
.ms-computed-note { font-family: var(--fm); font-size: 10px; color: var(--g2); margin-top: 4px; }

.ms-motor-list {
  display: flex; flex-direction: column; gap: 3px; margin-top: 8px;
  max-height: 280px; overflow-y: auto;
}
.ms-motor-list::-webkit-scrollbar { width: 4px; }
.ms-motor-list::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }
.ms-motor-item {
  font-family: var(--fu); font-size: 11px; color: var(--black); text-align: left;
  background: var(--bg); border: 1px solid transparent; border-radius: 4px;
  padding: 6px 10px; cursor: pointer; transition: all .1s; line-height: 1.3; width: 100%;
  appearance: none;
}
.ms-motor-item:hover { border-color: var(--border); background: var(--surface); }
.ms-motor-item.selected { border-color: var(--accent); background: rgba(255,90,31,.07); color: var(--accent); }
.ms-motor-item-brand { font-size: 9px; color: var(--g2); display: block; }
.ms-motor-item.selected .ms-motor-item-brand { color: rgba(255,90,31,.6); }

.ms-max-msg {
  font-family: var(--fm); font-size: 11px; color: var(--accent);
  margin-top: 8px; opacity: 0; transition: opacity .2s; min-height: 16px;
}
.ms-max-msg.visible { opacity: 1; }

/* Main area */
.ms-main { display: flex; flex-direction: column; gap: 16px; }

.ms-chart-card {
  background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
  padding: 24px;
}
.ms-chart-header { display: flex; align-items: baseline; gap: 14px; margin-bottom: 16px; flex-wrap: wrap; }
.ms-chart-title { font-family: var(--fd); font-size: 20px; font-weight: 800; color: var(--black); }
.ms-chart-subtitle { font-family: var(--fm); font-size: 11px; color: var(--g2); }
.ms-canvas-wrap { position: relative; height: 400px; background: #0d0d0d; border-radius: 6px; padding: 12px; }

.ms-table-card {
  background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 20px 24px;
}
.ms-table-title { font-family: var(--fd); font-size: 18px; font-weight: 800; color: var(--black); margin-bottom: 14px; }
.ms-table { width: 100%; border-collapse: collapse; }
.ms-table th {
  font-family: var(--fu); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em;
  color: var(--g2); padding: 8px 12px; text-align: left; border-bottom: 2px solid var(--border); white-space: nowrap;
}
.ms-table td { font-family: var(--fb); font-size: 13px; color: var(--g1); padding: 9px 12px; border-bottom: 1px solid var(--border); }
.ms-table tbody tr:last-child td { border-bottom: none; }
.ms-table td:first-child { font-family: var(--fm); font-size: 12px; color: var(--black); }
.ms-empty { font-family: var(--fm); font-size: 12px; color: var(--g2); padding: 16px 12px !important; }
.ms-motor-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; flex-shrink: 0; }
.ms-speed-val { font-family: var(--fd); font-size: 16px; font-weight: 800; }
.ms-speed-val.capped { color: var(--g2); }
.ms-48v-ok   { font-family: var(--fm); font-size: 11px; padding: 2px 7px; border-radius: 3px; background: rgba(74,222,128,.12); color: #22c55e; }
.ms-48v-good { font-family: var(--fm); font-size: 11px; padding: 2px 7px; border-radius: 3px; background: rgba(255,90,31,.12); color: var(--accent); }
.ms-48v-not  { font-family: var(--fm); font-size: 11px; padding: 2px 7px; border-radius: 3px; background: rgba(156,163,175,.12); color: #9ca3af; }

.ms-specs-details { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 4px 0; }
.ms-specs-summary {
  font-family: var(--fu); font-size: 12px; font-weight: 700; color: var(--g2); text-transform: uppercase; letter-spacing: .07em;
  padding: 14px 24px; cursor: pointer; list-style: none; user-select: none;
}
.ms-specs-summary::-webkit-details-marker { display: none; }
.ms-specs-summary:hover { color: var(--black); }
.ms-specs-details[open] .ms-specs-summary { border-bottom: 1px solid var(--border); }

.ms-attribution {
  font-family: var(--fu); font-size: 11px; color: var(--g2); line-height: 1.6;
  background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 12px 16px;
}
.ms-attribution a { color: var(--accent); text-decoration: none; }
.ms-attribution a:hover { text-decoration: underline; }

@media (max-width: 960px)  { .ms-inner { grid-template-columns: 1fr; } .ms-sidebar { position: static; max-height: none; } }
@media (max-width: 768px)  { .ms-wrap { padding: 20px 0 48px; } .ms-inner { padding: 0 20px; } .ms-canvas-wrap { height: 280px; } }
</style>

