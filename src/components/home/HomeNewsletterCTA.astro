---
// HomeNewsletterCTA — compact editorial callout strip between Latest and Ecosystems
import BeehiivEmbed from '../BeehiivEmbed.astro';
---
<section class="nlcta-section" aria-label="Newsletter signup">
  <div class="nlcta-container">
    <div class="nlcta-inner">
      <div class="nlcta-text">
        <p class="nlcta-eyebrow">Free Weekly Newsletter</p>
        <p class="nlcta-headline">The 3D printing briefing</p>
        <p class="nlcta-sub">What's worth buying, building, and following — every Tuesday.</p>
      </div>
      <div class="nlcta-form-wrap">
        <div class="nlcta-beehiiv-wrap">
          <BeehiivEmbed />
        </div>
        <p class="nlcta-note">Free, always. No spam. Unsubscribe any time.</p>
      </div>
    </div>
  </div>
</section>
<script is:inline type="text/javascript" async src="https://subscribe-forms.beehiiv.com/attribution.js"></script>

<style is:global>
  .nlcta-section {
    background: var(--bg);
    padding: 24px 40px;
  }
  .nlcta-container {
    max-width: 1200px;
    margin: 0 auto;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 400ms cubic-bezier(0.4,0,0.2,1),
                transform 400ms cubic-bezier(0.4,0,0.2,1);
  }
  .nlcta-container.nlcta-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .nlcta-inner {
    display: flex;
    align-items: center;
    gap: 40px;
    border-left: 4px solid var(--accent);
    padding: 20px 28px;
    background: var(--surface);
    border-radius: 0 8px 8px 0;
    border-top: 1px solid var(--border);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    box-sizing: border-box;
    width: 100%;
  }
  .nlcta-text {
    flex: 1;
    min-width: 0;
  }
  .nlcta-eyebrow {
    font-family: var(--fm);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 4px;
  }
  .nlcta-headline {
    font-family: var(--fd);
    font-size: clamp(20px, 2vw + 10px, 28px);
    font-weight: 800;
    color: var(--black);
    line-height: 1.05;
    margin: 0 0 4px;
  }
  .nlcta-sub {
    font-family: var(--fb);
    font-style: italic;
    font-size: 13px;
    color: var(--grey-1);
    line-height: 1.5;
    margin: 0;
  }
  .nlcta-form-wrap {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 320px;
    flex-shrink: 0;
  }
  .nlcta-form {
    display: flex;
    gap: 8px;
    width: 100%;
  }
  .nlcta-field {
    flex: 1;
    height: 40px;
    padding: 0 14px;
    font-size: 13px;
    font-family: var(--fu);
    background: var(--surface);
    color: var(--black);
    border: 1px solid var(--border);
    border-radius: 5px;
    outline-color: transparent;
    transition: border-color 150ms;
    min-width: 0;
    box-sizing: border-box;
  }
  .nlcta-field::placeholder { color: var(--grey-2); }
  .nlcta-field:focus { border-color: var(--accent); }
  .nlcta-btn {
    height: 40px;
    padding: 0 18px;
    background: var(--accent);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    font-family: var(--fu);
    border: none;
    border-radius: 5px;
    cursor: pointer;
    white-space: nowrap;
    transition: background 150ms;
    flex-shrink: 0;
  }
  .nlcta-btn:hover { background: var(--accent-dk); }
  .nlcta-note {
    font-size: 11px;
    color: var(--grey-2);
    font-family: var(--fu);
    margin: 0;
  }

  @media (max-width: 900px) {
    .nlcta-section { padding: 20px 24px; }
    .nlcta-inner { gap: 24px; }
    .nlcta-form-wrap { width: 280px; }
  }
  @media (max-width: 768px) {
    .nlcta-section { padding: 20px; }
    .nlcta-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding: 20px;
    }
    .nlcta-form-wrap { width: 100%; }
    .nlcta-form { flex-direction: column; }
    .nlcta-field,
    .nlcta-btn {
      width: 100%;
      box-sizing: border-box;
    }
    .nlcta-btn { height: 44px; }
  }
</style>

<script>
  const container = document.querySelector('.nlcta-container');
  if (container) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          container.classList.add('nlcta-visible');
          observer.disconnect();
        }
      },
      { threshold: 0.1 }
    );
    observer.observe(container);
  }
</script>
