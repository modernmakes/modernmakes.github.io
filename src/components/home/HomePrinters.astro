---
// HomePrinters — 3-column card grid for printer coverage
---

<section class="section" aria-label="Printer coverage">
  <div class="container">
    <div class="section-head">
      <h2 class="section-head-label">Printers</h2>
      <a href="/printers" class="section-head-link">All coverage</a>
    </div>
    <div class="grid-3">
      {[
        { cat:'Overview', title:'Bambu Lab A1 Mini Combo: The Best Beginner Multi-Color Printer Right Now', excerpt:'Auto-calibration, AMS Lite, and print speeds that were flagship-only a year ago — for under $400.', price:'From $349', verdict:'best', verdictLabel:'✓ Best', bg:'linear-gradient(135deg,#1a2535,#0d1824)' },
        { cat:'Comparison', title:'Prusa MK4S vs Bambu P1S: Two Philosophies, One Choice', excerpt:'Very different machines serving the same need. The answer depends entirely on what you value.', date:'May 15, 2026', verdict:'rec', verdictLabel:'✓ Rec', bg:'linear-gradient(135deg,#1f2010,#131708)' },
        { cat:'Buying guide', title:'Best 3D Printers Under $500 in 2026: The Ones That Actually Earn a Spot', excerpt:'Updated monthly. We cover every machine on this list. No filler, no compromises.', date:'Updated May 2026', verdict:'upd', verdictLabel:'↑ Updated', bg:'linear-gradient(135deg,#1a1520,#0d0d18)' }
      ].map(card => (
        <article class="card">
          <div class="card-img" style={`background:${card.bg};display:flex;align-items:center;justify-content:center`}>
            <span style="font-family:'Barlow Condensed',sans-serif;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.3)">{card.cat}</span>
          </div>
          <div class="card-body">
            <div class="card-cat">{card.cat}</div>
            <div class="card-title">{card.title}</div>
            <div class="card-excerpt">{card.excerpt}</div>
            <div class="card-footer">
              {card.date && <span class="card-date">{card.date}</span>}
              {card.price && <span class="card-price">{card.price}</span>}
              {card.verdict && <span class={`verdict verdict-${card.verdict}`}>{card.verdictLabel}</span>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
