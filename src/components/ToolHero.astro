---
// Dark hero for /tools and every tool page: breadcrumb, H1, intro, optional unit chip.
interface Props {
  title: string;     // visible H1
  intro: string;
  unit?: string;     // chip under the intro, e.g. 'mm³/s'
  crumb?: string;    // last breadcrumb item; defaults to title
  eyebrow?: string;  // only the /tools hub sets this; it also drops the "Tools" crumb link
}
const { title, intro, unit, crumb = title, eyebrow } = Astro.props;
---
<div class="tool-hero">
  <div class="tool-hero-inner">
    <div class="tool-hero-crumbs">
      <a href="/">Home</a>
      <span class="tool-hero-sep">/</span>
      {!eyebrow && <><a href="/tools">Tools</a><span class="tool-hero-sep">/</span></>}
      <span>{crumb}</span>
    </div>
    {eyebrow && <div class="eyebrow tool-hero-eyebrow">{eyebrow}</div>}
    <h1 class="tool-hero-title">{title}</h1>
    <p class:list={['tool-hero-intro', { 'tool-hero-intro--hub': eyebrow }]}>{intro}</p>
    {unit && (
      <div class="tool-hero-chips">
        <span class="tool-hero-chip">{unit}</span>
      </div>
    )}
  </div>
</div>

<style>
  .tool-hero { background: var(--black); padding: 64px 0 40px; border-bottom: 1px solid rgba(255,255,255,.1); }
  .tool-hero-inner { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
  .tool-hero-crumbs { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .tool-hero-crumbs a, .tool-hero-crumbs span { font-size: 12px; color: var(--on-dark-muted); font-family: var(--fu); }
  .tool-hero-crumbs .tool-hero-sep { font-size: 11px; font-family: inherit; }
  .tool-hero-eyebrow { margin-bottom: 10px; color: var(--accent); }
  .tool-hero-title { font-family: var(--fd); font-size: 52px; font-weight: 800; color: var(--surface); line-height: 1; letter-spacing: -.5px; margin-bottom: 12px; }
  .tool-hero-intro { font-family: var(--fb); font-size: 15px; color: var(--on-dark-muted); line-height: 1.7; max-width: 600px; }
  .tool-hero-intro--hub { max-width: 520px; }
  .tool-hero-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 16px; }
  .tool-hero-chip { font-family: var(--fm); font-size: 10px; background: rgba(255,90,31,.15); color: var(--accent); border: 1px solid rgba(255,90,31,.3); padding: 3px 10px; border-radius: 3px; }
</style>
