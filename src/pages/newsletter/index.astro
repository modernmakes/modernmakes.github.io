---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
const label = 'newsletter'.charAt(0).toUpperCase() + 'newsletter'.slice(1);
---
<Base title={label}>
  <Nav slot="nav" currentPath={'/newsletter'} />
  <section style="padding:80px 40px;max-width:1200px;margin:0 auto;text-align:center">
    <div class="eyebrow" style="margin-bottom:12px">Coming soon</div>
    <h1 style="font-family:'Barlow Condensed',sans-serif;font-size:48px;font-weight:800;color:var(--black)">{label}</h1>
    <p style="font-family:'Lora',serif;font-size:15px;color:var(--g1);margin:12px auto 24px;max-width:440px">This section is being built.</p>
    <a href="/" style="font-size:13px;font-weight:600;color:var(--accent)">← Back to homepage</a>
    <p style="margin-top:24px"><a href="/newsletter/archive" style="font-family:'Barlow',sans-serif;font-size:13px;color:var(--g1)">Browse past issues →</a></p>
  </section>
  <Footer slot="footer" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "name": "The Modern Makes Weekly Briefing — Subscribe Free",
        "description": "The Modern Makes newsletter — 3D printing launches, deals, and community finds every Tuesday. Free, no spam.",
        "url": "https://modernmakes.com/newsletter",
        "isPartOf": { "@type": "WebSite", "url": "https://modernmakes.com" }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://modernmakes.com" },
          { "@type": "ListItem", "position": 2, "name": "Newsletter", "item": "https://modernmakes.com/newsletter" }
        ]
      }
    ]
  })}></script>
</Base>
