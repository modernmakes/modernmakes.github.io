---
// Designed stand-in for a missing image: category eyebrow, headline set large,
// optional mono date. Decorative (the card or page already carries the text),
// so it is hidden from assistive tech. Styles: .type-cover in global.css.
interface Props {
  title: string;
  eyebrow?: string;
  date?: string;
  size?: 'card' | 'hero';
}
const { title, eyebrow, date, size = 'card' } = Astro.props;
---
<div class:list={['type-cover', { 'type-cover--hero': size === 'hero' }]} aria-hidden="true">
  {eyebrow && <span class="type-cover-eyebrow">{eyebrow}</span>}
  <span class="type-cover-title">{title}</span>
  {date && <span class="type-cover-date">{date}</span>}
</div>
