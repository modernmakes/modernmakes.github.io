---
// HomeNewsletterCTA — the newsletter as its own full-width dark band: headline and one line, the form
// beside them from 768px and stacked under them on phones. The form's markup is the subscribe.ts
// contract (ids, data-subscribe, data-campaign, field names, the message element next to the form):
// change the wrapper, never the form. Subscribe is the band's one orange element.
---
<section class="nlcta-section" aria-labelledby="nlcta-heading">
  <div class="nlcta-container">
    <div class="nlcta-text">
      <h2 class="nlcta-headline" id="nlcta-heading">The 3D printing briefing</h2>
      <p class="nlcta-sub">What's worth buying, building, and following.</p>
    </div>
    <div class="nlcta-form-wrap">
        <form class="beehiiv-fallback-form" id="nlcta-form" data-subscribe data-campaign="homepage_cta">
          <input type="email" name="email" id="nlcta-email"
            placeholder="your@email.com" aria-label="Email address" aria-describedby="nlcta-msg" required />
          <button type="submit" id="nlcta-btn" class="sub-btn"><span class="sub-label">Subscribe →</span><span class="sub-spin" aria-hidden="true"></span></button>
        </form>
        <p class="nlcta-note" id="nlcta-msg" role="status" data-subscribe-msg></p>
    </div>
  </div>
</section>

<style is:global>
  /* Hallmark · component: newsletter band · genre: editorial · theme: DESIGN.md (dark plane)
   * states: idle · hover (fine pointers) · focus-visible · active · working (spinner) · error · success
   * (shared with BeehiivEmbed through subscribe.ts and global.css .sub-*). Ink on orange in every state.
   * Every form rule is scoped to .nlcta-section: BeehiivEmbed uses the same form class. */
  .nlcta-section {
    background: var(--dark-bg);
    padding: var(--section-y) 40px;
  }
  .nlcta-container {
    max-width: var(--max-w);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
    align-items: center;
    gap: 24px 48px;
  }
  .nlcta-text { min-width: 0; }
  .nlcta-headline {
    margin: 0;
    font: 800 clamp(2rem, 5vw, 2.5rem)/1 var(--fd);
    letter-spacing: -0.5px;
    color: var(--on-dark);
    text-wrap: balance;
  }
  .nlcta-sub {
    margin: 10px 0 0;
    font: 400 15px/1.6 var(--fb);
    color: var(--on-dark-muted);
  }
  .nlcta-form-wrap { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .nlcta-section .beehiiv-fallback-form { display: flex; gap: 8px; width: 100%; }
  .nlcta-section .beehiiv-fallback-form input[type="email"] {
    flex: 1;
    min-width: 0;
    height: 44px;
    padding: 0 14px;
    font: 400 15px var(--fu);
    color: var(--on-dark);
    background: color-mix(in srgb, var(--on-dark) 8%, transparent);
    /* 40% white: the field's edge clears 3:1 against the band (WCAG 1.4.11). */
    border: 1px solid color-mix(in srgb, var(--on-dark) 40%, transparent);
    border-radius: var(--radius-sm);
    box-sizing: border-box;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .nlcta-section .beehiiv-fallback-form input[type="email"]::placeholder { color: var(--on-dark-muted); }
  .nlcta-section .beehiiv-fallback-form input[type="email"]:focus { border-color: var(--accent); }
  .nlcta-section .beehiiv-fallback-form input[type="email"][aria-invalid="true"],
  .nlcta-section .beehiiv-fallback-form input[type="email"][aria-invalid="true"]:focus { border-color: var(--sub-error-on-dark); }
  .nlcta-section .beehiiv-fallback-form button[type="submit"] {
    flex: none;
    height: 44px;
    padding: 0 20px;
    background: var(--accent);
    color: var(--on-accent);
    font: 700 14px var(--fu);
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color var(--dur-fast) var(--ease-out), var(--press-release);
  }
  .nlcta-section .beehiiv-fallback-form button[type="submit"]:active { background: var(--accent-mid); }
  @media (hover: hover) and (pointer: fine) {
    .nlcta-section .beehiiv-fallback-form button[type="submit"]:hover { background: var(--accent-mid); }
  }
  .nlcta-note { margin: 0; font: 400 13px/1.5 var(--fu); color: var(--on-dark-muted); }
  .nlcta-note:empty { display: none; }
  .nlcta-note[data-state="error"] { color: var(--sub-error-on-dark); }
  .nlcta-note[data-state="success"] { color: var(--on-dark); font-size: 15px; }

  @media (max-width: 767px) {
    .nlcta-section { padding-inline: 20px; }
    .nlcta-container { grid-template-columns: minmax(0, 1fr); }
    .nlcta-section .beehiiv-fallback-form { flex-direction: column; }
    .nlcta-section .beehiiv-fallback-form input[type="email"] { flex: none; }
    .nlcta-section .beehiiv-fallback-form button[type="submit"] { width: 100%; }
  }
</style>

<script>import '../../scripts/subscribe';</script>
