---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface VendorLink {
  name: string;
  url: string;
  price: string;
  region: 'us' | 'ca' | 'eu' | 'global';
  primary?: boolean;
}
interface SpecItem {
  label: string;
  value: string;
  note?: string;
}
interface CompatItem {
  name: string;
  status: 'compatible' | 'incompatible' | 'untested';
}
interface RelatedComp {
  title: string;
  category: string;
  href: string;
  price?: string;
  gradient?: string;
}
interface QuickSpec {
  label: string;
  value: string;
}
interface ToolheadLink {
  name: string;
  href: string;
}

interface Props {
  title: string;
  category: string;
  componentType: string;
  brand: string;
  price: { usd: number; cad?: number };
  verdict: string;
  verdictLabel: 'BUY' | 'CONSIDER' | 'SKIP' | 'UPDATED';
  heroImage?: string;
  maxTemp?: number;
  maxFlow?: number;
  compatibility?: CompatItem[];
  tags?: string[];
  vendors?: VendorLink[];
  specs?: SpecItem[];
  pros?: string[];
  cons?: string[];
  relatedComponents?: RelatedComp[];
  excerpt?: string;
  quickSpecs?: QuickSpec[];
  compatibleToolheads?: ToolheadLink[];
  pageTitle?: string;
  primaryVendorUrl?: string;
  heroImageUrl?: string;
}

const {
  title,
  category,
  brand,
  price,
  verdict,
  verdictLabel,
  heroImage,
  maxTemp,
  maxFlow,
  compatibility = [],
  tags = [],
  vendors = [],
  specs = [],
  pros = [],
  cons = [],
  relatedComponents = [],
  excerpt = '',
  quickSpecs = [],
  compatibleToolheads = [],
  pageTitle,
  primaryVendorUrl = '',
  heroImageUrl = '',
} = Astro.props;

const hasSidebar = quickSpecs.length > 0 || compatibleToolheads.length > 0;

const verdictColors: Record<string, { bg: string; text: string; border: string }> = {
  BUY:      { bg: 'rgba(34,197,94,.12)',  text: '#16a34a', border: 'rgba(34,197,94,.3)' },
  CONSIDER: { bg: 'rgba(59,130,246,.12)', text: '#1565c0', border: 'rgba(59,130,246,.3)' },
  SKIP:     { bg: 'rgba(140,140,140,.14)', text: '#5a5a5a', border: 'var(--border-s)' },
  UPDATED:  { bg: 'rgba(255,90,31,.12)',  text: '#c93b08', border: 'rgba(255,90,31,.3)' },
};
const vc = verdictColors[verdictLabel] ?? verdictColors.CONSIDER;

const regionLabels: Record<string, string> = {
  us: 'US',
  ca: 'CA',
  eu: 'EU',
  global: 'Global',
};

// Flow-rate scale. Ceiling matches the real top of the hotend catalogue
// (water-cooled blocks reach ~100 mm³/s) so a 75 and a 100 don't pin to the
// same spot — the marker position stays honest across the whole range.
const FLOW_MAX = 100;
const flowBenchmarks = [
  { label: 'Standard',  value: 15 },
  { label: 'High-Flow', value: 30 },
  { label: 'Volcano',   value: 45 },
  { label: 'Ultra',     value: 70 },
];
const flowPct = maxFlow ? Math.min((maxFlow / FLOW_MAX) * 100, 100) : 0;
// Anchor the readout so it never spills past either end of the track.
const flowAnchor = flowPct >= 88 ? 'end' : flowPct <= 12 ? 'start' : 'mid';

const siteBase = Astro.site
  ? new URL(Astro.site).href.replace(/\/$/, '')
  : 'https://modernmakes.github.io';
const canonicalUrl = siteBase + Astro.url.pathname;
const pathSegments = Astro.url.pathname.replace(/^\/|\/$/g, '').split('/').filter(Boolean);
const segLabels: Record<string, string> = {
  hardware: 'Hardware', hotends: 'Hotends', extruders: 'Extruders', probes: 'Bed Probes', motion: 'Motion Mods',
};
const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteBase}/` },
  ...pathSegments.map((seg: string, i: number) => ({
    '@type': 'ListItem',
    position: i + 2,
    name: i === pathSegments.length - 1
      ? title
      : (segLabels[seg] ?? seg.charAt(0).toUpperCase() + seg.slice(1)),
    item: `${siteBase}/${pathSegments.slice(0, i + 1).join('/')}`,
  })),
];
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: title,
  brand: { '@type': 'Brand', name: brand },
  description: excerpt || verdict,
  url: canonicalUrl,
  image: heroImageUrl
    ? `${siteBase}${heroImageUrl}`
    : `${siteBase}/images/og-default.jpg`,
  offers: {
    '@type': 'Offer',
    price: price.usd,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    ...(primaryVendorUrl ? { url: primaryVendorUrl } : {}),
  },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
};
---
<Base
  title={pageTitle ?? `${title} — ${brand} ${category} Specs & Verdict`}
  description={excerpt || verdict}
  heroPage={true}
  hasHero={true}
  hasPageH1={true}
>
  <Nav slot="nav" currentPath="/hardware" />

  <!-- ── COMPONENT HERO ── -->
  <section class="comp-hero">
    <div class="comp-hero-inner">
      <div class="comp-hero-image">
        {heroImage
          ? <img src={heroImage} alt={title} loading="eager" fetchpriority="high" class="comp-hero-img" />
          : <div class="comp-hero-placeholder">
              <span class="comp-hero-placeholder-cat">{category}</span>
            </div>
        }
      </div>
      <div class="comp-hero-info">
        <nav class="comp-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>›</span>
          <a href="/hardware">Hardware</a>
          <span>›</span>
          <a href={`/hardware/${pathSegments[1]}`}>{segLabels[pathSegments[1]] ?? (pathSegments[1].charAt(0).toUpperCase() + pathSegments[1].slice(1))}</a>
          <span>›</span>
          <span>{title}</span>
        </nav>
        <div class="comp-brand">{brand}</div>
        <h1 class="comp-title">{title}</h1>
        <div class="comp-verdict-row">
          <a href="#where-to-buy" class="comp-verdict-badge" style={`background:${vc.bg};color:${vc.text};border-color:${vc.border}`}>
            {verdictLabel}
          </a>
          <span class="comp-verdict-text">{verdict}</span>
        </div>
        <div class="comp-key-stats">
          <div class="comp-stat">
            <span class="comp-stat-label">USD</span>
            <span class="comp-stat-val">${price.usd}</span>
          </div>
          {price.cad && (
            <div class="comp-stat">
              <span class="comp-stat-label">CAD</span>
              <span class="comp-stat-val">${price.cad}</span>
            </div>
          )}
          {maxTemp && (
            <div class="comp-stat">
              <span class="comp-stat-label">Max Temp</span>
              <span class="comp-stat-val">{maxTemp}°C</span>
            </div>
          )}
          {maxFlow && (
            <div class="comp-stat">
              <span class="comp-stat-label">Max Flow</span>
              <span class="comp-stat-val">{maxFlow} mm³/s</span>
            </div>
          )}
        </div>
        {tags.length > 0 && (
          <div class="comp-tags">
            {tags.map(tag => <span class="comp-tag">{tag}</span>)}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ── MAIN CONTENT ── -->
  <div class="comp-body">
    <div class:list={['comp-body-inner', { 'has-sidebar': hasSidebar }]}>

      <div class="comp-main">

        <!-- FLOW RATE BOX -->
        {maxFlow && (
          <section class="comp-section comp-flow-section" aria-labelledby="flow-heading">
            <h2 class="comp-section-title" id="flow-heading">Flow Rate Reference</h2>
            <div class="comp-flow-box">
              <p class="sr-only">
                Rated max flow {maxFlow} mm³/s on a 0 to {FLOW_MAX} mm³/s scale.
                Reference tiers: {flowBenchmarks.map(b => `${b.label} ${b.value}`).join(', ')} mm³/s.
              </p>
              <div class="comp-flow-graph" aria-hidden="true">
                <!-- reference tiers sit ABOVE the track so the fill never hides them -->
                <div class="comp-flow-marks">
                  {flowBenchmarks.map(b => (
                    <div class="comp-flow-mark" style={`left:${(b.value / FLOW_MAX) * 100}%`}>
                      <span class="comp-flow-mark-name">{b.label}</span>
                      <span class="comp-flow-mark-num">{b.value}</span>
                    </div>
                  ))}
                </div>
                <div class="comp-flow-track">
                  {flowBenchmarks.map(b => (
                    <span class="comp-flow-gridline" style={`left:${(b.value / FLOW_MAX) * 100}%`}></span>
                  ))}
                  <div class="comp-flow-fill" style={`width:${flowPct}%`}></div>
                  <div class="comp-flow-dot" style={`left:${flowPct}%`}></div>
                </div>
                <!-- this product's value sits BELOW the track, anchored away from the edges -->
                <div class="comp-flow-readout-row">
                  <div class={`comp-flow-readout comp-flow-readout-${flowAnchor}`} style={`left:${flowPct}%`}>
                    <span class="comp-flow-readout-num">{maxFlow}</span>
                    <span class="comp-flow-readout-unit">mm³/s</span>
                  </div>
                </div>
                <div class="comp-flow-axis">
                  <span>0</span>
                  <span>{FLOW_MAX} mm³/s</span>
                </div>
              </div>
              <p class="comp-flow-note">
                Max flow tested at 250°C with standard PLA/PETG. Actual performance varies by filament, nozzle diameter, and temperature.
              </p>
            </div>
          </section>
        )}

        <!-- SPECS TABLE -->
        {specs.length > 0 && (
          <section class="comp-section" aria-labelledby="specs-heading">
            <h2 class="comp-section-title" id="specs-heading">Full Specifications</h2>
            <div class="comp-specs-wrap">
              <table class="comp-specs-table">
                <tbody>
                  {specs.map(s => (
                    <tr class="comp-specs-row">
                      <td class="comp-specs-label">{s.label}</td>
                      <td class="comp-specs-val">
                        {s.value}
                        {s.note && <span class="comp-specs-note">{s.note}</span>}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        <!-- COMPATIBILITY MATRIX -->
        {compatibility.length > 0 && (
          <section class="comp-section" aria-labelledby="compat-heading">
            <h2 class="comp-section-title" id="compat-heading">Compatibility</h2>
            <div class="comp-compat-grid">
              {compatibility.map(c => (
                <span class={`comp-compat-chip comp-compat-${c.status}`} title={c.status}>
                  {c.name}
                  <span class="comp-compat-dot" aria-hidden="true"></span>
                </span>
              ))}
            </div>
            <div class="comp-compat-legend">
              <span class="comp-compat-chip comp-compat-compatible comp-compat-legend-item">Compatible</span>
              <span class="comp-compat-chip comp-compat-untested comp-compat-legend-item">Untested</span>
              <span class="comp-compat-chip comp-compat-incompatible comp-compat-legend-item">Incompatible</span>
            </div>
          </section>
        )}

        <!-- PROS & CONS -->
        {(pros.length > 0 || cons.length > 0) && (
          <section class="comp-section" aria-labelledby="proscons-heading">
            <h2 class="comp-section-title" id="proscons-heading">Pros &amp; Cons</h2>
            <div class="comp-proscons-grid">
              {pros.length > 0 && (
                <div class="comp-pros">
                  <div class="comp-pros-head">Pros</div>
                  <ul class="comp-pros-list">
                    {pros.map(p => <li><span class="comp-pros-icon" aria-hidden="true">✓</span>{p}</li>)}
                  </ul>
                </div>
              )}
              {cons.length > 0 && (
                <div class="comp-cons">
                  <div class="comp-cons-head">Cons</div>
                  <ul class="comp-cons-list">
                    {cons.map(c => <li><span class="comp-cons-icon" aria-hidden="true">✗</span>{c}</li>)}
                  </ul>
                </div>
              )}
            </div>
          </section>
        )}

        <!-- PROSE CONTENT (editorial notes) -->
        <div class="comp-prose art-content">
          <slot />
        </div>

        <!-- BUY SECTION -->
        {vendors.length > 0 && (
          <section class="comp-section" id="where-to-buy" aria-labelledby="buy-heading" style="margin-top:48px">
            <h2 class="comp-section-title" id="buy-heading">Where to Buy</h2>
            <div class="comp-vendors-grid">
              {vendors.map(v => (
                <a
                  href={v.url}
                  class={`comp-vendor-card${v.primary ? ' comp-vendor-primary' : ''}`}
                  target="_blank"
                  rel="noopener sponsored"
                  aria-label={`Buy from ${v.name}`}
                >
                  {v.primary && <span class="comp-vendor-primary-badge">Best Option</span>}
                  <span class="comp-vendor-region">{regionLabels[v.region] ?? 'Global'}</span>
                  <div class="comp-vendor-name">{v.name}</div>
                  {v.price && <div class="comp-vendor-price">{v.price}</div>}
                  <div class="comp-vendor-arrow" aria-hidden="true">→</div>
                </a>
              ))}
            </div>
          </section>
        )}

      </div><!-- /comp-main -->

      <!-- ── RIGHT SIDEBAR ── -->
      {hasSidebar && (
        <aside class="comp-sidebar">

          {quickSpecs.length > 0 && (
            <div class="comp-sidebar-card">
              <div class="comp-sidebar-title">Quick Specs</div>
              {quickSpecs.map(s => (
                <div class="comp-spec-row">
                  <span class="comp-spec-label">{s.label}</span>
                  <span class="comp-spec-value">{s.value}</span>
                </div>
              ))}
            </div>
          )}

          {compatibleToolheads.length > 0 && (
            <div class="comp-sidebar-card">
              <div class="comp-sidebar-title">Compatible Toolheads</div>
              <div class="comp-toolhead-chips">
                {compatibleToolheads.map(th => (
                  <a href={th.href} class="comp-toolhead-chip">{th.name}</a>
                ))}
              </div>
            </div>
          )}

          {vendors.length > 0 && (
            <div class="comp-sidebar-card">
              <div class="comp-sidebar-title">Where to Buy</div>
              {vendors.map(v => (
                <a
                  href={v.url}
                  class="comp-vendor-quick"
                  target="_blank"
                  rel="noopener sponsored"
                  aria-label={`Buy from ${v.name}`}
                >
                  <span class="comp-vendor-quick-name">{v.name}</span>
                  <span class="comp-vendor-quick-arrow">→</span>
                </a>
              ))}
            </div>
          )}

        </aside>
      )}

    </div>
  </div>

  <!-- ── RELATED COMPONENTS ── -->
  {relatedComponents.length > 0 && (
    <section class="comp-related" aria-labelledby="related-heading">
      <div class="comp-related-inner">
        <div class="comp-related-head">
          <h2 class="comp-related-title" id="related-heading">Related Components</h2>
          <a href="/hardware" class="comp-related-all">All hardware →</a>
        </div>
        <div class="comp-related-grid">
          {relatedComponents.map(r => (
            <a href={r.href} class="comp-related-card">
              <div class="comp-related-card-img" style={r.gradient ? `background:${r.gradient}` : 'background:linear-gradient(135deg,#1a1520,#0d0d18)'}>
                <span class="comp-related-card-cat">{r.category}</span>
              </div>
              <div class="comp-related-card-body">
                <div class="comp-related-card-title">{r.title}</div>
                {r.price && <div class="comp-related-card-price">{r.price}</div>}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer slot="footer" />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify(productSchema)}></script>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <slot name="head" slot="head" />
</Base>

<style is:global>
/* ── COMPONENT HERO ── */
.comp-hero {
  background: var(--black);
  /* padding-top: 80px nav clearance + 48px design spacing */
  padding: 128px 0 48px;
  border-bottom: 1px solid rgba(255,255,255,.08);
}
.comp-hero-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px;
  display: grid;
  grid-template-columns: 380px 1fr;
  gap: 52px;
  align-items: center;
}
.comp-hero-image {
  background: #111;
  border-radius: var(--radius-lg);
  overflow: hidden;
  aspect-ratio: 4/3;
  display: flex;
  align-items: center;
  justify-content: center;
}
.comp-hero-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}
.comp-hero-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1a1520, #0d0d18);
}
.comp-hero-placeholder-cat {
  font-family: var(--fd);
  font-size: 14px;
  font-weight: 800;
  letter-spacing: .15em;
  text-transform: uppercase;
  color: rgba(255,255,255,.2);
}
.comp-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 16px;
}
.comp-breadcrumb a,
.comp-breadcrumb span {
  font-family: var(--fm);
  font-size: 11px;
  color: rgba(255,255,255,.55);
  transition: color .15s;
}
.comp-breadcrumb a:hover { color: var(--accent); }
.comp-brand {
  font-family: var(--fu);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 8px;
}
.comp-title {
  font-family: var(--fd);
  font-size: 38px;
  font-weight: 800;
  color: #fff;
  line-height: 1.05;
  letter-spacing: -.3px;
  margin-bottom: 16px;
}
.comp-verdict-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
  flex-wrap: wrap;
}
.comp-verdict-badge {
  font-family: var(--fu);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .1em;
  text-transform: uppercase;
  border: 1.5px solid;
  border-radius: 4px;
  padding: 4px 12px;
  flex-shrink: 0;
  text-decoration: none;
}
.comp-verdict-text {
  font-family: var(--fb);
  font-size: 14px;
  color: rgba(255,255,255,.65);
  line-height: 1.5;
}
.comp-key-stats {
  display: flex;
  gap: 24px;
  flex-wrap: wrap;
  margin-bottom: 16px;
}
.comp-stat {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.comp-stat-label {
  font-family: var(--fu);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: rgba(255,255,255,.55);
}
.comp-stat-val {
  font-family: var(--fd);
  font-size: 22px;
  font-weight: 800;
  color: #fff;
  line-height: 1;
}
.comp-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.comp-tag {
  font-family: var(--fm);
  font-size: 10px;
  color: rgba(255,255,255,.4);
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 3px;
  padding: 2px 8px;
}

/* ── BODY ── */
.comp-body {
  background: var(--bg);
  padding: 48px 0 64px;
}
.comp-body-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px;
}
.comp-main { max-width: 820px; }

/* ── TWO-COLUMN LAYOUT WHEN SIDEBAR IS PRESENT ── */
.comp-body-inner.has-sidebar {
  display: grid;
  grid-template-columns: 1fr 280px;
  gap: 40px;
  align-items: start;
}
.comp-body-inner.has-sidebar .comp-main { max-width: none; }

/* ── SIDEBAR ── */
.comp-sidebar {
  position: sticky;
  top: 80px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.comp-sidebar-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 16px;
}
.comp-sidebar-title {
  font-family: var(--fd);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .1em;
  color: var(--g2);
  margin-bottom: 12px;
}

/* Quick Specs rows */
.comp-spec-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 8px;
  padding: 5px 0;
  border-bottom: 1px solid var(--border);
}
.comp-spec-row:last-child { border-bottom: none; }
.comp-spec-label {
  font-family: var(--fm);
  font-size: 10px;
  color: var(--g1);
  text-transform: uppercase;
  letter-spacing: .04em;
  flex-shrink: 0;
}
.comp-spec-value {
  font-family: var(--fm);
  font-size: 12px;
  font-weight: 700;
  color: var(--black);
  text-align: right;
}

/* Toolhead pill chips */
.comp-toolhead-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.comp-toolhead-chip {
  font-family: var(--fu);
  font-size: 11px;
  font-weight: 600;
  color: var(--black);
  background: var(--bg);
  border: 1.5px solid var(--border);
  border-radius: 20px;
  padding: 4px 12px;
  text-decoration: none;
  transition: border-color .12s, color .12s;
}
.comp-toolhead-chip:hover { border-color: var(--accent); color: var(--accent); }

/* Compact vendor quick-links */
.comp-vendor-quick {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 7px 0;
  border-bottom: 1px solid var(--border);
  text-decoration: none;
}
.comp-vendor-quick:last-child { border-bottom: none; }
.comp-vendor-quick-name {
  font-family: var(--fu);
  font-size: 13px;
  font-weight: 600;
  color: var(--black);
  transition: color .12s;
}
.comp-vendor-quick-arrow {
  font-size: 12px;
  color: var(--g2);
  transition: color .12s;
}
.comp-vendor-quick:hover .comp-vendor-quick-name { color: var(--accent); }
.comp-vendor-quick:hover .comp-vendor-quick-arrow { color: var(--accent); }

/* ── SECTIONS ── */
.comp-section {
  margin-bottom: 52px;
}
.comp-section-title {
  font-family: var(--fd);
  font-size: 22px;
  font-weight: 800;
  color: var(--black);
  margin-bottom: 20px;
  padding-bottom: 12px;
  border-bottom: 2px solid var(--black);
}

