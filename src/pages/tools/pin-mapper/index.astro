---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
const currentPath = '/tools';
---
<Base
  title="Klipper Pin Mapper — BTT, Fysetc, LDO Board Pin Reference"
  description="Quick-reference pin lookup for common Klipper control boards. Find step, dir, enable, thermistor, heater, fan, and endstop pin names without digging through docs."
>
  <Nav slot="nav" currentPath={currentPath} />

  <!-- HERO -->
  <div style="background:var(--black);padding:64px 0 40px;border-bottom:1px solid rgba(255,255,255,.1)">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
        <a href="/" style="font-size:11px;color:rgba(255,255,255,.3);font-family:'JetBrains Mono',monospace">Home</a>
        <span style="color:rgba(255,255,255,.2);font-size:11px">/</span>
        <a href="/tools" style="font-size:11px;color:rgba(255,255,255,.3);font-family:'JetBrains Mono',monospace">Tools</a>
        <span style="color:rgba(255,255,255,.2);font-size:11px">/</span>
        <span style="font-size:11px;color:rgba(255,255,255,.5);font-family:'JetBrains Mono',monospace">Pin Mapper</span>
      </div>
      <div class="eyebrow" style="margin-bottom:10px;color:var(--accent)">Reference Tool</div>
      <h1 style="font-family:'Barlow Condensed',sans-serif;font-size:52px;font-weight:800;color:#fff;line-height:1;letter-spacing:-.5px;margin-bottom:12px">Klipper Pin Mapper</h1>
      <p style="font-family:'Lora',serif;font-size:15px;color:rgba(255,255,255,.45);line-height:1.7;max-width:600px">Quick-reference pin names for common Klipper boards. Select your board, search by function, and copy pin names directly into your config.</p>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:16px">
        <span style="font-family:'JetBrains Mono',monospace;font-size:10px;background:rgba(255,90,31,.15);color:var(--accent);border:1px solid rgba(255,90,31,.3);padding:3px 10px;border-radius:3px">Klipper pins</span>
        <span style="font-family:'JetBrains Mono',monospace;font-size:10px;background:rgba(255,255,255,.06);color:rgba(255,255,255,.5);border:1px solid rgba(255,255,255,.12);padding:3px 10px;border-radius:3px">BTT · Fysetc · LDO</span>
      </div>
    </div>
  </div>

  <!-- TOOL BODY -->
  <div class="pm-wrap">
    <div class="pm-inner">

      <!-- Controls bar -->
      <div class="pm-controls">
        <div class="pm-ctrl-field">
          <label class="pm-label" for="boardSel">Board</label>
          <select class="pm-select" id="boardSel">
            <option value="octopus-v1">BTT Octopus v1.1</option>
            <option value="octopus-pro">BTT Octopus Pro v1.0/1.1</option>
            <option value="manta-m8p-v1">BTT Manta M8P v1.0</option>
            <option value="manta-m8p-v2">BTT Manta M8P v2.0</option>
            <option value="skr3">BTT SKR 3 / SKR 3 EZ</option>
            <option value="spider">Fysetc Spider v2.2</option>
            <option value="leviathan">LDO Leviathan v1.2</option>
          </select>
        </div>
        <div class="pm-ctrl-field" style="flex:2">
          <label class="pm-label" for="pinSearch">Search pins</label>
          <input class="pm-input" type="text" id="pinSearch" placeholder="e.g. stepper, fan, probe, heater…">
        </div>
        <div class="pm-board-info">
          <div class="pm-board-mcu" id="boardMcu">STM32F446ZET6</div>
        </div>
      </div>

      <!-- Table -->
      <div class="pm-table-card">
        <table class="pm-table" id="pinTable">
          <thead>
            <tr>
              <th>Function</th>
              <th>Config key</th>
              <th>Pin</th>
              <th>Notes</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="pinTableBody">
          </tbody>
        </table>
      </div>

      <!-- Disclaimer -->
      <div class="pm-disclaimer">
        <strong>Verify against documentation.</strong> Pin assignments can vary between board revisions. Always cross-check with your board's official Klipper config template or schematic before flashing.
        Klipper sample configs: <a href="https://github.com/Klipper3d/klipper/tree/master/config" target="_blank" rel="noopener">github.com/Klipper3d/klipper/config</a>
      </div>

    </div>
  </div>

  <Footer slot="footer" />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "SoftwareApplication",
        "name": "Klipper Pin Mapper",
        "description": "Quick-reference pin lookup tool for common Klipper 3D printer control boards.",
        "url": "https://modernmakes.github.io/tools/pin-mapper",
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "Web",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://modernmakes.github.io" },
          { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://modernmakes.github.io/tools" },
          { "@type": "ListItem", "position": 3, "name": "Pin Mapper", "item": "https://modernmakes.github.io/tools/pin-mapper" }
        ]
      }
    ]
  })}></script>
</Base>

<style is:global>
.pm-wrap { background: var(--bg); padding: 40px 0 64px; }
.pm-inner { max-width: 1200px; margin: 0 auto; padding: 0 40px; display: flex; flex-direction: column; gap: 20px; }
.pm-controls {
  background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
  padding: 20px; display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap;
}
.pm-ctrl-field { display: flex; flex-direction: column; gap: 5px; flex: 1; min-width: 180px; }
.pm-label { font-family: var(--fm); font-size: 10px; color: var(--g2); text-transform: uppercase; letter-spacing: .07em; }
.pm-select, .pm-input {
  font-family: var(--fm); font-size: 13px; color: var(--black); background: var(--bg);
  border: 1px solid var(--border); border-radius: 5px; padding: 8px 10px; width: 100%; transition: border-color .12s;
}
.pm-select:focus, .pm-input:focus { outline: none; border-color: var(--accent); }
.pm-board-info { display: flex; align-items: flex-end; padding-bottom: 2px; }
.pm-board-mcu { font-family: var(--fm); font-size: 11px; color: var(--g2); background: var(--bg); border: 1px solid var(--border); border-radius: 4px; padding: 6px 10px; white-space: nowrap; }

.pm-table-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; overflow-x: auto; }
.pm-table { width: 100%; border-collapse: collapse; }
.pm-table thead { background: var(--bg); }
.pm-table th {
  font-family: var(--fu); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em;
  color: var(--g2); padding: 10px 16px; text-align: left; border-bottom: 1px solid var(--border);
}
.pm-table td { padding: 9px 16px; border-bottom: 1px solid var(--border); }
.pm-table tbody tr:last-child td { border-bottom: none; }
.pm-table tbody tr:hover { background: rgba(255,90,31,.03); }
.pm-func { font-family: var(--fu); font-size: 13px; color: var(--black); font-weight: 600; }
.pm-key { font-family: var(--fm); font-size: 11px; color: var(--g2); }
.pm-pin {
  font-family: var(--fm); font-size: 13px; font-weight: 600; color: var(--accent);
  background: rgba(255,90,31,.08); border: 1px solid rgba(255,90,31,.2);
  border-radius: 3px; padding: 2px 8px; display: inline-block;
}
.pm-pin-neg { color: #60a5fa; background: rgba(96,165,250,.08); border-color: rgba(96,165,250,.2); }
.pm-note { font-family: var(--fu); font-size: 11px; color: var(--g2); }
.pm-copy-pin {
  font-family: var(--fu); font-size: 10px; font-weight: 600; padding: 4px 10px;
  background: var(--bg); color: var(--g2); border: 1px solid var(--border); border-radius: 3px;
  cursor: pointer; transition: all .12s; white-space: nowrap;
}
.pm-copy-pin:hover { border-color: var(--accent); color: var(--accent); }
.pm-copy-pin.copied { background: rgba(74,222,128,.12); color: #22c55e; border-color: rgba(74,222,128,.3); }
.pm-section-row td { background: var(--bg); }
.pm-section-row .pm-section-label { font-family: var(--fu); font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; color: var(--g2); }
.pm-no-results { font-family: var(--fm); font-size: 13px; color: var(--g2); padding: 20px 16px; }

.pm-disclaimer {
  font-family: var(--fu); font-size: 12px; color: var(--g2); line-height: 1.6;
  background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 14px 18px;
}
.pm-disclaimer a { color: var(--accent); text-decoration: none; }
.pm-disclaimer a:hover { text-decoration: underline; }

@media (max-width: 768px) { .pm-wrap { padding: 20px 0 48px; } .pm-inner { padding: 0 20px; } .pm-controls { flex-direction: column; } }
</style>

