---
import { getCollection } from 'astro:content';

const [newsEntries, guideEntries, comparisonEntries] = await Promise.all([
  getCollection('news'),
  getCollection('guides'),
  getCollection('comparisons'),
]);

type ArticleCard = {
  title: string;
  category: string;
  date: Date;
  heroImage?: string;
  href: string;
};

const allArticles: ArticleCard[] = [
  ...newsEntries.map(e => ({
    title: e.data.title,
    category: e.data.category,
    date: e.data.date,
    heroImage: e.data.heroImage,
    href: `/news/${e.slug}`,
  })),
  ...guideEntries.map(e => ({
    title: e.data.title,
    category: e.data.category,
    date: e.data.date,
    heroImage: e.data.heroImage,
    href: `/guides/${e.slug}`,
  })),
  ...comparisonEntries.map(e => ({
    title: e.data.title,
    category: e.data.category,
    date: e.data.date,
    heroImage: e.data.heroImage,
    href: `/comparisons/${e.slug}`,
  })),
];

const latestArticles = allArticles
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 4);

function bgStyle(heroImage?: string) {
  if (heroImage) {
    return `background-image:url('${heroImage}');background-size:cover;background-position:center;`;
  }
  return `background:var(--dark-bg);`;
}

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<section class="la-section" aria-label="Latest articles">
  <div class="la-container">
    <div class="la-head">
      <span class="la-label" data-reveal>Latest</span>
      <a href="/news" class="la-all-link" data-reveal data-reveal-delay="60">All articles <span class="arrow">→</span></a>
    </div>
    <div class="la-grid">
      {latestArticles.map((article, i) => (
        <a href={article.href} class="la-card" data-reveal data-reveal-delay={i * 60} aria-label={article.title}>
          <div class="la-card-img" style={bgStyle(article.heroImage)}>
            <div class="la-card-img-overlay"></div>
            <span class="la-card-img-cat">{article.category}</span>
          </div>
          <div class="la-card-body">
            <div class="la-card-cat">{article.category}</div>
            <div class="la-card-title">{article.title}</div>
            <div class="la-card-footer">
              <span class="la-card-date">{formatDate(article.date)}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .la-section {
    background: var(--bg);
    padding: 48px 40px;
  }
  .la-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .la-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 24px;
  }
  .la-label {
    font-family: var(--fd);
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--accent);
  }
  .la-all-link {
    font-size: 12px;
    color: var(--grey-1);
    font-family: var(--fu);
    transition: color 150ms;
  }
  .la-all-link:hover { color: var(--black); }

  .la-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  /* Section-scoped (0,2,0) so this transition wins over the shared reveal
     utility's :where() transition — keeps the hover lift/shadow/border crisp
     while opacity + filter carry the 600ms reveal. */
  .la-section .la-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition:
      transform    200ms var(--stagger-ease),
      box-shadow   200ms var(--stagger-ease),
      border-color 200ms var(--stagger-ease),
      opacity      var(--stagger-dur) var(--stagger-ease),
      filter       var(--stagger-dur) var(--stagger-ease);
  }
  .la-section .la-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,.08);
    border-color: var(--border-s);
  }

  .la-card-img {
    width: 100%;
    aspect-ratio: 16/9;
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    flex-shrink: 0;
    background-size: cover;
    background-position: center;
    /* Signature editorial hover — slow image zoom (F7). Card clips it. */
    transition: transform 500ms var(--stagger-ease);
  }
  .la-section .la-card:hover .la-card-img { transform: scale(1.05); }
  .la-card-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,.55) 0%, rgba(0,0,0,.1) 50%, transparent 100%);
  }
  .la-card-img-cat {
    font-family: var(--fu);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: rgba(255,255,255,.5);
    position: relative;
    z-index: 1;
    padding: 0 12px 10px;
  }

  .la-card-body {
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .la-card-cat {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 6px;
    font-family: var(--fu);
  }
  .la-card-title {
    font-family: var(--fd);
    font-size: 16px;
    font-weight: 800;
    color: var(--black);
    line-height: 1.15;
    margin-bottom: 10px;
    flex: 1;
    transition: color 200ms var(--stagger-ease);
  }
  .la-section .la-card:hover .la-card-title { color: var(--accent-dk); }
  .la-card-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    flex-wrap: wrap;
  }
  .la-card-date {
    font-family: var(--fm);
    font-size: 10px;
    color: var(--grey-2);
  }
  .la-card-price {
    font-family: var(--fm);
    font-size: 11px;
    font-weight: 600;
    color: var(--black);
    margin-left: auto;
  }

  /* Verdict badges */
  .verdict {
    font-family: var(--fu);
    font-size: 10px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 3px;
    margin-left: auto;
  }
  .verdict-rec  { background: rgba(34,197,94,.12);  color: #16a34a; }
  .verdict-best { background: rgba(255,90,31,.12);  color: var(--accent); }
  .verdict-upd  { background: rgba(59,130,246,.12); color: #3b82f6; }

  /* Responsive */
  @media (max-width: 1024px) {
    .la-section { padding: 40px 24px; }
    .la-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  }
  @media (max-width: 640px) {
    .la-section { padding: 32px 20px; }
    .la-grid { grid-template-columns: 1fr; gap: 10px; }
    .la-card-img { aspect-ratio: 16/7; }
    .la-card-title { font-size: 17px; }
  }

  /* Reveal + image zoom are motion — never move for reduce users. */
  @media (prefers-reduced-motion: reduce) {
    .la-card-img { transition: none; }
    .la-section .la-card:hover .la-card-img { transform: none; }
    .la-card-title { transition: none; }
  }
</style>

<!-- Entrance is handled by the shared [data-reveal] observer in Base.astro (M1). -->

