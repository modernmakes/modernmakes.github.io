---
/* Hallmark · macrostructure: Long Document (2-col prose + sticky sidebar TOC) — inherits lg-* from ToS */
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const siteBase = Astro.site
  ? new URL(Astro.site).href.replace(/\/$/, '')
  : 'https://modernmakes.github.io';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Cookie Policy — Modern Makes',
  url: `${siteBase}/legal/cookie-policy`,
  description: 'Cookie policy for Modern Makes. We use GA4 analytics only — no advertising or tracking cookies.',
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',          item: `${siteBase}/` },
    { '@type': 'ListItem', position: 2, name: 'Cookie Policy', item: `${siteBase}/legal/cookie-policy` },
  ],
};

const sections = [
  { id: 'what-are-cookies', label: 'What Are Cookies' },
  { id: 'what-we-use',      label: 'What We Use' },
  { id: 'no-ad-cookies',    label: 'What We Do Not Use' },
  { id: 'third-party',      label: 'Third-Party Services' },
  { id: 'your-choices',     label: 'Your Choices' },
  { id: 'no-banner',        label: 'No Cookie Banner' },
  { id: 'contact',          label: 'Contact' },
];
---
<Base
  title="Cookie Policy — Modern Makes"
  description="Cookie policy for Modern Makes. We use GA4 analytics only — no advertising or tracking cookies."
  hasPageH1={true}
>
  <Nav slot="nav" currentPath="/" />

  <div class="lg-wrap">
    <div class="lg-inner">

      <nav class="lg-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <span>Legal</span>
        <span aria-hidden="true">›</span>
        <span>Cookie Policy</span>
      </nav>

      <div class="lg-layout">

        <aside class="lg-sidebar" aria-label="Table of contents">
          <div class="lg-toc">
            <p class="lg-toc-label">On this page</p>
            <nav>
              {sections.map(s => (
                <a class="lg-toc-link" href={`#${s.id}`}>{s.label}</a>
              ))}
            </nav>
          </div>
        </aside>

        <main class="lg-content" id="lg-main">
          <h1 class="lg-title">Cookie Policy</h1>
          <p class="lg-meta">Effective June 2026 · Jurisdiction: British Columbia, Canada (PIPEDA + CASL)</p>

          <section id="what-are-cookies">
            <h2>What Are Cookies</h2>
            <p>Cookies are small text files stored in your browser when you visit a website. They help sites remember preferences and understand how visitors use the site. Modern Makes uses cookies minimally and only for purposes that help us publish better content.</p>
          </section>

          <section id="what-we-use">
            <h2>What We Use</h2>
            <p>We use one analytics service: Google Analytics 4 (property ID: G-CGR4N532H6). GA4 sets cookies to help us understand aggregate traffic patterns — which pages are visited, how long people stay, and where traffic comes from. We use this data to decide what content to prioritize. We do not use this data to build individual profiles or target advertising.</p>
            <p>GA4 cookies: <strong>_ga</strong> (expires 2 years, distinguishes users), <strong>_ga_CGR4N532H6</strong> (expires 2 years, session state), <strong>_gid</strong> (expires 24 hours, distinguishes users).</p>
          </section>

          <section id="no-ad-cookies">
            <h2>What We Do Not Use</h2>
            <p>We do not use advertising cookies, retargeting pixels, or any tracking technology for ad targeting. We do not sell data. We do not use Facebook Pixel, TikTok Pixel, or any social media tracking cookies.</p>
          </section>

          <section id="third-party">
            <h2>Third-Party Services</h2>
            <p><strong>Beehiiv:</strong> If you subscribe to our newsletter, Beehiiv may set cookies related to subscription management. Beehiiv's privacy policy governs their data practices.</p>
            <p><strong>Make.com:</strong> Our newsletter subscription form passes your email to a Make.com webhook, which forwards it to Beehiiv. Make.com does not retain your personal data beyond processing the request.</p>
            <p><strong>GitHub Pages:</strong> The site is hosted on GitHub Pages. GitHub may collect limited technical data as part of standard server logging. GitHub's privacy policy governs this.</p>
          </section>

          <section id="your-choices">
            <h2>Your Choices</h2>
            <p>You can disable cookies in your browser settings at any time. Disabling analytics cookies will not affect your ability to use any part of this site. To opt out of Google Analytics across all sites, install the Google Analytics Opt-out Browser Add-on at <a href="https://tools.google.com/dlpage/gaoptout" class="lg-email-link">tools.google.com/dlpage/gaoptout</a>.</p>
          </section>

          <section id="no-banner">
            <h2>No Cookie Banner</h2>
            <p>We do not display a cookie consent banner. Under PIPEDA and CASL, implied consent is sufficient for analytics cookies on a free, publicly accessible editorial site. This notice page provides the required transparency.</p>
          </section>

          <section id="contact">
            <h2>Contact</h2>
            <p>Questions: <a href="mailto:modernmakesco@gmail.com" class="lg-email-link">modernmakesco@gmail.com</a></p>
          </section>

        </main>
      </div>
    </div>
  </div>

  <Footer slot="footer" />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify(pageSchema)}></script>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)}></script>
</Base>

<script>
(function () {
  const sections = document.querySelectorAll<HTMLElement>('.lg-content section[id]');
  const links    = document.querySelectorAll<HTMLAnchorElement>('.lg-toc-link');
  if (!sections.length || !links.length) return;
  const obs = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        links.forEach(l => l.removeAttribute('aria-current'));
        const active = document.querySelector<HTMLAnchorElement>(`.lg-toc-link[href="#${entry.target.id}"]`);
        if (active) active.setAttribute('aria-current', 'true');
      }
    }
  }, { rootMargin: '-15% 0px -75% 0px' });
  sections.forEach(s => obs.observe(s));
})();
</script>
