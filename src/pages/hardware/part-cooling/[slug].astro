---
import HardwareDetail from '../../../components/HardwareDetail.astro';
import records from '../../../data/hardware/part-cooling.json';
import { staticPathsFor, type DetailConfig } from '../../../lib/hardware';

const config: DetailConfig = {
  categoryLabel: 'PART COOLING',
  componentType: 'Part Cooling Fan',
  titleNoun: 'Part Cooling Fan',
  quickSpecs: [
    { label: 'Type', fields: ['Type'] },
    { label: 'Size', fields: ['Size', 'Size (mm)'] },
    { label: 'Voltage', fields: ['Voltage'] },
  ],
  specs: [
    { label: 'Type', fields: ['Type'] },
    { label: 'Size', fields: ['Size', 'Size (mm)'] },
    { label: 'Voltage', fields: ['Voltage'] },
    { label: 'Airflow / Static Pressure', fields: ['CFM / Static Pressure', 'CFM', 'Airflow'] },
    { label: 'Noise', fields: ['Noise', 'Noise (dBA)'] },
  ],
};

export function getStaticPaths() {
  return staticPathsFor(records as any[]);
}

const { record } = Astro.props as { record: any };
---
<HardwareDetail record={record} config={config} />
