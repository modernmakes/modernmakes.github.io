---
import HardwareDetail from '../../../components/HardwareDetail.astro';
import records from '../../../data/hardware/enclosures.json';
import { staticPathsFor, type DetailConfig } from '../../../lib/hardware';

const config: DetailConfig = {
  categoryLabel: 'ENCLOSURE',
  componentType: 'Enclosure',
  titleNoun: 'Enclosure',
  quickSpecs: [
    { label: 'Type', fields: ['Type'] },
    { label: 'Material', fields: ['Material'] },
    { label: 'Max Chamber Temp', fields: ['Max Chamber Temp', 'Max Chamber Temp (°C)'], fmt: (v) => `${v}°C` },
  ],
  specs: [
    { label: 'Type', fields: ['Type'] },
    { label: 'Material', fields: ['Material'] },
    { label: 'Thickness', fields: ['Thickness'] },
    { label: 'Max Chamber Temp', fields: ['Max Chamber Temp', 'Max Chamber Temp (°C)'], fmt: (v) => `${v}°C` },
    { label: 'DIY or Kit', fields: ['DIY or Kit'] },
  ],
};

export function getStaticPaths() {
  return staticPathsFor(records as any[]);
}

const { record } = Astro.props as { record: any };
---
<HardwareDetail record={record} config={config} />
