---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---
<Base
  title="Contact"
  description="Get in touch with Modern Makes — editorial enquiries, PR and review requests, and general correspondence."
  heroPage={true}
>
  <Nav slot="nav" currentPath="/contact" />

  <!-- HERO -->
  <section class="pg-hero">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div class="eyebrow" style="margin-bottom:12px">Modern Makes</div>
      <h1 style="font-family:'Barlow Condensed',sans-serif;font-size:56px;font-weight:800;color:#fff;line-height:1;letter-spacing:-.5px;margin-bottom:16px">
        Contact
      </h1>
      <p style="font-family:'Lora',serif;font-size:16px;color:rgba(255,255,255,.45);line-height:1.7;max-width:500px">
        We read every message. Response times vary — editorial enquiries are prioritised.
      </p>
    </div>
  </section>

  <!-- CONTACT BODY -->
  <section class="section">
    <div class="container" style="max-width:720px">

      <div style="border:1px solid var(--border);border-radius:10px;padding:36px 40px;margin-bottom:24px">
        <div class="eyebrow" style="margin-bottom:10px">General enquiries</div>
        <h2 style="font-family:'Barlow Condensed',sans-serif;font-size:28px;font-weight:800;color:var(--black);margin-bottom:12px">
          Email us
        </h2>
        <p style="font-family:'Lora',serif;font-size:15px;color:var(--g1);line-height:1.7;margin-bottom:20px">
          For editorial feedback, reader questions, corrections, or anything else — reach us at:
        </p>
        <a
          href="mailto:hello@modernmakes.ca"
          style="display:inline-flex;align-items:center;gap:8px;font-family:'Barlow',sans-serif;font-size:18px;font-weight:700;color:var(--accent);text-decoration:none;border-bottom:2px solid rgba(255,90,31,.25);padding-bottom:2px"
        >
          hello@modernmakes.ca
        </a>
      </div>

      <div style="border:1px solid var(--border);border-radius:10px;padding:36px 40px;margin-bottom:24px">
        <div class="eyebrow" style="margin-bottom:10px">PR &amp; Review requests</div>
        <h2 style="font-family:'Barlow Condensed',sans-serif;font-size:28px;font-weight:800;color:var(--black);margin-bottom:12px">
          Manufacturers &amp; PR agencies
        </h2>
        <p style="font-family:'Lora',serif;font-size:15px;color:var(--g1);line-height:1.7;margin-bottom:16px">
          Review unit requests, press releases, and product enquiries are welcome at the same address:
          <strong style="display:block;margin-top:12px;font-family:'Barlow',sans-serif;font-size:16px;color:var(--black)">hello@modernmakes.ca</strong>
        </p>
        <p style="font-family:'Lora',serif;font-size:14px;color:var(--g2);line-height:1.6">
          Please note: receipt of a review unit does not guarantee coverage, and coverage is never paid for.
          Our <a href="/about#editorial" style="color:var(--accent)">editorial policy</a> applies to all manufacturer relationships.
        </p>
      </div>

      <div style="border:1px solid rgba(255,90,31,.2);border-radius:10px;padding:24px 40px;background:rgba(255,90,31,.04)">
        <p style="font-family:'Lora',serif;font-size:14px;color:var(--g1);line-height:1.6">
          For legal, privacy, or GDPR-related requests — use the same email address with "Privacy Request" or
          "Legal" in the subject line. See our <a href="/privacy" style="color:var(--accent)">Privacy Policy</a> for details
          on data handling and your rights.
        </p>
      </div>

    </div>
  </section>

  <Footer slot="footer" />
</Base>
