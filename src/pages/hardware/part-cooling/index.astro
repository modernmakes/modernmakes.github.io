---
import HardwareIndex from '../../../components/HardwareIndex.astro';
import records from '../../../data/hardware/part-cooling.json';

const chips = (r: any) => [
  r['Type'] ? String(r['Type']) : null,
  (r['Size'] ?? r['Size (mm)']) ? String(r['Size'] ?? r['Size (mm)']) : null,
  r['Price (USD)'] != null ? `~$${r['Price (USD)']}` : null,
].filter(Boolean) as string[];
---
<HardwareIndex
  records={records}
  route="part-cooling"
  categoryLabel="PART COOLING"
  crumb="Part Cooling"
  heading="Part Cooling"
  sub="Blowers and fans for part cooling. Airflow, static pressure, voltage, and toolhead fit."
  nounSingular="fan"
  nounPlural="fans"
  title="Best Part-Cooling Fans for Voron & High-Flow Toolheads"
  description="Part-cooling fan and blower specs, airflow, static pressure, and where to buy — CPAP blowers and 5015 fans for high-flow CoreXY toolheads."
  schemaName="Best Part-Cooling Fans for Voron & High-Flow Toolheads"
  chips={chips}
/>
