---
import HardwareDetail from '../../../components/HardwareDetail.astro';
import records from '../../../data/hardware/extruders.json';
import { staticPathsFor, type DetailConfig } from '../../../lib/hardware';

const joinList = (v: any) => (Array.isArray(v) ? v.join(', ') : String(v));

const config: DetailConfig = {
  categoryLabel: 'EXTRUDER',
  componentType: 'Extruder',
  titleNoun: 'Extruder',
  quickSpecs: [
    { label: 'Gear Ratio', fields: ['Gear Ratio'] },
    { label: 'Weight', fields: ['Weight (g)'], fmt: (v) => `${v}g` },
    { label: 'Mount', fields: ['Mount', 'Mount Style'] },
    { label: 'Ecosystem', fields: ['Ecosystem'], fmt: joinList },
  ],
  specs: [
    { label: 'Gear Ratio', fields: ['Gear Ratio'] },
    { label: 'Weight', fields: ['Weight (g)'], fmt: (v) => `${v}g` },
    { label: 'Mount', fields: ['Mount', 'Mount Style'] },
    { label: 'Drive Type', fields: ['Drive Type', 'Drive'] },
    { label: 'Ecosystem', fields: ['Ecosystem'], fmt: joinList },
  ],
};

export function getStaticPaths() {
  return staticPathsFor(records as any[]);
}

const { record } = Astro.props as { record: any };
---
<HardwareDetail record={record} config={config} />
