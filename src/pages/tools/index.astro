---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const tools = [
  {
    name: 'Pressure Advance Calibration',
    description: 'Generate a PA/LA test pattern for Klipper, Marlin, or RepRapFirmware. Supports presets for Voron, Bambu, and Prusa.',
    href: '/tools/pressure-advance',
    badge: 'Klipper · Marlin · RRF',
    category: 'Calibration',
    icon: 'pa',
  },
  {
    name: 'Retraction Calibration',
    description: 'Generate a retraction distance test tower for direct drive or Bowden setups. Finds your optimal retraction in one print.',
    href: '/tools/retraction-tuning',
    badge: 'Direct Drive · Bowden',
    category: 'Calibration',
    icon: 'retract',
  },
  {
    name: 'Flowrate Calculator',
    description: 'Find your printer\'s maximum volumetric flow rate — hotend, nozzle, and filament.',
    href: '/tools/flowrate',
    badge: 'mm³/s',
    category: 'Calibration',
    icon: 'flow',
  },
  {
    name: 'Print Cost Estimator',
    description: 'Calculate filament, time, and power costs per print job.',
    href: '/tools/cost',
    badge: '$/print',
    category: 'Planning',
    icon: 'cost',
  },
  {
    name: 'Filament Converter',
    description: 'Convert between filament length and weight for any diameter or density.',
    href: '/tools/filament-converter',
    badge: 'g ↔ m',
    category: 'Utility',
    icon: 'convert',
  },
  {
    name: 'Motor Simulator',
    description: 'Simulate stepper motor performance at different voltages, currents, and speeds. Useful for validating AWD motor choices and 48V upgrades.',
    href: 'https://tools.excit3d.shop/motor-sym/',
    badge: 'AWD · 48V',
    category: 'Calibration Tools',
    icon: 'external',
    external: true,
  },
  {
    name: 'Pin Mapper',
    description: 'Interactive Klipper pin mapping tool for common control boards. Find the correct pin names for your board without digging through documentation.',
    href: 'https://tools.excit3d.shop/pin-mapper/',
    badge: 'Klipper pins',
    category: 'Reference Tools',
    icon: 'external',
    external: true,
  },
  {
    name: 'PA Calculator',
    description: 'Calculate starting Pressure Advance values based on your hotend, extruder, and print speed. Complements the Modern Makes PA tuner tool.',
    href: 'https://tools.excit3d.shop/pa-calc/',
    badge: 'Pressure Advance',
    category: 'Calibration Tools',
    icon: 'external',
    external: true,
  },
  {
    name: 'PA Tuner',
    description: 'Step-by-step Pressure Advance tuning workflow from Excit3D. Pattern-based PA tuning with visual guidance.',
    href: 'https://tools.excit3d.shop/pa-tuner/',
    badge: 'Pressure Advance',
    category: 'Calibration Tools',
    icon: 'external',
    external: true,
  },
];

const iconSvgs: Record<string, string> = {
  pa: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l4-8 4 4 4-6 4 10"/></svg>`,
  retract: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v10M12 2l-3 3M12 2l3 3M12 22v-10M12 22l-3-3M12 22l3-3"/></svg>`,
  flow: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
  cost: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  convert: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3m8 0h3a2 2 0 0 0 2-2v-3"/></svg>`,
  external: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>`,
};
---
<Base
  title="Free 3D Printing Tools & Calculators"
  description="Free calculators and tools for 3D printing — pressure advance calibration, volumetric flow rate, print cost estimator, filament converter, and more."
>
  <Nav slot="nav" currentPath="/tools" />

  <!-- HERO -->
  <div style="background:var(--black);padding:64px 0 40px;border-bottom:1px solid rgba(255,255,255,.1)">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
        <a href="/" style="font-size:11px;color:rgba(255,255,255,.3);font-family:'JetBrains Mono',monospace">Home</a>
        <span style="color:rgba(255,255,255,.2);font-size:11px">/</span>
        <span style="font-size:11px;color:rgba(255,255,255,.5);font-family:'JetBrains Mono',monospace">Tools</span>
      </div>
      <div class="eyebrow" style="margin-bottom:10px;color:var(--accent)">Free Tools</div>
      <h1 style="font-family:'Barlow Condensed',sans-serif;font-size:52px;font-weight:800;color:#fff;line-height:1;letter-spacing:-.5px;margin-bottom:12px">3D Printing Calculators</h1>
      <p style="font-family:'Lora',serif;font-size:15px;color:rgba(255,255,255,.45);line-height:1.7;max-width:520px">No sign-up. No ads. Just the tools serious 3D printers actually need.</p>
    </div>
  </div>

  <!-- TOOLS GRID -->
  <section style="padding:48px 0 64px;background:var(--bg)">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div class="tools-idx-grid">
        {tools.map(tool => (
          <a
            href={tool.href}
            class="tools-idx-card"
            target={tool.external ? '_blank' : undefined}
            rel={tool.external ? 'noopener noreferrer' : undefined}
          >
            <div class="tools-idx-icon" set:html={iconSvgs[tool.icon] ?? iconSvgs.flow} />
            <div class="tools-idx-body">
              <span class="tools-idx-cat">{tool.category}</span>
              <div class="tools-idx-name">{tool.name}</div>
              <div class="tools-idx-desc">{tool.description}</div>
            </div>
            <div class="tools-idx-footer">
              <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
                <span class="tools-idx-badge">{tool.badge}</span>
                {tool.external && <span class="tools-idx-ext-label">↗ External tool</span>}
              </div>
              <span class="tools-idx-arrow">{tool.external ? '↗' : '→'}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "CollectionPage",
        "name": "Free 3D Printing Tools & Calculators — Modern Makes",
        "description": "Free calculators and tools for 3D printing — pressure advance, volumetric flow rate, print cost estimator, filament converter and more.",
        "url": "https://modernmakes.com/tools",
        "isPartOf": { "@type": "WebSite", "url": "https://modernmakes.com" }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://modernmakes.com" },
          { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://modernmakes.com/tools" }
        ]
      }
    ]
  })}></script>
</Base>

<style is:global>
.tools-idx-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}
.tools-idx-card {
  display: flex;
  flex-direction: column;
  gap: 14px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 24px;
  text-decoration: none;
  color: inherit;
  transition: border-color .15s, background .15s, transform .15s, box-shadow .15s;
  position: relative;
  overflow: hidden;
}
.tools-idx-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: var(--accent);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .2s ease;
}
.tools-idx-card:hover {
  border-color: var(--accent);
  background: var(--accent-t);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(255,90,31,.1);
}
.tools-idx-card:hover::before { transform: scaleX(1); }
.tools-idx-icon { color: var(--accent); display: flex; align-items: center; width: 22px; }
.tools-idx-body { flex: 1; display: flex; flex-direction: column; gap: 5px; }
.tools-idx-cat {
  font-family: var(--fu);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--g2);
}
.tools-idx-name {
  font-family: var(--fd);
  font-size: 22px;
  font-weight: 800;
  color: var(--black);
  line-height: 1.1;
}
.tools-idx-desc {
  font-family: var(--fb);
  font-size: 13px;
  color: var(--g1);
  line-height: 1.55;
}
.tools-idx-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12px;
  border-top: 1px solid var(--border);
}
.tools-idx-badge {
  font-family: var(--fm);
  font-size: 11px;
  font-weight: 500;
  color: var(--accent);
  background: rgba(255,90,31,.08);
  padding: 3px 8px;
  border-radius: 3px;
}
.tools-idx-arrow {
  font-size: 16px;
  color: var(--g2);
  transition: color .15s, transform .15s;
}
.tools-idx-card:hover .tools-idx-arrow { color: var(--accent); transform: translateX(3px); }
.tools-idx-ext-label {
  font-family: var(--fm);
  font-size: 10px;
  font-weight: 600;
  color: var(--g2);
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 3px;
  padding: 2px 6px;
}
@media (max-width: 768px) {
  .tools-idx-grid { grid-template-columns: 1fr; }
}
</style>
