<script>
// ── PRESETS ──
const PRESETS: Record<string, Record<string, string | number>> = {
  voron: { bedX:250, bedY:250, hotendTemp:240, bedTemp:110, acceleration:5000, travelSpeed:300, nozzleDia:0.4, firmware:'klipper' },
  bambu: { bedX:256, bedY:256, hotendTemp:220, bedTemp:60, acceleration:10000, travelSpeed:500, firmware:'bambu' },
  prusa: { bedX:250, bedY:210, hotendTemp:215, bedTemp:60, acceleration:1000, travelSpeed:150 },
  ender: { bedX:235, bedY:235, hotendTemp:200, bedTemp:60, acceleration:500, travelSpeed:120 },
};

const KLIPPER_START = `SET_PRINT_STATS_INFO TOTAL_LAYER=[TOTAL_LAYER_COUNT]\nG28\nG90\nM190 S[BED_TEMP]\nM109 S[HOTEND_TEMP]\nG92 E0\nG1 Z5 F3000`;
const MARLIN_START  = `G28\nM190 S[BED_TEMP]\nM109 S[HOTEND_TEMP]\nG92 E0\nG1 Z5 F3000`;

// ── G-CODE GENERATOR ──
function generateGcode(s: Record<string, any>): string {
  const rawCount    = (s.paEnd - s.paStart) / s.paIncrement;
  const patternCount = Math.max(1, Math.round(rawCount) + 1);

  if (patternCount > 30) {
    return `; ERROR: Too many patterns (${patternCount}). Reduce your PA range or increase the increment.\n; Maximum is 30 patterns.`;
  }

  const lineLength = 30;
  const spacing    = 3;
  const totalWidth = patternCount * (lineLength + spacing);
  const startX     = (s.bedX - totalWidth) / 2;
  const startY     = (s.bedY - lineLength) / 2;

  const extW  = (s.lineWidthPct / 100) * s.nozzleDia;
  const fArea = Math.PI * Math.pow(s.filamentDia / 2, 2);
  const crossSec = (h: number) => extW * h - (Math.PI / 4) * h * h;
  const ePerMm   = (h: number) => crossSec(h) / fArea;
  const fle = ePerMm(s.firstLayerHeight);
  const rle = ePerMm(s.layerHeight);

  const slowSpeed = s.printSpeed * 0.25;

  const setPACmd = (v: number): string => {
    const f = v.toFixed(4);
    if (s.firmware === 'klipper') return `SET_PRESSURE_ADVANCE ADVANCE=${f}`;
    if (s.firmware === 'rrf')     return `M572 D0 S${f}`;
    return `M900 K${f}`; // marlin + bambu
  };

  const displayCmd = (v: number): string => {
    const label = `PA=${v.toFixed(4)}`;
    if (s.firmware === 'rrf') return `M291 P"${label}" S0 T3`;
    return `M117 ${label}`;
  };

  const accelCmd = (a: number): string => {
    if (s.firmware === 'klipper') return `SET_VELOCITY_LIMIT ACCEL=${a}`;
    if (s.firmware === 'rrf')     return `M566 X${a} Y${a}`;
    return `M204 P${a}`; // marlin + bambu
  };

  const processGcode = (raw: string) =>
    raw.replace(/\[BED_TEMP\]/g, String(s.bedTemp))
       .replace(/\[HOTEND_TEMP\]/g, String(s.hotendTemp))
       .replace(/\[TOTAL_LAYER_COUNT\]/g, String(s.layerCount + 1));

  const fwNames: Record<string, string> = { klipper:'Klipper', marlin:'Marlin', rrf:'RepRapFirmware', bambu:'Bambu' };
  const fwName  = fwNames[s.firmware] ?? 'Klipper';

  const lines: string[] = [];
  const push = (...args: string[]) => lines.push(...args);

  push(
    `; Pressure Advance Calibration Pattern`,
    `; Generated by Modern Makes — modernmakes.github.io/tools/pressure-advance`,
    `; ─────────────────────────────────────────`,
    `; Firmware  : ${fwName}`,
    `; PA Range  : ${s.paStart.toFixed(3)} → ${s.paEnd.toFixed(3)} (step ${s.paIncrement.toFixed(3)})`,
    `; Patterns  : ${patternCount}`,
    `; Nozzle    : ${s.nozzleDia}mm | Layer: ${s.layerHeight}mm | Layers: ${s.layerCount}`,
    `; Bed       : ${s.bedX}×${s.bedY}mm | Hotend: ${s.hotendTemp}°C | Bed: ${s.bedTemp}°C`,
    `; ─────────────────────────────────────────`,
  );

  if (s.firmware === 'bambu') {
    push(
      `; NOTE: Bambu printers — verify M900 is supported on your firmware version.`,
      `; Alternative: use Bambu Studio's built-in Calibration → Pressure Advance tool.`,
    );
  }

  push(
    ``,
    `; === START G-CODE ===`,
    processGcode(s.startGcode).trim(),
    ``,
    `; Acceleration`,
    accelCmd(s.acceleration),
    ``,
    `; First layer fan`,
    `M106 S${Math.round(s.firstLayerFan * 2.55)}`,
    ``,
  );

  // Prime line
  const primeLen = 50;
  const primeX0  = Math.max(5, startX - 20);
  const primeE   = (fle * primeLen).toFixed(5);
  push(
    `; === PRIME LINE ===`,
    `G1 Z${s.firstLayerHeight.toFixed(2)} F3000`,
    `G1 X${primeX0.toFixed(2)} Y5.00 F${s.travelSpeed * 60}`,
    `G1 E${s.retractDist.toFixed(3)} F${s.unretractSpeed * 60}`,
    `G1 X${(primeX0 + primeLen).toFixed(2)} Y5.00 E${primeE} F${s.firstLayerSpeed * 60}`,
    `G92 E0`,
    ``,
  );

  for (let layer = 0; layer < s.layerCount; layer++) {
    const z       = s.firstLayerHeight + layer * s.layerHeight;
    const isFirst = layer === 0;
    const lEpMm   = isFirst ? fle : rle;
    const lE      = (lEpMm * lineLength).toFixed(5);
    const curSlow = isFirst ? s.firstLayerSpeed : slowSpeed;
    const curFast = isFirst ? s.firstLayerSpeed : s.printSpeed;

    push(`; === LAYER ${layer + 1} / ${s.layerCount} === Z${z.toFixed(2)}`);
    push(`G1 Z${z.toFixed(2)} F3000`);
    if (layer === 1) push(`M106 S${Math.round(s.fanSpeed * 2.55)} ; print fan on`);
    push(`G92 E0`, ``);

    for (let i = 0; i < patternCount; i++) {
      const paValue = s.paStart + i * s.paIncrement;
      const px = startX + i * (lineLength + spacing);
      const py = startY;

      push(
        `; ── Pattern ${i + 1}/${patternCount} — PA ${paValue.toFixed(4)} ──`,
        setPACmd(paValue),
        displayCmd(paValue),
        `G1 X${px.toFixed(2)} Y${py.toFixed(2)} F${s.travelSpeed * 60}`,
        `G1 E${s.retractDist.toFixed(3)} F${s.unretractSpeed * 60}`,
        `G1 X${px.toFixed(2)} Y${(py + lineLength).toFixed(2)} E${lE} F${curSlow * 60}`,
        `G1 X${(px + lineLength).toFixed(2)} Y${(py + lineLength).toFixed(2)} E${lE} F${curFast * 60}`,
        `G1 X${(px + lineLength).toFixed(2)} Y${py.toFixed(2)} E${lE} F${curSlow * 60}`,
        `G1 E-${s.retractDist.toFixed(3)} F${s.retractSpeed * 60}`,
        ``,
      );
    }
  }

  push(`; === END G-CODE ===`, processGcode(s.endGcode).trim());
  return lines.join('\n');
}

// ── SYNTAX HIGHLIGHT ──
function highlight(raw: string): string {
  return raw.split('\n').map(line => {
    const t = line.trimStart();
    if (t.startsWith(';')) return `<span class="gc-comment">${esc(line)}</span>`;
    if (t.startsWith('SET_PRESSURE_ADVANCE') || t.startsWith('M900') || t.startsWith('M572'))
      return `<span class="gc-pa">${esc(line)}</span>`;
    if (t.startsWith('M117') || t.startsWith('M291'))
      return `<span class="gc-comment">${esc(line)}</span>`;
    return line.replace(/^([A-Z][0-9]+)/, '<span class="gc-cmd">$1</span>');
  }).join('\n');
}
function esc(s: string) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// ── COLLECT SETTINGS ──
function getSettings(): Record<string, any> {
  const fw = (document.querySelector<HTMLInputElement>('input[name="firmware"]:checked'))?.value ?? 'klipper';
  return {
    firmware:         fw,
    bedX:             +v('bedX'),
    bedY:             +v('bedY'),
    nozzleDia:        +v('nozzleDia'),
    filamentDia:      +v('filamentDia'),
    travelSpeed:      +v('travelSpeed'),
    bedTemp:          +v('bedTemp'),
    hotendTemp:       +v('hotendTemp'),
    retractDist:      +v('retractDist'),
    retractSpeed:     +v('retractSpeed'),
    unretractSpeed:   +v('unretractSpeed'),
    firstLayerHeight: +v('firstLayerHeight'),
    firstLayerSpeed:  +v('firstLayerSpeed'),
    firstLayerFan:    +v('firstLayerFan'),
    lineWidthPct:     +v('lineWidthPct'),
    layerHeight:      +v('layerHeight'),
    layerCount:       +v('layerCount'),
    printSpeed:       +v('printSpeed'),
    acceleration:     +v('acceleration'),
    fanSpeed:         +v('fanSpeed'),
    paStart:          +v('paStart'),
    paEnd:            +v('paEnd'),
    paIncrement:      +v('paIncrement'),
    startGcode:       v('startGcode'),
    endGcode:         v('endGcode'),
  };
}
function v(id: string): string {
  const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
  return el?.value ?? '';
}

// ── VALIDATION ──
interface VResult { valid: boolean; errors: Map<string, string>; }

function validate(s: Record<string, any>): VResult {
  const errors = new Map<string, string>();
  if (s.paStart < 0)                                         errors.set('paStart',     'Must be ≥ 0');
  if (s.paEnd <= s.paStart)                                  errors.set('paEnd',       'Must be > PA Start');
  if (s.paIncrement <= 0 || s.paIncrement > (s.paEnd - s.paStart))
                                                             errors.set('paIncrement', 'Must be > 0 and ≤ range');
  if (s.nozzleDia < 0.1 || s.nozzleDia > 2.0)              errors.set('nozzleDia',   '0.1 – 2.0 mm');
  if (s.bedX <= 50)                                          errors.set('bedX',        'Must be > 50');
  if (s.bedY <= 50)                                          errors.set('bedY',        'Must be > 50');
  if (s.layerHeight < 0.05 || s.layerHeight > 0.5)         errors.set('layerHeight', '0.05 – 0.5 mm');
  if (s.printSpeed <= 0)                                     errors.set('printSpeed',  'Must be > 0');
  return { valid: errors.size === 0, errors };
}

function applyValidation(result: VResult) {
  document.querySelectorAll<HTMLInputElement>('.pa-input').forEach(el => el.classList.remove('input-error'));
  document.querySelectorAll<HTMLElement>('.pa-field-error').forEach(el => { el.style.display = 'none'; el.textContent = ''; });
  result.errors.forEach((msg, fieldId) => {
    const input = document.getElementById(fieldId) as HTMLInputElement | null;
    if (input) input.classList.add('input-error');
    const errEl = document.getElementById(`err-${fieldId}`);
    if (errEl) { errEl.textContent = msg; errEl.style.display = 'block'; }
  });
  const disabled = !result.valid;
  const copyBtn = document.getElementById('copyBtn') as HTMLButtonElement | null;
  const dlBtn   = document.getElementById('downloadBtn') as HTMLButtonElement | null;
  if (copyBtn) copyBtn.disabled = disabled;
  if (dlBtn)   dlBtn.disabled   = disabled;
}

// ── PATTERN COUNT + RANGE WARNINGS ──
function updatePatternCount() {
  const start = +v('paStart');
  const end   = +v('paEnd');
  const inc   = +v('paIncrement');
  if (inc <= 0 || end <= start) return;

  const rawCount = (end - start) / inc;
  const count    = Math.max(1, Math.round(rawCount) + 1);
  const countEl  = document.getElementById('patternCountNum');
  if (countEl) countEl.textContent = String(count);

  const errEl = document.getElementById('pattern-count-error');
  if (errEl) errEl.style.display = count > 30 ? 'block' : 'none';

  const isClean = Math.abs(rawCount - Math.round(rawCount)) < 0.0001;
  const warnEl  = document.getElementById('increment-warning');
  if (warnEl) {
    warnEl.style.display = !isClean ? 'block' : 'none';
    if (!isClean) {
      const actualEnd = (start + Math.round(rawCount) * inc).toFixed(4);
      const spanEl = document.getElementById('incrementActualEnd');
      if (spanEl) spanEl.textContent = `Actual end: ${actualEnd}`;
    }
  }
}

// ── STATS BAR ──
function updateStats(s: Record<string, any>) {
  const count      = Math.max(1, Math.round((s.paEnd - s.paStart) / s.paIncrement) + 1);
  const lineLength = 30;
  const totalMoves = count * s.layerCount * 3;
  const avgSpeed   = s.printSpeed * 0.625;
  const totalMm    = totalMoves * lineLength;
  const estSec     = (totalMm / avgSpeed) + count * s.layerCount * 2;
  const estMin     = Math.max(1, Math.round(estSec / 60));
  const fwLabels: Record<string, string> = { klipper:'Klipper', marlin:'Marlin', rrf:'RRF', bambu:'Bambu' };
  const fw = fwLabels[s.firmware] ?? 'Klipper';

  setText('statPatterns', String(count));
  setText('statRange', `${s.paStart.toFixed(3)} → ${s.paEnd.toFixed(3)}`);
  setText('statTime', `~${estMin} min`);
  setText('statFirmware', fw);
}

function setText(id: string, val: string) {
  const el = document.getElementById(id);
  if (el) el.textContent = val;
}

// ── BED FIT CHECK ──
function checkBedFit(s: Record<string, any>) {
  const count      = Math.max(1, Math.round((s.paEnd - s.paStart) / s.paIncrement) + 1);
  const lineLength = 30;
  const spacing    = 3;
  const totalWidth = count * (lineLength + spacing);
  const bedFitEl   = document.getElementById('bed-fit-warning');
  if (!bedFitEl) return;
  if (totalWidth > s.bedX * 0.9) {
    bedFitEl.textContent = `⚠ Patterns (${totalWidth}mm) exceed bed width (${s.bedX}mm). Reduce pattern count or increase increment.`;
    bedFitEl.style.display = 'block';
  } else if (lineLength > s.bedY * 0.9) {
    bedFitEl.textContent = `⚠ Pattern height exceeds bed depth.`;
    bedFitEl.style.display = 'block';
  } else {
    bedFitEl.style.display = 'none';
  }
}

// ── MAIN UPDATE ──
let currentGcode = '';
let debounceTimer: ReturnType<typeof setTimeout> | null = null;

function doUpdate() {
  const ind = document.getElementById('updatingIndicator');
  if (ind) ind.classList.remove('visible');

  const s = getSettings();
  updateStats(s);
  updatePatternCount();
  checkBedFit(s);

  const vResult = validate(s);
  applyValidation(vResult);

  try {
    currentGcode = generateGcode(s);
    const out = document.getElementById('gcodeOutput');
    if (out) out.innerHTML = highlight(currentGcode);
  } catch(e) {
    console.error('G-code generation error:', e);
  }
}

function scheduleUpdate() {
  const ind = document.getElementById('updatingIndicator');
  if (ind) ind.classList.add('visible');
  if (debounceTimer) clearTimeout(debounceTimer);
  debounceTimer = setTimeout(doUpdate, 150);
}

// ── PRESET APPLY ──
let presetActive   = 'custom';
let presetModified = false;

function applyPreset(preset: string) {
  presetActive   = preset;
  presetModified = false;
  updateModifiedBadge();

  const data = PRESETS[preset];
  if (!data) { scheduleUpdate(); return; }

  for (const [key, val] of Object.entries(data)) {
    if (key === 'firmware') {
      const radio = document.querySelector<HTMLInputElement>(`input[name="firmware"][value="${val}"]`);
      if (radio) radio.checked = true;
      // Update start gcode to match firmware
      const sgEl = document.getElementById('startGcode') as HTMLTextAreaElement | null;
      if (sgEl) {
        sgEl.value = (val === 'klipper' || val === 'bambu') ? KLIPPER_START : MARLIN_START;
      }
    } else {
      const el = document.getElementById(key) as HTMLInputElement | null;
      if (el) el.value = String(val);
    }
  }
  scheduleUpdate();
}

function updateModifiedBadge() {
  const badge = document.getElementById('preset-modified');
  if (!badge) return;
  badge.style.display = (presetActive !== 'custom' && presetModified) ? 'block' : 'none';
}

// ── WIRE UP ──
document.addEventListener('DOMContentLoaded', () => {
  // Preset selector
  const presetEl = document.getElementById('preset') as HTMLSelectElement | null;
  presetEl?.addEventListener('change', () => applyPreset(presetEl.value));

  // All form inputs — track modifications
  document.querySelectorAll<HTMLElement>('.pa-input, .pa-textarea')
    .forEach(el => {
      el.addEventListener('input', () => {
        if (presetActive !== 'custom') { presetModified = true; updateModifiedBadge(); }
        scheduleUpdate();
      });
    });

  // Radio buttons
  document.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach(el => {
    el.addEventListener('change', () => {
      if (presetActive !== 'custom') { presetModified = true; updateModifiedBadge(); }
      // Auto-update start gcode when firmware changes (unless user already edited it)
      if (el.name === 'firmware' && !presetModified) {
        const sgEl = document.getElementById('startGcode') as HTMLTextAreaElement | null;
        if (sgEl) {
          sgEl.value = (el.value === 'klipper' || el.value === 'bambu') ? KLIPPER_START : MARLIN_START;
        }
      }
      scheduleUpdate();
    });
  });

  // Copy button
  document.getElementById('copyBtn')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(currentGcode);
      const btn = document.getElementById('copyBtn') as HTMLButtonElement;
      btn.textContent = 'Copied ✓';
      btn.classList.add('copied');
      setTimeout(() => { btn.textContent = 'Copy G-code'; btn.classList.remove('copied'); }, 2000);
    } catch { /* clipboard blocked */ }
  });

  // Download button
  document.getElementById('downloadBtn')?.addEventListener('click', () => {
    const s = getSettings();
    const fwPrefix: Record<string, string> = { klipper:'pa_klipper', marlin:'la_marlin', rrf:'pa_rrf', bambu:'pa_bambu' };
    const prefix   = fwPrefix[s.firmware] ?? 'pa_klipper';
    const filename = `${prefix}_${s.paStart.toFixed(3)}-${s.paEnd.toFixed(3)}_${s.paIncrement.toFixed(3)}.gcode`;
    const blob = new Blob([currentGcode], { type: 'text/plain' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href = url; a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  // Initial render
  doUpdate();
});
</script>
