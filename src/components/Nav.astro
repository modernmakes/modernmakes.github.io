---
import CommandPalette from './CommandPalette.astro';
import Sheet from './Sheet.astro';
import home from '../data/homepage.json';
interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

const printersActive  = currentPath.startsWith('/voron') || currentPath.startsWith('/printers');
const hardwareActive  = currentPath.startsWith('/hardware');

// Same ecosystem list as the footer: a live one is a link, the rest carry a "Soon" tag.
const ecosystems = (home as any).ecosystems ?? [];
const mainLinks = [
  ['/hardware', 'Hardware', hardwareActive],
  ['/filament', 'Filament', currentPath.startsWith('/filament')],
  ['/guides', 'Guides', currentPath.startsWith('/guides')],
  ['/tools', 'Tools', currentPath.startsWith('/tools')],
  ['/news', 'News', currentPath.startsWith('/news')],
] as const;
---

<nav class="nav" id="site-nav" aria-label="Primary navigation">
  <!-- Reading progress (articles, guides, comparisons). Before .nav-ext so the extrusion line paints over it. -->
  <div class="nav-prog" aria-hidden="true"></div>
  <div class="nav-ext" aria-hidden="true"></div>
  <div class="nav-bar">
    <div class="nav-inner">

      <a href="/" class="nav-logo" aria-label="Modern Makes home">
        <img class="logo-wordmark"   src="/images/wordmark.svg"   alt="Modern Makes" width="1000" height="200" decoding="async" />
        <img class="logo-lettermark" src="/images/lettermark.svg" alt="Modern Makes" width="500" height="500" decoding="async" />
      </a>

      <!-- Links and the compact page title share one cell on desktop and swap in place. -->
      <div class="nav-mid">
      <div class="nav-links">

        <!-- Printers dropdown -->
        <div class="nav-dd" id="printers-dd">
          <button
            class:list={['nav-dd-btn', { active: printersActive }]}
            id="printers-btn"
            aria-haspopup="true"
            aria-expanded="false"
          >
            Printers
            <svg class="chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </button>
          <div class="nav-dd-panel" id="printers-panel" role="menu" aria-labelledby="printers-btn">
            <a href="/printers" class="nav-dd-item" role="menuitem"><strong>All printers</strong></a>
            <a href="/voron" class="nav-dd-item" role="menuitem"><strong>Voron</strong><span class="sep"> · </span><span class="desc">2.4, Trident</span></a>
          </div>
        </div>

        <a href="/hardware" class:list={['nav-link', { active: hardwareActive }]}>Hardware</a>
        <a href="/filament" class:list={['nav-link', { active: currentPath.startsWith('/filament') }]}>Filament</a>
        <a href="/guides"   class:list={['nav-link', { active: currentPath.startsWith('/guides') }]}>Guides</a>
        <a href="/tools"    class:list={['nav-link', { active: currentPath.startsWith('/tools') }]}>Tools</a>
        <a href="/news"     class:list={['nav-link', { active: currentPath.startsWith('/news') }]}>News</a>

      </div>

      <!-- Page title, shown once the page's H1 scrolls under the nav (centre under 1024px,
           left of search on desktop). The H1 stays the real heading; this is a visual echo,
           so hidden from AT. -->
      <div class="nav-title" aria-hidden="true"><span></span></div>
      </div>

      <div class="nav-spacer" aria-hidden="true"></div>

      <div class="nav-right">
        <!-- A plain link to /search without JS; CommandPalette turns [data-palette] into its trigger. -->
        <a href="/search" class="nav-search-btn" id="nav-search-btn" data-palette aria-label="Search" aria-keyshortcuts="Meta+K Control+K /">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <path d="M21 21l-4.35-4.35"/>
          </svg>
        </a>
        <button class="nav-hamburger" id="nav-hamburger" type="button" aria-label="Open menu" aria-haspopup="dialog" aria-expanded="false" aria-controls="menu-sheet" data-sheet="menu-sheet">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <line class="h-line h-top" x1="3" y1="5"  x2="17" y2="5"/>
            <line class="h-line h-mid" x1="3" y1="10" x2="17" y2="10"/>
            <line class="h-line h-bot" x1="3" y1="15" x2="17" y2="15"/>
          </svg>
        </button>
      </div>

    </div>
  </div>
</nav>

<!-- Sibling of <nav> — participates in normal document flow to push content down -->
<!-- The menu: a bottom sheet at the medium detent on phones (draggable to large), a popover under the
     hamburger on tablets. Links close it instantly so the page transition sees a clean page. -->
<Sheet id="menu-sheet" title="Menu" detent="medium" desktop="popover" dark>
  <nav aria-label="Menu">
    <span class="sheet-label">Printers</span>
    <a href="/printers" class="sheet-row" aria-current={currentPath.startsWith('/printers') ? 'page' : undefined}>All printers</a>
    {ecosystems.map((eco: any) => eco.status === 'live'
      ? <a href={eco.href} class="sheet-row" aria-current={currentPath.startsWith(eco.href) ? 'page' : undefined}>{eco.name}</a>
      : (
        <span class="sheet-row">
          <span class="grow">{eco.name}<span class="sr-only">, coming soon</span></span>
          <span class="sheet-tag" aria-hidden="true">Soon</span>
        </span>
      )
    )}
    <span class="sheet-label">Browse</span>
    {mainLinks.map(([href, label, on]) => <a href={href} class="sheet-row" aria-current={on ? 'page' : undefined}>{label}</a>)}
  </nav>
</Sheet>

<CommandPalette />

<style is:global>
  /* ─── ENTRANCE ANIMATION ─── */
  @keyframes nav-enter {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ─── SHELL ─── */
  .nav {
  position: fixed !important;
  top: 0 !important;
    z-index: 1000;
    width: 100%;
  background: rgba(20, 20, 20, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition:
      background     200ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color   200ms cubic-bezier(0.4, 0, 0.2, 1),
      backdrop-filter          200ms cubic-bezier(0.4, 0, 0.2, 1),
      -webkit-backdrop-filter  200ms cubic-bezier(0.4, 0, 0.2, 1);
    animation: nav-enter 400ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  .nav.scrolled {
    background: var(--black);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* ─── TRANSPARENT STATE — hero pages on initial load ─── */
  /*
   * Active when body[data-hero="true"] and the user hasn't scrolled yet.
   * The nav-enter slide-in animation plays through this transparent state,
   * so the hero image fills the viewport cleanly edge-to-edge.
   */
  .nav.nav-transparent {
    background: transparent !important;
    /* Use blur(0px) instead of none so the CSS transition animates smoothly */
    backdrop-filter: blur(0px) !important;
    -webkit-backdrop-filter: blur(0px) !important;
    border-bottom-color: transparent !important;
  }
  /* Keep nav text/logo clearly legible over dark heroes */
  .nav.nav-transparent .nav-link,
  .nav.nav-transparent .nav-dd-btn {
    color: rgba(255, 255, 255, 0.85);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav.nav-transparent .nav-link:hover,
    .nav.nav-transparent .nav-dd-btn:hover {
      color: #fff;
      background: rgba(255, 255, 255, 0.08);
    }
  }
  .nav.nav-transparent .nav-search-btn,
  .nav.nav-transparent .nav-hamburger {
    color: var(--on-dark-muted);
  }

  /* ─── BAR HEIGHT ─── */
  .nav-bar {
    height: 80px;
    transition: height 180ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav.scrolled .nav-bar { height: var(--nav-h); }

  /* ─── INNER LAYOUT ─── */
  .nav-inner {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  /* ─── LOGO ─── */
  .nav-logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    line-height: 0;
  }
  .logo-wordmark {
    height: 44px;
    width: auto;
    display: block;
    transition: height 160ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav.scrolled .logo-wordmark { height: 32px; }

  .logo-lettermark {
    height: 36px;
    width: auto;
    display: none;
    transition: height 160ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav.scrolled .logo-lettermark { height: 30px; }

  /* ─── DESKTOP NAV LINKS ─── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2px;
    flex: 1;
  }
  .nav-spacer { display: none; }

  /* ─── LINK BASE ─── */
  .nav-link {
    font-family: var(--fu, 'Barlow', sans-serif);
    font-size: 13px;
    font-weight: 600;
    color: var(--on-dark-muted);
    padding: 6px 10px;
    border-radius: 4px;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color 150ms ease, background 150ms ease, transform 120ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      color: #fff;
      background: rgba(255, 255, 255, 0.06);
      transform: translateY(-1px);
    }
  }
  /* Press: no scale on text links, just the 6% wash (native-feel press table) */
  .nav-link:active,
  .nav-dd-btn:active { color: #fff; background: rgba(255, 255, 255, 0.06); }
  .nav-link.active {
    color: #fff;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 4px;
  }

  /* ─── PRINTERS DROPDOWN ─── */
  .nav-dd { position: relative; }

  .nav-dd-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--fu, 'Barlow', sans-serif);
    font-size: 13px;
    font-weight: 600;
    color: var(--on-dark-muted);
    padding: 6px 10px;
    border-radius: 4px;
    border: none;
    background: transparent;
    cursor: pointer;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color 150ms ease, background 150ms ease, transform 120ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-dd-btn:hover {
      color: #fff;
      background: rgba(255, 255, 255, 0.06);
      transform: translateY(-1px);
    }
  }
  .nav-dd-btn.active {
    color: #fff;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 4px;
  }
  .nav-dd.open .nav-dd-btn { color: #fff; background: rgba(255, 255, 255, 0.06); }

  .chevron { flex-shrink: 0; transition: transform 150ms ease; }
  .nav-dd.open .chevron { transform: rotate(180deg); }

  .nav-dd-panel {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 200px;
    background: #222;
    border-radius: 8px;
    padding: 6px;
    z-index: 1001;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }
  .nav-dd.open .nav-dd-panel { display: block; }

  .nav-dd-item {
    display: flex;
    align-items: baseline;
    gap: 5px;
    padding: 10px 14px;
    border-radius: 5px;
    transition: background 150ms ease;
    line-height: 1.2;
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-dd-item:hover { background: rgba(255, 255, 255, 0.05); }
  }

  .nav-dd-item strong {
    font-family: var(--fd, 'Barlow Condensed', sans-serif);
    font-size: 15px;
    font-weight: 800;
    color: #fff;
    white-space: nowrap;
  }
  .sep  { color: var(--on-dark-muted); font-size: 13px; }
  .desc { font-family: var(--fu); font-size: 12px; color: var(--on-dark-muted); }

  /* ─── RIGHT RAIL ─── */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  /* ─── SEARCH (opens the command palette) ─── */
  .nav-search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--on-dark-muted);
    border-radius: 4px;
    flex-shrink: 0;
    position: relative;
    transition: color 150ms ease, background 150ms ease, var(--press-release);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-search-btn:hover { color: rgba(255, 255, 255, 0.8); background: rgba(255, 255, 255, 0.06); }
  }
  /* Invisible 44 x 44 hit area (Apple HIG) without changing the visible size */
  .nav-search-btn::after,
  .nav-hamburger::after { content: ''; position: absolute; inset: -6px; }

  /* ─── HAMBURGER ─── */
  .nav-hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--on-dark-muted);
    border-radius: 4px;
    flex-shrink: 0;
    position: relative;
    transition: color 150ms ease, background 150ms ease, var(--press-release);
  }
  .nav-hamburger::after { inset: -4px; }
  @media (hover: hover) and (pointer: fine) {
    .nav-hamburger:hover { color: #fff; background: rgba(255, 255, 255, 0.06); }
  }

  .h-line {
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  /* ─── PAGE TITLE IN NAV (under 1024px) ─── */
  .nav-title { display: none; }
  @media (max-width: 1023px) {
    .nav-title {
      display: flex;
      position: absolute;
      top: 0; bottom: 0; left: 240px; right: 240px;
      align-items: center;
      justify-content: center;
      font-family: var(--fd);
      font-size: 19px;
      font-weight: 800;
      letter-spacing: .01em;
      color: #fff;
      white-space: nowrap;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
      pointer-events: none;
    }
    .nav-title span { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
    .nav.show-title .nav-title { opacity: 1; transform: none; }
    /* The logo fades out as the title arrives. visibility drops it from the tab
       order once it is gone; it flips straight back to visible on the way in. */
    .nav-logo { transition: opacity var(--dur-base) var(--ease-out), visibility 0s; }
    .nav.show-title .nav-logo {
      opacity: 0;
      visibility: hidden;
      transition: opacity var(--dur-base) var(--ease-out), visibility 0s linear var(--dur-base);
    }
  }
  @media (max-width: 767px) {
    .nav-title { left: 112px; right: 112px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-title { transform: none; transition: opacity var(--dur-fast) var(--ease-out); }
  }

  /* ─── READING PROGRESS ───
     2px soft-white line (never orange: that is the extrusion line) along the bottom of the nav, filling as the article body
     ([data-progress]) is read: 0 when its top meets the nav, 1 when its end meets the
     bottom of the screen. Scroll-driven where supported, else a passive scroll fallback
     in the script below. Information, not decoration: kept under reduced motion. */
  .nav-prog {
    display: none;
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 2px;
    background: var(--on-dark-soft);
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
  }
  html:has([data-progress]) .nav-prog { display: block; }
  @keyframes nav-prog { to { transform: scaleX(1); } }
  @supports (animation-timeline: view()) {
    html { timeline-scope: --read; }
    [data-progress] { view-timeline: --read block; view-timeline-inset: var(--nav-h) 0px; }
    .nav-prog { animation: nav-prog linear both; animation-timeline: --read; animation-range: contain 0% contain 100%; }
  }

  /* ─── LARGE-TITLE HAND-OFF (1024px and up) ───
     The links fade out and the page title fades in left of search. Scrolling up 56px
     (.peek) brings the links back. Opacity only, so the nav never changes size; the
     links stay focusable and reappear when focus enters them. */
  .nav-mid { display: contents; }
  @media (min-width: 1024px) {
    .nav-mid { display: grid; flex: 1; min-width: 0; align-items: center; }
    .nav-mid > * { grid-area: 1 / 1; }
    .nav-links { transition: opacity var(--dur-base) var(--ease-out); }
    .nav-title {
      display: flex;
      justify-content: flex-end;
      min-width: 0;
      font-family: var(--fd);
      font-size: 17px;
      font-weight: 800;
      letter-spacing: .01em;
      color: #fff;
      white-space: nowrap;
      opacity: 0;
      transform: translateY(4px);
      transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
      pointer-events: none;
    }
    .nav-title span { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
    .nav.show-title:not(.peek) .nav-title { opacity: 1; transform: none; }
    .nav.show-title:not(.peek) .nav-links { opacity: 0; pointer-events: none; }
    .nav.show-title:not(.peek) .nav-links:focus-within { opacity: 1; pointer-events: auto; }
    .nav.show-title:not(.peek):has(.nav-links:focus-within) .nav-title { opacity: 0; }
  }

  /* ─── TABLET  768px–1023px ─── */
  @media (max-width: 1023px) {
    .nav-bar { height: 72px; }
    .nav.scrolled .nav-bar { height: var(--nav-h); }

    .nav-inner { gap: 16px; }

    .logo-wordmark { height: 38px; }
    .nav.scrolled .logo-wordmark { height: 28px; }

    .nav-links  { display: none; }
    .nav-spacer { display: block; flex: 1; }
    .nav-hamburger { display: flex; }

  }

  /* ─── MOBILE  below 768px ─── */
  @media (max-width: 767px) {
    .nav-bar { height: 64px; }
    .nav.scrolled .nav-bar { height: var(--nav-h); }

    .nav-inner { padding: 0 20px; gap: 12px; }

    .logo-wordmark   { display: none; }
    .logo-lettermark { display: block; height: 36px; }
    .nav.scrolled .logo-lettermark { height: 30px; }

  }
</style>

<script>
  import { closeSheet } from '../scripts/sheet';

  document.addEventListener('DOMContentLoaded', () => {
    const nav          = document.getElementById('site-nav')       as HTMLElement;
    const printersBtn  = document.getElementById('printers-btn')   as HTMLButtonElement;
    const printersDd   = document.getElementById('printers-dd')    as HTMLElement;

    /* ── Hero-page transparent nav ── */
    /*
     * When body[data-hero="true"], the nav starts fully transparent so the
     * hero image fills the viewport cleanly. On scroll, it transitions to
     * the glass state. Hysteresis mirrors the .scrolled pattern below.
     */
    const isHeroPage    = document.body.dataset.hero === 'true';
    const TRANS_HIDE    = 50;  // remove transparent when scroll > 50px
    const TRANS_RESTORE = 10;  // restore transparent when scroll < 10px

    if (isHeroPage && window.scrollY < TRANS_RESTORE) {
      nav.classList.add('nav-transparent');
    }

    /* ── Throttled scroll → .scrolled with hysteresis (on:80 / off:60) ── */
    let rafPending = false;
    let isScrolled = false;
    /* Desktop title hand-off: 56px of upward scroll brings the links back (.peek),
       56px down hides them again. Mobile never peeks. */
    const desk = matchMedia('(min-width: 1024px)');
    const PEEK = 56;
    let lastY = window.scrollY, upRun = 0, downRun = 0;
    const SCROLL_ON  = 80;
    const SCROLL_OFF = 60;

    window.addEventListener('scroll', () => {
      if (!rafPending) {
        rafPending = true;
        requestAnimationFrame(() => {
          const y = window.scrollY;

          /* Transparent ↔ glass toggle (hero pages only) */
          if (isHeroPage) {
            if (y > TRANS_HIDE) {
              nav.classList.remove('nav-transparent');
            } else if (y < TRANS_RESTORE) {
              nav.classList.add('nav-transparent');
            }
          }

          /* Glass ↔ solid toggle */
          if (!isScrolled && y > SCROLL_ON) {
            isScrolled = true;
            nav.classList.add('scrolled');
          } else if (isScrolled && y < SCROLL_OFF) {
            isScrolled = false;
            nav.classList.remove('scrolled');
          }

          const dy = y - lastY;
          lastY = y;
          if (desk.matches && nav.classList.contains('show-title')) {
            if (dy < 0) { upRun -= dy; downRun = 0; if (upRun >= PEEK) nav.classList.add('peek'); }
            else if (dy > 0) { downRun += dy; upRun = 0; if (downRun >= PEEK) nav.classList.remove('peek'); }
          } else {
            upRun = downRun = 0;
            nav.classList.remove('peek');
          }
          rafPending = false;
        });
      }
    }, { passive: true });

    /* ── Page title in nav: IntersectionObserver on the opted-in H1 (no scroll
       listener). The H1 counts as "under the nav" once it is fully above the
       compact nav height; CSS decides whether that shows (under 1024px). ── */
    const pageH1  = document.querySelector<HTMLElement>('h1[data-nav-title]');
    const titleEl = nav.querySelector('.nav-title span');
    if (pageH1 && titleEl) {
      titleEl.textContent = pageH1.dataset.navTitle || (pageH1.textContent ?? '').replace(/\s+/g, ' ').trim();
      const navH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-h')) || 56;
      new IntersectionObserver(
        ([e]) => nav.classList.toggle('show-title', !e.isIntersecting && e.boundingClientRect.height > 0 && e.boundingClientRect.bottom <= navH),
        { rootMargin: `-${navH}px 0px 0px 0px` },
      ).observe(pageH1);
    }

    /* ── Reading progress fallback (no scroll-driven animations) ── */
    const prog = nav.querySelector<HTMLElement>('.nav-prog');
    const readBody = document.querySelector<HTMLElement>('[data-progress]');
    if (prog && readBody && !CSS.supports('animation-timeline: view()')) {
      const barNavH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-h')) || 56;
      let progPending = false;
      const paint = () => {
        progPending = false;
        const r = readBody.getBoundingClientRect();
        const span = r.height - (innerHeight - barNavH);
        const p = span > 0 ? (barNavH - r.top) / span : r.bottom <= innerHeight ? 1 : 0;
        prog.style.transform = `scaleX(${Math.min(1, Math.max(0, p))})`;
      };
      const queue = () => { if (!progPending) { progPending = true; requestAnimationFrame(paint); } };
      addEventListener('scroll', queue, { passive: true });
      addEventListener('resize', queue);
      paint();
    }

    /* ── Printers dropdown ── */
    function closePrinters() {
      printersDd.classList.remove('open');
      printersBtn.setAttribute('aria-expanded', 'false');
    }
    function openPrinters() {
      printersDd.classList.add('open');
      printersBtn.setAttribute('aria-expanded', 'true');
    }

    printersBtn.addEventListener('click', e => {
      e.stopPropagation();
      printersDd.classList.contains('open') ? closePrinters() : openPrinters();
    });

    document.addEventListener('click', e => {
      if (!printersDd.contains(e.target as Node)) closePrinters();
    });

    /* ── Escape closes everything ── */
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closePrinters(); // the menu and palette handle their own Esc (sheet.ts)
    });

    /* ── The menu popover has no business open once the desktop links are showing ── */
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { if (e.matches) closeSheet('menu-sheet', true); });
  });
</script>
