---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ComparisonLayout from '../../layouts/ComparisonLayout.astro';
import GuideLayout from '../../layouts/GuideLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('news');
  return entries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const {
  title,
  type = 'news',
  category,
  date,
  readTime,
  heroImage,
  excerpt,
  summary = [],
  // comparison fields
  items,
  verdict,
  verdictText,
  specs,
  scores,
  // guide fields
  difficulty,
  timeRequired,
  tools,
  parts,
} = entry.data;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---
{type === 'comparison' ? (
  <ComparisonLayout
    title={title}
    category={category}
    date={formattedDate}
    readTime={readTime}
    heroImage={heroImage}
    excerpt={excerpt}
    summary={summary}
    items={items ?? ['Product A', 'Product B']}
    verdict={verdict}
    verdictText={verdictText}
    specs={specs ?? []}
    scores={scores ?? []}
  >
    <Content />
  </ComparisonLayout>
) : type === 'guide' ? (
  <GuideLayout
    title={title}
    category={category}
    date={formattedDate}
    readTime={readTime}
    heroImage={heroImage}
    excerpt={excerpt}
    summary={summary}
    difficulty={difficulty ?? 'Intermediate'}
    timeRequired={timeRequired ?? ''}
    tools={tools ?? []}
    parts={parts ?? []}
  >
    <Content />
  </GuideLayout>
) : (
  <ArticleLayout
    title={title}
    category={category}
    date={formattedDate}
    readTime={readTime}
    heroImage={heroImage}
    excerpt={excerpt}
    summary={summary}
  >
    <Content />
  </ArticleLayout>
)}
