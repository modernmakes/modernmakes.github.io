---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
const currentPath = '/ratrig';
const label = 'ratrig'.toUpperCase();
const siteBase = Astro.site
  ? new URL(Astro.site).href.replace(/\/$/, '')
  : 'https://modernmakes.github.io';
---
<Base hasPageH1={true} title={`${label} Upgrades & Mods`} description={`The complete mod and upgrade resource for ${label} builders.`}>
  <Nav slot="nav" currentPath={currentPath} />
  <section style="background:var(--black);padding:80px 0">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px;text-align:center">
      <div class="eyebrow" style="margin-bottom:12px">Coming soon</div>
      <h1 style="font-family:'Barlow Condensed',sans-serif;font-size:56px;font-weight:800;color:#fff;line-height:1;letter-spacing:-.5px;margin-bottom:12px">{label}</h1>
      <p style="font-family:'Lora',serif;font-size:15px;color:rgba(255,255,255,.4);line-height:1.7;max-width:480px;margin:0 auto 24px">The {label} ecosystem hub is being built. Launch content coming soon.</p>
      <a href="/" style="display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:var(--accent)">← Back to homepage</a>
    </div>
  </section>
  <Footer slot="footer" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "CollectionPage",
        "name": "RatRig Printer Ecosystem — Modern Makes",
        "description": "V-Core 4, 3.1, and 3 build resources, parts directory, and upgrade guides. Coming soon.",
        "url": `${siteBase}/ratrig`,
        "isPartOf": { "@type": "WebSite", "url": siteBase }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": siteBase },
          { "@type": "ListItem", "position": 2, "name": "RatRig", "item": `${siteBase}/ratrig` }
        ]
      }
    ]
  })}></script>
</Base>
