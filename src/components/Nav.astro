---
import CommandPalette from './CommandPalette.astro';
import Sheet from './Sheet.astro';
import home from '../data/homepage.json';
interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

const printersActive  = currentPath.startsWith('/voron') || currentPath.startsWith('/printers');
const hardwareActive  = currentPath.startsWith('/hardware');

// Same ecosystem list as the footer: a live one is a link, the rest carry a "Soon" tag.
const ecosystems = (home as any).ecosystems ?? [];
const mainLinks = [
  ['/hardware', 'Hardware', hardwareActive],
  ['/filament', 'Filament', currentPath.startsWith('/filament')],
  ['/guides', 'Guides', currentPath.startsWith('/guides')],
  ['/tools', 'Tools', currentPath.startsWith('/tools')],
  ['/news', 'News', currentPath.startsWith('/news')],
] as const;
---

<nav class="nav" id="site-nav" aria-label="Primary navigation">
  <!-- Reading progress (articles, guides, comparisons). Before .nav-ext so the extrusion line paints over it. -->
  <div class="nav-prog" aria-hidden="true"></div>
  <div class="nav-ext" aria-hidden="true"></div>
  <div class="nav-bar">
    <div class="nav-inner">

      <a href="/" class="nav-logo" aria-label="Modern Makes home">
        <img class="logo-wordmark"   src="/images/wordmark.svg"   alt="Modern Makes" width="1000" height="200" decoding="async" />
        <img class="logo-lettermark" src="/images/lettermark.svg" alt="Modern Makes" width="500" height="500" decoding="async" />
      </a>

      <div class="nav-links">

        <!-- Printers dropdown -->
        <div class="nav-dd" id="printers-dd">
          <button
            class:list={['nav-dd-btn', { active: printersActive }]}
            id="printers-btn"
            type="button"
            popovertarget="printers-panel"
            aria-haspopup="menu"
            aria-expanded="false"
          >
            Printers
            <svg class="chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </button>
          <div class="nav-dd-panel" id="printers-panel" popover role="menu" aria-labelledby="printers-btn">
            <a href="/printers" class="nav-dd-item" role="menuitem"><strong>All printers</strong></a>
            <a href="/voron" class="nav-dd-item" role="menuitem"><strong>Voron</strong><span class="sep"> · </span><span class="desc">2.4, Trident</span></a>
          </div>
        </div>

        <a href="/hardware" class:list={['nav-link', { active: hardwareActive }]}>Hardware</a>
        <a href="/filament" class:list={['nav-link', { active: currentPath.startsWith('/filament') }]}>Filament</a>
        <a href="/guides"   class:list={['nav-link', { active: currentPath.startsWith('/guides') }]}>Guides</a>
        <a href="/tools"    class:list={['nav-link', { active: currentPath.startsWith('/tools') }]}>Tools</a>
        <a href="/news"     class:list={['nav-link', { active: currentPath.startsWith('/news') }]}>News</a>

      </div>

      <!-- Page title, shown once the page's H1 scrolls under the nav. It sits in the logo's grid
           cell (and the links' on desktop) and swaps with them by opacity, so nothing shifts.
           The H1 stays the real heading; this is a visual echo, so hidden from AT. -->
      <div class="nav-title" aria-hidden="true"><span></span></div>

      <div class="nav-right">
        <!-- A plain link to /search without JS; CommandPalette turns [data-palette] into its trigger. -->
        <a href="/search" class="nav-search-btn" id="nav-search-btn" data-palette aria-label="Search" aria-keyshortcuts="Meta+K Control+K /">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <path d="M21 21l-4.35-4.35"/>
          </svg>
          <!-- Desktop shortcut hint. CommandPalette fills it (⌘K on Mac, Ctrl K elsewhere) and unhides it. -->
          <kbd class="nav-kbd" data-kbd aria-hidden="true" hidden></kbd>
        </a>
        <button class="nav-hamburger" id="nav-hamburger" type="button" aria-label="Open menu" aria-haspopup="dialog" aria-expanded="false" aria-controls="menu-sheet" data-sheet="menu-sheet" data-haptic>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <line class="h-line h-top" x1="3" y1="5"  x2="17" y2="5"/>
            <line class="h-line h-mid" x1="3" y1="10" x2="17" y2="10"/>
            <line class="h-line h-bot" x1="3" y1="15" x2="17" y2="15"/>
          </svg>
        </button>
      </div>

    </div>
  </div>
</nav>

<!-- Sibling of <nav> — participates in normal document flow to push content down -->
<!-- The menu: a bottom sheet at the medium detent on phones (draggable to large), a popover under the
     hamburger on tablets. Links close it instantly so the page transition sees a clean page. -->
<Sheet id="menu-sheet" title="Menu" detent="medium" desktop="popover" dark>
  <nav aria-label="Menu">
    <span class="sheet-label">Printers</span>
    <a href="/printers" class="sheet-row" aria-current={currentPath.startsWith('/printers') ? 'page' : undefined}>All printers</a>
    {ecosystems.map((eco: any) => eco.status === 'live'
      ? <a href={eco.href} class="sheet-row" aria-current={currentPath.startsWith(eco.href) ? 'page' : undefined}>{eco.name}</a>
      : (
        <span class="sheet-row">
          <span class="grow">{eco.name}<span class="sr-only">, coming soon</span></span>
          <span class="sheet-tag" aria-hidden="true">Soon</span>
        </span>
      )
    )}
    <span class="sheet-label">Browse</span>
    {mainLinks.map(([href, label, on]) => <a href={href} class="sheet-row" aria-current={on ? 'page' : undefined}>{label}</a>)}
  </nav>
</Sheet>

<CommandPalette />

<style is:global>
  /* ─── ENTRANCE ANIMATION ─── */
  @keyframes nav-enter {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ─── SHELL ─── */
  .nav {
  position: fixed !important;
  top: 0 !important;
    z-index: 1000;
    width: 100%;
  background: rgba(20, 20, 20, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition:
      background     200ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color   200ms cubic-bezier(0.4, 0, 0.2, 1),
      backdrop-filter          200ms cubic-bezier(0.4, 0, 0.2, 1),
      -webkit-backdrop-filter  200ms cubic-bezier(0.4, 0, 0.2, 1);
    animation: nav-enter 400ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  .nav.scrolled {
    background: var(--black);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* ─── TRANSPARENT STATE — hero pages on initial load ─── */
  /*
   * Active when body[data-hero="true"] and the user hasn't scrolled yet.
   * The nav-enter slide-in animation plays through this transparent state,
   * so the hero image fills the viewport cleanly edge-to-edge.
   */
  .nav.nav-transparent {
    background: transparent !important;
    /* Use blur(0px) instead of none so the CSS transition animates smoothly */
    backdrop-filter: blur(0px) !important;
    -webkit-backdrop-filter: blur(0px) !important;
    border-bottom-color: transparent !important;
  }
  /* Keep nav text/logo clearly legible over dark heroes */
  .nav.nav-transparent .nav-link,
  .nav.nav-transparent .nav-dd-btn {
    color: rgba(255, 255, 255, 0.85);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav.nav-transparent .nav-link:hover,
    .nav.nav-transparent .nav-dd-btn:hover {
      color: #fff;
      background: rgba(255, 255, 255, 0.08);
    }
  }
  .nav.nav-transparent .nav-search-btn,
  .nav.nav-transparent .nav-hamburger {
    color: var(--on-dark-muted);
  }

  /* ─── BAR HEIGHT ─── */
  .nav-bar {
    height: 80px;
    transition: height 180ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav.scrolled .nav-bar { height: var(--nav-h); }

  /* ─── INNER LAYOUT ───
     One row: logo | links (an empty 1fr under 1024px) | search + menu. The compact page
     title spans the first two cells, so it starts where the logo starts. */
  .nav-inner {
    --nav-gap: 32px;
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    height: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--nav-gap);
  }

  /* ─── LOGO ─── */
  .nav-logo {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    line-height: 0;
  }
  .logo-wordmark {
    height: 44px;
    width: auto;
    display: block;
    transition: height 160ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav.scrolled .logo-wordmark { height: 32px; }

  .logo-lettermark {
    height: 36px;
    width: auto;
    display: none;
    transition: height 160ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav.scrolled .logo-lettermark { height: 30px; }

  /* ─── DESKTOP NAV LINKS ─── */
  .nav-links {
    grid-area: 1 / 2;
    display: flex;
    align-items: center;
    gap: 2px;
  }

  /* ─── LINK BASE ─── */
  .nav-link {
    font-family: var(--fu, 'Barlow', sans-serif);
    font-size: 13px;
    font-weight: 600;
    color: var(--on-dark-muted);
    padding: 6px 10px;
    border-radius: 4px;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color 150ms ease, background 150ms ease, transform 120ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      color: #fff;
      background: rgba(255, 255, 255, 0.06);
      transform: translateY(-1px);
    }
  }
  /* Press: no scale on text links, just the 6% wash (native-feel press table) */
  .nav-link:active,
  .nav-dd-btn:active { color: #fff; background: rgba(255, 255, 255, 0.06); }
  .nav-link.active {
    color: #fff;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 4px;
  }

  /* ─── PRINTERS DROPDOWN ─── */
  .nav-dd { position: relative; }

  .nav-dd-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--fu, 'Barlow', sans-serif);
    font-size: 13px;
    font-weight: 600;
    color: var(--on-dark-muted);
    padding: 6px 10px;
    border-radius: 4px;
    border: none;
    background: transparent;
    cursor: pointer;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color 150ms ease, background 150ms ease, transform 120ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-dd-btn:hover {
      color: #fff;
      background: rgba(255, 255, 255, 0.06);
      transform: translateY(-1px);
    }
  }
  .nav-dd-btn.active {
    color: #fff;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 4px;
  }
  .nav-dd.open .nav-dd-btn { color: #fff; background: rgba(255, 255, 255, 0.06); }

  .chevron { flex-shrink: 0; transition: transform 150ms ease; }
  .nav-dd.open .chevron { transform: rotate(180deg); }

  /* The panel is a [popover]: top layer, light dismiss and Esc for free. JS places it under the trigger and
     sets its transform-origin there, so it scales in from the button (0.96, 180ms); it leaves faster (150ms).
     The UA hides it while closed; the exit runs because display/overlay transition discretely. */
  .nav-dd-panel {
    position: fixed;
    inset: auto;
    margin: 0;
    min-width: 200px;
    background: #222;
    border: 0;
    border-radius: 8px;
    padding: 6px;
    color: #fff;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    opacity: 0;
    transform: scale(var(--scale-enter));
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out), display var(--dur-fast) allow-discrete, overlay var(--dur-fast) allow-discrete;
  }
  .nav-dd-panel:popover-open { opacity: 1; transform: none; transition-duration: 180ms; }
  @starting-style { .nav-dd-panel:popover-open { opacity: 0; transform: scale(var(--scale-enter)); } }
  @media (prefers-reduced-motion: reduce) {
    .nav-dd-panel { transform: none; transition-duration: var(--dur-fast); }
    @starting-style { .nav-dd-panel:popover-open { transform: none; } }
  }
  /* No Popover API: a plain absolutely-positioned panel toggled by a class (rare; desktop only). */
  @supports not selector(:popover-open) {
    .nav-dd-panel { display: none; position: absolute; top: calc(100% + 8px); left: 0; opacity: 1; transform: none; z-index: 1001; }
    .nav-dd.open .nav-dd-panel { display: block; }
  }

  .nav-dd-item {
    display: flex;
    align-items: baseline;
    gap: 5px;
    padding: 10px 14px;
    border-radius: 5px;
    transition: background 150ms ease;
    line-height: 1.2;
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-dd-item:hover { background: rgba(255, 255, 255, 0.05); }
  }

  .nav-dd-item strong {
    font-family: var(--fd, 'Barlow Condensed', sans-serif);
    font-size: 15px;
    font-weight: 800;
    color: #fff;
    white-space: nowrap;
  }
  .sep  { color: var(--on-dark-muted); font-size: 13px; }
  .desc { font-family: var(--fu); font-size: 12px; color: var(--on-dark-muted); }

  /* ─── RIGHT RAIL ─── */
  .nav-right {
    grid-area: 1 / 3;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* ─── SEARCH (opens the command palette) ─── */
  .nav-search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--on-dark-muted);
    border-radius: 4px;
    flex-shrink: 0;
    position: relative;
    transition: color 150ms ease, background 150ms ease, var(--press-release);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-search-btn:hover { color: rgba(255, 255, 255, 0.8); background: rgba(255, 255, 255, 0.06); }
  }
  /* ⌘K hint: only where a keyboard is likely (768px+ and a fine pointer). The control's name stays "Search". */
  .nav-kbd { display: none; }
  @media (min-width: 768px) and (hover: hover) and (pointer: fine) {
    .nav-search-btn:has(.nav-kbd:not([hidden])) { width: auto; gap: 8px; padding: 0 6px 0 8px; }
    .nav-kbd:not([hidden]) {
      display: inline-flex; align-items: center;
      height: 20px; padding: 0 5px;
      font: 500 11px/1 var(--fm);
      color: var(--on-dark-muted);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: var(--radius-sm);
    }
  }
  /* Invisible 44 x 44 hit area (Apple HIG) without changing the visible size */
  .nav-search-btn::after,
  .nav-hamburger::after { content: ''; position: absolute; inset: -6px; }

  /* ─── HAMBURGER ─── */
  .nav-hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--on-dark-muted);
    border-radius: 4px;
    flex-shrink: 0;
    position: relative;
    transition: color 150ms ease, background 150ms ease, var(--press-release);
  }
  .nav-hamburger::after { inset: -4px; }
  @media (hover: hover) and (pointer: fine) {
    .nav-hamburger:hover { color: #fff; background: rgba(255, 255, 255, 0.06); }
  }

  .h-line {
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  /* ─── COMPACT PAGE TITLE (all widths) ───
     Once the page H1 is under the nav, the title takes the logo's place: it spans the logo
     cell and the links cell, starts at the logo's left edge and stops 12px before search.
     Logo (and desktop links) fade out as it fades in. Opacity only, so nothing shifts.
     On desktop, scrolling up 56px (.peek, set by the script) swaps them back; .peek is
     never set under 1024px. Keyboard focus inside the links brings them back too.
     visibility takes whatever is hidden out of the tab order and hit testing once it has
     faded, and flips straight back to visible on the way in. */
  .nav { --fade: var(--dur-base); }
  @media (prefers-reduced-motion: reduce) { .nav { --fade: var(--dur-fast); } }
  .nav-title {
    grid-area: 1 / 1 / 2 / 3;
    margin-right: calc(12px - var(--nav-gap)); /* reach into the gap: 12px short of search */
    min-width: 0;
    display: flex;
    align-items: center;
    font-family: var(--fd);
    font-size: 17px;
    font-weight: 800;
    letter-spacing: .01em;
    color: #fff;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--fade) var(--ease-out), visibility 0s linear var(--fade);
  }
  .nav-title span { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .nav-logo, .nav-links { transition: opacity var(--fade) var(--ease-out), visibility 0s; }
  .nav.show-title:not(.peek) .nav-title { opacity: 1; visibility: visible; transition: opacity var(--fade) var(--ease-out), visibility 0s; }
  .nav.show-title:not(.peek) .nav-logo { opacity: 0; visibility: hidden; transition: opacity var(--fade) var(--ease-out), visibility 0s linear var(--fade); }
  .nav.show-title:not(.peek) .nav-links { opacity: 0; pointer-events: none; }
  .nav.show-title:not(.peek) .nav-links:focus-within { opacity: 1; pointer-events: auto; }
  .nav.show-title:not(.peek):has(.nav-links:focus-within) .nav-title { opacity: 0; visibility: hidden; }
  @media (max-width: 1023px) { .nav-title { font-size: 19px; } }

  /* ─── READING PROGRESS ───
     2px soft-white line (never orange: that is the extrusion line) along the bottom of the nav, filling as the article body
     ([data-progress]) is read: 0 when its top meets the nav, 1 when its end meets the
     bottom of the screen. Script-driven on every browser (below), with no transition: the
     CSS scroll-driven version snapped back to 0 on iPhone when scrolling stopped.
     Information, not decoration: kept under reduced motion. */
  .nav-prog {
    display: none;
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 2px;
    background: var(--on-dark-soft);
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
  }
  html:has([data-progress]) .nav-prog { display: block; }

  /* ─── TABLET  768px–1023px ─── */
  @media (max-width: 1023px) {
    .nav-bar { height: 72px; }
    .nav.scrolled .nav-bar { height: var(--nav-h); }

    .nav-inner { --nav-gap: 16px; }

    .logo-wordmark { height: 38px; }
    .nav.scrolled .logo-wordmark { height: 28px; }

    .nav-links  { display: none; }
    .nav-hamburger { display: flex; }

  }

  /* ─── MOBILE  below 768px ─── */
  @media (max-width: 767px) {
    .nav-bar { height: 64px; }
    .nav.scrolled .nav-bar { height: var(--nav-h); }

    .nav-inner { padding: 0 20px; --nav-gap: 12px; }

    .logo-wordmark   { display: none; }
    .logo-lettermark { display: block; height: 36px; }
    .nav.scrolled .logo-lettermark { height: 30px; }

  }
</style>

<script>
  import { closeSheet } from '../scripts/sheet';

  document.addEventListener('DOMContentLoaded', () => {
    const nav          = document.getElementById('site-nav')       as HTMLElement;
    const printersBtn  = document.getElementById('printers-btn')   as HTMLButtonElement;
    const printersDd   = document.getElementById('printers-dd')    as HTMLElement;

    /* ── Hero-page transparent nav ── */
    /*
     * When body[data-hero="true"], the nav starts fully transparent so the
     * hero image fills the viewport cleanly. On scroll, it transitions to
     * the glass state. Hysteresis mirrors the .scrolled pattern below.
     */
    const isHeroPage    = document.body.dataset.hero === 'true';
    const TRANS_HIDE    = 50;  // remove transparent when scroll > 50px
    const TRANS_RESTORE = 10;  // restore transparent when scroll < 10px

    if (isHeroPage && window.scrollY < TRANS_RESTORE) {
      nav.classList.add('nav-transparent');
    }

    /* ── Throttled scroll → .scrolled with hysteresis (on:80 / off:60) ── */
    let rafPending = false;
    let isScrolled = false;
    /* Desktop title hand-off: 56px of upward scroll brings the links back (.peek),
       56px down hides them again. Mobile never peeks. */
    const desk = matchMedia('(min-width: 1024px)');
    const PEEK = 56;
    let lastY = window.scrollY, upRun = 0, downRun = 0;
    const SCROLL_ON  = 80;
    const SCROLL_OFF = 60;

    window.addEventListener('scroll', () => {
      if (!rafPending) {
        rafPending = true;
        requestAnimationFrame(() => {
          const y = window.scrollY;

          /* Transparent ↔ glass toggle (hero pages only) */
          if (isHeroPage) {
            if (y > TRANS_HIDE) {
              nav.classList.remove('nav-transparent');
            } else if (y < TRANS_RESTORE) {
              nav.classList.add('nav-transparent');
            }
          }

          /* Glass ↔ solid toggle */
          if (!isScrolled && y > SCROLL_ON) {
            isScrolled = true;
            nav.classList.add('scrolled');
          } else if (isScrolled && y < SCROLL_OFF) {
            isScrolled = false;
            nav.classList.remove('scrolled');
          }

          const dy = y - lastY;
          lastY = y;
          if (desk.matches && nav.classList.contains('show-title')) {
            if (dy < 0) { upRun -= dy; downRun = 0; if (upRun >= PEEK) nav.classList.add('peek'); }
            else if (dy > 0) { downRun += dy; upRun = 0; if (downRun >= PEEK) nav.classList.remove('peek'); }
          } else {
            upRun = downRun = 0;
            nav.classList.remove('peek');
          }
          rafPending = false;
        });
      }
    }, { passive: true });

    /* ── Page title in nav: IntersectionObserver on the opted-in H1 (no scroll
       listener). The H1 counts as "under the nav" once it is fully above the
       compact nav height; CSS swaps it with the logo (and the links on desktop). ── */
    const pageH1  = document.querySelector<HTMLElement>('h1[data-nav-title]');
    const titleEl = nav.querySelector('.nav-title span');
    if (pageH1 && titleEl) {
      titleEl.textContent = pageH1.dataset.navTitle || (pageH1.textContent ?? '').replace(/\s+/g, ' ').trim();
      const navH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-h')) || 56;
      new IntersectionObserver(
        ([e]) => nav.classList.toggle('show-title', !e.isIntersecting && e.boundingClientRect.height > 0 && e.boundingClientRect.bottom <= navH),
        { rootMargin: `-${navH}px 0px 0px 0px` },
      ).observe(pageH1);
    }

    /* ── Reading progress: 0 when the body's top meets the compact nav, 1 when its end meets the
       bottom of the screen. One rAF-throttled write per frame. ── */
    const prog = nav.querySelector<HTMLElement>('.nav-prog');
    const readBody = document.querySelector<HTMLElement>('[data-progress]');
    if (prog && readBody) {
      const readNavH = () => parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-h')) || 56;
      let barNavH = readNavH(), progPending = false;
      const paint = () => {
        progPending = false;
        const r = readBody.getBoundingClientRect();
        const span = r.height - (innerHeight - barNavH);
        const p = span > 0 ? (barNavH - r.top) / span : r.bottom <= innerHeight ? 1 : 0;
        prog.style.transform = `scaleX(${Math.min(1, Math.max(0, p))})`;
      };
      const queue = () => { if (!progPending) { progPending = true; requestAnimationFrame(paint); } };
      addEventListener('scroll', queue, { passive: true });
      addEventListener('scrollend', queue);
      addEventListener('resize', () => { barNavH = readNavH(); queue(); }); // --nav-h changes per breakpoint
      addEventListener('load', queue);
      paint();
    }

    /* ── Printers dropdown: the Popover API does light dismiss, Esc and focus return; this places it under the
       trigger, closes it on scroll (the nav moves), and adds menu keys. ── */
    const panel = document.getElementById('printers-panel') as HTMLElement;
    const hasPopover = 'showPopover' in panel;
    const items = () => [...panel.querySelectorAll<HTMLElement>('[role="menuitem"]')];
    const placePrinters = () => {
      const r = printersBtn.getBoundingClientRect();
      panel.style.left = `${r.left}px`;
      panel.style.top = `${r.bottom + 8}px`;
      panel.style.transformOrigin = `${Math.round(r.width / 2)}px -8px`; // scale in from the trigger
    };
    const closeOnScroll = () => panel.hidePopover();
    let viaKeyboard = false;

    if (hasPopover) {
      printersBtn.addEventListener('click', (e) => { viaKeyboard = e.detail === 0; placePrinters(); });
      panel.addEventListener('toggle', (e) => {
        const open = (e as ToggleEvent).newState === 'open';
        printersDd.classList.toggle('open', open);
        printersBtn.setAttribute('aria-expanded', String(open));
        if (open) {
          addEventListener('scroll', closeOnScroll, { passive: true });
          if (viaKeyboard) items()[0]?.focus();
        } else removeEventListener('scroll', closeOnScroll);
      });
      // Tabbing out of the open menu closes it.
      panel.addEventListener('focusout', (e) => {
        const to = (e as FocusEvent).relatedTarget;
        if (to instanceof Node && !panel.contains(to) && to !== printersBtn) panel.hidePopover();
      });
      // Menu keys: arrows move between items, Home/End jump, ArrowDown/Up on the button opens it.
      printersBtn.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        viaKeyboard = true;
        placePrinters();
        if (!panel.matches(':popover-open')) panel.showPopover();
        const list = items();
        (e.key === 'ArrowDown' ? list[0] : list[list.length - 1])?.focus();
      });
      panel.addEventListener('keydown', (e) => {
        const list = items(), i = list.indexOf(document.activeElement as HTMLElement);
        const to = e.key === 'ArrowDown' ? (i + 1) % list.length : e.key === 'ArrowUp' ? (i - 1 + list.length) % list.length : e.key === 'Home' ? 0 : e.key === 'End' ? list.length - 1 : -1;
        if (to < 0) return;
        e.preventDefault();
        list[to].focus();
      });
    } else {
      // Fallback for browsers without the Popover API: click toggles, outside click and Esc close.
      const setOpen = (o: boolean) => { printersDd.classList.toggle('open', o); printersBtn.setAttribute('aria-expanded', String(o)); };
      printersBtn.addEventListener('click', (e) => { e.stopPropagation(); setOpen(!printersDd.classList.contains('open')); });
      document.addEventListener('click', (e) => { if (!printersDd.contains(e.target as Node)) setOpen(false); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
    }

    /* ── The menu popover has no business open once the desktop links are showing ── */
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { if (e.matches) closeSheet('menu-sheet', true); });
  });
</script>
