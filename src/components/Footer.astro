---
import data from '../data/homepage.json';

// Same ecosystem list as HomeEcosystemHubs: an entry becomes a link when its status flips to "live".
const ecosystems = (data as any).ecosystems ?? [];
---

<footer class="footer" role="contentinfo" data-reveal>
  <div class="footer-inner">
    <div class="footer-top">

      <!-- Brand -->
      <div>
        <a href="/" class="footer-logo" aria-label="Modern Makes home">
          <img src="/images/wordmark.svg" alt="Modern Makes" class="footer-wordmark" />
        </a>
        <p class="footer-tagline" id="footer-tagline">Never stop tinkering.</p>
      </div>

      <!-- Link columns -->
      <div class="footer-cats">
        <div>
          <div class="footer-cat-label">3D Printers</div>
          {ecosystems.map((eco: any) => eco.status === 'live'
            ? <a href={eco.href} class="footer-link">{eco.name}</a>
            : (
              <span class="footer-link footer-soon">
                {eco.name}<span class="sr-only">, coming soon</span>
                <span class="footer-soon-hover" aria-hidden="true">Coming soon</span>
                <span class="footer-soon-tag" aria-hidden="true">Soon</span>
              </span>
            )
          )}
        </div>
        <div>
          <div class="footer-cat-label">Editorial</div>
          <a href="/filament" class="footer-link">Filament</a>
          <a href="/guides"   class="footer-link">Guides</a>
          <a href="/news"     class="footer-link">News</a>
          <a href="/tools"    class="footer-link">Tools</a>
        </div>
        <div>
          <div class="footer-cat-label">Parts</div>
          <a href="/hotends"        class="footer-link">Hotends</a>
          <a href="/extruders"      class="footer-link">Extruders</a>
          <a href="/electronics"    class="footer-link">Electronics</a>
          <a href="/motion-system"  class="footer-link">Motion system</a>
          <a href="/build-surfaces" class="footer-link">Build surfaces</a>
        </div>
        <div>
          <div class="footer-cat-label">Publication</div>
          <a href="/newsletter"        class="footer-link">Newsletter</a>
          <a href="/newsletter/archive" class="footer-link">Newsletter Archive</a>
          <a href="/about"             class="footer-link">About</a>
          <a href="/editorial"          class="footer-link">Editorial policy</a>
          <a href="/advertise"         class="footer-link">Advertise</a>
          <a href="/partners"          class="footer-link">Partner With Us</a>
          <a href="/search"            class="footer-link">Search</a>
          <a href="/sitemap"           class="footer-link">Sitemap</a>
          <a href="mailto:modernmakesco@gmail.com" class="footer-link footer-link-email">modernmakesco@gmail.com</a>
        </div>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <div class="footer-legal">
        &copy; 2026 Modern Makes.
        <a href="/legal/terms-of-service">Terms</a> &middot; <a href="/legal/cookie-policy">Cookies</a>
      </div>
      <div class="footer-disclosure">
        Modern Makes uses affiliate links. We may earn a commission when you buy through links on this site. This never influences our editorial recommendations.
      </div>
    </div>
  </div>
</footer>

<style is:global>
  /* Entrance is handled by the shared [data-reveal] observer in Base.astro (M1). */

  /* ─── SHELL ─── */
  .footer {
    background: #111;
    padding: 56px 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ─── TOP SECTION ─── */
  .footer-top {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* ─── LOGO ─── */
  .footer-logo { display: inline-block; line-height: 0; }

  .footer-wordmark {
    height: 28px;
    width: auto;
    display: block;
    margin-bottom: 16px;
    opacity: 0.9;
    transition: opacity 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .footer-wordmark:hover { opacity: 1; }
  }

  /* ─── TAGLINE ─── */
  .footer-tagline {
    font-family: var(--fb);
    font-size: 13px;
    color: var(--on-dark-muted);
    line-height: 1.6;
    max-width: 180px;
  }

  /* ─── COLUMNS ─── */
  .footer-cats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .footer-cat-label {
    font-family: var(--fu);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
    margin-bottom: 12px;
  }

  .footer-link {
    display: block;
    font-family: var(--fu);
    font-size: 13px;
    color: var(--on-dark-muted);
    padding: 3px 0;
    transition: color 150ms ease;
    line-height: 1.5;
  }
  @media (hover: hover) and (pointer: fine) {
    .footer-link:hover { color: rgba(255, 255, 255, 0.8); }
  }
  .footer-link-email { font-family: var(--fm); font-size: 11px; margin-top: 6px; }

  /* ─── COMING-SOON ENTRIES (plain text, not focusable) ─── */
  .footer-soon { position: relative; width: fit-content; cursor: default; }
  @media (hover: hover) and (pointer: fine) {
    .footer-link.footer-soon:hover { color: var(--on-dark-muted); }
  }
  .footer-soon-hover,
  .footer-soon-tag {
    font-family: var(--fm);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .06em;
    margin-left: 8px;
  }
  /* Touch / no-hover: a static tag so it never reads as a broken link. */
  .footer-soon-hover { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .footer-soon-tag { display: none; }
    .footer-soon-hover {
      display: inline;
      position: absolute; /* out of flow: no layout shift */
      left: 100%;
      top: 50%;
      margin-left: 0;
      transform: translateY(-50%);
      padding-left: 8px;
      white-space: nowrap;
      opacity: 0;
      transition: opacity var(--dur-fast) var(--ease-out);
    }
    .footer-soon:hover .footer-soon-hover { opacity: 1; }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: reduce) {
    .footer-soon-hover { transition: none; }
  }

  /* ─── BOTTOM BAR ─── */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    flex-wrap: wrap;
  }

  .footer-legal {
    font-family: var(--fu);
    font-size: 11px;
    color: var(--on-dark-muted);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .footer-legal a {
    color: var(--on-dark-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .footer-legal a:hover { color: var(--on-dark-soft); }
  }

  .footer-disclosure {
    font-family: var(--fu);
    font-size: 11px;
    color: var(--on-dark-muted);
    max-width: 480px;
    text-align: right;
    line-height: 1.5;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 1024px) {
    .footer-top { grid-template-columns: 1fr; gap: 32px; }
    .footer-cats { grid-template-columns: repeat(2, 1fr); }
    .footer-tagline { max-width: 100%; }
  }

  @media (max-width: 768px) {
    .footer-inner { padding: 0 20px; }
    .footer-top { padding-bottom: 32px; }
    .footer-cats { grid-template-columns: repeat(2, 1fr); gap: 28px; }
    .footer-bottom { flex-direction: column; align-items: flex-start; gap: 12px; }
    .footer-disclosure { text-align: left; max-width: 100%; }
  }

  @media (max-width: 480px) {
    .footer-cats { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  const taglines = [
    "Never stop tinkering.",
    "Still calibrating. Always will be.",
    "We read the changelogs so you don't have to.",
    "Chasing the next 0.1mm.",
    "Built for people who never call a print \"finished.\"",
    "For people who read Discord before bed.",
    "Always one upgrade away from done.",
    "Never satisfied with stock firmware.",
    "The build is never actually finished.",
    "Made for people with too many nozzles.",
    "Print first, sleep later.",
    "Still tuning. Still tinkering.",
    "For the ones who source their own BOM.",
    "Obsessed with the details nobody else covers."
  ];

  const ROTATION_HOURS = 4;
  const bucket = Math.floor(Date.now() / (ROTATION_HOURS * 60 * 60 * 1000));
  const index = bucket % taglines.length;

  const el = document.getElementById('footer-tagline');
  if (el) el.textContent = taglines[index];
</script>
