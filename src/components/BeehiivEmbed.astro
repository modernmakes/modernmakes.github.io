---
---
<form class="beehiiv-fallback-form" id="newsletter-form">
  <input type="email" name="email" id="newsletter-email" placeholder="Enter your email" required />
  <button type="submit" id="newsletter-btn">Subscribe →</button>
</form>
<p class="beehiiv-open-note" id="newsletter-msg" style="display:none;"></p>

<script is:inline>
(function() {
  var form = document.getElementById('newsletter-form');
  var btn = document.getElementById('newsletter-btn');
  var msg = document.getElementById('newsletter-msg');
  var email = document.getElementById('newsletter-email');

  if (!form) return;

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    btn.textContent = 'Subscribing...';
    btn.disabled = true;

    var slug = window.location.pathname.replace(/\//g, '-').replace(/^-|-$/g, '') || 'unknown';
    var pageType = window.location.pathname.includes('/guides/') ? 'guide_footer' : 'article_footer';

    fetch('https://hook.us1.make.com/rb9wcdyixxygfhoihhr0mnjpm1k61hu4', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: email.value,
        utm_source: 'website',
        utm_medium: 'subscribe_form',
        utm_campaign: pageType + '__' + slug
      })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      form.style.display = 'none';
      msg.textContent = "You're in. Welcome to The Modern Makes Brief.";
      msg.style.display = 'block';
      msg.style.color = '#fff';
      msg.style.fontSize = '15px';
    })
    .catch(function() {
      btn.textContent = 'Subscribe →';
      btn.disabled = false;
      msg.textContent = 'Something went wrong. Please try again.';
      msg.style.display = 'block';
      msg.style.color = 'rgba(255,255,255,0.5)';
    });
  });
})();
</script>

<style>
  .beehiiv-fallback-form {
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .beehiiv-fallback-form input[type="email"] {
    flex: 1;
    min-width: 220px;
    max-width: 320px;
    padding: 12px 16px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 4px;
    color: #fff;
    font-family: var(--fb);
    font-size: 14px;
  }
  .beehiiv-fallback-form input[type="email"]::placeholder {
    color: rgba(255,255,255,0.4);
  }
  .beehiiv-fallback-form button {
    padding: 12px 24px;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 4px;
    font-family: var(--fd);
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .05em;
    cursor: pointer;
    white-space: nowrap;
  }
  .beehiiv-fallback-form button:hover {
    background: #e04d1a;
  }
  .beehiiv-fallback-form button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .beehiiv-open-note {
    font-size: 13px;
    color: rgba(255,255,255,0.3);
    font-family: var(--fb);
    text-align: center;
    margin: 8px 0 0;
  }
</style>
