---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const entries = await getCollection('filament');

// Stable display order
const ORDER = ['petg', 'asa', 'abs', 'pa-cf', 'tpu'];
const sorted = [...entries].sort(
  (a, b) => ORDER.indexOf(a.slug) - ORDER.indexOf(b.slug)
);

function verdictClass(v: string): string {
  const u = v.toUpperCase();
  if (u === 'BEST IN CLASS' || u === 'BEST')    return 'verdict-best';
  if (u === 'AVOID' || u === 'NOT RECOMMENDED') return 'verdict-skip';
  return 'verdict-rec';
}

const difficultyColor: Record<string, string> = {
  Beginner:     '#16a34a',
  Intermediate: '#d97706',
  Advanced:     '#dc2626',
};
---
<Base
  title="Filament Reviews & Material Guides — Modern Makes"
  description="Independent filament reviews and material guides — PETG, ASA, ABS, PA-CF, TPU and more. Real settings, real prints, real verdicts."
  heroPage={true}
>
  <Nav slot="nav" currentPath="/filament" />

  <!-- HERO -->
  <section class="pg-hero">
    <div style="max-width:1200px;margin:0 auto;padding:0 40px">
      <div class="eyebrow" style="margin-bottom:12px">Modern Makes</div>
      <h1 style="font-family:'Barlow Condensed',sans-serif;font-size:56px;font-weight:800;color:#fff;line-height:1;letter-spacing:-.5px;margin-bottom:16px">
        Filament
      </h1>
      <p style="font-family:'Lora',serif;font-size:16px;color:rgba(255,255,255,.45);line-height:1.7;max-width:560px">
        Material guides, brand recommendations, and troubleshooting — every filament type we cover, with real print settings.
      </p>
    </div>
  </section>

  <!-- MATERIALS GRID -->
  <section class="section" style="background:var(--bg)">
    <div class="container">
      <div class="section-head">
        <span class="section-head-label">Materials</span>
        <span style="font-family:var(--fm);font-size:11px;color:var(--g2)">{sorted.length} guides</span>
      </div>
      <div class="fil-index-grid">
        {sorted.map(entry => {
          const { material, materialFull, verdict, verdictLabel, summary, stats } = entry.data;
          return (
            <a href={`/filament/${entry.slug}`} class="fil-index-card">
              <div class="fil-index-card-head">
                <div>
                  <p class="fil-index-full">{materialFull}</p>
                  <h2 class="fil-index-name">{material}</h2>
                </div>
                <span class={`verdict ${verdictClass(verdict)}`}>{verdict}</span>
              </div>
              <p class="fil-index-summary">{summary}</p>
              <div class="fil-index-chips">
                <span class="fil-index-chip">{stats.nozzleTemp}</span>
                <span class="fil-index-chip">{stats.bedTemp} bed</span>
                <span class="fil-index-chip" style={`color:${difficultyColor[stats.difficulty] ?? 'inherit'}`}>
                  {stats.difficulty}
                </span>
              </div>
              <div class="fil-index-footer">
                <span class="fil-index-verdict-label">{verdictLabel}</span>
                <span class="fil-index-arrow">→</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- BRIDGE TO NEWS -->
  <section class="section" style="background:var(--surface);border-top:1px solid var(--border)">
    <div class="container" style="max-width:720px">
      <div style="display:flex;align-items:flex-start;gap:20px;border:1px solid rgba(255,90,31,.2);border-radius:10px;padding:28px 32px;background:rgba(255,90,31,.04)">
        <div style="flex-shrink:0;width:40px;height:40px;background:var(--accent);border-radius:8px;display:flex;align-items:center;justify-content:center">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2z"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
        </div>
        <div>
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-size:20px;font-weight:800;color:var(--black);margin:0 0 8px;line-height:1">
            Filament launches and news
          </h3>
          <p style="font-family:'Lora',serif;font-size:14px;color:var(--g1);line-height:1.7;margin:0 0 14px">
            New filament releases, brand announcements, and material coverage also appear in our News section.
          </p>
          <a href="/news" style="display:inline-flex;align-items:center;gap:6px;font-family:'Barlow',sans-serif;font-size:13px;font-weight:700;color:var(--accent)">
            Browse News →
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "CollectionPage",
        "name": "Filament Reviews & Guides — Modern Makes",
        "description": "Independent filament reviews, buying guides, and comparisons for PETG, ASA, ABS, PA-CF, TPU and more.",
        "url": "https://modernmakes.github.io/filament",
        "isPartOf": { "@type": "WebSite", "url": "https://modernmakes.github.io" },
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home",     "item": "https://modernmakes.github.io" },
          { "@type": "ListItem", "position": 2, "name": "Filament", "item": "https://modernmakes.github.io/filament" },
        ],
      },
    ],
  })}></script>
</Base>

<style is:global>
.fil-index-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.fil-index-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 22px 24px;
  text-decoration: none;
  color: inherit;
  transition: border-color .15s, transform .15s, box-shadow .15s;
  position: relative;
  overflow: hidden;
}
.fil-index-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: var(--accent);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .2s ease;
}
.fil-index-card:hover {
  border-color: var(--accent);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(255,90,31,.08);
}
.fil-index-card:hover::before { transform: scaleX(1); }

.fil-index-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}
.fil-index-full {
  font-family: var(--fm);
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--g2);
  margin: 0 0 3px;
}
.fil-index-name {
  font-family: var(--fd);
  font-size: 28px;
  font-weight: 800;
  color: var(--black);
  line-height: 1;
  margin: 0;
}
.fil-index-summary {
  font-family: var(--fb);
  font-size: 13px;
  color: var(--g1);
  line-height: 1.6;
  margin: 0;
  flex: 1;
}
.fil-index-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.fil-index-chip {
  font-family: var(--fm);
  font-size: 10px;
  color: var(--g1);
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 3px;
  padding: 2px 7px;
}
.fil-index-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12px;
  border-top: 1px solid var(--border);
  margin-top: auto;
}
.fil-index-verdict-label {
  font-family: var(--fu);
  font-size: 12px;
  color: var(--g2);
  font-style: italic;
}
.fil-index-arrow {
  font-size: 16px;
  color: var(--g2);
  transition: color .15s, transform .15s;
}
.fil-index-card:hover .fil-index-arrow { color: var(--accent); transform: translateX(3px); }

@media (max-width: 1024px) {
  .fil-index-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .fil-index-grid { grid-template-columns: 1fr; }
}
</style>
