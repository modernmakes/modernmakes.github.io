---
import { getCollection } from 'astro:content';
import heroData from '../../data/homepage.json';

// Build url → heroImage from every collection that carries heroImage
const heroImageMap = new Map<string, string>();
const [newsEntries, guidesEntries, comparisonsEntries] = await Promise.all([
  getCollection('news'),
  getCollection('guides'),
  getCollection('comparisons'),
]);
for (const e of newsEntries)        if (e.data.heroImage) heroImageMap.set(`/news/${e.slug}`,        e.data.heroImage);
for (const e of guidesEntries)      if (e.data.heroImage) heroImageMap.set(`/guides/${e.slug}`,       e.data.heroImage);
for (const e of comparisonsEntries) if (e.data.heroImage) heroImageMap.set(`/comparisons/${e.slug}`, e.data.heroImage);

// Enrich slides with resolved heroImage — image field is not stored in JSON
const slides = (heroData.heroSlides as any[]).map(slide => ({
  ...slide,
  resolvedImage: heroImageMap.get(slide.url) ?? null,
}));

const defaultSlide = slides[0];

function bgStyle(slide: any) {
  if (slide.resolvedImage) {
    return `background-image: url('${slide.resolvedImage}'); background-size: cover; background-position: center 15%;`;
  }
  return `background: ${slide.gradient};`;
}
---

<section
  class="hero"
  aria-label="Featured article"
  data-slides={JSON.stringify(slides)}
>
  <div class="hero-slides">
    <div class="hero-slide is-active">
      <div
        class="hero-bg kb-active"
        style={bgStyle(defaultSlide)}
        data-fallback={defaultSlide.gradient}
      ></div>
      <div class:list={['hero-overlay', { 'hero-overlay--photo': !!defaultSlide.resolvedImage }]}></div>
      <a href={defaultSlide.url} class="hero-content" tabindex="0">
        <div class="hero-content-inner">
          <span class={`hero-cat hero-cat--${defaultSlide.categoryColor}`}>{defaultSlide.category}</span>
          <h2 class="hero-title">{defaultSlide.title}</h2>
          <p class="hero-excerpt">{defaultSlide.excerpt}</p>
          <div class="hero-meta">
            <span class="hero-read-cta">Read article <span class="arrow">→</span></span>
          </div>
        </div>
      </a>
    </div>
  </div>
</section>

<style is:global>
  .hero {
    position: relative;
    width: 100%;
    height: 620px;
    overflow: hidden;
  }

  .hero-slides {
    position: absolute;
    inset: 0;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 600ms ease;
    pointer-events: none;
  }

  .hero-slide.is-active {
    opacity: 1;
    z-index: 1;
    pointer-events: all;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    transform-origin: center;
    background-repeat: no-repeat;
  }

  /* Entrance choreography + perpetual ambient drift (M2).
     Gated behind no-preference; under reduce the bg + copy sit at rest.
     Above the fold, so keyframes + animation-delay drive it — not IO. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-bg.kb-active {
      /* entrance fade/settle hands off seamlessly (scale 1.04) to the loop */
      animation:
        hero-bg-in 900ms var(--stagger-ease) both,
        ken-burns  36s ease-in-out 900ms infinite alternate;
      will-change: transform;
    }
    .hero-cat     { animation: hero-rise var(--stagger-dur) var(--stagger-ease) 250ms both; }
    .hero-title   { animation: hero-rise var(--stagger-dur) var(--stagger-ease) 330ms both; }
    .hero-excerpt { animation: hero-rise var(--stagger-dur) var(--stagger-ease) 410ms both; }
    .hero-meta    { animation: hero-rise var(--stagger-dur) var(--stagger-ease) 490ms both; }
  }

  @keyframes hero-bg-in {
    from { opacity: 0; transform: scale(1.06); }
    to   { opacity: 1; transform: scale(1.04); }
  }

  /* 36s alternate = never a visible loop seam, never dead (fixes F2) */
  @keyframes ken-burns {
    from { transform: scale(1.04) translate(0, 0); }
    to   { transform: scale(1.08) translate(-1.2%, 0.8%); }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(var(--stagger-distance));
      filter: blur(var(--stagger-blur));
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top,  rgba(0,0,0,.90) 0%, rgba(0,0,0,.4) 40%, rgba(0,0,0,.15) 70%, transparent 100%),
      linear-gradient(to right, rgba(0,0,0,.3) 0%, transparent 60%);
  }

  .hero-overlay--photo {
    background:
      linear-gradient(to top,   rgba(0,0,0,.88) 0%, rgba(0,0,0,.45) 35%, rgba(0,0,0,.1) 65%, transparent 100%),
      linear-gradient(to right, rgba(0,0,0,.75) 0%, rgba(0,0,0,.2) 45%, transparent 70%);
  }

  .hero-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    padding: 0 40px 80px;
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .hero-content-inner { max-width: 560px; }

  .hero-cat {
    display: inline-flex;
    align-items: center;
    font-family: var(--fu);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    background: var(--accent);
    color: #fff;
    padding: 4px 10px;
    border-radius: 3px;
    margin-bottom: 12px;
  }

  .hero-title {
    font-family: var(--fd);
    font-size: clamp(22px, 3.5vw + 8px, 42px);
    font-weight: 800;
    color: #fff;
    line-height: 1.02;
    letter-spacing: -.5px;
    margin-bottom: 14px;
    text-shadow: 0 2px 20px rgba(0,0,0,.3);
  }

  .hero-meta {
    font-family: var(--fm);
    font-size: 11px;
    color: rgba(255,255,255,.5);
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .hero-excerpt {
    font-family: var(--fb);
    font-size: clamp(13px, 1.2vw, 15px);
    color: rgba(255,255,255,.65);
    line-height: 1.65;
    margin-bottom: 18px;
    max-width: 480px;
  }

  .hero-read-cta {
    font-family: var(--fu);
    font-size: 12px;
    font-weight: 600;
    color: rgba(255,255,255,.55);
    letter-spacing: .04em;
    transition: color 200ms var(--stagger-ease);
  }

  /* Hover response on the full-bleed link (was inert) — CTA colour + arrow slide.
     Arrow slide is driven by the global `a:hover .arrow` rule. */
  .hero-content:hover .hero-read-cta,
  .hero-content:focus-visible .hero-read-cta { color: var(--accent); }

  /* ── REDUCED MOTION ── */
  @media (prefers-reduced-motion: reduce) {
    .hero-slide { transition: none; }
    .hero-read-cta { transition: none; }
  }

  /* ── ULTRAWIDE ── */
  @media (min-width: 1800px) {
    .hero { height: 620px; }
    .hero-bg[style*="background-image"] { background-position: 65% center; }
  }

  /* ── TABLET ── */
  @media (max-width: 1024px) {
    .hero {
      height: auto;
      display: flex;
      flex-direction: column;
    }
    .hero-slides {
      position: relative;
      height: 460px;
      flex-shrink: 0;
    }
    .hero-bg[style*="background-image"] { background-position: center center; }
    .hero-title { letter-spacing: -.3px; }
    .hero-content { padding: 0 24px 80px; }
    .hero-content-inner { max-width: 100%; }
  }

  /* ── MOBILE ── */
  @media (max-width: 767px) {
    .hero-slides { height: 420px; }
    .hero-bg[style*="background-image"] { background-position: 70% center; }
    .hero-overlay--photo {
      background:
        linear-gradient(to top,   rgba(0,0,0,.92) 0%, rgba(0,0,0,.55) 40%, rgba(0,0,0,.15) 70%, transparent 100%),
        linear-gradient(to right, rgba(0,0,0,.6)  0%, transparent 70%);
    }
    .hero-title { letter-spacing: -.3px; }
    .hero-content { padding: 0 20px 72px; }
    .hero-cat { font-size: 9px; padding: 3px 8px; margin-bottom: 8px; }
    .hero-meta { font-size: 10px; gap: 6px; }
  }

  @media (max-width: 480px) {
    .hero-slides { height: 360px; }
    .hero-bg[style*="background-image"] { background-position: center center; }
  }
</style>

<script>
(function () {
  const heroEl = document.querySelector('.hero');
  if (!heroEl) return;

  // Determine today's slide via day-of-year seed — same index for all visitors on the same day
  const now       = new Date();
  const start     = new Date(now.getFullYear(), 0, 0);
  const dayOfYear = Math.floor((now - start) / (1000 * 60 * 60 * 24));

  const slides = JSON.parse(heroEl.dataset.slides || '[]');
  if (!slides.length) return;

  const activeIdx = dayOfYear % slides.length;
  const active    = slides[activeIdx];

  // Slide 0 is already rendered as the SSR default; only update DOM when a different slide is active
  if (activeIdx !== 0) {
    const bgEl      = heroEl.querySelector('.hero-bg');
    const overlayEl = heroEl.querySelector('.hero-overlay');
    const catEl     = heroEl.querySelector('.hero-cat');
    const titleEl   = heroEl.querySelector('.hero-title');
    const excerptEl = heroEl.querySelector('.hero-excerpt');
    const linkEl    = heroEl.querySelector('.hero-content');

    if (catEl)     { catEl.textContent = active.category; catEl.className = 'hero-cat hero-cat--' + active.categoryColor; }
    if (titleEl)   titleEl.textContent  = active.title;
    if (excerptEl) excerptEl.textContent = active.excerpt;
    if (linkEl)    linkEl.setAttribute('href', active.url);

    if (bgEl) {
      if (active.resolvedImage) {
        bgEl.style.cssText = "background-image:url('" + active.resolvedImage + "');background-size:cover;background-position:center 15%;";
        if (overlayEl) overlayEl.classList.add('hero-overlay--photo');
      } else {
        bgEl.style.cssText = 'background:' + active.gradient + ';';
        if (overlayEl) overlayEl.classList.remove('hero-overlay--photo');
      }
      bgEl.dataset.fallback = active.gradient;
    }
  }

  // Graceful fallback: swap to gradient if background-image 404s
  const bgEl = heroEl.querySelector('.hero-bg');
  if (bgEl) {
    const styleVal = bgEl.getAttribute('style') || '';
    const match    = styleVal.match(/url\(['"]?([^'")\s]+)['"]?\)/);
    if (match) {
      const img = new Image();
      img.onerror = function () {
        const fallback = bgEl.dataset.fallback;
        if (fallback) { bgEl.style.backgroundImage = ''; bgEl.style.background = fallback; }
      };
      img.src = match[1];
    }
  }

  // Scroll parallax — hero content sinks + dims as the page scrolls over it,
  // reading as depth (M2 optional). rAF-throttled, transform/opacity only,
  // and skipped entirely under reduced motion. The Ken Burns bg is left
  // untouched (its transform is owned by the running animation).
  if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const content = heroEl.querySelector('.hero-content');
    if (content) {
      const heroHeight = heroEl.offsetHeight || 620;
      let ticking = false;
      const update = function () {
        const y = window.scrollY || window.pageYOffset || 0;
        if (y <= heroHeight) {
          content.style.transform = 'translateY(' + (y * 0.15) + 'px)';
          content.style.opacity = String(Math.max(0, 1 - y / 500));
        }
        ticking = false;
      };
      window.addEventListener('scroll', function () {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }, { passive: true });
      update();
    }
  }
}());
</script>