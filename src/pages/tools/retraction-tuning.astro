---
import '../../styles/tools-gcode.css';
import ToolHero from '../../components/ToolHero.astro';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
const currentPath = '/tools';
const siteBase = Astro.site
  ? new URL(Astro.site).href.replace(/\/$/, '')
  : 'https://modernmakes.github.io';
---
<Base hasPageH1={true}
  title="Retraction Calibration Tool — Direct Drive & Bowden"
  description="Generate a retraction distance test tower for Klipper, Marlin, or RepRapFirmware. Finds your optimal retraction in one print. Supports Voron, Bambu, Prusa, and Ender presets."
>
  <Nav slot="nav" currentPath={currentPath} />

  <ToolHero title="Retraction Calibration" intro="Generate a retraction distance tower test for direct drive or Bowden setups. Each tower uses a different retraction distance — find the cleanest travel move and you have your value." />

  <!-- TOOL BODY -->
  <div class="pa-tool-wrap">
    <div class="pa-tool-inner">

      <!-- LEFT: SETTINGS -->
      <aside class="pa-sidebar">

        <!-- Preset -->
        <div class="pa-form-group" style="margin-bottom:0;padding-bottom:16px;border-bottom:1px solid var(--border)">
          <label class="pa-label" for="preset">Printer Preset</label>
          <div style="position:relative">
            <select class="pa-select" id="preset">
              <option value="custom">Custom (manual)</option>
              <option value="voron">Voron 2.4 / Trident</option>
              <option value="bambu">Bambu X1C / P1S</option>
              <option value="prusa">Prusa MK4</option>
              <option value="ender">Ender 3 / CR-10</option>
            </select>
            <span id="preset-modified" class="pa-modified-badge">(modified)</span>
          </div>
        </div>

        <!-- Section: Retraction Range (open first — most important) -->
        <details class="pa-section" open>
          <summary class="pa-section-head">
            <span>Retraction Range</span>
            <span class="pa-section-arrow">▾</span>
          </summary>
          <div class="pa-section-body">
            <div class="pa-row-3">
              <div class="pa-form-group">
                <label class="pa-label" for="rStart">Start (mm)</label>
                <input class="pa-input" type="number" id="rStart" value="0.5" min="0" max="10" step="0.1">
                <span id="err-rStart" class="pa-field-error"></span>
              </div>
              <div class="pa-form-group">
                <label class="pa-label" for="rEnd">End (mm)</label>
                <input class="pa-input" type="number" id="rEnd" value="6.0" min="0.1" max="15" step="0.1">
                <span id="err-rEnd" class="pa-field-error"></span>
              </div>
              <div class="pa-form-group">
                <label class="pa-label" for="rIncrement">Increment</label>
                <input class="pa-input" type="number" id="rIncrement" value="0.5" min="0.1" max="2" step="0.1">
                <span id="err-rIncrement" class="pa-field-error"></span>
              </div>
            </div>
            <div class="pa-form-group" style="margin-top:10px">
              <label class="pa-label" for="rSpeed">Retraction Speed (mm/s)</label>
              <input class="pa-input" type="number" id="rSpeed" value="35" min="1" max="120">
            </div>
            <div class="pa-pattern-count" id="towerCountDisplay">
              <span id="towerCountNum">12</span> towers will be generated
            </div>
            <div id="tower-count-error" class="pa-inline-error" style="display:none">
              ⚠ Too many towers — maximum 20. Increase increment or reduce range.
            </div>
            <div id="increment-warning" class="pa-inline-warn" style="display:none">
              ⚠ Increment doesn't divide evenly into range — <span id="incrementActualEnd"></span>
            </div>
            <div class="rt-range-note">
              Direct drive: 0.5–2.0mm &nbsp;·&nbsp; Bowden: 2.0–7.0mm
            </div>
          </div>
        </details>

        <!-- Section: Firmware -->
        <details class="pa-section" open>
          <summary class="pa-section-head">
            <span>Firmware</span>
            <span class="pa-section-arrow">▾</span>
          </summary>
          <div class="pa-section-body">
            <div class="pa-form-group">
              <div class="pa-radio-group">
                <label class="pa-radio"><input type="radio" name="firmware" value="klipper" checked> Klipper</label>
                <label class="pa-radio"><input type="radio" name="firmware" value="marlin"> Marlin</label>
                <label class="pa-radio"><input type="radio" name="firmware" value="rrf"> RepRapFirmware 3+</label>
              </div>
            </div>
          </div>
        </details>

        <!-- Section: Printer -->
        <details class="pa-section">
          <summary class="pa-section-head">
            <span>Printer</span>
            <span class="pa-section-arrow">▾</span>
          </summary>
          <div class="pa-section-body">
            <div class="pa-row-2">
              <div class="pa-form-group">
                <label class="pa-label" for="nozzleDia">Nozzle Diameter (mm)</label>
                <input class="pa-input" type="number" id="nozzleDia" value="0.4" min="0.1" max="2.0" step="0.1">
              </div>
              <div class="pa-form-group">
                <label class="pa-label" for="filamentDia">Filament Diameter (mm)</label>
                <input class="pa-input" type="number" id="filamentDia" value="1.75" min="1.6" max="3.1" step="0.01">
              </div>
            </div>
            <div class="pa-row-2">
              <div class="pa-form-group">
                <label class="pa-label" for="bedX">Bed Size X (mm)</label>
                <input class="pa-input" type="number" id="bedX" value="250" min="51" max="700">
                <span id="err-bedX" class="pa-field-error"></span>
              </div>
              <div class="pa-form-group">
                <label class="pa-label" for="bedY">Bed Size Y (mm)</label>
                <input class="pa-input" type="number" id="bedY" value="210" min="51" max="700">
                <span id="err-bedY" class="pa-field-error"></span>
              </div>
            </div>
            <div id="bed-fit-warning" class="pa-inline-error" style="display:none"></div>
            <div class="pa-form-group">
              <label class="pa-label" for="travelSpeed">Travel Speed (mm/s)</label>
              <input class="pa-input" type="number" id="travelSpeed" value="150" min="20" max="800">
            </div>
          </div>
        </details>

        <!-- Section: Temperature -->
        <details class="pa-section">
          <summary class="pa-section-head">
            <span>Temperature</span>
            <span class="pa-section-arrow">▾</span>
          </summary>
          <div class="pa-section-body">
            <div class="pa-row-2">
              <div class="pa-form-group">
                <label class="pa-label" for="hotendTemp">Hotend Temp (°C)</label>
                <input class="pa-input" type="number" id="hotendTemp" value="220" min="150" max="350">
              </div>
              <div class="pa-form-group">
                <label class="pa-label" for="bedTemp">Bed Temp (°C)</label>
                <input class="pa-input" type="number" id="bedTemp" value="60" min="0" max="150">
              </div>
            </div>
          </div>
        </details>

        <!-- Section: Tower Settings -->
        <details class="pa-section">
          <summary class="pa-section-head">
            <span>Tower Settings</span>
            <span class="pa-section-arrow">▾</span>
          </summary>
          <div class="pa-section-body">
            <div class="pa-row-2">
              <div class="pa-form-group">
                <label class="pa-label" for="towerHeight">Tower Height (mm)</label>
                <input class="pa-input" type="number" id="towerHeight" value="20" min="5" max="60">
              </div>
              <div class="pa-form-group">
                <label class="pa-label" for="towerWidth">Tower Width (mm)</label>
                <input class="pa-input" type="number" id="towerWidth" value="10" min="5" max="30">
              </div>
            </div>
            <div class="pa-row-2">
              <div class="pa-form-group">
                <label class="pa-label" for="layerHeight">Layer Height (mm)</label>
                <input class="pa-input" type="number" id="layerHeight" value="0.2" min="0.05" max="0.5" step="0.01">
                <span id="err-layerHeight" class="pa-field-error"></span>
              </div>
              <div class="pa-form-group">
                <label class="pa-label" for="printSpeed">Print Speed (mm/s)</label>
                <input class="pa-input" type="number" id="printSpeed" value="50" min="1" max="400">
                <span id="err-printSpeed" class="pa-field-error"></span>
              </div>
            </div>
            <div class="pa-form-group">
              <label class="pa-label" for="fanSpeed">Fan Speed (%)</label>
              <input class="pa-input" type="number" id="fanSpeed" value="100" min="0" max="100">
            </div>
          </div>
        </details>

        <!-- Section: Start G-code -->
        <details class="pa-section">
          <summary class="pa-section-head">
            <span>Start G-code</span>
            <span class="pa-section-arrow">▾</span>
          </summary>
          <div class="pa-section-body">
            <div class="pa-form-group">
              <label class="pa-label" for="startGcode">Tokens: [BED_TEMP] [HOTEND_TEMP]</label>
              <textarea class="pa-textarea" id="startGcode" rows="6">G28
G90
M190 S[BED_TEMP]
M109 S[HOTEND_TEMP]
G92 E0
G1 Z5 F3000</textarea>
            </div>
          </div>
        </details>

        <!-- Section: End G-code -->
        <details class="pa-section">
          <summary class="pa-section-head">
            <span>End G-code</span>
            <span class="pa-section-arrow">▾</span>
          </summary>
          <div class="pa-section-body">
            <div class="pa-form-group">
              <textarea class="pa-textarea" id="endGcode" rows="4">M104 S0
M140 S0
G28 X
M84</textarea>
            </div>
          </div>
        </details>

      </aside>

      <!-- RIGHT: OUTPUT -->
      <main class="pa-output">

        <!-- Stats bar -->
        <div class="pa-stats-bar">
          <div class="pa-stat">
            <span class="pa-stat-label">Towers</span>
            <span class="pa-stat-val" id="statTowers">12</span>
          </div>
          <div class="pa-stat-div"></div>
          <div class="pa-stat">
            <span class="pa-stat-label">Retraction Range</span>
            <span class="pa-stat-val" id="statRange">0.5 → 6.0mm</span>
          </div>
          <div class="pa-stat-div"></div>
          <div class="pa-stat">
            <span class="pa-stat-label">Est. Print Time</span>
            <span class="pa-stat-val" id="statTime">~18 min</span>
          </div>
          <div class="pa-stat-div"></div>
          <div class="pa-stat">
            <span class="pa-stat-label">Firmware</span>
            <span class="pa-stat-val" id="statFirmware">Klipper</span>
          </div>
          <div class="pa-updating" id="updatingIndicator">Updating…</div>
        </div>

        <!-- Action buttons -->
        <div class="pa-actions">
          <button class="pa-btn-copy" id="copyBtn">Copy G-code</button>
          <button class="pa-btn-download" id="downloadBtn">Download .gcode</button>
        </div>

        <!-- G-code output -->
        <div class="pa-code-wrap">
          <pre class="pa-code" id="gcodeOutput" aria-label="Generated G-code" tabindex="0"></pre>
        </div>

        <!-- How to use -->
        <div class="pa-howto">
          <h2 class="pa-howto-title">How to use</h2>
          <ol class="pa-howto-steps">
            <li><strong>Configure settings.</strong> Select a preset to fill common values. Set your retraction range: <code>0.5–2.0mm</code> for direct drive, <code>2.0–7.0mm</code> for Bowden.</li>
            <li><strong>Download and print directly.</strong> Do not slice this file. Load it in Mainsail, Fluidd, OctoPrint, or from SD card and print as-is.</li>
            <li><strong>Inspect the travel moves between towers.</strong> Too little retraction: strings bridge between towers. Too much: blobs on resume, gaps at layer start.</li>
            <li><strong>Find the cleanest tower.</strong> Count from left — the leftmost tower is your start distance. <code>distance = start + (index × increment)</code>. Apply this value in your slicer retraction settings.</li>
          </ol>
          <div class="pa-diagram">
            <div class="pa-diagram-title">Reading the retraction towers</div>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480 140" style="width:100%;display:block" aria-label="Retraction tower comparison: too little shows strings between towers, correct shows clean gap, too much shows blobs on resume">

            <!-- ── Group 1: Too little retraction ── -->
            <text x="80" y="18" text-anchor="middle" fill="#ccc" font-size="11" font-weight="bold" font-family="'JetBrains Mono',monospace">Too little retraction</text>
            <rect x="46" y="26" width="26" height="84" fill="none" stroke="#555" stroke-width="1.5"/>
            <rect x="88" y="26" width="26" height="84" fill="none" stroke="#555" stroke-width="1.5"/>
            <path d="M 72,46 Q 80,42 88,46" fill="none" stroke="#FF5A1F" stroke-width="1.5"/>
            <path d="M 72,61 Q 80,57 88,61" fill="none" stroke="#FF5A1F" stroke-width="1.5"/>
            <path d="M 72,76 Q 80,72 88,76" fill="none" stroke="#FF5A1F" stroke-width="1.5"/>
            <path d="M 72,91 Q 80,87 88,91" fill="none" stroke="#FF5A1F" stroke-width="1.5"/>
            <text x="80" y="126" text-anchor="middle" fill="#888" font-size="9" font-family="'JetBrains Mono',monospace">strings between towers</text>

            <!-- ── Group 2: Correct ── -->
            <text x="240" y="18" text-anchor="middle" fill="#ccc" font-size="11" font-weight="bold" font-family="'JetBrains Mono',monospace">Correct</text>
            <rect x="206" y="26" width="26" height="84" fill="none" stroke="#555" stroke-width="1.5"/>
            <rect x="248" y="26" width="26" height="84" fill="none" stroke="#555" stroke-width="1.5"/>
            <text x="240" y="126" text-anchor="middle" fill="#888" font-size="9" font-family="'JetBrains Mono',monospace">clean travels</text>

            <!-- ── Group 3: Too much retraction ── -->
            <text x="400" y="18" text-anchor="middle" fill="#ccc" font-size="11" font-weight="bold" font-family="'JetBrains Mono',monospace">Too much retraction</text>
            <rect x="366" y="26" width="26" height="84" fill="none" stroke="#555" stroke-width="1.5"/>
            <rect x="408" y="26" width="26" height="84" fill="none" stroke="#555" stroke-width="1.5"/>
            <circle cx="392" cy="28" r="6" fill="#FF5A1F"/>
            <circle cx="408" cy="28" r="6" fill="#FF5A1F"/>
            <text x="400" y="126" text-anchor="middle" fill="#888" font-size="9" font-family="'JetBrains Mono',monospace">blobs on resume</text>

          </svg>
          </div>
          <div class="pa-howto-note">
            Klipper: set retraction in your slicer — it passes <code>G1 E</code> commands directly. Or use <code>SET_RETRACTION</code> if firmware retraction is enabled in your config.<br>
            Marlin: <code>M207</code> sets firmware retraction distance. Enable <code>FWRETRACT</code> in <code>Configuration_adv.h</code>. Or configure retraction in your slicer profile directly.
          </div>
        </div>

      </main>
    </div>
  </div>

  <Footer slot="footer" />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "SoftwareApplication",
        "name": "Retraction Calibration Tool",
        "description": "Generate a retraction distance tower test for direct drive or Bowden printers.",
        "url": `${siteBase}/tools/retraction-tuning`,
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "Web",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
        "isPartOf": { "@type": "WebSite", "url": siteBase }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": siteBase },
          { "@type": "ListItem", "position": 2, "name": "Tools", "item": `${siteBase}/tools` },
          { "@type": "ListItem", "position": 3, "name": "Retraction Calibration", "item": `${siteBase}/tools/retraction-tuning` }
        ]
      }
    ]
  })}></script>
</Base>

<style is:global>
#towerCountNum { font-weight: 700; font-size: 13px; }
.pa-code .gc-retract { color: #4fc3f7; }
.rt-range-note {
  margin-top: 8px;
  font-family: var(--fu);
  font-size: 10px;
  color: var(--g2);
  padding: 5px 0;
}
</style>

<script>
// ── PRESETS ──
const PRESETS: Record<string, Record<string, string | number>> = {
  voron: { bedX:250, bedY:250, hotendTemp:240, bedTemp:110, travelSpeed:300, firmware:'klipper', rStart:0.5, rEnd:2.0, rIncrement:0.25 },
  bambu: { bedX:256, bedY:256, hotendTemp:220, bedTemp:60,  travelSpeed:500, firmware:'klipper', rStart:0.5, rEnd:1.5, rIncrement:0.25 },
  prusa: { bedX:250, bedY:210, hotendTemp:215, bedTemp:60,  travelSpeed:150, rStart:0.5, rEnd:2.0, rIncrement:0.25 },
  ender: { bedX:235, bedY:235, hotendTemp:200, bedTemp:60,  travelSpeed:120, rStart:2.0, rEnd:7.0, rIncrement:0.5  },
};

const KLIPPER_START = `G28\nG90\nM190 S[BED_TEMP]\nM109 S[HOTEND_TEMP]\nG92 E0\nG1 Z5 F3000`;
const MARLIN_START  = `G28\nM190 S[BED_TEMP]\nM109 S[HOTEND_TEMP]\nG92 E0\nG1 Z5 F3000`;

// ── G-CODE GENERATOR ──
function generateGcode(s: Record<string, any>): string {
  const rawCount   = (s.rEnd - s.rStart) / s.rIncrement;
  const towerCount = Math.max(1, Math.round(rawCount) + 1);

  if (towerCount > 20) {
    return `; ERROR: Too many towers (${towerCount}). Reduce range or increase increment.\n; Maximum is 20 towers.`;
  }

  const tw      = s.towerWidth;
  const tSpc    = 10;  // gap between towers
  const totalW  = towerCount * (tw + tSpc);
  const startX  = (s.bedX - totalW) / 2;
  const startY  = (s.bedY - tw) / 2;

  if (startX < 5 || startY < 5) {
    return `; ERROR: Towers (${totalW.toFixed(0)}mm) do not fit on bed (${s.bedX}mm). Reduce tower count or increment.`;
  }

  // Extrusion math
  const extW    = 1.05 * s.nozzleDia;  // ~105% nozzle width
  const fArea   = Math.PI * Math.pow(s.filamentDia / 2, 2);
  const crossSec= (h: number) => extW * h - (Math.PI / 4) * h * h;
  const ePerMm  = (h: number) => crossSec(h) / fArea;
  const lE      = ePerMm(s.layerHeight);
  const sideE   = (lE * tw).toFixed(5);
  const towerLayers = Math.max(1, Math.round(s.towerHeight / s.layerHeight));

  const fwNames: Record<string, string> = { klipper:'Klipper', marlin:'Marlin', rrf:'RepRapFirmware' };
  const fwName  = fwNames[s.firmware] ?? 'Klipper';

  const processGcode = (raw: string) =>
    raw.replace(/\[BED_TEMP\]/g, String(s.bedTemp))
       .replace(/\[HOTEND_TEMP\]/g, String(s.hotendTemp));

  const lines: string[] = [];
  const push = (...args: string[]) => lines.push(...args);

  push(
    `; Retraction Distance Calibration Tower`,
    `; Generated by Modern Makes — modernmakes.github.io/tools/retraction-tuning`,
    `; ─────────────────────────────────────────`,
    `; Firmware    : ${fwName}`,
    `; Ret. Range  : ${s.rStart.toFixed(1)} → ${s.rEnd.toFixed(1)}mm (step ${s.rIncrement.toFixed(2)}mm)`,
    `; Ret. Speed  : ${s.rSpeed} mm/s`,
    `; Towers      : ${towerCount} | Size: ${tw}×${tw}mm | Height: ${s.towerHeight}mm`,
    `; Bed         : ${s.bedX}×${s.bedY}mm | Hotend: ${s.hotendTemp}°C | Bed: ${s.bedTemp}°C`,
    `; ─────────────────────────────────────────`,
    ``,
    `; === START G-CODE ===`,
    processGcode(s.startGcode).trim(),
    ``,
    `; Fan on`,
    `M106 S${Math.round(s.fanSpeed * 2.55)}`,
    ``,
    `; === PRIME LINE ===`,
    `G1 Z${s.layerHeight.toFixed(2)} F3000`,
    `G1 X${Math.max(5, startX - 15).toFixed(2)} Y5.00 F${s.travelSpeed * 60}`,
    `G1 E0.5 F${s.rSpeed * 60}`,
    `G1 X${Math.max(5, startX - 15 + 40).toFixed(2)} Y5.00 E${(lE * 40).toFixed(5)} F${s.printSpeed * 60}`,
    `G92 E0`,
    ``,
  );

  // Initial travel to tower 0 (retract at start distance before moving)
  const t0x = startX;
  const t0y = startY;
  push(
    `; Initial move to tower 0`,
    `G1 E-${s.rStart.toFixed(2)} F${s.rSpeed * 60} ; retract`,
    `G1 X${t0x.toFixed(2)} Y${t0y.toFixed(2)} F${s.travelSpeed * 60} ; travel`,
    `G1 E${s.rStart.toFixed(2)} F${s.rSpeed * 60} ; unretract`,
    ``,
  );

  for (let i = 0; i < towerCount; i++) {
    const retDist = s.rStart + i * s.rIncrement;
    const tx = startX + i * (tw + tSpc);
    const ty = startY;

    push(`; ── Tower ${i + 1}/${towerCount} — Retraction: ${retDist.toFixed(2)}mm ──`);
    if (s.firmware === 'marlin') {
      push(`M207 S${retDist.toFixed(2)} F${s.rSpeed * 60} ; set firmware retraction`);
    }
    push(`M117 RET=${retDist.toFixed(2)}mm`);
    push(``);

    for (let layer = 0; layer < towerLayers; layer++) {
      const z = s.layerHeight + layer * s.layerHeight;
      push(`G1 Z${z.toFixed(2)} F3000`);
      push(`G92 E0`);
      // Move to tower start corner
      push(`G1 X${tx.toFixed(2)} Y${ty.toFixed(2)} F${s.travelSpeed * 60}`);
      // Print 4 sides of the square
      push(`G1 X${(tx + tw).toFixed(2)} Y${ty.toFixed(2)} E${sideE} F${s.printSpeed * 60}`);
      push(`G1 X${(tx + tw).toFixed(2)} Y${(ty + tw).toFixed(2)} E${sideE}`);
      push(`G1 X${tx.toFixed(2)} Y${(ty + tw).toFixed(2)} E${sideE}`);
      push(`G1 X${tx.toFixed(2)} Y${ty.toFixed(2)} E${sideE}`);
      push(`G92 E0`);
    }

    // After completing this tower, travel to next (if not last)
    if (i < towerCount - 1) {
      const nextTx = startX + (i + 1) * (tw + tSpc);
      const nextTy = startY;
      const zTop   = (s.layerHeight + (towerLayers - 1) * s.layerHeight + 0.5).toFixed(2);
      push(``);
      push(`; Travel to tower ${i + 2} — testing ${retDist.toFixed(2)}mm retraction`);
      push(`G1 Z${zTop} F3000 ; z-hop`);
      push(`G1 E-${retDist.toFixed(2)} F${s.rSpeed * 60} ; retract`);
      push(`G1 X${nextTx.toFixed(2)} Y${nextTy.toFixed(2)} F${s.travelSpeed * 60} ; travel (inspect for stringing)`);
      push(`G1 E${retDist.toFixed(2)} F${s.rSpeed * 60} ; unretract`);
      push(`G1 Z${(s.layerHeight).toFixed(2)} F3000 ; drop to first layer height`);
      push(``);
    }
  }

  push(``);
  push(`; === END G-CODE ===`, processGcode(s.endGcode).trim());
  return lines.join('\n');
}

// ── SYNTAX HIGHLIGHT ──
function highlight(raw: string): string {
  return raw.split('\n').map(line => {
    const t = line.trimStart();
    if (t.startsWith(';')) return `<span class="gc-comment">${esc(line)}</span>`;
    if (t.match(/^G1 E-/) || t.match(/^M207/))
      return `<span class="gc-retract">${esc(line)}</span>`;
    if (t.startsWith('M117')) return `<span class="gc-comment">${esc(line)}</span>`;
    return line.replace(/^([A-Z][0-9]+)/, '<span class="gc-cmd">$1</span>');
  }).join('\n');
}
function esc(s: string) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// ── COLLECT SETTINGS ──
function getSettings(): Record<string, any> {
  const fw = (document.querySelector<HTMLInputElement>('input[name="firmware"]:checked'))?.value ?? 'klipper';
  return {
    firmware:    fw,
    bedX:        +v('bedX'),
    bedY:        +v('bedY'),
    nozzleDia:   +v('nozzleDia'),
    filamentDia: +v('filamentDia'),
    travelSpeed: +v('travelSpeed'),
    hotendTemp:  +v('hotendTemp'),
    bedTemp:     +v('bedTemp'),
    rStart:      +v('rStart'),
    rEnd:        +v('rEnd'),
    rIncrement:  +v('rIncrement'),
    rSpeed:      +v('rSpeed'),
    towerHeight: +v('towerHeight'),
    towerWidth:  +v('towerWidth'),
    layerHeight: +v('layerHeight'),
    printSpeed:  +v('printSpeed'),
    fanSpeed:    +v('fanSpeed'),
    startGcode:  v('startGcode'),
    endGcode:    v('endGcode'),
  };
}
function v(id: string): string {
  const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
  return el?.value ?? '';
}

// ── VALIDATION ──
interface VResult { valid: boolean; errors: Map<string, string>; }

function validate(s: Record<string, any>): VResult {
  const errors = new Map<string, string>();
  if (s.rStart < 0)                                        errors.set('rStart',      'Must be ≥ 0');
  if (s.rEnd <= s.rStart)                                  errors.set('rEnd',        'Must be > Start');
  if (s.rIncrement <= 0 || s.rIncrement > (s.rEnd - s.rStart))
                                                           errors.set('rIncrement',  'Must be > 0 and ≤ range');
  if (s.bedX <= 50)                                        errors.set('bedX',        'Must be > 50');
  if (s.bedY <= 50)                                        errors.set('bedY',        'Must be > 50');
  if (s.layerHeight < 0.05 || s.layerHeight > 0.5)       errors.set('layerHeight', '0.05 – 0.5 mm');
  if (s.printSpeed <= 0)                                   errors.set('printSpeed',  'Must be > 0');
  return { valid: errors.size === 0, errors };
}

function applyValidation(result: VResult) {
  document.querySelectorAll<HTMLInputElement>('.pa-input').forEach(el => el.classList.remove('input-error'));
  document.querySelectorAll<HTMLElement>('.pa-field-error').forEach(el => { el.style.display = 'none'; el.textContent = ''; });
  result.errors.forEach((msg, fieldId) => {
    const input = document.getElementById(fieldId) as HTMLInputElement | null;
    if (input) input.classList.add('input-error');
    const errEl = document.getElementById(`err-${fieldId}`);
    if (errEl) { errEl.textContent = msg; errEl.style.display = 'block'; }
  });
  const disabled = !result.valid;
  const copyBtn = document.getElementById('copyBtn') as HTMLButtonElement | null;
  const dlBtn   = document.getElementById('downloadBtn') as HTMLButtonElement | null;
  if (copyBtn) copyBtn.disabled = disabled;
  if (dlBtn)   dlBtn.disabled   = disabled;
}

// ── TOWER COUNT + WARNINGS ──
function updateTowerCount() {
  const start = +v('rStart');
  const end   = +v('rEnd');
  const inc   = +v('rIncrement');
  if (inc <= 0 || end <= start) return;

  const rawCount = (end - start) / inc;
  const count    = Math.max(1, Math.round(rawCount) + 1);
  const countEl  = document.getElementById('towerCountNum');
  if (countEl) countEl.textContent = String(count);

  const errEl = document.getElementById('tower-count-error');
  if (errEl) errEl.style.display = count > 20 ? 'block' : 'none';

  const isClean = Math.abs(rawCount - Math.round(rawCount)) < 0.0001;
  const warnEl  = document.getElementById('increment-warning');
  if (warnEl) {
    warnEl.style.display = !isClean ? 'block' : 'none';
    if (!isClean) {
      const actualEnd = (start + Math.round(rawCount) * inc).toFixed(2);
      const spanEl = document.getElementById('incrementActualEnd');
      if (spanEl) spanEl.textContent = `Actual end: ${actualEnd}mm`;
    }
  }
}

// ── BED FIT CHECK ──
function checkBedFit(s: Record<string, any>) {
  const count    = Math.max(1, Math.round((s.rEnd - s.rStart) / s.rIncrement) + 1);
  const tw       = s.towerWidth;
  const tSpc     = 10;
  const totalW   = count * (tw + tSpc);
  const bedFitEl = document.getElementById('bed-fit-warning');
  if (!bedFitEl) return;
  if (totalW > s.bedX * 0.9) {
    bedFitEl.textContent = `⚠ Towers (${totalW.toFixed(0)}mm) exceed bed width (${s.bedX}mm). Increase increment or reduce range.`;
    bedFitEl.style.display = 'block';
  } else if (tw > s.bedY * 0.9) {
    bedFitEl.textContent = `⚠ Tower depth exceeds bed Y dimension.`;
    bedFitEl.style.display = 'block';
  } else {
    bedFitEl.style.display = 'none';
  }
}

// ── STATS BAR ──
function updateStats(s: Record<string, any>) {
  const count    = Math.max(1, Math.round((s.rEnd - s.rStart) / s.rIncrement) + 1);
  const tw       = s.towerWidth;
  const tLayers  = Math.max(1, Math.round(s.towerHeight / s.layerHeight));
  // 4 sides per layer × towerWidth each + travel between towers
  const perimMm  = count * tLayers * 4 * tw;
  const estSec   = (perimMm / s.printSpeed) + count * 3; // rough estimate
  const estMin   = Math.max(1, Math.round(estSec / 60));
  const fwLabels: Record<string, string> = { klipper:'Klipper', marlin:'Marlin', rrf:'RRF' };
  const fw = fwLabels[s.firmware] ?? 'Klipper';

  setText('statTowers', String(count));
  setText('statRange', `${s.rStart.toFixed(1)} → ${s.rEnd.toFixed(1)}mm`);
  setText('statTime', `~${estMin} min`);
  setText('statFirmware', fw);
}

function setText(id: string, val: string) {
  const el = document.getElementById(id);
  if (el) el.textContent = val;
}

// ── MAIN UPDATE ──
let currentGcode = '';
let debounceTimer: ReturnType<typeof setTimeout> | null = null;

function doUpdate() {
  const ind = document.getElementById('updatingIndicator');
  if (ind) ind.classList.remove('visible');

  const s = getSettings();
  updateStats(s);
  updateTowerCount();
  checkBedFit(s);
  const vResult = validate(s);
  applyValidation(vResult);

  try {
    currentGcode = generateGcode(s);
    const out = document.getElementById('gcodeOutput');
    if (out) out.innerHTML = highlight(currentGcode);
  } catch(e) {
    console.error('G-code generation error:', e);
  }
}

function scheduleUpdate() {
  const ind = document.getElementById('updatingIndicator');
  if (ind) ind.classList.add('visible');
  if (debounceTimer) clearTimeout(debounceTimer);
  debounceTimer = setTimeout(doUpdate, 150);
}

// ── PRESET APPLY ──
let presetActive   = 'custom';
let presetModified = false;

function applyPreset(preset: string) {
  presetActive   = preset;
  presetModified = false;
  updateModifiedBadge();

  const data = PRESETS[preset];
  if (!data) { scheduleUpdate(); return; }

  for (const [key, val] of Object.entries(data)) {
    if (key === 'firmware') {
      const radio = document.querySelector<HTMLInputElement>(`input[name="firmware"][value="${val}"]`);
      if (radio) radio.checked = true;
      const sgEl = document.getElementById('startGcode') as HTMLTextAreaElement | null;
      if (sgEl) sgEl.value = (val === 'klipper') ? KLIPPER_START : MARLIN_START;
    } else {
      const el = document.getElementById(key) as HTMLInputElement | null;
      if (el) el.value = String(val);
    }
  }
  scheduleUpdate();
}

function updateModifiedBadge() {
  const badge = document.getElementById('preset-modified');
  if (!badge) return;
  badge.style.display = (presetActive !== 'custom' && presetModified) ? 'block' : 'none';
}

// ── WIRE UP ──
document.addEventListener('DOMContentLoaded', () => {
  const presetEl = document.getElementById('preset') as HTMLSelectElement | null;
  presetEl?.addEventListener('change', () => applyPreset(presetEl.value));

  document.querySelectorAll<HTMLElement>('.pa-input, .pa-textarea').forEach(el => {
    el.addEventListener('input', () => {
      if (presetActive !== 'custom') { presetModified = true; updateModifiedBadge(); }
      scheduleUpdate();
    });
  });

  document.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach(el => {
    el.addEventListener('change', () => {
      if (presetActive !== 'custom') { presetModified = true; updateModifiedBadge(); }
      if (el.name === 'firmware' && !presetModified) {
        const sgEl = document.getElementById('startGcode') as HTMLTextAreaElement | null;
        if (sgEl) sgEl.value = el.value === 'klipper' ? KLIPPER_START : MARLIN_START;
      }
      scheduleUpdate();
    });
  });

  document.getElementById('copyBtn')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(currentGcode);
      const btn = document.getElementById('copyBtn') as HTMLButtonElement;
      btn.textContent = 'Copied ✓';
      btn.classList.add('copied');
      setTimeout(() => { btn.textContent = 'Copy G-code'; btn.classList.remove('copied'); }, 2000);
    } catch { /* clipboard blocked */ }
  });

  document.getElementById('downloadBtn')?.addEventListener('click', () => {
    const s = getSettings();
    const fwPrefix: Record<string, string> = { klipper:'retraction_klipper', marlin:'retraction_marlin', rrf:'retraction_rrf' };
    const prefix   = fwPrefix[s.firmware] ?? 'retraction_klipper';
    const filename = `${prefix}_${s.rStart.toFixed(1)}-${s.rEnd.toFixed(1)}mm.gcode`;
    const blob = new Blob([currentGcode], { type: 'text/plain' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href = url; a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  doUpdate();
});
</script>
