---
/* Hallmark · macrostructure: 2-col Cards · tone: technical-utilitarian · anchor hue: orange
 * transitions: tabs-sliding (16) on filter · texts-reveal (18) on card entrance
 * Distinct from: hotends (3-col) and extruders (rows) — cards occupy full columns
 * pre-emit critique: P5 H4 E4 S4 R5 V4
 */
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import probes from '../../../data/hardware/bed-probes.json';

const toSlug = (name: string) =>
  name.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');

const VERDICT_ORDER = ['BUY', 'CONSIDER', 'SKIP', 'UPDATED'];

const VERDICT_BADGE: Record<string, { cls: string; label: string }> = {
  'BUY':      { cls: 'verdict-best', label: 'Buy' },
  'CONSIDER': { cls: 'verdict-rec',  label: 'Consider' },
  'SKIP':     { cls: 'verdict-skip', label: 'Skip' },
  'UPDATED':  { cls: 'verdict-upd',  label: 'Updated' },
};

const records = (probes as any[])
  .filter((r: any) => typeof r['Name'] === 'string' && r['Name'].trim())
  .sort((a: any, b: any) => {
    const av = a['Verdict'] as string | undefined;
    const bv = b['Verdict'] as string | undefined;
    const ai = av ? VERDICT_ORDER.indexOf(av) : -1;
    const bi = bv ? VERDICT_ORDER.indexOf(bv) : -1;
    return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
  });

const verdictCounts: Record<string, number> = { all: records.length };
for (const v of VERDICT_ORDER) {
  const n = records.filter((r: any) => r['Verdict'] === v).length;
  if (n > 0) verdictCounts[v] = n;
}
const activeVerdicts = VERDICT_ORDER.filter(v => (verdictCounts[v] ?? 0) > 0);

const siteBase = Astro.site
  ? new URL(Astro.site).href.replace(/\/$/, '')
  : 'https://modernmakes.github.io';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Best Bed Probes for Voron & Prosumer Printers',
  url: `${siteBase}/hardware/probes`,
  itemListElement: records.map((r: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: r['Name'] as string,
    url: `${siteBase}/hardware/probes/${toSlug(r['Name'] as string)}`,
  })),
};
---
<Base
  title="Best Bed Probes for Voron & Prosumer Printers — Modern Makes"
  description="Bed probe comparisons and verdicts for Voron, RatRig, and CoreXY builds — Beacon, Cartographer, Klicky, Euclid, Voron Tap."
  heroPage={false}
>
  <Nav slot="nav" currentPath="/hardware" />

  <!-- HEADER -->
  <div class="pbi-header">
    <div class="pbi-header-inner">
      <div class="pbi-header-content">
        <nav class="pbi-breadcrumb" aria-label="Breadcrumb">
          <a href="/hardware">Hardware</a>
          <span aria-hidden="true">/</span>
          <span>Bed Probes</span>
        </nav>
        <h1 class="pbi-title">Bed Probes</h1>
        <p class="pbi-sub">Automatic bed leveling solutions for Voron, RatRig, VzBot, and other CoreXY platforms.</p>
        <div class="pbi-meta-row">
          <span class="pbi-meta-chip">{records.length} probe{records.length !== 1 ? 's' : ''}</span>
          <span class="pbi-meta-chip">Eddy current, magnetic, nozzle-based</span>
        </div>
      </div>

      {/* Only show filter if there are verdict-tagged records */}
      {activeVerdicts.length > 0 && (
        <div class="pbi-filter-wrap">
          <p class="pbi-filter-label">Filter</p>
          <div class="t-tabs" role="tablist" id="pbi-tabs" aria-label="Filter by verdict">
            <span class="t-tabs-pill" aria-hidden="true"></span>
            <button class="t-tab" role="tab" aria-selected="true" data-verdict="all">
              All<span class="pbi-count">{records.length}</span>
            </button>
            {activeVerdicts.map(v => (
              <button class="t-tab" role="tab" aria-selected="false" data-verdict={v.toLowerCase()}>
                {v.charAt(0).toUpperCase() + v.slice(1).toLowerCase()}<span class="pbi-count">{verdictCounts[v]}</span>
              </button>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- 2-COL CARD GRID -->
  <div class="pbi-body">
    <div class="pbi-container">
      {records.length > 0 ? (
        <div class="pbi-card-grid" id="pbi-grid">
          {records.map((r: any, i: number) => {
            const slug = toSlug(r['Name']);
            const badge = r['Verdict'] ? (VERDICT_BADGE[r['Verdict']] ?? null) : null;
            const probeType = r['Probe Type'] as string | undefined;
            const price    = r['Price (USD)'] as number | undefined;
            const brand    = r['Brand'] as string | undefined;
            const excerpt  = r['Excerpt'] ?? r['Description'] as string | undefined;
            return (
              <a
                href={`/hardware/probes/${slug}`}
                class="pbi-card"
                data-verdict={(r['Verdict'] as string | undefined)?.toLowerCase() ?? ''}
                style={`transition-delay:calc(var(--stagger-stagger) * ${i})`}
                aria-label={`${r['Name']}${badge ? ` — ${badge.label}` : ''}`}
              >
                <div class="pbi-card-head">
                  <div class="pbi-card-identity">
                    {brand && <span class="pbi-card-brand">{brand}</span>}
                    <span class="pbi-card-name">{r['Name']}</span>
                  </div>
                  {badge && <span class={`verdict ${badge.cls}`}>{badge.label}</span>}
                </div>
                <div class="pbi-card-body">
                  {excerpt && <p class="pbi-card-excerpt">{excerpt}</p>}
                  <div class="pbi-card-specs">
                    {probeType && (
                      <div class="pbi-spec">
                        <span class="pbi-spec-label">Type</span>
                        <span class="pbi-spec-value">{probeType}</span>
                      </div>
                    )}
                    {price != null && (
                      <div class="pbi-spec">
                        <span class="pbi-spec-label">Price</span>
                        <span class="pbi-spec-value pbi-price">${price}</span>
                      </div>
                    )}
                  </div>
                </div>
                <div class="pbi-card-footer">
                  <span class="pbi-card-link">View specs →</span>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <p class="pbi-empty">No bed probe data yet — check back after the next Airtable sync.</p>
      )}
      <p class="pbi-no-match" id="pbi-no-match" style="display:none">
        No probes match this filter.
      </p>
    </div>
  </div>

  <Footer slot="footer" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(itemListSchema)}></script>
</Base>

<!-- ── FILTER + TABS JS ── -->
<script>
(function () {
  const bar   = document.getElementById('pbi-tabs') as HTMLElement | null;
  const grid  = document.getElementById('pbi-grid') as HTMLElement | null;
  const noMsg = document.getElementById('pbi-no-match') as HTMLElement | null;
  if (!grid) return;

  /* ── texts-reveal on grid enter ── */
  const obs = new IntersectionObserver(([entry]) => {
    if (entry.isIntersecting) {
      grid.classList.add('is-shown');
      obs.disconnect();
    }
  }, { threshold: 0.05 });
  obs.observe(grid);

  if (!bar) return;

  const pill = bar.querySelector('.t-tabs-pill') as HTMLElement;
  const tabs = [...bar.querySelectorAll<HTMLButtonElement>('.t-tab')];
  const cards = [...grid.querySelectorAll<HTMLElement>('.pbi-card')];

  function moveTo(tab: HTMLButtonElement, animate: boolean) {
    if (!animate) {
      const prev = pill.style.transition;
      pill.style.transition = 'none';
      pill.style.transform = `translateX(${tab.offsetLeft}px)`;
      pill.style.width     = `${tab.offsetWidth}px`;
      void pill.offsetWidth;
      pill.style.transition = prev;
    } else {
      pill.style.transform = `translateX(${tab.offsetLeft}px)`;
      pill.style.width     = `${tab.offsetWidth}px`;
    }
  }

  const activeTab = () =>
    tabs.find(t => t.getAttribute('aria-selected') === 'true') ?? tabs[0];

  function applyFilter(verdict: string) {
    let visible = 0;
    cards.forEach(card => {
      const match = verdict === 'all' || card.dataset.verdict === verdict;
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    if (noMsg) noMsg.style.display = visible === 0 ? 'block' : 'none';
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.setAttribute('aria-selected', t === tab ? 'true' : 'false'));
      moveTo(tab, true);
      applyFilter(tab.dataset.verdict ?? 'all');
    });
  });

  requestAnimationFrame(() => moveTo(activeTab(), false));
  window.addEventListener('resize', () => moveTo(activeTab(), false));
})();
</script>

<style is:global>
/* ─── PROBE INDEX — 2-col Cards macrostructure ───────────────────────── */

.pbi-header {
  background: var(--surface);
  border-bottom: 2px solid var(--black);
  padding: 40px 0 32px;
}
.pbi-header-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 40px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;
}
.pbi-header-content { flex: 1; min-width: 0; }
.pbi-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--fm);
  font-size: 10px;
  color: var(--g2);
  margin-bottom: 14px;
}
.pbi-breadcrumb a { transition: color .15s; }
.pbi-breadcrumb a:hover { color: var(--accent); }
.pbi-title {
  font-family: var(--fd);
  font-size: 48px;
  font-weight: 800;
  color: var(--black);
  line-height: 1;
  letter-spacing: -.5px;
  margin-bottom: 8px;
}
.pbi-sub {
  font-family: var(--fb);
  font-size: 14px;
  color: var(--g1);
  line-height: 1.6;
  margin-bottom: 12px;
  max-width: 460px;
  font-style: italic;
}
.pbi-meta-row { display: flex; flex-wrap: wrap; gap: 6px; }
.pbi-meta-chip {
  font-family: var(--fm);
  font-size: 10px;
  color: var(--g2);
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 3px;
  padding: 2px 8px;
}

/* filter */
.pbi-filter-wrap {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
}
.pbi-filter-label {
  font-family: var(--fm);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--g2);
}
.pbi-count {
  display: inline-block;
  font-family: var(--fm);
  font-size: 9px;
  font-weight: 700;
  color: var(--g2);
  background: rgba(0,0,0,.06);
  border-radius: 3px;
  padding: 1px 5px;
  margin-left: 4px;
}
.t-tab[aria-selected="true"] .pbi-count {
  background: rgba(255,90,31,.12);
  color: var(--accent);
}

/* body */
.pbi-body {
  background: var(--bg);
  padding: 32px 0 72px;
}
.pbi-container {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 40px;
}

/* 2-col card grid */
.pbi-card-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

/* card entrance — texts-reveal */
.pbi-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  text-decoration: none;
  color: inherit;
  /* entrance */
  opacity: 0;
  transform: translateY(var(--stagger-distance));
  filter: blur(var(--stagger-blur));
  transition:
    opacity   var(--stagger-dur) var(--stagger-ease),
    transform var(--stagger-dur) var(--stagger-ease),
    filter    var(--stagger-dur) var(--stagger-ease);
  will-change: opacity, transform, filter;
}
.pbi-card-grid.is-shown .pbi-card {
  opacity: 1;
  transform: none;
  filter: none;
  transition: border-color .15s ease, box-shadow .15s ease;
}
.pbi-card-grid.is-shown .pbi-card:hover {
  border-color: var(--accent);
  box-shadow: 0 4px 20px rgba(255,90,31,.08);
}
@media (prefers-reduced-motion: reduce) {
  .pbi-card {
    transition: none !important;
    opacity: 1 !important;
    transform: none !important;
    filter: none !important;
  }
}

/* card internals */
.pbi-card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
}
.pbi-card-identity { display: flex; flex-direction: column; gap: 3px; }
.pbi-card-brand {
  font-family: var(--fm);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--accent);
}
.pbi-card-name {
  font-family: var(--fd);
  font-size: 24px;
  font-weight: 800;
  color: var(--black);
  line-height: 1;
  letter-spacing: -.3px;
}
.pbi-card-body { flex: 1; }
.pbi-card-excerpt {
  font-family: var(--fb);
  font-size: 13px;
  color: var(--g1);
  line-height: 1.75;
  margin-bottom: 14px;
}
.pbi-card-specs {
  display: flex;
  gap: 24px;
  flex-wrap: wrap;
}
.pbi-spec { display: flex; flex-direction: column; gap: 2px; }
.pbi-spec-label {
  font-family: var(--fm);
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--g2);
}
.pbi-spec-value {
  font-family: var(--fm);
  font-size: 12px;
  color: var(--black);
  font-weight: 600;
}
.pbi-price { color: var(--black); }
.pbi-card-footer {
  border-top: 1px solid var(--border);
  padding-top: 14px;
  margin-top: auto;
}
.pbi-card-link {
  font-family: var(--fu);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .05em;
  text-transform: uppercase;
  color: var(--g2);
  transition: color .15s;
}
.pbi-card-grid.is-shown .pbi-card:hover .pbi-card-link {
  color: var(--accent);
}
.pbi-empty,
.pbi-no-match {
  font-family: var(--fb);
  font-size: 15px;
  color: var(--g2);
  font-style: italic;
  padding: 40px 0;
}

/* responsive */
@media (max-width: 900px) {
  .pbi-card-grid { grid-template-columns: 1fr; }
}
@media (max-width: 768px) {
  .pbi-header-inner {
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding: 0 24px;
  }
  .pbi-header { padding: 32px 0 24px; }
  .pbi-title { font-size: 40px; }
  .pbi-filter-wrap { align-items: flex-start; }
  .pbi-container { padding: 0 24px; }
}
@media (max-width: 480px) {
  .pbi-header-inner, .pbi-container { padding: 0 20px; }
  .pbi-title { font-size: 34px; }
}
</style>
